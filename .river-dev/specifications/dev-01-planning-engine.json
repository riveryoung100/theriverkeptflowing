    "typecheck",
    "documentation",
    "exports",
    "secret-scan",
    "review",
    "staged-diff"
  ],
  "approvedCommands": [
    "git-status",
    "git-branch-current",
    "git-diff",
    "typecheck",
    "test-tsx"
  ],
  "repairLimits": {
