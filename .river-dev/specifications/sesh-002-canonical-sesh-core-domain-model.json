    "identifierContract":  {
                               "requirements":  [
                                                    "Every identifier must be a branded string type.",
                                                    "Every identifier must have an explicit parser or validator.",
                                                    "Every identifier must reject empty values.",
                                                    "Every identifier must reject values with the wrong prefix.",
                                                    "Identifier helpers must not use randomness internally unless explicitly supplied by a caller.",
                                                    "Canonical records accept identifiers but do not create hidden identities as side effects."
                                                ],
                               "recommendedShape":  "\u003cprefix\u003e:\u003cnon-empty-local-id\u003e"
                           },
    "canonicalCoreModels":  [
                                {
                                    "name":  "SeshCreatorProfile",
                                    "requiredFields":  [
                                                           "id",
                                                           "displayName",
                                                           "createdAt"
                                                       ],
                                    "optionalFields":  [
                                                           "handle",
                                                           "bio"
                                                       ],
                                    "invariants":  [
                                                       "displayName must be non-empty.",
                                                       "Creator profile is not an authentication account.",
                                                       "Creator profile is not a legal identity record."
                                                   ]
                                },
                                {
                                    "name":  "SeshMusicProject",
                                    "requiredFields":  [
                                                           "id",
                                                           "ownerCreatorId",
                                                           "title",
                                                           "createdAt",
                                                           "updatedAt",
                                                           "trackIds",
                                                           "sessionIds",
                                                           "audioAssetIds"
                                                       ],
                                    "optionalFields":  [
                                                           "tempoMapId",
                                                           "beatGridId",
                                                           "description"
                                                       ],
                                    "invariants":  [
                                                       "title must be non-empty.",
                                                       "ownerCreatorId must be a valid SeshCreatorId.",
                                                       "updatedAt must not precede createdAt.",
                                                       "referenced identifiers must be valid canonical Sesh identifiers.",
                                                       "duplicate referenced identifiers must be rejected or normalized deterministically."
                                                   ]
                                },
                                {
                                    "name":  "SeshAudioAsset",
                                    "requiredFields":  [
                                                           "id",
                                                           "projectId",
                                                           "kind",
                                                           "name",
                                                           "createdAt"
                                                       ],
                                    "optionalFields":  [
                                                           "durationSeconds",
                                                           "sampleRateHz",
                                                           "channelCount",
                                                           "storageReference",
                                                           "contentType"
                                                       ],
                                    "allowedKinds":  [
                                                         "recording",
                                                         "track",
                                                         "stem",
                                                         "sample",
                                                         "loop",
                                                         "one-shot",
                                                         "render",
                                                         "mix",
                                                         "master",
                                                         "reference"
                                                     ],
                                    "invariants":  [
                                                       "name must be non-empty.",
                                                       "durationSeconds, when present, must be finite and non-negative.",
                                                       "sampleRateHz, when present, must be finite and positive.",
                                                       "channelCount, when present, must be a positive integer.",
                                                       "storageReference is opaque metadata and must not make the canonical domain dependent on a storage provider."
                                                   ]
                                },
                                {
                                    "name":  "SeshSession",
                                    "requiredFields":  [
                                                           "id",
                                                           "projectId",
                                                           "startedAt"
                                                       ],
                                    "optionalFields":  [
                                                           "endedAt",
                                                           "name"
                                                       ],
                                    "invariants":  [
                                                       "endedAt, when present, must not precede startedAt."
                                                   ]
                                },
                                {
                                    "name":  "SeshTrack",
                                    "requiredFields":  [
                                                           "id",
                                                           "projectId",
                                                           "name",
                                                           "order",
                                                           "audioAssetIds"
                                                       ],
                                    "optionalFields":  [
                                                           "muted",
                                                           "solo",
                                                           "gain"
                                                       ],
                                    "invariants":  [
                                                       "name must be non-empty.",
                                                       "order must be a non-negative integer.",
                                                       "gain, when present, must be finite.",
                                                       "audioAssetIds must contain valid SeshAudioAssetIds."
                                                   ]
                                },
                                {
                                    "name":  "SeshTempoPoint",
                                    "requiredFields":  [
                                                           "beat",
                                                           "bpm"
                                                       ],
                                    "invariants":  [
                                                       "beat must be finite and non-negative.",
                                                       "bpm must be finite and greater than zero."
                                                   ]
                                },
                                {
                                    "name":  "SeshTempoMap",
                                    "requiredFields":  [
                                                           "id",
                                                           "projectId",
                                                           "points"
                                                       ],
                                    "invariants":  [
                                                       "points must contain at least one tempo point.",
                                                       "tempo points must be ordered by beat.",
                                                       "two tempo points may not occupy the same beat."
                                                   ]
                                },
                                {
                                    "name":  "SeshBeatGrid",
                                    "requiredFields":  [
