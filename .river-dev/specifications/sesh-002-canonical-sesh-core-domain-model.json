                                                        "versionId"
                                                    ],
                                 "rule":  "The presence of a storage reference must not imply any one persistence technology."
                             }
                         ],
    "validationContract":  {
                               "strategy":  "Explicit runtime validators with deterministic error behavior.",
                               "requirements":  [
                                                    "Validate unknown input rather than trusting TypeScript types at runtime.",
                                                    "Do not silently coerce malformed identifiers.",
                                                    "Do not silently coerce NaN or Infinity into valid musical values.",
                                                    "Reject empty required strings after trimming.",
                                                    "Reject invalid enum members.",
                                                    "Reject impossible temporal ordering.",
                                                    "Reject duplicate values where uniqueness is a model invariant.",
                                                    "Return or throw errors with enough field context for future API and persistence layers.",
                                                    "Validators must not perform network calls.",
                                                    "Validators must not access persistence.",
                                                    "Validators must not mutate repository or global state."
                                                ]
                           },
    "publicExportContract":  {
