                                                 "identifier helpers",
                                                 "canonical core model types",
                                                 "canonical enum/union types",
                                                 "runtime validation functions"
                                             ],
                                 "rule":  "Consumers should be able to import canonical Sesh core concepts from src/lib/sesh without knowing internal file layout."
                             },
