{
    "id":  "SESH-002",
    "title":  "Canonical Sesh Core Domain Model",
    "status":  "proposed",
    "version":  "1.0.0",
    "createdDate":  "2026-09-21",
    "parent":  {
                   "id":  "SESH-001",
                   "title":  "Sesh Domain Architecture Foundation",
                   "commit":  "309c56b69c323e9a70219023559c0e4d986f371b"
               },
    "objective":  "Implement the smallest canonical, provider-independent, storage-independent Sesh domain foundation required for every major Sesh product family.",
    "rationale":  [
                      "Sesh Studio, Rhythm, Keys, Control, Pulse, Sounds, Launch, future hardware, and future intelligence all require stable shared music-domain concepts.",
                      "The domain model must exist before UI, persistence, audio-engine integration, marketplace logic, membership logic, rights workflows, or hardware execution.",
                      "The first implementation should capture identity, ownership relationships, temporal music structure, input normalization, and synchronized feedback without binding the domain to a particular browser API, database, cloud provider, AI provider, payment system, or audio engine."
                  ],
    "architectureRules":  [
                              "Place canonical implementation under src/lib/sesh.",
                              "Keep the core domain pure TypeScript.",
                              "Do not import Astro components into the Sesh domain.",
                              "Do not import Cloudflare bindings into the Sesh domain.",
                              "Do not import Stripe into the Sesh domain.",
                              "Do not import River OS CRM persistence into the Sesh domain.",
                              "Do not import the River Development Agent into the Sesh domain.",
                              "Do not bind canonical models to D1, R2, filesystem storage, IndexedDB, localStorage, or another persistence technology.",
                              "Do not bind canonical models to Web Audio, AudioWorklet, Tone.js, MIDI APIs, Gamepad APIs, or another execution provider.",
                              "Domain records must be serializable data.",
                              "Canonical identity creation and validation must be deterministic and independently testable.",
                              "Domain validation must reject malformed data at the Sesh boundary.",
                              "Low-latency musical execution belongs to later execution layers, not these canonical records.",
                              "Core models must support future web, desktop, mobile, hardware, and AI-assisted product surfaces."
                          ],
    "implementationScope":  {
                                "codeRoot":  "src/lib/sesh",
                                "files":  [
                                              {
                                                  "path":  "src/lib/sesh/identifiers.ts",
                                                  "responsibility":  "Canonical Sesh branded identifier types, creation, and validation."
                                              },
                                              {
                                                  "path":  "src/lib/sesh/model.ts",
                                                  "responsibility":  "Canonical Sesh core domain record and union types."
                                              },
                                              {
                                                  "path":  "src/lib/sesh/validation.ts",
                                                  "responsibility":  "Runtime validation for canonical Sesh core records."
                                              },
                                              {
                                                  "path":  "src/lib/sesh/index.ts",
                                                  "responsibility":  "Stable public export surface for the canonical Sesh core."
                                              },
                                              {
                                                  "path":  "src/lib/sesh/identifiers.test.ts",
                                                  "responsibility":  "Identifier construction and validation tests."
                                              },
                                              {
                                                  "path":  "src/lib/sesh/validation.test.ts",
                                                  "responsibility":  "Canonical domain validation tests."
                                              },
                                              {
                                                  "path":  "src/lib/sesh/model.test.ts",
                                                  "responsibility":  "Type-shape and invariant behavior tests for representative Sesh records."
                                              }
                                          ]
                            },
