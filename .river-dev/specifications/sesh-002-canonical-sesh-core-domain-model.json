                                                           "pointer",
                                                           "touch",
                                                           "game-controller",
                                                           "midi",
                                                           "sesh-device"
                                                       ],
                                    "invariants":  [
                                                       "Input normalization must preserve source without coupling downstream musical logic to source-specific APIs.",
                                                       "occurredAt must be a valid timestamp."
                                                   ]
                                },
                                {
