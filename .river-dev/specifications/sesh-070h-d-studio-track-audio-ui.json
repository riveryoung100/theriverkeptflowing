{
  "id": "SESH-070H-D",
  "title": "Studio track-audio attachment UI",
  "baseline": {
    "trackCrudUi": "SESH-070G",
    "audioDeleteCanonicalMembershipFix": "SESH-070H-A2",
    "trackAudioOperationService": "SESH-070H-B",
    "trackAudioHttpRuntime": "SESH-070H-C"
  },
  "purpose": [
    "Let an authenticated Studio owner view canonical private-audio attachment state for each canonical project track.",
