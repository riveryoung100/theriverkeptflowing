    "Let the owner detach currently attached private audio through the existing dedicated track-audio DELETE route."
  ],
  "canonicalAuthority": {
    "projectAudioInventory": "project.audioAssetIds",
    "trackAttachmentState": "track.audioAssetIds",
    "attachMutation": "SESH-070H-C PUT",
    "detachMutation": "SESH-070H-C DELETE",
    "requestBodyAuthority": "none",
    "browserRevisionAuthority": "none",
    "genericTrackPatchAudioMutation": false,
    "browserProjectAudioMutation": false
  },
  "studioBehavior": {
    "trackAudioControls": true,
    "privateAudioInventoryRead": true,
    "alreadyAttachedAssetsShown": true,
    "duplicateAttachChoiceShown": false,
    "successfulMutationRefreshesCanonicalServerState": true,
    "optimisticAttachmentMutation": false,
    "boundedErrorPresentation": true,
    "rawStorageIdentityDisplayed": false
  },
  "authorityBoundaries": {
    "directD1": false,
    "directR2": false,
    "seshDbBinding": false,
    "seshAudioBinding": false,
    "identityBinding": false,
    "ownerIdentityFromBrowserTrusted": false,
    "revisionFromBrowserTrusted": false
  },
  "excluded": [
    "Generic PATCH mutation of track.audioAssetIds.",
    "Mutation of project.audioAssetIds.",
