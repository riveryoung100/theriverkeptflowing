    "objective":  "Select the first production-grade metadata and binary-object persistence adapters for Sesh while preserving the provider-neutral contracts established by SESH-003.",
    "decisionScope":  [
                          "Select a production metadata persistence adapter.",
                          "Select a production binary audio-object adapter.",
                          "Define the adapter boundaries required to preserve SESH-003 repository contracts.",
                          "Define operational constraints, failure semantics, migration expectations, and rollback expectations.",
                          "Do not provision infrastructure yet.",
                          "Do not deploy yet."
                      ],
    "establishedConstraints":  [
                                   "Canonical Sesh domain models remain provider-independent.",
                                   "SeshProjectRepository remains the project persistence contract.",
                                   "SeshAudioAssetRepository remains the audio metadata persistence contract.",
                                   "SeshAudioObjectStore remains the binary-object persistence contract.",
                                   "Metadata and binary audio remain separate storage concerns.",
                                   "Production adapters must preserve canonical validation behavior.",
                                   "Production adapters must preserve not-found, validation, version, conflict, and storage failure distinctions.",
                                   "Production adapters must not introduce Cloudflare-specific types into canonical Sesh or provider-neutral persistence contracts.",
                                   "Local low-latency musical execution must not depend on production persistence latency."
                               ],
    "evaluatedMetadataAdapters":  [
                                      {
                                          "name":  "Cloudflare D1",
                                          "category":  "relational edge database",
                                          "disposition":  "selected",
                                          "strengths":  [
                                                            "Fits existing Cloudflare deployment architecture.",
                                                            "Suitable for structured project and audio metadata.",
                                                            "Supports relational querying and indexing.",
                                                            "Can store serialized persistence envelopes or normalized metadata tables.",
                                                            "Keeps metadata separate from binary audio objects.",
                                                            "Operationally aligned with the existing TRKF infrastructure direction."
                                                        ],
                                          "constraints":  [
                                                              "Adapter must remain behind SeshProjectRepository and SeshAudioAssetRepository.",
                                                              "D1 bindings must not leak into canonical domain files.",
                                                              "Schema migrations require explicit version control and review.",
                                                              "D1 errors must map to Sesh persistence failure semantics rather than being surfaced raw."
                                                          ]
                                      },
                                      {
                                          "name":  "Production filesystem",
                                          "category":  "filesystem storage",
                                          "disposition":  "not-selected",
                                          "strengths":  [
                                                            "Simple local development model.",
                                                            "Useful for test or tooling adapters."
                                                        ],
                                          "constraints":  [
                                                              "Poor fit for distributed production Cloudflare execution.",
                                                              "Not appropriate as the primary production metadata store."
                                                          ]
                                      },
                                      {
                                          "name":  "External relational database",
                                          "category":  "managed relational database",
                                          "disposition":  "deferred",
                                          "strengths":  [
                                                            "Could provide broader SQL features or alternate scaling characteristics."
                                                        ],
                                          "constraints":  [
                                                              "Adds operational and integration complexity before D1 limits are demonstrated.",
                                                              "Not justified for the first production Sesh persistence implementation."
                                                          ]
                                      }
                                  ],
    "selectedMetadataAdapter":  {
                                    "provider":  "Cloudflare D1",
                                    "purpose":  "Production Sesh structured metadata persistence.",
                                    "contractsImplemented":  [
                                                                 "SeshProjectRepository",
                                                                 "SeshAudioAssetRepository"
                                                             ],
                                    "selectionReason":  "D1 matches the existing Cloudflare architecture, fits structured Sesh metadata, and can remain cleanly isolated behind the already-proven repository contracts."
                                },
    "evaluatedBinaryObjectAdapters":  [
                                          {
                                              "name":  "Cloudflare R2",
                                              "category":  "object storage",
                                              "disposition":  "selected",
                                              "strengths":  [
                                                                "Designed for large binary objects.",
                                                                "Fits Cloudflare deployment architecture.",
                                                                "Natural match for recorded audio, stems, samples, mixes, and rendered files.",
                                                                "Allows metadata to remain in D1 while object bytes remain in object storage.",
                                                                "Maps cleanly to opaque SeshStorageReference values."
