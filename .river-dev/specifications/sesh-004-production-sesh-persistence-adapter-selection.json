                                              "purpose":  "Durable Sesh project records.",
                                              "conceptualColumns":  [
                                                                        "project_id",
                                                                        "schema_version",
                                                                        "revision",
                                                                        "stored_at",
                                                                        "payload_json"
                                                                    ]
                                          },
                                          {
                                              "name":  "sesh_audio_assets",
                                              "purpose":  "Durable Sesh audio metadata records.",
                                              "conceptualColumns":  [
                                                                        "audio_asset_id",
                                                                        "project_id",
                                                                        "schema_version",
                                                                        "revision",
                                                                        "stored_at",
                                                                        "payload_json"
                                                                    ]
                                          }
                                      ],
                           "indexes":  [
                                           "Primary lookup by project_id.",
                                           "Primary lookup by audio_asset_id.",
                                           "Audio-asset listing index by project_id."
                                       ],
                           "rules":  [
                                         "payload_json must deserialize through existing SESH-003 validation.",
                                         "Database columns used for lookup must agree with canonical payload identifiers.",
                                         "Schema version must remain explicit.",
                                         "Revision must remain available for future optimistic concurrency.",
                                         "Migration files must be version-controlled."
                                     ]
                       },
    "r2KeyStrategy":  {
                          "objective":  "Define stable opaque object keys without encoding legal or business authority.",
                          "recommendedShape":  "sesh/projects/\u003cproject-local-id\u003e/audio/\u003casset-local-id\u003e/\u003cobject-name\u003e",
                          "rules":  [
                                        "Object keys are infrastructure identifiers, not canonical Sesh IDs.",
                                        "Canonical SeshAudioAssetId remains stored in metadata.",
                                        "R2 keys must not imply ownership rights.",
                                        "Object keys should be deterministic where practical.",
                                        "File names must be sanitized before inclusion in object keys.",
                                        "Future content-addressed storage remains possible."
                                    ]
                      },
    "operationalRequirements":  [
                                    "Adapter writes validate canonical payloads before persistence.",
                                    "Adapter reads validate persisted payloads before returning data.",
                                    "Database failures map to storage failures.",
                                    "Missing rows or objects map to not-found results.",
                                    "Unsupported schema versions map to version failures.",
                                    "Future optimistic-concurrency mismatches map to conflict failures.",
                                    "Metadata writes must not require binary-object writes in the same operation unless explicitly orchestrated.",
                                    "Binary-object writes must not silently create canonical metadata.",
                                    "Delete operations remain explicit.",
                                    "No destructive cascading deletion is introduced by default."
                                ],
    "migrationAndRollback":  [
                                 "Initial D1 schema must be introduced through a version-controlled migration.",
                                 "Migration execution requires explicit authorization separate from code creation.",
                                 "R2 bucket provisioning requires explicit authorization separate from code creation.",
                                 "Adapters must be testable against local or mocked bindings before production provisioning.",
                                 "Rollback must preserve existing SESH-003 in-memory adapters.",
                                 "Provider-neutral repository interfaces remain the fallback boundary.",
                                 "No production data migration is authorized by SESH-004."
                             ],
    "securityAndPrivacy":  [
                               "Do not place secrets in canonical Sesh records.",
                               "Do not place Cloudflare credentials in source code.",
                               "Bindings are supplied by runtime configuration.",
                               "Future authorization checks belong above or around repository adapters rather than inside canonical data models.",
