                          "discoveryConclusion":  {
                                                      "statement":  "The current River OS access session proves authorization to enter River OS but does not identify a distinct human or account.",
                                                      "consequence":  "The current river-os-authenticated boolean session MUST NOT be used as Sesh creator identity.",
                                                      "reason":  [
                                                                     "A boolean cannot distinguish multiple creators.",
                                                                     "A shared access key does not establish durable per-person identity.",
                                                                     "Sesh project ownership requires a stable authenticated subject.",
                                                                     "SeshCreatorId must remain a domain identity rather than become the authentication credential itself."
                                                                 ]
                                                  },
                          "identityLayers":  {
                                                 "authenticatedPrincipal":  {
                                                                                "purpose":  "Represent the durable authenticated application identity.",
                                                                                "proposedType":  "AuthenticatedPrincipal",
                                                                                "proposedIdType":  "PrincipalId",
                                                                                "semantics":  "Stable application-level identity independent of Sesh, CRM, display name, email, or session identifier.",
                                                                                "mustContain":  [
                                                                                                    "principalId"
                                                                                                ],
                                                                                "mayContain":  [
                                                                                                   "authenticationMethod",
                                                                                                   "sessionId",
                                                                                                   "issuedAt",
                                                                                                   "expiresAt"
                                                                                               ],
                                                                                "mustNotContainAsCanonicalIdentity":  [
                                                                                                                          "displayName",
                                                                                                                          "email",
                                                                                                                          "CRM relationship id",
                                                                                                                          "SeshCreatorId"
                                                                                                                      ]
                                                                            },
                                                 "seshCreator":  {
                                                                     "canonicalType":  "SeshCreatorId",
                                                                     "semantics":  "Music-domain creator identity owned by Sesh.",
                                                                     "rule":  "SeshCreatorId MUST remain distinct from PrincipalId.",
                                                                     "mapping":  "An explicit mapping must associate an authenticated PrincipalId with one or more authorized SeshCreatorId values."
                                                                 },
                                                 "crmPerson":  {
                                                                   "rule":  "River CRM relationship/person identity remains independent and MUST NOT automatically become PrincipalId or SeshCreatorId."
                                                               }
                                             },
                          "selectedArchitecture":  {
                                                       "model":  "Principal-first identity with explicit Sesh creator mapping",
                                                       "sequence":  [
                                                                        "Authenticate caller.",
                                                                        "Resolve durable PrincipalId.",
                                                                        "Load explicit principal-to-SeshCreator mapping.",
                                                                        "Resolve authorized SeshCreatorId.",
                                                                        "Load target SeshMusicProject.",
                                                                        "Authorize ownerCreatorId or future collaborator permission.",
                                                                        "Only then perform project or audio operation."
                                                                    ],
                                                       "rejectedAlternatives":  [
                                                                                    "Use river-os-authenticated=true as creator identity.",
                                                                                    "Use the shared River OS access key as creator identity.",
                                                                                    "Use email address directly as SeshCreatorId.",
                                                                                    "Use CRM relationship identity as SeshCreatorId.",
                                                                                    "Trust creatorId supplied by client request.",
                                                                                    "Infer creator identity from display name.",
                                                                                    "Infer ownership from project identifier."
                                                                                ]
                                                   },
                          "principalId":  {
                                              "requiredProperties":  [
