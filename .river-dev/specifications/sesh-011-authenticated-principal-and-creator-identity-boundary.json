                                                                         "Opaque",
                                                                         "Unique",
                                                                         "Non-secret",
                                                                         "Not derived from mutable profile information"
                                                                     ],
                                              "proposedPrefix":  "principal",
                                              "example":  "principal:01JXYZ...",
                                              "generation":  "Generated server-side when an account/principal is created.",
