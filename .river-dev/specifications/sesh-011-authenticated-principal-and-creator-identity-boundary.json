                          "migrationStrategy":  {
                                                    "phase1":  "Specify shared PrincipalId and account/session architecture.",
                                                    "phase2":  "Implement shared principal resolution without changing Sesh public API.",
                                                    "phase3":  "Create explicit PrincipalId to SeshCreatorId mapping.",
                                                    "phase4":  "Implement Sesh project authorization service.",
                                                    "phase5":  "Only then expose authenticated Sesh project APIs.",
                                                    "compatibility":  "Existing private River OS boolean access may remain temporarily for operator-only tooling but cannot authorize creator-owned Sesh resources."
                                                },
                          "securityRules":  [
                                                "Authentication and authorization remain separate concerns.",
                                                "Every creator-owned request must resolve an authenticated PrincipalId.",
                                                "Every creator-owned request must resolve allowed SeshCreatorId values server-side.",
                                                "Client-supplied creator identity is never authoritative.",
                                                "Knowing a project id is never sufficient authorization.",
                                                "Same-origin is defense in depth only.",
                                                "Session regeneration must occur after successful authentication.",
                                                "No secret credential becomes a durable identity identifier.",
                                                "Authorization failures must not unnecessarily reveal existence of unauthorized resources."
