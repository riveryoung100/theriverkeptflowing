                                                  "futureAuthenticatedSession":  "Must carry or resolve a durable PrincipalId rather than only a boolean authorization flag.",
                                                  "sessionIdRule":  "Session identity is ephemeral and MUST NOT itself become PrincipalId.",
                                                  "regeneration":  "Successful login should continue regenerating session state to reduce fixation risk.",
                                                  "logout":  "Logout destroys the session but MUST NOT destroy PrincipalId or creator ownership."
