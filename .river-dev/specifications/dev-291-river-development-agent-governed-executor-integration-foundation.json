                            "controlled-executor-operation-execution-authorization-foundation",
                            "governed-executor-integration-foundation",
                            "package-executor",
                            "implementation-runner"
                        ],
    "applyRequirements":  [
                              "execution authorization exists",
                              "authorization is trusted",
                              "authorization is ready",
                              "authorization is explicitly authorized",
                              "authorization default policy is DENY",
                              "authorization remains decision-only",
                              "authorization contains no blocked reasons",
                              "prepared operation matches the authorized operation",
                              "required capability matches the requested operation",
                              "required capability is explicitly authorized",
                              "required capability exists in authorized capabilities",
                              "requested execution remains within approved execution scope"
                          ],
    "previewSemantics":  {
                             "mutating":  false,
                             "authorizationPresenceMayGrantMutation":  false,
                             "mayConvertToApply":  false
                         },
    "governedIntegrationBoundary":  {
                                        "failClosed":  true,
                                        "mayManufactureAuthorization":  false,
                                        "mayExpandAuthorization":  false,
