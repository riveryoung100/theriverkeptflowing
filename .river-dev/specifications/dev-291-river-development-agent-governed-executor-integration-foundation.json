                                        "mayCreateCapabilityAuthorization":  false,
                                        "mayExecuteOperation":  false,
                                        "mayModifyRepository":  false,
                                        "mayPush":  false,
                                        "mayDeploy":  false
                                    },
    "validationRequirements":  [
                                   "preview remains non-mutating",
                                   "apply without authorization is denied",
                                   "apply with untrusted authorization is denied",
                                   "apply with unready authorization is denied",
                                   "apply with unauthorized authorization is denied",
                                   "apply with blocked reasons is denied",
                                   "apply with mismatched prepared operation is denied",
                                   "apply with unauthorized required capability is denied",
                                   "apply with required capability absent from authorized capabilities is denied",
                                   "apply outside approved execution scope is denied",
                                   "valid apply authorization may cross the governed integration boundary",
                                   "authorization cannot create capability authorization",
                                   "authorization cannot expand scope",
                                   "authorization cannot execute the operation",
                                   "authorization cannot modify the repository",
