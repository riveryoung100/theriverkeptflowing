{
    "id":  "DEV-291",
    "title":  "River Development Agent Governed Executor Integration Foundation",
    "status":  "foundation",
    "objective":  "Establish a default-deny governed integration boundary between controlled operation execution authorization and package execution so that apply mode alone can never constitute execution authorization.",
    "predecessor":  {
                        "id":  "DEV-290",
                        "commit":  "5429336",
                        "foundation":  "controlled-execution-integrity-seal-foundation"
                    },
    "authorizationContract":  {
                                  "authoritativeType":  "RiverDevControlledExecutorOperationExecutionAuthorizationFoundation",
                                  "parallelAuthorizationModelAllowed":  false,
                                  "defaultPolicy":  "DENY",
                                  "authorizationDecisionOnly":  true
                              },
    "coreSecurityInvariants":  [
                                   "apply is an execution mode, not execution authorization",
                                   "execution mode alone must never authorize mutation",
                                   "missing authorization must deny apply execution",
                                   "untrusted authorization must deny apply execution",
                                   "unready authorization must deny apply execution",
                                   "unauthorized authorization must deny apply execution",
                                   "blocked authorization must deny apply execution",
                                   "operation authorization must remain bound to the prepared operation",
                                   "required capability must be explicitly authorized",
                                   "required capability must exist within the authorized capability set",
                                   "execution must remain within approved execution scope",
                                   "authorization must not create capability authorization",
                                   "authorization must not expand scope",
                                   "authorization must not execute operations",
                                   "authorization must not modify repository state",
                                   "preview execution must remain non-mutating"
                               ],
    "integrationPath":  [
