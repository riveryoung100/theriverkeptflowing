                      "function":  "readFoodCashPaymentEvidenceByExactIdentity",
                      "signature":  "readFoodCashPaymentEvidenceByExactIdentity(database, cashEvidenceId, cashEvidenceVersion)",
                      "valueType":  "FoodCashPaymentEvidenceVersion",
                      "outcomes":  [
                                       "found",
                                       "not-found",
                                       "invalid",
                                       "storage-failure"
                                   ]
                  },
    "inputContract":  {
                          "cashEvidenceId":  "Require exact canonical FoodCashPaymentEvidenceId accepted by parseFoodCashPaymentEvidenceId. No coercion, trimming, prefix repair, fallback, or normalization.",
                          "cashEvidenceVersion":  "Require number type, safe integer, exactly 1. No coercion, latest-version selection, fallback, default, or repair.",
                          "invalidInputOutcome":  "invalid",
                          "invalidInputMustNotQuery":  true,
                          "noCallerProvidedOrderSnapshot":  true
                      },
    "queryContract":  {
                          "selection":  "exact durable identity only",
                          "table":  "food_cash_payment_evidence",
                          "columns":  [
                                          "cash_evidence_id",
                                          "cash_evidence_version",
                                          "order_id",
                                          "order_version",
                                          "merchandise_subtotal_currency",
                                          "merchandise_subtotal_minor_units",
                                          "channel",
                                          "cash_receipt_reference",
                                          "confirmation_source_reference",
                                          "received_amount_currency",
                                          "received_amount_minor_units"
                                      ],
                          "where":  "cash_evidence_id = ? AND cash_evidence_version = ?",
                          "boundArguments":  [
                                                 "canonical cashEvidenceId",
                                                 "exact cashEvidenceVersion"
                                             ],
                          "rowLimit":  2,
                          "reasonForLimitTwo":  "Reject impossible or hostile duplicate exact-identity rows instead of silently selecting one.",
                          "allowedD1Method":  "prepare(sql).bind(id, version).all()",
                          "ordering":  "none",
                          "latestSelection":  false,
                          "currentSelection":  false,
                          "joins":  false,
                          "pagination":  false,
                          "mutations":  false
                      },
    "durableRowContract":  {
                               "expectedColumns":  [
                                                       "cash_evidence_id",
                                                       "cash_evidence_version",
                                                       "order_id",
                                                       "order_version",
                                                       "merchandise_subtotal_currency",
                                                       "merchandise_subtotal_minor_units",
                                                       "channel",
                                                       "cash_receipt_reference",
                                                       "confirmation_source_reference",
                                                       "received_amount_currency",
                                                       "received_amount_minor_units"
                                                   ],
                               "exactIdentityMustMatchSelector":  true,
                               "exactVersionMustMatchSelector":  true,
                               "rejectMissingColumns":  true,
                               "rejectExtraColumns":  true,
                               "rejectSymbolKeys":  true,
                               "rejectAccessors":  true,
                               "rejectHostilePrototypes":  true,
                               "rejectUnexpectedRowShapes":  true,
                               "rejectNoncanonicalDomainValues":  true,
                               "malformedPersistedRowOutcome":  "storage-failure"
                           },
    "reconstruction":  {
                           "domainType":  "FoodCashPaymentEvidenceVersion",
                           "canonicalIdParser":  "parseFoodCashPaymentEvidenceId",
                           "domainValidator":  "validateFoodCashPaymentEvidenceVersion",
                           "exactVersion":  1,
