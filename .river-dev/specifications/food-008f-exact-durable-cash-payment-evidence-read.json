                                                                  1,
                                                                  2
                                                              ],
                           "orderSnapshotFields":  [
                                                       "id",
                                                       "version",
                                                       "merchandiseSubtotal"
                                                   ],
                           "evidenceFields":  [
                                                  "channel",
                                                  "cashReceiptReference",
                                                  "confirmationSourceReference",
                                                  "receivedAmount"
                                              ],
                           "channel":  "cash",
                           "monetaryFields":  [
                                                  "merchandiseSubtotal.currency",
                                                  "merchandiseSubtotal.minorUnits",
                                                  "receivedAmount.currency",
                                                  "receivedAmount.minorUnits"
                                              ],
                           "currencyAndMoneyMustValidate":  true,
                           "receivedAmountMayDifferFromSubtotal":  true,
                           "deepFreezeReturnedValue":  true,
                           "forbidMutationOfDatabaseRow":  true,
                           "reauthenticatePhysicalOrderOnRead":  false,
                           "reauthenticationExplanation":  "This unit reads immutable historical evidence only; it does not establish current order state or confer authority from a fresh physical-order read."
                       },
    "responseContract":  {
                             "validEnvelopeRequiresOwnSuccessTrue":  true,
                             "validEnvelopeRequiresOwnResultsArray":  true,
                             "allowD1MetadataFields":  true,
                             "rejectAccessorProperties":  true,
                             "rejectHostileArrayShape":  true,
                             "zeroRows":  "not-found",
                             "oneValidRow":  "found",
                             "multipleRows":  "storage-failure",
                             "failedOrMalformedEnvelope":  "storage-failure",
                             "databasePrepareFailure":  "storage-failure",
                             "databaseBindFailure":  "storage-failure",
                             "databaseReadFailure":  "storage-failure",
                             "corruptStoredValue":  "storage-failure",
                             "returnedOutcomesFrozen":  true
                         },
    "safetyBoundaries":  [
                             "Read only; no INSERT, UPDATE, DELETE, REPLACE, transactions, or migration execution.",
                             "Do not select latest, current, maximum version, or all records.",
                             "Do not infer that cash was physically received from the existence of an evidence row.",
                             "Do not infer paid-in-full status from receivedAmount matching merchandiseSubtotal.",
                             "Do not require receivedAmount to equal merchandiseSubtotal.",
                             "Do not confer readiness, fulfillment, dispatch, refund, settlement, or accounting authority.",
                             "Do not compose electronic processor confirmations or processor authenticity.",
                             "Do not modify FOOD-008E domain, persistence implementation, or migration.",
                             "Do not silently normalize malformed durable data.",
                             "Do not expose a list, search, or aggregate cash evidence API."
                         ],
    "testRequirements":  [
                             "Exact canonical ID and version 1 returns found with validated immutable value.",
                             "No matching row returns not-found.",
                             "Malformed ID, noncanonical prefix, whitespace variants, and invalid versions return invalid without querying.",
                             "Query uses exactly eleven selected columns, exact two-field WHERE, and LIMIT 2.",
                             "Query binds exactly the supplied canonical ID and version.",
                             "Zero, one, two, and malformed result counts are handled distinctly.",
                             "Unexpected row columns, missing columns, accessors, symbols, prototypes, and corrupt field types return storage-failure.",
                             "Stored row identity/version mismatching selector returns storage-failure.",
                             "Invalid cash channel, money, currency, reference bounds, or order snapshot returns storage-failure.",
                             "Received cash amount different from merchandise subtotal remains valid when domain constraints pass.",
                             "Prepare, bind, read, and response-envelope failures return storage-failure.",
                             "No writes, no latest lookup, no current order lookup, and no settlement/readiness inference.",
                             "Found result, nested order snapshot, evidence, and money values cannot be mutated.",
                             "Existing FOOD-008E persistence behavior remains unchanged."
                         ],
