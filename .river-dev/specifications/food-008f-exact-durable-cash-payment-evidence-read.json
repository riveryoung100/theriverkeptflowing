    "purpose":  [
                    "Read one exact durable cash payment evidence version from the existing FOOD-008E storage model.",
                    "Require caller-supplied canonical cash evidence identity and exact supported version.",
                    "Return reconstructed validated cash evidence without selecting any latest or current version.",
                    "The record is evidence of a claimed cash receipt, not independent proof that funds were received, reconciled, or settled.",
                    "Do not compose payment completion, order readiness, fulfillment, delivery, accounting, refund, or settlement authority."
                ],
    "ownedArtifact":  {
                          "specification":  ".river-dev/specifications/food-008f-exact-durable-cash-payment-evidence-read.json",
