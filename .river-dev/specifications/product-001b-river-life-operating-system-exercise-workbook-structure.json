                                                                                    "Exercise 12 converts selected gates into explicit operating rules."
                                                                                ]
                                                          }
                                           }
                                       ]
                     },
                     {
                         "id":  "destination",
                         "name":  "The Destination",
                         "intendedClarity":  "deliberate-direction clarity",
