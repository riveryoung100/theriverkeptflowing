                         "intendedClarity":  "desired-life clarity",
                         "workingPages":  5,
                         "exercises":  [
                                           {
                                               "order":  3,
                                               "id":  "what-is-worth-wanting",
                                               "title":  "What Is Worth Wanting?",
                                               "purpose":  "Examine desire and distinguish personally meaningful aims from inherited, performative, comparative, or insufficient desires.",
                                               "mechanics":  [
                                                                 "List major things currently wanted.",
                                                                 "Identify where each desire came from.",
                                                                 "Test what receiving each desire would require and what it would become in the reader\u0027s hands.",
                                                                 "Separate wants worth pursuing from wants that should be loosened or released.",
                                                                 "Define what enough means in the areas where endless accumulation is possible."
                                                             ],
                                               "output":  {
                                                              "name":  "Worth-Wanting Statement",
                                                              "type":  "priority-statement",
                                                              "requiredDecisions":  [
                                                                                        "What is genuinely worth wanting?",
                                                                                        "What is no longer worth organizing life around?",
                                                                                        "What does enough mean?"
                                                                                    ],
                                                              "downstreamUse":  [
                                                                                    "Exercise 4 tests whether these desires produce the person the reader wants to become.",
                                                                                    "Exercises 7 through 11 compare actual allocation, repetition, boundaries, and costs against these declared desires.",
                                                                                    "Exercise 12 carries the selected desires into final priorities."
                                                                                ]
                                                          }
                                           },
                                           {
                                               "order":  4,
                                               "id":  "who-is-this-life-making-me",
                                               "title":  "Who Is This Life Making Me?",
                                               "purpose":  "Evaluate the character and identity being formed by current pursuits rather than judging life only by achievement or appearance.",
                                               "mechanics":  [
                                                                 "Name the major paths currently being pursued.",
                                                                 "For each path, identify the traits it repeatedly trains.",
                                                                 "Distinguish achievement from identity.",
                                                                 "Identify traits worth strengthening and traits that signal a path needs adjustment."
                                                             ],
                                               "output":  {
                                                              "name":  "Becoming Profile",
