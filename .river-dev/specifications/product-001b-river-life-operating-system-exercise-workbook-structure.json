                                           {
                                               "order":  1,
                                               "id":  "the-life-that-shaped-me",
                                               "title":  "The Life That Shaped Me",
                                               "purpose":  "Identify formative experiences, environments, roles, expectations, adaptations, successes, failures, and identities that helped shape the reader\u0027s present life.",
                                               "mechanics":  [
                                                                 "Map formative seasons and experiences.",
                                                                 "Name what each season taught or trained.",
                                                                 "Identify roles or identities adopted in response.",
                                                                 "Separate useful formation from inherited assumptions."
                                                             ],
                                               "output":  {
                                                              "name":  "Formative Life Map",
                                                              "type":  "map",
                                                              "requiredDecisions":  [
                                                                                        "What shaped me?",
                                                                                        "What did it teach me?",
                                                                                        "What identity or adaptation did I carry from it?"
                                                                                    ],
                                                              "downstreamUse":  [
                                                                                    "Exercise 2 uses this map to decide what should be carried, repaired, released, or reconsidered.",
                                                                                    "Exercise 4 uses identity observations when evaluating who the current life is making the reader."
                                                                                ]
                                                          }
                                           },
                                           {
                                               "order":  2,
                                               "id":  "what-comes-with-me",
                                               "title":  "What Comes With Me?",
                                               "purpose":  "Decide which inherited lessons, responsibilities, values, ambitions, adaptations, identities, and patterns should continue into the life being built.",
                                               "mechanics":  [
                                                                 "Review the Formative Life Map.",
                                                                 "Sort significant inherited patterns into carry, repair, release, or reconsider.",
                                                                 "Name why each important item belongs in its category.",
                                                                 "Identify one inherited identity that no longer gets to govern future decisions."
                                                             ],
                                               "output":  {
                                                              "name":  "Carry / Repair / Release Ledger",
                                                              "type":  "decision-ledger",
                                                              "requiredDecisions":  [
                                                                                        "Carry",
                                                                                        "Repair",
                                                                                        "Release",
                                                                                        "Reconsider"
                                                                                    ],
                                                              "downstreamUse":  [
                                                                                    "Exercises 3 and 4 begin from what the reader intentionally chooses to carry forward.",
                                                                                    "Exercise 12 uses release and repair decisions when forming the Personal Operating Plan."
                                                                                ]
                                                          }
                                           }
                                       ]
                     },
                     {
