                                                                                    "Exercise 8 checks how these allocations appear inside an ordinary day.",
                                                                                    "Exercise 10 identifies gates required to protect corrected allocations.",
                                                                                    "Exercise 12 converts selected reallocations into operating priorities."
                                                                                ]
                                                          }
                                           }
                                       ]
                     },
                     {
                         "id":  "current",
                         "name":  "The Current",
                         "intendedClarity":  "lived-reality clarity",
