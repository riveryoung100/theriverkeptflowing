                                                                                        "Which current pursuits support or contradict that direction?"
                                                                                    ],
                                                              "downstreamUse":  [
                                                                                    "Exercise 5 uses the Becoming Profile as part of whole-life evaluation.",
                                                                                    "Exercises 9 and 11 test whether repeated behavior and accepted costs support the desired person.",
                                                                                    "Exercise 12 incorporates chosen character direction."
                                                                                ]
                                                          }
                                           }
                                       ]
                     },
                     {
                         "id":  "tributaries",
                         "name":  "Tributaries",
                         "intendedClarity":  "stewardship clarity",
                         "workingPages":  7,
