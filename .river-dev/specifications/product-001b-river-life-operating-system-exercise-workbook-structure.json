                                                              "downstreamUse":  [
                                                                                    "Exercise 7 uses genuine responsibilities when evaluating allocation.",
                                                                                    "Exercise 10 uses them to determine what needs protection.",
                                                                                    "Exercise 12 converts accepted responsibilities into operating commitments."
                                                                                ]
                                                          }
                                           },
                                           {
