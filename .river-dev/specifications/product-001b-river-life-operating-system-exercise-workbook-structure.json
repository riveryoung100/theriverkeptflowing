                                               "purpose":  "Map actual ordinary life and test whether it is inhabitable, sustainable, and aligned with stated priorities.",
                                               "mechanics":  [
                                                                 "Map a recent ordinary weekday from waking through sleep.",
                                                                 "Record work, transitions, attention, meals, family presence, rest, consumption, maintenance, and unassigned time.",
                                                                 "Identify where the day supports or contradicts declared priorities.",
                                                                 "Describe an ordinary day that could realistically be repeated without abandoning important responsibilities."
                                                             ],
                                               "output":  {
                                                              "name":  "Actual-Day Map",
                                                              "type":  "time-and-life-map",
                                                              "requiredDecisions":  [
                                                                                        "What does my ordinary day actually contain?",
                                                                                        "What is unsustainable or misaligned?",
                                                                                        "What should an inhabitable ordinary day protect?"
                                                                                    ],
                                                              "downstreamUse":  [
                                                                                    "Exercise 9 projects repeated daily patterns into future direction.",
                                                                                    "Exercise 10 identifies structural gates needed to protect a better ordinary day.",
                                                                                    "Exercise 12 incorporates selected ordinary-day changes."
                                                                                ]
                                                          }
                                           },
                                           {
                                               "order":  9,
                                               "id":  "the-repetition-audit",
                                               "title":  "The Repetition Audit",
                                               "purpose":  "Identify repeated behaviors and choices currently compounding into future direction.",
                                               "mechanics":  [
                                                                 "Identify significant repeated behaviors across work, spending, relationships, body, attention, consumption, and use of discretionary time.",
                                                                 "Project important repetitions forward five to ten years.",
                                                                 "Identify repetitions that build the desired life and repetitions that quietly undermine it.",
                                                                 "Choose what should continue, change, begin, or stop."
