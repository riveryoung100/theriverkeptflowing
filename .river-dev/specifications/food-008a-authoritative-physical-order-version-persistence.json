    "outcomeSemantics":  {
                             "created":  "The exact validated version did not already exist, all durable lifecycle prerequisites held, one canonical row was inserted, and the returned row reconstructed to the exact requested FOOD-005E value.",
                             "already-present":  "The same order ID/version already exists and reconstructs to exactly the same canonical FOOD-005E value. No write occurs.",
                             "conflict":  "The caller supplied a structurally valid FOOD-005E value that conflicts with durable identity, version sequencing, lifecycle state, predecessor state, terminal cancellation rules or exact immutable snapshot history.",
                             "invalid":  "The supplied input fails canonical FOOD-005E structural validation or cannot be canonically serialized.",
                             "storage-failure":  "A D1 operation fails, a stored row is malformed, storage state violates invariants, or an uncertain insert cannot be resolved by authoritative reread."
                         },
    "appendAlgorithm":  [
                            "Validate and detach the complete input using validateFoodPhysicalOrderVersion.",
                            "Build canonical snapshot_format_version=1 and deterministic snapshot_json from quote, fulfillmentIntent, reservationRequest, lines and merchandiseSubtotal.",
                            "Read the exact durable order_id/order_version first.",
                            "If exact exists and reconstructs identically, return already-present.",
                            "If exact exists and differs, return conflict.",
                            "If version=1, require state=requested and require no durable version already exists for the order ID.",
                            "If version=2, require state=cancelled, require exact durable predecessor version 1 in requested state, and require canonical snapshot equality with that predecessor.",
                            "Reject all versions greater than 2 as conflict under the current FOOD-005E lifecycle.",
                            "Attempt one INSERT RETURNING.",
                            "Require one returned row that reconstructs exactly before returning created.",
                            "If insert throws or result is uncertain, reread the exact identity once.",
                            "Exact canonical raced row =\u003e already-present.",
                            "Divergent exact raced row =\u003e conflict.",
                            "No classifiable exact durable row =\u003e storage-failure.",
                            "Never blindly retry a write."
