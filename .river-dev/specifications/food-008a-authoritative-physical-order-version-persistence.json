                                         "order_version",
                                         "state",
                                         "snapshot_format_version",
                                         "snapshot_json"
                                     ],
                         "snapshotFormatVersion":  1,
                         "canonicalSnapshotOwnKeyOrder":  [
                                                              "quote",
                                                              "fulfillmentIntent",
                                                              "reservationRequest",
                                                              "lines",
                                                              "merchandiseSubtotal"
                                                          ],
                         "excludedFromSnapshotBecauseStoredAsColumns":  [
                                                                            "id",
                                                                            "version",
                                                                            "state"
                                                                        ],
                         "canonicalization":  "Validate the complete input with validateFoodPhysicalOrderVersion first, then create a fresh detached snapshot object in the exact locked key order and JSON.stringify that object. Stored JSON text is therefore deterministic canonical adapter output.",
                         "reconstruction":  "Read order_id/order_version/state plus snapshot_json, parse the exact snapshot object, combine them into one complete FoodPhysicalOrderVersion and pass the reconstructed value through validateFoodPhysicalOrderVersion.",
                         "noArbitraryJsonAuthority":  "A syntactically valid JSON payload is not sufficient authority. Stored content must reconstruct into a canonical FOOD-005E value."
                     },
    "lifecycle":  {
                      "supportedStates":  [
                                              "requested",
                                              "cancelled"
                                          ],
                      "initial":  {
                                      "orderVersion":  1,
                                      "state":  "requested",
                                      "predecessor":  null,
                                      "rule":  "Version 1 requested must be the first durable version for the order ID."
                                  },
                      "cancellation":  {
                                           "orderVersion":  2,
                                           "state":  "cancelled",
                                           "predecessorVersion":  1,
                                           "predecessorState":  "requested",
                                           "snapshotEquality":  "snapshot_format_version and snapshot_json must exactly equal the durable requested predecessor.",
                                           "terminal":  true
                                       },
                      "unsupported":  [
                                          "version greater than 2",
                                          "cancelled version 1",
                                          "requested version 2",
                                          "requested revision after cancellation",
                                          "revision after cancelled",
                                          "version gaps",
                                          "order identity drift",
                                          "snapshot drift during cancellation"
                                      ],
                      "noLifecycleExpansion":  [
