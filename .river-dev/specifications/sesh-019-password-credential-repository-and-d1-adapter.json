{
    "id":  "SESH-019",
    "title":  "Password Credential Repository and D1 Adapter",
    "status":  "IMPLEMENTED_LOCALLY_PENDING_REVIEW",
    "objective":  "Define provider-neutral password credential persistence contracts and a Cloudflare D1 adapter for the existing principal_password_credentials table without creating real users, mutating production identity data, exposing authentication endpoints, creating sessions, or granting Sesh authorization.",
    "sourceBaseline":  {
                           "branch":  "cif-001-canonical-content-source-record",
                           "commit":  "506a7ea8df172a9f4824b460cedc4a4d111017b3",
                           "predecessor":  "SESH-018",
                           "database":  "river-identity",
                           "productionBinding":  "RIVER_IDENTITY_DB",
                           "table":  "principal_password_credentials"
                       },
    "providerNeutralRepository":  {
                                      "interface":  "PasswordCredentialRepository",
                                      "root":  "src/lib/identity/credentials/repository.ts",
                                      "methods":  [
                                                      "saveCredential",
                                                      "getCredentialByPrincipalId",
                                                      "getCredentialByNormalizedEmail",
                                                      "credentialExistsForPrincipal"
                                                  ],
                                      "resultModel":  "Explicit ok/result union",
                                      "errorKinds":  [
                                                         "not-found",
                                                         "validation",
                                                         "conflict",
                                                         "storage"
                                                     ],
                                      "separationRule":  "Credential repository remains separate from PrincipalRepository."
                                  },
    "d1Adapter":  {
                      "class":  "D1PasswordCredentialRepository",
                      "path":  "src/lib/identity/cloudflare/d1-password-credential-repository.ts",
                      "table":  "principal_password_credentials",
                      "bindingOwnership":  "Adapter receives an injected IdentityD1DatabaseLike and does not read global Cloudflare bindings.",
                      "fakeableBoundary":  "Uses the existing narrow IdentityD1DatabaseLike contract.",
                      "operations":  [
                                         "Lookup by PrincipalId",
                                         "Lookup by normalized email",
                                         "Credential existence by PrincipalId",
                                         "Insert first credential",
                                         "Update email/password hash while preserving PrincipalId and createdAt"
                                     ]
                  },
    "invariants":  [
                       "PasswordCredential validation runs before persistence.",
                       "Persisted rows are validated after reads.",
                       "createdAt cannot drift under an existing PrincipalId.",
                       "Normalized email cannot belong to two PrincipalId values.",
                       "Email lookup input must already be canonical.",
                       "PrincipalId remains the durable identity.",
                       "Password hashes never enter PrincipalRepository.",
                       "D1 uniqueness conflicts map to provider-neutral conflict behavior.",
                       "D1 provider failures map to provider-neutral storage behavior."
                   ],
    "schema":  {
                   "migration":  "migrations/identity/0001_river_identity.sql",
                   "existingTable":  "principal_password_credentials",
                   "schemaChangeRequired":  false,
                   "newMigration":  false
               },
    "authenticationBoundary":  {
                                   "passwordHasher":  "Implemented in SESH-018",
                                   "credentialPersistence":  "Implemented locally in SESH-019",
                                   "authenticationService":  "DEFERRED",
                                   "registration":  "DEFERRED",
                                   "login":  "DEFERRED",
                                   "passwordReset":  "DEFERRED",
                                   "authenticatedPrincipalSession":  "DEFERRED"
                               },
    "authorizationBoundary":  {
                                  "principalToSeshCreatorMapping":  "DEFERRED",
                                  "creatorOwnedSeshApi":  "FORBIDDEN",
                                  "rule":  "Credential persistence does not grant Sesh creator ownership, collaborator access, publishing rights, management rights, or any other product authorization."
                              },
    "tests":  [
                  "Store and reload canonical credential",
                  "Lookup by normalized email",
                  "Reject non-normalized lookup",
                  "Update mutable credential fields",
                  "Preserve createdAt",
                  "Reject createdAt drift",
