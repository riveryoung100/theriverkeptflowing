{
    "id":  "SESH-018",
    "title":  "Provider-Neutral Password Credential Domain and Argon2id Hasher Contract",
    "status":  "IMPLEMENTED_LOCALLY_PENDING_REVIEW",
    "objective":  "Define the canonical River Identity password-credential domain, deterministic login-email normalization, password-hasher contract, PHC-compatible Argon2id encoded-hash representation, and initial password-hashing work-factor envelope without creating users, persistence mutations, public authentication endpoints, authenticated sessions, or Sesh authorization mappings.",
    "sourceBaseline":  {
                           "branch":  "cif-001-canonical-content-source-record",
                           "commit":  "7fa310f2adbb8d6523d968bce9824a6c5daf9237",
                           "predecessor":  "SESH-017",
                           "argon2Capability":  "PROVEN",
                           "package":  "@noble/hashes",
                           "packageVersion":  "2.2.0"
                       },
    "credentialDomain":  {
                             "root":  "src/lib/identity/credentials",
                             "model":  "PasswordCredential",
                             "fields":  [
                                            "principalId",
                                            "emailNormalized",
                                            "passwordHash",
                                            "createdAt",
                                            "updatedAt"
                                        ],
                             "identityRule":  "PasswordCredential references PrincipalId but does not redefine canonical identity.",
                             "principalApiRule":  "PrincipalRepository remains credential-free and must never return password hashes."
                         },
    "emailNormalization":  {
                               "function":  "normalizeCredentialEmail",
                               "phaseOnePolicy":  [
                                                      "Trim leading and trailing whitespace.",
                                                      "Lowercase the complete login identifier.",
                                                      "Reject embedded whitespace.",
                                                      "Require exactly one non-terminal @ separator.",
                                                      "Reject normalized values longer than 320 characters."
                                                  ],
                               "identityRule":  "Normalized email is a mutable login identifier and MUST NOT become PrincipalId.",
                               "note":  "This is application login normalization, not a claim that RFC mailbox local-parts are universally case-insensitive."
                           },
    "passwordHasherContract":  {
                                   "interface":  "PasswordHasher",
                                   "methods":  [
                                                   "hashPassword(password)",
                                                   "verifyPassword(password, encodedHash)"
                                               ],
                                   "verificationResult":  [
                                                              "verified",
                                                              "needsRehash"
                                                          ],
                                   "plaintextRule":  "Plaintext password is transient process input only and MUST NOT be persisted or logged.",
                                   "clientRule":  "Password hashing and verification remain server-side."
                               },
    "argon2id":  {
                     "algorithm":  "Argon2id",
                     "version":  19,
                     "implementation":  "@noble/hashes/argon2.js",
                     "initialParameters":  {
                                               "memoryKiB":  19456,
                                               "memoryMiB":  19,
                                               "iterations":  2,
                                               "parallelism":  1,
                                               "saltBytes":  16,
                                               "hashBytes":  32
                                           },
                     "parameterBasis":  "OWASP Password Storage Cheat Sheet minimum Argon2id configuration checked 2026-09-21: m=19 MiB, t=2, p=1.",
                     "capabilityBasis":  "SESH-017 proved RFC 9106 correctness, Worker dry-run bundling, absence of node:crypto Argon2, full identity regression, full Sesh regression, and Astro/Cloudflare build compatibility.",
                     "futureTuning":  "Work factors are versioned in stored hashes and may be strengthened later. Successful verification reports needsRehash when a valid stored envelope differs from the current canonical envelope."
                 },
    "encodedHash":  {
                        "family":  "PHC-compatible Argon2id string",
                        "canonicalShape":  "$argon2id$v=19$m=19456,t=2,p=1$\u003cbase64-salt\u003e$\u003cbase64-hash\u003e",
                        "padding":  "Base64 components are stored without trailing = padding.",
                        "storedMetadata":  [
                                               "algorithm",
                                               "version",
                                               "memory",
                                               "iterations",
                                               "parallelism",
                                               "salt",
                                               "derived hash"
                                           ],
                        "parsing":  "Strict fail-closed parsing.",
                        "verificationSafetyEnvelope":  {
                                                           "maximumMemoryKiB":  131072,
                                                           "maximumIterations":  10,
                                                           "maximumParallelism":  4,
                                                           "purpose":  "Prevent corrupted or adversarial stored parameters from forcing unbounded verification work."
                                                       }
                    },
    "security":  {
                     "comparison":  "Derived hash comparison uses a full-length XOR accumulation rather than early byte exit.",
                     "randomSalt":  "Each new password hash uses globalThis.crypto.getRandomValues with a 16-byte salt.",
                     "malformedHash":  "Verification fails closed.",
                     "unsupportedVersion":  "Verification fails closed.",
                     "unsafeStoredParameters":  "Verification fails closed.",
                     "emptyPassword":  "Rejected by the hashing boundary.",
                     "maximumPasswordUtf8Bytes":  1024,
                     "sha256Alone":  "FORBIDDEN",
                     "plaintextPersistence":  "FORBIDDEN",
                     "reversiblePasswordStorage":  "FORBIDDEN",
                     "silentAlgorithmFallback":  "FORBIDDEN"
                 },
    "persistence":  {
                        "productionTable":  "principal_password_credentials",
                        "repositoryImplementation":  "DEFERRED_TO_NEXT_SLICE",
                        "databaseMutation":  "NONE",
                        "migration":  "NONE",
                        "schemaChange":  "NONE"
                    },
    "authentication":  {
                           "registrationEndpoint":  "DEFERRED",
                           "loginEndpoint":  "DEFERRED",
                           "passwordReset":  "DEFERRED",
                           "emailVerification":  "DEFERRED",
                           "authenticatedPrincipalSession":  "DEFERRED",
                           "currentRiverOsSharedKey":  "UNCHANGED_AND_NOT_A_PRINCIPAL_IDENTITY"
                       },
    "seshAuthorization":  {
                              "principalToCreatorMapping":  "DEFERRED",
                              "creatorOwnedApi":  "FORBIDDEN_UNTIL_MAPPING_AND_OWNERSHIP_AUTHORIZATION_EXIST",
                              "rule":  "Password authentication alone never grants SeshCreatorId ownership or collaborator authority."
                          },
    "implementationFiles":  [
                                "src/lib/identity/credentials/model.ts",
                                "src/lib/identity/credentials/contracts.ts",
                                "src/lib/identity/credentials/validation.ts",
                                "src/lib/identity/credentials/argon2id.ts",
                                "src/lib/identity/credentials/index.ts",
                                "src/lib/identity/credentials/password-credentials.test.ts",
                                "src/lib/identity/index.ts"
                            ],
    "tests":  [
                  "Canonical email normalization",
                  "Malformed email rejection",
                  "Canonical PasswordCredential validation",
                  "Non-canonical credential rejection",
                  "Locked Argon2id parameters",
                  "PHC-compatible hash generation",
                  "Independent random salts",
                  "Correct-password verification",
                  "Incorrect-password rejection",
                  "Malformed-hash fail-closed behavior",
                  "Verification work-factor safety envelope"
              ],
    "nextSlice":  {
                      "id":  "SESH-019",
                      "title":  "Password Credential Repository and D1 Adapter",
                      "scope":  [
                                    "Define provider-neutral PasswordCredentialRepository.",
                                    "Implement D1PasswordCredentialRepository against principal_password_credentials.",
                                    "Lookup by normalized email.",
                                    "Lookup by PrincipalId.",
                                    "Enforce credential validation at persistence boundaries.",
                                    "Map D1 uniqueness/storage failures into provider-neutral behavior.",
                                    "Keep password hashes out of PrincipalRepository.",
                                    "Use fakeable D1 contracts.",
                                    "Do not create real users.",
                                    "Do not mutate production D1.",
                                    "Do not create registration or login endpoints.",
                                    "Do not create authenticated sessions.",
                                    "Do not create PrincipalId to SeshCreatorId mappings.",
                                    "Do not deploy."
                                ]
                  },
    "nonGoals":  [
                     "Creating a user",
                     "Writing credentials to production D1",
                     "Changing the identity migration",
                     "Registration routes",
                     "Login routes",
                     "Password reset",
                     "Email verification",
                     "Authenticated sessions",
                     "River OS auth replacement",
                     "PrincipalId to SeshCreatorId mapping",
                     "Public creator-owned Sesh APIs",
                     "Migration execution",
                     "Deployment"
                 ]
}
