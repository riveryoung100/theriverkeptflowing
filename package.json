{
  "name": "the-river-kept-flowing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && npm run search:index",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "wrangler deploy",
    "publish": "npm run build && npm run deploy",
    "verify:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-production.ps1",
    "release": "npm run lint && npm run typecheck && npm run publish && npm run verify:production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run typecheck && npm run build",
    "typecheck": "astro check",
    "search:index": "pagefind --site dist",
    "preview:search": "pagefind --site dist --serve",
    "test:assimilation": "tsx --test \"src/lib/assimilation/**/*.test.ts\""
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.65.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.9.0",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.118.0"
  }
}
