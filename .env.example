# Stripe-hosted Payment Links
# These URLs are safe to expose publicly.
# Replace the placeholders in your local .env and Cloudflare build variables.

PUBLIC_STRIPE_RIVER_SUPPORT_URL=""
PUBLIC_STRIPE_COMMUNITY_TABLE_URL=""
PUBLIC_STRIPE_MONTHLY_SUPPORT_URL=""
# PRODUCT-001E Stripe webhook verification
# Server-only secret. Never prefix this value with PUBLIC_.
STRIPE_WEBHOOK_SECRET=""
# PRODUCT-001E Stripe Checkout session creation
# Server-only values. Never prefix these values with PUBLIC_.
# Checkout fails closed unless mode is explicitly "test" or "live".
# The secret-key prefix must match the selected mode: sk_test_ or sk_live_.
STRIPE_CHECKOUT_MODE="test"
STRIPE_SECRET_KEY=""

# PRODUCT-001E transactional product delivery
# Server-only. Never prefix these values with PUBLIC_.
RESEND_API_KEY=""
RIVER_DELIVERY_FROM=""
