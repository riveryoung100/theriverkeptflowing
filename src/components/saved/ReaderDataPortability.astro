<section
    class="reader-data-portability"
    data-reader-data-portability
    aria-labelledby="reader-data-portability-title"
>

    <div class="reader-data-portability__header">

        <div>

            <p class="reader-data-portability__eyebrow">
                Reader data
            </p>

            <h2 id="reader-data-portability-title">
                Back up or restore your reading data
            </h2>

            <p>
                Export your saved readings and reading progress as a JSON
                backup file. Imports are processed only in this browser.
            </p>

        </div>

    </div>


    <div
        class="reader-data-portability__controls"
        role="group"
        aria-label="Reader data backup controls"
    >

        <button
            class="reader-data-portability__button"
            type="button"
            data-reader-data-export
        >
            Export reader data
        </button>


        <label
            class="reader-data-portability__button reader-data-portability__button--secondary"
            for="reader-data-import-file"
        >
            Choose backup file
        </label>


        <input
            id="reader-data-import-file"
            class="visually-hidden"
            type="file"
            accept="application/json,.json"
            data-reader-data-import-file
        />

    </div>


    <section
        class="reader-data-portability__preview"
        data-reader-data-preview
        hidden
        aria-labelledby="reader-data-preview-title"
    >

        <h3 id="reader-data-preview-title">
            Import preview
        </h3>


        <dl class="reader-data-portability__preview-grid">

            <div>

                <dt>
                    Bookmarks
                </dt>

                <dd data-reader-data-preview-bookmarks>
                    0
                </dd>

            </div>


            <div>

                <dt>
                    Reading records
                </dt>

                <dd data-reader-data-preview-memory>
                    0
                </dd>

            </div>


            <div>

                <dt>
                    Newer records
                </dt>

                <dd data-reader-data-preview-newer>
                    0
                </dd>

            </div>


            <div>

                <dt>
                    Skipped records
                </dt>

                <dd data-reader-data-preview-skipped>
                    0
                </dd>

            </div>

        </dl>


        <div class="reader-data-portability__preview-actions">

            <button
                class="reader-data-portability__button"
                type="button"
                data-reader-data-import-confirm
            >
                Import backup
            </button>


            <button
                class="reader-data-portability__button reader-data-portability__button--secondary"
                type="button"
                data-reader-data-import-cancel
            >
                Cancel
            </button>

        </div>

    </section>


    <p
        class="reader-data-portability__status"
        data-reader-data-status
        aria-live="polite"
        aria-atomic="true"
    >
    </p>

</section>


<script>
    import {
    type ReaderDataBackup,     buildReaderDataBackup,     previewReaderDataImport,     importReaderDataBackup,
    parseReaderDataBackup,
} from "../../lib/readerPersistence";







    interface ImportPreview {
        backup:
            ReaderDataBackup;
        bookmarks:
            number;
        memory:
            number;
        newer:
            number;
        skipped:
            number;
    }


    interface PortabilityState {
        root:
            HTMLElement;
        exportButton:
            HTMLButtonElement;
        importInput:
            HTMLInputElement;
        preview:
            HTMLElement;
        previewBookmarks:
            HTMLElement;
        previewMemory:
            HTMLElement;
        previewNewer:
            HTMLElement;
        previewSkipped:
            HTMLElement;
        confirmButton:
            HTMLButtonElement;
        cancelButton:
            HTMLButtonElement;
        status:
            HTMLElement;
        pendingPreview:
            ImportPreview | null;
        statusTimer:
            number | null;
    }
function announce(
        state: PortabilityState,
        message: string
    ): void {

        state.status.textContent =
            message;


        if (
            state.statusTimer !==
            null
        ) {

            window.clearTimeout(
                state.statusTimer
            );

        }


        state.statusTimer =
            window.setTimeout(
                () => {

                    state.status.textContent =
                        "";

                    state.statusTimer =
                        null;

                },
                3600
            );

    }


    function collectReaderData(): ReaderDataBackup {
        return buildReaderDataBackup(window.location.origin);
    }

    function downloadBackup(
        backup: ReaderDataBackup
    ): void {

        const serialized =
            JSON.stringify(
                backup,
                null,
                2
            );

        const blob =
            new Blob(
                [
                    serialized
                ],
                {
                    type:
                        "application/json"
                }
            );

        const url =
            URL.createObjectURL(
                blob
            );

        const anchor =
            document.createElement(
                "a"
            );

        const date =
            new Date()
                .toISOString()
                .slice(
                    0,
                    10
                );


        anchor.href =
            url;

        anchor.download =
            `river-reader-data-${date}.json`;

        anchor.hidden =
            true;


        document.body.appendChild(
            anchor
        );

        anchor.click();

        anchor.remove();


        window.setTimeout(
            () => {

                URL.revokeObjectURL(
                    url
                );

            },
            0
        );

    }


    function showPreview(
        state: PortabilityState,
        preview: ImportPreview
    ): void {

        state.pendingPreview =
            preview;

        state.previewBookmarks.textContent =
            String(
                preview.bookmarks
            );

        state.previewMemory.textContent =
            String(
                preview.memory
            );

        state.previewNewer.textContent =
            String(
                preview.newer
            );

        state.previewSkipped.textContent =
            String(
                preview.skipped
            );

        state.preview.hidden =
            false;

        state.confirmButton.focus();

    }


    function createImportPreview(
        backup: ReaderDataBackup
    ): ImportPreview {
        const preview =
            previewReaderDataImport(
                backup
            );

        return {
            backup: preview.backup,
            bookmarks: preview.bookmarks,
            memory: preview.memory,
            newer: preview.newer,
            skipped: preview.skipped
        };
    }

    function clearPreview(
        state: PortabilityState
    ): void {

        state.pendingPreview =
            null;

        state.preview.hidden =
            true;

        state.importInput.value =
            "";

    }


    async function readImportFile(
        state: PortabilityState,
        file: File
    ): Promise<void> {

        if (
            file.size >
            5 * 1024 * 1024
        ) {

            announce(
                state,
                "That backup is larger than the 5 MB import limit."
            );

            state.importInput.value =
                "";

            return;

        }


        try {

            const text =
                await file.text();

            const parsed =
                JSON.parse(
                    text
                ) as unknown;

            const backup =
                parseReaderDataBackup(parsed);


            if (!backup) {

                announce(
                    state,
                    "That file is not a supported River reader-data backup."
                );

                state.importInput.value =
                    "";

                return;

            }


            const preview =
                createImportPreview(
                    backup
                );


            showPreview(
                state,
                preview
            );


            announce(
                state,
                "Backup validated. Review the import preview."
            );

        }
        catch {

            announce(
                state,
                "The selected file could not be read as JSON."
            );

            state.importInput.value =
                "";

        }

    }


    function initializePortability(
        element: Element
    ): void {

        if (
            !(
                element instanceof
                HTMLElement
            ) ||
            element.dataset.readerDataPortabilityReady ===
                "true"
        ) {

            return;

        }


        const exportButton =
            element.querySelector<HTMLButtonElement>(
                "[data-reader-data-export]"
            );

        const importInput =
            element.querySelector<HTMLInputElement>(
                "[data-reader-data-import-file]"
            );

        const preview =
            element.querySelector<HTMLElement>(
                "[data-reader-data-preview]"
            );

        const previewBookmarks =
            element.querySelector<HTMLElement>(
                "[data-reader-data-preview-bookmarks]"
            );

        const previewMemory =
            element.querySelector<HTMLElement>(
                "[data-reader-data-preview-memory]"
            );

        const previewNewer =
            element.querySelector<HTMLElement>(
                "[data-reader-data-preview-newer]"
            );

        const previewSkipped =
            element.querySelector<HTMLElement>(
                "[data-reader-data-preview-skipped]"
            );

        const confirmButton =
            element.querySelector<HTMLButtonElement>(
                "[data-reader-data-import-confirm]"
            );

        const cancelButton =
            element.querySelector<HTMLButtonElement>(
                "[data-reader-data-import-cancel]"
            );

        const status =
            element.querySelector<HTMLElement>(
                "[data-reader-data-status]"
            );


        if (
            !exportButton ||
            !importInput ||
            !preview ||
            !previewBookmarks ||
            !previewMemory ||
            !previewNewer ||
            !previewSkipped ||
            !confirmButton ||
            !cancelButton ||
            !status
        ) {

            return;

        }


        element.dataset.readerDataPortabilityReady =
            "true";


        const state:
            PortabilityState = {
            root:
                element,
            exportButton,
            importInput,
            preview,
            previewBookmarks,
            previewMemory,
            previewNewer,
            previewSkipped,
            confirmButton,
            cancelButton,
            status,
            pendingPreview:
                null,
            statusTimer:
                null
        };


        state.exportButton.addEventListener(
            "click",
            () => {

                const backup =
                    collectReaderData();


                downloadBackup(
                    backup
                );


                announce(
                    state,
                    `Exported ${backup.bookmarks.length} bookmarks and ${backup.readingMemory.length} reading records.`
                );

            }
        );


        state.importInput.addEventListener(
            "change",
            () => {

                const file =
                    state.importInput.files?.[0];


                if (!file) {

                    return;

                }


                void readImportFile(
                    state,
                    file
                );

            }
        );


        state.confirmButton.addEventListener(
            "click",
            () => {

                if (
                    !state.pendingPreview
                ) {

                    return;

                }


                importBackup(
                    state,
                    state.pendingPreview
                );

            }
        );


        state.cancelButton.addEventListener(
            "click",
            () => {

                clearPreview(
                    state
                );


                announce(
                    state,
                    "Import canceled."
                );

            }
        );

    }


    function initializeAllPortability(): void {

        document
            .querySelectorAll(
                "[data-reader-data-portability]"
            )
            .forEach(
                initializePortability
            );

    }


    initializeAllPortability();


    document.addEventListener(
        "astro:page-load",
        initializeAllPortability
    );

    function importBackup(
        state: PortabilityState,
        preview: ImportPreview
    ): void {

        const result =
            importReaderDataBackup(
                preview.backup
            );

        clearPreview(
            state
        );

        announce(
            state,
            result.failed > 0
                ? `Imported  records, skipped , and could not write .`
                : `Imported  newer records and skipped .`
        );

    }

</script>
