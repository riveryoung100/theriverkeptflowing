<div class="river-search">

    <button
        class="river-search__trigger"
        type="button"
        data-river-search-open
        aria-haspopup="dialog"
        aria-controls="river-search-dialog"
    >

        <svg
            class="river-search__icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
        >

            <circle
                cx="11"
                cy="11"
                r="7"
            ></circle>

            <path d="m16 16 4 4"></path>

        </svg>

        <span class="river-search__trigger-label">
            Search
        </span>

        <span
            class="river-search__shortcut"
            aria-hidden="true"
        >
            Ctrl K
        </span>

    </button>


    <dialog
        class="river-search__dialog"
        id="river-search-dialog"
        aria-labelledby="river-search-title"
    >

        <div class="river-search__panel">

            <header class="river-search__header">

                <div>

                    <p class="river-search__eyebrow">
                        Search the River
                    </p>

                    <h2 id="river-search-title">
                        Find what you need.
                    </h2>

                </div>


                <button
                    class="river-search__close"
                    type="button"
                    data-river-search-close
                    aria-label="Close search"
                >
                    ×
                </button>

            </header>


            <div class="river-search__input-wrap">

                <svg
                    class="river-search__input-icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >

                    <circle
                        cx="11"
                        cy="11"
                        r="7"
                    ></circle>

                    <path d="m16 16 4 4"></path>

                </svg>


                <label
                    class="visually-hidden"
                    for="river-search-input"
                >
                    Search The River Kept Flowing
                </label>


                <input
                    class="river-search__input"
                    id="river-search-input"
                    type="search"
                    inputmode="search"
                    autocomplete="off"
                    placeholder="Search guides, stories, recipes, and more..."
                    data-river-search-input
                >

            </div>


            <p
                class="river-search__status"
                data-river-search-status
                aria-live="polite"
            >
                Type at least two characters to begin.
            </p>


            <div
                class="river-search__results"
                data-river-search-results
            ></div>


            <footer class="river-search__footer">

                <span>
                    Press Esc to close
                </span>

                <span>
                    Powered by the River Library
                </span>

            </footer>

        </div>

    </dialog>

</div>


<script is:inline type="module">

    const dialog = document.querySelector(
        "#river-search-dialog"
    );

    const openButton = document.querySelector(
        "[data-river-search-open]"
    );

    const closeButton = document.querySelector(
        "[data-river-search-close]"
    );

    const input = document.querySelector(
        "[data-river-search-input]"
    );

    const status = document.querySelector(
        "[data-river-search-status]"
    );

    const resultsContainer = document.querySelector(
        "[data-river-search-results]"
    );

    let pagefindPromise = null;
    let searchTimer = null;
    let latestSearch = 0;


    function getPagefind() {

        if (!pagefindPromise) {

            pagefindPromise = import("/pagefind/pagefind.js")
                .then(async (pagefind) => {

                    await pagefind.init();

                    return pagefind;

                });

        }

        return pagefindPromise;

    }


    function clearResults() {

        resultsContainer.replaceChildren();

    }


    function createResult(result) {

        const article = document.createElement("article");
        article.className = "river-search-result";


        const link = document.createElement("a");
        link.className = "river-search-result__link";
        link.href = result.url;


        const title = document.createElement("h3");
        title.className = "river-search-result__title";
        title.textContent =
            result.meta?.title ||
            result.url;


        const route = document.createElement("p");
        route.className = "river-search-result__route";
        route.textContent = result.url;


        const excerpt = document.createElement("p");
        excerpt.className = "river-search-result__excerpt";
        excerpt.innerHTML =
            result.excerpt ||
            result.meta?.description ||
            "";


        link.append(
            title,
            route,
            excerpt
        );

        article.append(link);

        return article;

    }


    async function runSearch(query) {

        const searchNumber = ++latestSearch;

        clearResults();


        if (query.length < 2) {

            status.textContent =
                "Type at least two characters to begin.";

            return;

        }


        status.textContent = "Searching the River...";


        try {

            const pagefind = await getPagefind();

            const search = await pagefind.search(query);


            if (searchNumber !== latestSearch) {

                return;

            }


            const resultData = await Promise.all(
                search.results
                    .slice(0, 10)
                    .map((result) => result.data())
            );


            if (searchNumber !== latestSearch) {

                return;

            }


            if (resultData.length === 0) {

                status.textContent =
                    `No results found for “${query}”.`;

                return;

            }


            status.textContent =
                `${search.results.length} result${
                    search.results.length === 1
                        ? ""
                        : "s"
                } found. Showing the first ${
                    resultData.length
                }.`;

            const fragment =
                document.createDocumentFragment();


            resultData.forEach((result) => {

                fragment.append(
                    createResult(result)
                );

            });


            resultsContainer.append(fragment);

        }
        catch (error) {

            console.error(
                "River search failed:",
                error
            );

            status.textContent =
                "Search is unavailable in development mode. Build and preview the site to test it.";

        }

    }


    async function openSearch() {

        if (!dialog.open) {

            dialog.showModal();

        }


        try {

            await getPagefind();

        }
        catch (error) {

            console.error(
                "Unable to initialize Pagefind:",
                error
            );

        }


        window.requestAnimationFrame(() => {

            input.focus();
            input.select();

        });

    }


    function closeSearch() {

        if (dialog.open) {

            dialog.close();

        }

        openButton.focus();

    }


    openButton.addEventListener(
        "click",
        openSearch
    );


    closeButton.addEventListener(
        "click",
        closeSearch
    );


    input.addEventListener(
        "input",
        () => {

            window.clearTimeout(searchTimer);

            const query = input.value.trim();

            searchTimer = window.setTimeout(
                () => runSearch(query),
                150
            );

        }
    );


    dialog.addEventListener(
        "click",
        (event) => {

            if (event.target === dialog) {

                closeSearch();

            }

        }
    );


    dialog.addEventListener(
        "close",
        () => {

            latestSearch++;
            window.clearTimeout(searchTimer);

        }
    );


    document.addEventListener(
        "keydown",
        (event) => {

            const searchShortcut =
                (
                    event.ctrlKey ||
                    event.metaKey
                ) &&
                event.key.toLowerCase() === "k";


            if (searchShortcut) {

                event.preventDefault();

                openSearch();

            }

        }
    );

</script>