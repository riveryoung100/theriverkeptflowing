---
interface Props {
    title:string;
    description:string;
    action:string;
    href:string;
    type?:string;
    headingLevel?: 2 | 3;
}

const {
    title,
    description,
    action,
    href,
    type="Service",
    headingLevel = 3
}=Astro.props;

const Heading = headingLevel === 2 ? "h2" : "h3";
---

<article class="service-card">

    <p class="content-type">
        {type}
    </p>

    <Heading>
        {title}
    </Heading>

    <p>
        {description}
    </p>

    <a
        href={href}
        class="card-link"
    >
        {action} &rarr;
    </a>

</article>