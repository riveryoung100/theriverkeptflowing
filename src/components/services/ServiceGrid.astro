---
import ServiceCard from "./ServiceCard.astro";

interface Item {
    title:string;
    description:string;
    action:string;
    href:string;
    type?:string;
}

interface Props {
    items:Item[];
    headingLevel?: 2 | 3;
}

const {
    items,
    headingLevel = 3
}=Astro.props;
---

<div class="service-grid">

{
    items.map((item)=>(

        <ServiceCard
            title={item.title}
            description={item.description}
            action={item.action}
            href={item.href}
            type={item.type}
            headingLevel={headingLevel}
        />

    ))
}

</div>