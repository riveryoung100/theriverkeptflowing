---
import ContentCard from "../content/ContentCard.astro";

interface LibraryItem {
    title:string;
    description:string;
    href:string;
    label:string;
    action?:string;
    number?:string;
    published?:Date;
    readingMinutes?:number;
    tags?:string[];
    featured?:boolean;
}

interface Props {
    items:LibraryItem[];
    emptyTitle?:string;
    emptyDescription?:string;
    emptyHref?:string;
    emptyAction?:string;
}

const {
    items,
    emptyTitle = "The collection is being prepared.",
    emptyDescription =
        "Published entries will appear here automatically as the library grows.",
    emptyHref,
    emptyAction = "Learn more"
} = Astro.props;
---

{
    items.length > 0 ? (

        <div class="library-entry-grid">

            {
                items.map((item) => (

                    <ContentCard
                        type={item.label}
                        title={item.title}
                        description={item.description}
                        href={item.href}
                        published={item.published}
                        featured={item.featured}
                        number={item.number}
                        readingMinutes={item.readingMinutes}
                        tags={item.tags}
                        action={item.action}
                    />

                ))
            }

        </div>

    ) : (

        <article class="library-entry-empty">

            <p class="section-label">
                The archive is growing
            </p>

            <h3>
                {emptyTitle}
            </h3>

            <p>
                {emptyDescription}
            </p>

            {
                emptyHref && (
                    <a
                        href={emptyHref}
                        class="library-entry-card__link"
                    >
                        {emptyAction}
                        <span aria-hidden="true">
                            &rarr;
                        </span>
                    </a>
                )
            }

        </article>

    )
}