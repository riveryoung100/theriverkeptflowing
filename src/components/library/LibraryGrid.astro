---
interface LibraryItem {
    title: string;
    description: string;
    href: string;
    label: string;
    action?: string;
    number?: string;
    published?: Date;
    readingMinutes?: number;
    tags?: string[];
    featured?: boolean;
}

interface Props {
    items: LibraryItem[];
    emptyTitle?: string;
    emptyDescription?: string;
    emptyHref?: string;
    emptyAction?: string;
    cardClass?: string;
    gridClass?: string;
}

const {
    items,
    emptyTitle = "The collection is being prepared.",
    emptyDescription =
        "Published entries will appear here automatically as the library grows.",
    emptyHref,
    emptyAction = "Learn more",
    cardClass = "library-entry-card",
    gridClass = "library-entry-grid"
} = Astro.props;
---

{
    items.length > 0 ? (

        <div class={gridClass}>

            {
                items.map((item, index) => (

                    <article
                        class:list={[
                            cardClass,
                            item.featured && `${cardClass}--featured`
                        ]}
                    >

                        <div class="library-entry-card__meta">

                            {item.number && (
                                <span class="library-entry-card__number">
                                    {item.number}
                                </span>
                            )}

                            <span class="library-entry-card__label">
                                {item.label}
                            </span>

                        </div>


                        <h3>
                            {item.title}
                        </h3>


                        <p class="library-entry-card__description">
                            {item.description}
                        </p>


                        {
                            item.tags && item.tags.length > 0 && (

                                <div class="library-entry-card__tags">

                                    {
                                        item.tags.slice(0, 4).map((tag) => (
                                            <span>{tag}</span>
                                        ))
                                    }

                                </div>

                            )
                        }


                        <div class="library-entry-card__footer">

                            <div class="library-entry-card__details">

                                {item.published && (
                                    <span>
                                        {item.published.toLocaleDateString(
                                            "en-US",
                                            {
                                                year: "numeric",
                                                month: "short",
                                                day: "numeric"
                                            }
                                        )}
                                    </span>
                                )}

                                {item.readingMinutes && (
                                    <span>
                                        {item.readingMinutes} min read
                                    </span>
                                )}

                            </div>

                            <a
                                href={item.href}
                                class="library-entry-card__link"
                            >
                                {item.action ?? "Read more"}
                                <span aria-hidden="true">&rarr;</span>
                            </a>

                        </div>

                    </article>

                ))
            }

        </div>

    ) : (

        <article class="library-entry-empty">

            <p class="section-label">
                The archive is growing
            </p>

            <h3>
                {emptyTitle}
            </h3>

            <p>
                {emptyDescription}
            </p>

            {emptyHref && (
                <a
                    href={emptyHref}
                    class="library-entry-card__link"
                >
                    {emptyAction}
                    <span aria-hidden="true">&rarr;</span>
                </a>
            )}

        </article>

    )
}