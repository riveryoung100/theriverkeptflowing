<section class="crm-create-panel" aria-labelledby="crm-create-heading">
    <div class="crm-create-copy">
        <p class="crm-create-eyebrow">
            Private entry
        </p>

        <h2 id="crm-create-heading">
            Add relationship
        </h2>

        <p>
            Create a governed CRM relationship manually. Nothing is messaged,
            scheduled, or contacted automatically.
        </p>
    </div>

    <form
        class="crm-create-form"
        method="post"
        action="/river-os/actions/crm-create"
    >
        <label>
            <span>Name</span>
            <input
                name="displayName"
                type="text"
                autocomplete="name"
                required
            />
        </label>

        <div class="crm-form-grid">
            <label>
                <span>Relationship</span>
                <select name="kind" required>
                    <option value="lead">Lead</option>
                    <option value="client">Client</option>
                    <option value="recruit">Recruit</option>
                    <option value="partner">Partner</option>
                </select>
            </label>

            <label>
                <span>Stage</span>
                <select name="stage" required>
                    <option value="new">New</option>
                    <option value="contacted">Contacted</option>
                    <option value="qualified">Qualified</option>
                    <option value="appointment-set">Appointment set</option>
                    <option value="proposal">Proposal</option>
                    <option value="won">Won</option>
                    <option value="lost">Lost</option>
                    <option value="nurture">Nurture</option>
                </select>
            </label>
        </div>

        <label>
            <span>Source</span>
            <input
                name="source"
                type="text"
                value="manual"
                required
            />
        </label>

        <div class="crm-form-grid">
            <label>
                <span>Email</span>
                <input
                    name="email"
                    type="email"
                    autocomplete="email"
                />
            </label>

            <label>
                <span>Phone</span>
                <input
                    name="phone"
                    type="tel"
                    autocomplete="tel"
                />
            </label>
        </div>

        <label>
            <span>Owner</span>
            <input
                name="owner"
                type="text"
                autocomplete="off"
            />
        </label>

        <button type="submit">
            Save relationship
        </button>
    </form>
</section>

