        color:
            var(--river-water);
        font-size:
            0.72rem;
        font-weight:
            800;
        letter-spacing:
            0.12em;
        text-transform:
            uppercase;
    }

    .crm-create-form {
        display:
            grid;
        gap:
            1rem;
    }

    .crm-create-form label {
        display:
