---
import InsuranceOperatingStateForm from "./InsuranceOperatingStateForm.astro";
import type {
    RiverCrmRelationship
} from "../../lib/river-os/crm-workspace";

import type {
    InsuranceLeadPresentation
} from "../../lib/insurance/lead-presentation";


interface Props {
    readonly relationships:
        readonly RiverCrmRelationship[];

    readonly insurancePresentations?:
        readonly InsuranceLeadPresentation[];
}


const {
    relationships,
    insurancePresentations = []
} = Astro.props as Props;

const insuranceByRelationshipId =
    new Map(
        insurancePresentations.map(
            presentation => [
                presentation.relationshipId,
                presentation
            ]
        )
    );

function readableLabel(
    value:
        string
): string {
    return value
        .split("-")
        .map(
            word =>
                word.length === 0
                    ? word
                    : word[0]!.toUpperCase() +
                        word.slice(1)
        )
        .join(" ");
}

function formatInsuranceDate(
    value:
        string
): string {
    return new Date(
        value
    ).toLocaleString(
        "en-US",
        {
            timeZone:
                "America/Chicago",
            timeZoneName:
                "short"
        }
    );
}
---

<section
    class="crm-relationships"
    aria-labelledby="crm-relationships-heading"
>
    <div class="crm-relationships-heading">
        <div>
            <p class="crm-list-eyebrow">
                Private records
            </p>

            <h2 id="crm-relationships-heading">
                Relationships
            </h2>
        </div>

        <span class="crm-record-count">
            {relationships.length}
            {
                relationships.length === 1
                    ? " record"
                    : " records"
            }
        </span>
    </div>

    {
        relationships.length === 0
            ? (
                <p class="crm-empty-state">
                    No CRM relationships have been created yet.
                </p>
            )
            : (
                <div class="crm-record-list">
                    {
                        relationships.map(
                            relationship => (
                                <article class="crm-record">
                                    <div class="crm-record-summary">
                                        <div>
                                            <strong>
                                                {relationship.displayName}
                                            </strong>

                                            <span>
                                                {relationship.kind}
                                                {" Â· "}
                                                {relationship.stage}
                                            </span>
                                        </div>

                                        <span class="crm-record-source">
                                            {relationship.source}
                                        </span>
                                    </div>

                                                                        {
                                        insuranceByRelationshipId.has(
                                            relationship.relationshipId
                                        ) && (
                                            <section
                                                class="crm-insurance-card"
                                                aria-label={`Insurance context for ${relationship.displayName}`}
                                            >
                                                <div class="crm-insurance-heading">
                                                    <div>
                                                        <span class="crm-insurance-eyebrow">
                                                            Insurance
                                                        </span>

                                                        <strong>
                                                            {
                                                                readableLabel(
                                                                    insuranceByRelationshipId.get(
                                                                        relationship.relationshipId
                                                                    )!.productInterest
                                                                )
                                                            }
                                                        </strong>
                                                    </div>

                                                    <span class="crm-insurance-status">
                                                        {
                                                            readableLabel(
                                                                insuranceByRelationshipId.get(
                                                                    relationship.relationshipId
                                                                )!.quoteStatus
                                                            )
                                                        }
                                                    </span>
                                                </div>

                                                <dl class="crm-insurance-facts">
                                                    <div>
                                                        <dt>State / ZIP</dt>
                                                        <dd>
                                                            {
                                                                insuranceByRelationshipId.get(
                                                                    relationship.relationshipId
                                                                )!.state
                                                            }
                                                            {" "}
                                                            {
                                                                insuranceByRelationshipId.get(
                                                                    relationship.relationshipId
                                                                )!.postalCode
                                                            }
                                                        </dd>
                                                    </div>

                                                    <div>
                                                        <dt>Source</dt>
                                                        <dd>
                                                            {
                                                                insuranceByRelationshipId.get(
                                                                    relationship.relationshipId
                                                                )!.acquisitionSource ??
                                                                "—"
                                                            }
                                                        </dd>
                                                    </div>

                                                    <div>
                                                        <dt>Campaign</dt>
                                                        <dd>
                                                            {
                                                                insuranceByRelationshipId.get(
                                                                    relationship.relationshipId
                                                                )!.campaign ??
                                                                "—"
                                                            }
                                                        </dd>
                                                    </div>

                                                    {
                                                        insuranceByRelationshipId.get(
                                                            relationship.relationshipId
                                                        )!.sourceVendor !== undefined && (
                                                            <div>
                                                                <dt>Vendor</dt>
                                                                <dd>
                                                                    {
                                                                        insuranceByRelationshipId.get(
                                                                            relationship.relationshipId
                                                                        )!.sourceVendor
                                                                    }
                                                                </dd>
                                                            </div>
                                                        )
                                                    }

                                                    {
                                                        insuranceByRelationshipId.get(
                                                            relationship.relationshipId
                                                        )!.assignedProducer !== undefined && (
                                                            <div>
                                                                <dt>Producer</dt>
                                                                <dd>
                                                                    {
                                                                        insuranceByRelationshipId.get(
                                                                            relationship.relationshipId
                                                                        )!.assignedProducer
                                                                    }
                                                                </dd>
                                                            </div>
                                                        )
                                                    }
                                                </dl>

                                                <div class="crm-insurance-section">
                                                    <div class="crm-insurance-section-heading">
                                                        <span>Consent</span>

                                                        {
                                                            insuranceByRelationshipId.get(
                                                                relationship.relationshipId
                                                            )!.doNotContact && (
                                                                <strong class="crm-dnc-badge">
                                                                    Do not contact
                                                                </strong>
                                                            )
                                                        }
                                                    </div>

                                                    {
                                                        insuranceByRelationshipId.get(
                                                            relationship.relationshipId
                                                        )!.consentChannels.length === 0
                                                            ? (
                                                                <p class="crm-insurance-empty">
                                                                    No channel consent record available.
                                                                </p>
                                                            )
                                                            : (
                                                                <div class="crm-consent-list">
                                                                    {
                                                                        insuranceByRelationshipId.get(
                                                                            relationship.relationshipId
                                                                        )!.consentChannels.map(
                                                                            consent => (
                                                                                <span class="crm-consent-chip">
                                                                                    {readableLabel(consent.channel)}
                                                                                    {" · "}
                                                                                    {readableLabel(consent.status)}
                                                                                </span>
                                                                            )
                                                                        )
                                                                    }
                                                                </div>
                                                            )
                                                    }
                                                </div>

                                                <div class="crm-insurance-section">
                                                    <div class="crm-insurance-section-heading">
                                                        <span>Recent events</span>
                                                    </div>

                                                    {
                                                        insuranceByRelationshipId.get(
                                                            relationship.relationshipId
                                                        )!.recentEvents.length === 0
                                                            ? (
                                                                <p class="crm-insurance-empty">
                                                                    No recent insurance events.
                                                                </p>
                                                            )
                                                            : (
                                                                <ol class="crm-event-list">
                                                                    {
                                                                        insuranceByRelationshipId.get(
                                                                            relationship.relationshipId
                                                                        )!.recentEvents.map(
                                                                            event => (
                                                                                <li>
                                                                                    <strong>
                                                                                        {
                                                                                            readableLabel(
                                                                                                event.eventType
                                                                                            )
                                                                                        }
                                                                                    </strong>

                                                                                    <span>
                                                                                        {
                                                                                            formatInsuranceDate(
                                                                                                event.occurredAt
                                                                                            )
                                                                                        }
                                                                                        {" · "}
                                                                                        {event.source}
                                                                                    </span>
                                                                                </li>
                                                                            )
                                                                        )
                                                                    }
                                                                </ol>
                                                            )
                                                    }
                                                </div>
                                            </section>
                                        )
                                    }
                                    {
                                        insuranceByRelationshipId.has(
                                            relationship.relationshipId
                                        ) && (
                                            <InsuranceOperatingStateForm
                                                relationshipId={relationship.relationshipId}
                                                stage={relationship.stage}
                                                quoteStatus={
                                                    insuranceByRelationshipId.get(
                                                        relationship.relationshipId
                                                    )!.quoteStatus
                                                }
                                                assignedProducer={
                                                    insuranceByRelationshipId.get(
                                                        relationship.relationshipId
                                                    )!.assignedProducer
                                                }
                                            />
                                        )
                                    }
<form
                                        class="crm-record-form"
                                        method="post"
                                        action="/river-os/actions/crm-update"
                                    >
                                        <input
                                            type="hidden"
                                            name="relationshipId"
                                            value={relationship.relationshipId}
                                        />

                                        <label class="crm-field-wide">
                                            <span>Name</span>
                                            <input
                                                name="displayName"
                                                type="text"
                                                value={relationship.displayName}
                                                required
                                            />
                                        </label>

                                        <label>
                                            <span>Relationship</span>
                                            <select
                                                name="kind"
                                                required
                                            >
                                                <option
                                                    value="lead"
                                                    selected={relationship.kind === "lead"}
                                                >
                                                    Lead
                                                </option>

                                                <option
                                                    value="client"
                                                    selected={relationship.kind === "client"}
                                                >
                                                    Client
                                                </option>

                                                <option
                                                    value="recruit"
                                                    selected={relationship.kind === "recruit"}
                                                >
                                                    Recruit
                                                </option>

                                                <option
                                                    value="partner"
                                                    selected={relationship.kind === "partner"}
                                                >
                                                    Partner
                                                </option>
                                            </select>
                                        </label>

                                        {
                                                insuranceByRelationshipId.has(
                                                    relationship.relationshipId
                                                )
                                                    ? (
                                                        <input
                                                            type="hidden"
                                                            name="stage"
                                                            value={relationship.stage}
                                                        />
                                                    )
                                                    : (
<label>
                                            <span>Stage</span>
                                            <select
                                                name="stage"
                                                required
                                            >
                                                <option
                                                    value="new"
                                                    selected={relationship.stage === "new"}
                                                >
                                                    New
                                                </option>

                                                <option
                                                    value="contacted"
                                                    selected={relationship.stage === "contacted"}
                                                >
                                                    Contacted
                                                </option>

                                                <option
                                                    value="qualified"
                                                    selected={relationship.stage === "qualified"}
                                                >
                                                    Qualified
                                                </option>

                                                <option
                                                    value="appointment-set"
                                                    selected={relationship.stage === "appointment-set"}
                                                >
                                                    Appointment set
                                                </option>

                                                <option
                                                    value="proposal"
                                                    selected={relationship.stage === "proposal"}
                                                >
                                                    Proposal
                                                </option>

                                                <option
                                                    value="won"
                                                    selected={relationship.stage === "won"}
                                                >
                                                    Won
                                                </option>

                                                <option
                                                    value="lost"
                                                    selected={relationship.stage === "lost"}
                                                >
                                                    Lost
                                                </option>

                                                <option
                                                    value="nurture"
                                                    selected={relationship.stage === "nurture"}
                                                >
                                                    Nurture
                                                </option>
                                            </select>
                                        </label>
                                                    )
                                            }

                                        <label>
                                            <span>Source</span>
                                            <input
                                                name="source"
                                                type="text"
                                                value={relationship.source}
                                                required
                                            />
                                        </label>

                                        <label>
                                            <span>Email</span>
                                            <input
                                                name="email"
                                                type="email"
                                                value={relationship.email ?? ""}
                                            />
                                        </label>

                                        <label>
                                            <span>Phone</span>
                                            <input
                                                name="phone"
                                                type="tel"
                                                value={relationship.phone ?? ""}
                                            />
                                        </label>

                                        <label>
                                            <span>Owner</span>
                                            <input
                                                name="owner"
                                                type="text"
                                                value={relationship.owner ?? ""}
                                            />
                                        </label>

                                        <div class="crm-record-footer">
                                            <span>
                                                Updated
                                                {" "}
                                                {
                                                    new Date(
                                                        relationship.updatedAt
                                                    ).toLocaleString(
                                                        "en-US",
                                                        {
                                                            timeZone:
                                                                "America/Chicago",
                                                            timeZoneName:
                                                                "short"
                                                        }
                                                    )
                                                }
                                            </span>

                                            <button type="submit">
                                                Save changes
                                            </button>
                                        </div>
                                    </form>
                                </article>
                            )
                        )
                    }
                </div>
            )
    }
</section>

<style>
    .crm-relationships {
        display:
            grid;
        gap:
            1rem;
        margin-top:
            1rem;
        border:
            1px solid var(--river-line);
        border-radius:
            20px;
        background:
            rgba(
                255,
                253,
                248,
                0.82
            );
        padding:
            1.5rem;
    }

    .crm-relationships-heading,
    .crm-record-summary,
    .crm-record-footer {
        display:
            flex;
        align-items:
            center;
        justify-content:
            space-between;
        gap:
            1rem;
    }

    .crm-relationships-heading h2,
    .crm-relationships-heading p {
        margin:
            0;
    }

    .crm-relationships-heading h2 {
        margin-top:
            0.35rem;
        font-family:
            var(--river-serif);
        font-size:
            1.8rem;
        font-weight:
            400;
    }

    .crm-list-eyebrow {
        color:
            var(--river-water);
        font-size:
            0.72rem;
        font-weight:
            800;
        letter-spacing:
            0.12em;
        text-transform:
            uppercase;
    }

    .crm-record-count,
    .crm-record-source {
        color:
            var(--river-text-muted);
        font-size:
            0.78rem;
        font-weight:
            800;
    }

    .crm-empty-state {
        margin:
            0;
        color:
            var(--river-text-soft);
    }

    .crm-record-list {
        display:
            grid;
        gap:
            1rem;
    }

    .crm-record {
        display:
            grid;
        gap:
            1rem;
        border-top:
            1px solid var(--river-line);
        padding-top:
            1rem;
    }

    .crm-record-summary strong,
    .crm-record-summary span {
        display:
            block;
    }

    .crm-record-summary strong {
        font-family:
            var(--river-serif);
        font-size:
            1.25rem;
        font-weight:
            400;
    }

    .crm-record-summary div > span {
        margin-top:
            0.2rem;
        color:
            var(--river-text-soft);
        font-size:
            0.82rem;
    }

    .crm-insurance-card {
        display:
            grid;
        gap:
            1rem;
        border:
            1px solid var(--river-line);
        border-radius:
            14px;
        background:
            var(--river-paper-warm);
        padding:
            1rem;
    }

    .crm-insurance-heading,
    .crm-insurance-section-heading {
        display:
            flex;
        align-items:
            center;
        justify-content:
            space-between;
        gap:
            1rem;
    }

    .crm-insurance-heading > div {
        display:
            grid;
        gap:
            0.2rem;
    }

    .crm-insurance-eyebrow,
    .crm-insurance-section-heading > span {
        color:
            var(--river-water);
        font-size:
            0.7rem;
        font-weight:
            800;
        letter-spacing:
            0.1em;
        text-transform:
            uppercase;
    }

    .crm-insurance-heading strong {
        font-family:
            var(--river-serif);
        font-size:
            1.15rem;
        font-weight:
            400;
    }

    .crm-insurance-status,
    .crm-dnc-badge,
    .crm-consent-chip {
        width:
            fit-content;
        border:
            1px solid var(--river-line);
        border-radius:
            999px;
        background:
            var(--river-white);
        color:
            var(--river-text-soft);
        font-size:
            0.72rem;
        font-weight:
            800;
        padding:
            0.4rem 0.6rem;
    }

    .crm-dnc-badge {
        color:
            var(--river-text);
    }

    .crm-insurance-facts {
        display:
            grid;
        grid-template-columns:
            repeat(
                3,
                minmax(0, 1fr)
            );
        gap:
            0.75rem;
        margin:
            0;
    }

    .crm-insurance-facts div {
        display:
            grid;
        gap:
            0.15rem;
    }

    .crm-insurance-facts dt {
        color:
            var(--river-text-muted);
        font-size:
            0.68rem;
        font-weight:
            800;
        letter-spacing:
            0.08em;
        text-transform:
            uppercase;
    }

    .crm-insurance-facts dd {
        margin:
            0;
        color:
            var(--river-text);
        font-size:
            0.84rem;
        font-weight:
            700;
    }

    .crm-insurance-section {
        display:
            grid;
        gap:
            0.55rem;
        border-top:
            1px solid var(--river-line);
        padding-top:
            0.8rem;
    }

    .crm-consent-list {
        display:
            flex;
        flex-wrap:
            wrap;
        gap:
            0.45rem;
    }

    .crm-insurance-empty {
        margin:
            0;
        color:
            var(--river-text-muted);
        font-size:
            0.8rem;
    }

    .crm-event-list {
        display:
            grid;
        gap:
            0.5rem;
        margin:
            0;
        padding:
            0;
        list-style:
            none;
    }

    .crm-event-list li {
        display:
            flex;
        align-items:
            baseline;
        justify-content:
            space-between;
        gap:
            1rem;
    }

    .crm-event-list strong {
        font-size:
            0.82rem;
    }

    .crm-event-list span {
        color:
            var(--river-text-muted);
        font-size:
            0.74rem;
    }
    .crm-record-form {
        display:
            grid;
        grid-template-columns:
            repeat(
                3,
                minmax(0, 1fr)
            );
        gap:
            0.85rem;
    }

    .crm-record-form label {
        display:
            grid;
        gap:
            0.35rem;
        color:
            var(--river-text-soft);
        font-size:
            0.78rem;
        font-weight:
            700;
    }

    .crm-field-wide,
    .crm-record-footer {
        grid-column:
            1 / -1;
    }

    .crm-record-form input,
    .crm-record-form select {
        width:
            100%;
        box-sizing:
            border-box;
        border:
            1px solid var(--river-line);
        border-radius:
            10px;
        background:
            var(--river-white);
        color:
            var(--river-text);
        font:
            inherit;
        padding:
            0.7rem 0.8rem;
    }

    .crm-record-footer {
        color:
            var(--river-text-muted);
        font-size:
            0.76rem;
        font-weight:
            700;
    }

    .crm-record-footer button {
        border:
            0;
        border-radius:
            999px;
        background:
            var(--river-water);
        color:
            var(--river-white);
        cursor:
            pointer;
        font:
            inherit;
        font-weight:
            800;
        padding:
            0.7rem 0.95rem;
    }

    @media (
        max-width: 760px
    ) {
        .crm-insurance-facts {
            grid-template-columns:
                1fr;
        }

        .crm-insurance-heading,
        .crm-insurance-section-heading,
        .crm-event-list li {
            align-items:
                flex-start;
            flex-direction:
                column;
        }
        .crm-record-form {
            grid-template-columns:
                1fr;
        }

        .crm-field-wide,
        .crm-record-footer {
            grid-column:
                auto;
        }

        .crm-relationships-heading,
        .crm-record-summary,
        .crm-record-footer {
            align-items:
                flex-start;
            flex-direction:
                column;
        }
    }
</style>
