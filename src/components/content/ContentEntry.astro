---
import {
    createTopicSlug
} from "../../lib/topics";
interface Props {
    eyebrow?: string;
    title: string;
    description?: string;
    author?: string;
    published?: Date;
    readingMinutes?: number;
    version?: string;
    tags?: string[];
    bodyClass?: string;
}

const {
    eyebrow,
    title,
    description,
    author = "River Young",
    published,
    readingMinutes,
    version,
    tags = []
} = Astro.props;
const validTags = (
    tags ?? []
).filter(
    (tag): tag is string => {
        return (
            typeof tag === "string" &&
            createTopicSlug(tag).length > 0
        );
    }
);
---
<article class="content-entry">

    <header class="content-entry__header">

        {
            eyebrow && (
                <p class="eyebrow">
                    {eyebrow}
                </p>
            )
        }


        <h1>
            {title}
        </h1>


        {
            description && (
                <p class="content-entry__description">
                    {description}
                </p>
            )
        }


        <div class="content-entry__meta">

            <span>
                By {author}
            </span>


            {
                published && (
                    <span>
                        {published.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "long",
                            day: "numeric"
                        })}
                    </span>
                )
            }


            {
                readingMinutes && (
                    <span>
                        {readingMinutes} min read
                    </span>
                )
            }


            {
                version && (
                    <span>
                        Version {version}
                    </span>
                )
            }

        </div>

    </header>


    <div class="content-entry__body">

        <slot />

    </div>


    {
        validTags.length > 0 && (
            <footer class="content-entry__tags">

                <p class="section-label">
                    Filed under
                </p>


                <ul>

                    {
                        validTags.map((tag) => (
                            <li>
                                <a
                                    href={`/topics/${createTopicSlug(tag)}/`}
                                >
                                    {tag}
                                </a>
                            </li>
                        ))
                    }

                </ul>

            </footer>
        )
    }

</article>
