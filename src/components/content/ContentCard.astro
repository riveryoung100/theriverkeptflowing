---
interface Props {
    type:string;
    title:string;
    description:string;
    href:string;
    published?:Date;
    featured?:boolean;
}

const {
    type,
    title,
    description,
    href,
    published,
    featured=false
} = Astro.props;
---

<article class:list={[
    "content-card",
    featured && "content-card-featured"
]}>

    <a href={href}>

        <p class="content-type">
            {type}
        </p>


        <h3>
            {title}
        </h3>


        <p class="content-description">
            {description}
        </p>


        {
            published &&
            <time datetime={published.toISOString()}>
                {published.toLocaleDateString("en-US", {
                    year:"numeric",
                    month:"long",
                    day:"numeric"
                })}
            </time>
        }


        <span class="card-link">
            Continue reading →
        </span>

    </a>

</article>