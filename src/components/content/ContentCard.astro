---
interface Props {
    type:string;
    title:string;
    description:string;
    href:string;
    published?:Date;
    featured?:boolean;
    number?:string;
    readingMinutes?:number;
    tags?:string[];
    action?:string;
}

const {
    type,
    title,
    description,
    href,
    published,
    featured=false,
    number,
    readingMinutes,
    tags,
    action="Continue reading"
} = Astro.props;
---

<article class:list={[
    "content-card",
    featured && "content-card-featured"
]}>

    <a href={href}>


        <div class="content-card-meta">

            {
                number &&
                <span>
                    {number}
                </span>
            }


            <span class="content-type">
                {type}
            </span>

        </div>


        <h3>
            {title}
        </h3>


        <p class="content-description">
            {description}
        </p>


        {
            tags &&
            tags.length > 0 &&
            <div class="content-tags">

                {
                    tags.slice(0,4).map((tag) => (
                        <span>
                            {tag}
                        </span>
                    ))
                }

            </div>
        }


        <div class="content-card-footer">


            {
                published &&
                <time datetime={published.toISOString()}>
                    {published.toLocaleDateString("en-US", {
                        year:"numeric",
                        month:"long",
                        day:"numeric"
                    })}
                </time>
            }


            {
                readingMinutes &&
                <span>
                    {readingMinutes} min read
                </span>
            }


        </div>


        <span class="card-link">
            {action} →
        </span>


    </a>

</article>