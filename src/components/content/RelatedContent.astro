---
import ContentCard from "./ContentCard.astro";

import {
    getPublishedTopicEntries,
    type TopicEntry
} from "../../lib/topics";

import {
    rankSemanticRecommendations
} from "../../lib/semanticRecommendations";


type CollectionName =
    | "guides"
    | "essays"
    | "letters"
    | "journal"
    | "recipes"
    | "films";


interface Props {
    currentCollection: CollectionName;
    currentId: string;
    currentTags?: string[];
    limit?: number;
}


const {
    currentCollection,
    currentId,
    currentTags = [],
    limit = 3
} = Astro.props;


const publishedEntries =
    await getPublishedTopicEntries();


const existingCurrentEntry =
    publishedEntries.find((entry) => {
        return (
            entry.collection ===
                currentCollection &&
            entry.id ===
                currentId
        );
    });


const currentEntry: TopicEntry =
    existingCurrentEntry ?? {
        collection:
            currentCollection,
        id:
            currentId,
        type:
            currentCollection,
        title:
            "",
        description:
            "",
        href:
            "",
        tags:
            currentTags,
        related:
            [],
        prerequisites:
            [],
        nextReading:
            [],
        learningPath:
            [],
        published:
            new Date(0),
        featured:
            false
    };


const relatedEntries =
    existingCurrentEntry
        ? rankSemanticRecommendations(
            currentEntry,
            publishedEntries,
            {
                limit,
                minimumScore: 1
            }
        )
        : [];
---


{
    relatedEntries.length > 0 && (
        <section
            class="related-content"
            aria-labelledby="related-content-title"
        >

            <header class="related-content__header">

                <p class="section-label">
                    Continue through the River
                </p>

                <h2 id="related-content-title">
                    Related reading
                </h2>

                <p>
                    Recommendations chosen through shared
                    topics and related ideas from across
                    the River Library.
                </p>

            </header>


            <div class="related-content__grid">

                {
                    relatedEntries.map((entry) => (

                        <article
                            class="related-content__recommendation"
                            data-semantic-score={entry.score}
                        >

                            <ContentCard
                                type={entry.type}
                                title={entry.title}
                                description={entry.description}
                                href={entry.href}
                                number={entry.number}
                                published={entry.published}
                                readingMinutes={
                                    entry.readingMinutes
                                }
                                featured={entry.featured}
                                tags={entry.tags}
                                action="Continue reading"
                            />


                            {
                                entry.reasons.length > 0 && (

                                    <p
                                        class="related-content__reason"
                                        data-pagefind-ignore
                                    >
                                        {
                                            entry.reasons[0]
                                        }
                                    </p>

                                )
                            }

                        </article>

                    ))
                }

            </div>

        </section>
    )
}


<style>

    .related-content__recommendation {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }


    .related-content__reason {
        margin:
            10px
            8px
            0;
        font-size: 0.78rem;
        line-height: 1.5;
        opacity: 0.7;
    }

</style>