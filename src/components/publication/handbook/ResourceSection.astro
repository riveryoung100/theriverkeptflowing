---
interface Props {
    eyebrow?: string;
    title: string;
    id?: string;
}

const {
    eyebrow,
    title,
    id
} = Astro.props;
---

<section
    id={id}
    class="publication-resource"
>

    {eyebrow && (
        <p class="eyebrow">
            {eyebrow}
        </p>
    )}

    <h2>
        {title}
    </h2>

    <div class="publication-resource__body">
        <slot />
    </div>

</section>