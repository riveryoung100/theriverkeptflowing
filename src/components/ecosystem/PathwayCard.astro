---
interface Props {
    title:string;
    description:string;
    action:string;
    href:string;
    type?:string;
}

const {
    title,
    description,
    action,
    href,
    type="Pathway"
}=Astro.props;
---

<article class="pathway-card">

    <div class="pathway-content">

        <p class="content-type">
            {type}
        </p>


        <h3>
            {title}
        </h3>


        <p class="pathway-description">
            {description}
        </p>


        <a
            href={href}
            class="card-link"
        >
            <span>
                {action}
            </span>

            <span aria-hidden="true">
                →
            </span>

        </a>

    </div>

</article>