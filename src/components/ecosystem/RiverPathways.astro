---
import PathwayCard from "./PathwayCard.astro";

const pathways = [

{
title:"Learn From The River",
description:
"Explore stories, guides, lessons, and resources collected through years of experience and reflection.",
action:"Enter the Library",
href:"/library/",
type:"Knowledge"
},


{
title:"Protect What Matters",
description:
"Understand practical systems, stewardship, and tools designed to help protect the things you have built.",
action:"Explore Guides",
href:"/river-guides/",
type:"Stewardship"
},


{
title:"Follow The Current",
description:
"See what is being learned, built, questioned, and shared in the present season.",
action:"Enter The Current",
href:"/current/",
type:"Current"
},


{
title:"Understand The Story",
description:
"Follow the people, experiences, failures, victories, and turning points that shaped the River.",
action:"Read The Story",
href:"/source/",
type:"Story"
},


{
title:"Participate In The Work",
description:
"Explore the current ways to contribute, collaborate, and help meaningful work continue flowing.",
action:"See Ways To Participate",
href:"/contribute/",
type:"Participation"
}

];

---

<div class="path-grid">

{
pathways.map((item)=>(

<PathwayCard
    title={item.title}
    description={item.description}
    action={item.action}
    href={item.href}
    type={item.type}
/>

))
}

</div>