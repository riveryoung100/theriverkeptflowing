---
import PathwayCard from "./PathwayCard.astro";

const pathways = [

{
title:"Learn From The River",
description:
"Explore stories, guides, lessons, and resources collected through years of experience and reflection.",
action:"Enter the Library",
href:"/library/",
type:"Knowledge"
},


{
title:"Protect What Matters",
description:
"Understand practical systems, stewardship, and tools designed to help protect the things you have built.",
action:"Explore Guides",
href:"/river-guides/",
type:"Stewardship"
},


{
title:"Support The Mission",
description:
"Help continue the work of creating, teaching, serving, and caring for people through practical action.",
action:"Visit The River Fund",
href:"/river-fund/",
type:"Mission"
},


{
title:"Build Something Together",
description:
"Work alongside The River through services, collaboration, and meaningful partnerships.",
action:"Explore Services",
href:"/services/",
type:"Services"
},


{
title:"Participate In The Journey",
description:
"Support creations, products, and resources that allow the work to continue flowing.",
action:"Visit The Shop",
href:"/shop/",
type:"Commerce"
}

];

---

<div class="pathway-grid">

{
pathways.map((item)=>(

<PathwayCard
    title={item.title}
    description={item.description}
    action={item.action}
    href={item.href}
    type={item.type}
/>

))
}

</div>