---
import SceneShell from "../primitives/SceneShell.astro";
import AmbientGlow from "../primitives/AmbientGlow.astro";
import MistBand from "../primitives/MistBand.astro";
import WindField from "../primitives/WindField.astro";
import LeafDrift from "../primitives/LeafDrift.astro";
import Tree from "../primitives/Tree.astro";
import GroundPath from "../primitives/GroundPath.astro";
import CloudLayer from "../primitives/CloudLayer.astro";
import SunLight from "../primitives/SunLight.astro";

const treeRows = [
    {
        className: "orchard-scene__row--far",
        count: 7,
        size: "small",
        depth: "far",
        fruitCount: 3
    },
    {
        className: "orchard-scene__row--middle",
        count: 6,
        size: "medium",
        depth: "middle",
        fruitCount: 4
    },
    {
        className: "orchard-scene__row--near",
        count: 5,
        size: "medium",
        depth: "near",
        fruitCount: 5
    }
] as const;
---

<SceneShell
    className="orchard-scene"
    label="Rows of fruit trees growing beside a quiet orchard path"
>
    <div
        slot="background"
        class="orchard-scene__sky"
    ></div>

    <AmbientGlow
        slot="background"
        position="left"
        size="large"
        intensity="medium"
        duration="18s"
    />

    <SunLight
        slot="background"
        position="right"
        size="large"
        intensity="soft"
        pulseDuration="22s"
    />

    <CloudLayer
        slot="atmosphere"
        count={6}
        depth="far"
        direction="right"
        speed="slow"
        opacity={0.38}
    />

    <div
        slot="distance"
        class="
            orchard-scene__hills
            orchard-scene__hills--far
        "
    ></div>

    <div
        slot="distance"
        class="
            orchard-scene__hills
            orchard-scene__hills--near
        "
    ></div>

    <MistBand
        slot="atmosphere"
        position="middle"
        density="light"
        direction="right"
        duration="30s"
    />

    <WindField
        slot="atmosphere"
        strength="gentle"
        direction="right"
        duration="15s"
    />

    <div
        slot="midground"
        class="orchard-scene__ground"
    ></div>

    <GroundPath
        slot="midground"
        width="medium"
        length="long"
        tone="earth"
        opacity={0.92}
    />

    {
        treeRows.map(
            (row, rowIndex) => (
                <div
                    slot="midground"
                    class:list={[
                        "orchard-scene__row",
                        row.className
                    ]}
                >
                    {
                        Array.from(
                            { length: row.count },
                            (_, treeIndex) => (
                                <Tree
                                    size={row.size}
                                    depth={row.depth}
                                    fruitCount={row.fruitCount}
                                    fruitColor={
                                        treeIndex % 3 === 0
                                            ? "gold"
                                            : treeIndex % 2 === 0
                                                ? "red"
                                                : "orange"
                                    }
                                    swayDuration={`${
                                        8 +
                                        ((treeIndex + rowIndex) % 4)
                                    }s`}
                                    animationDelay={`-${
                                        (
                                            treeIndex +
                                            rowIndex
                                        ) * 0.7
                                    }s`}
                                />
                            )
                        )
                    }
                </div>
            )
        )
    }

    <LeafDrift
        slot="foreground"
        count={18}
        direction="right"
        density="light"
    />

    <div
        slot="foreground"
        class="orchard-scene__fallen-fruit"
    >
        {
            Array.from(
                { length: 10 },
                (_, index) => (
                    <span
                        class="
                            orchard-scene__fallen-fruit-piece
                        "
                        style={`
                            --fallen-left: ${
                                5 +
                                ((index * 29) % 90)
                            }%;

                            --fallen-bottom: ${
                                3 +
                                ((index * 11) % 17)
                            }%;

                            --fallen-size: ${
                                0.42 +
                                ((index * 5) % 4) * 0.08
                            }rem;
                        `}
                    ></span>
                )
            )
        }
    </div>

    <div
        slot="foreground"
        class="orchard-scene__foreground"
    ></div>
</SceneShell>

<style>
    :global(.orchard-scene) {
        opacity: 0.95;
    }

    .orchard-scene__sky {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(
                180deg,
                rgba(194, 202, 160, 0.13) 0%,
                rgba(151, 171, 120, 0.09) 42%,
                rgba(91, 124, 76, 0.05) 70%,
                transparent 88%
            );
    }

    .orchard-scene__hills {
        position: absolute;
        right: -8%;
        left: -8%;
    }

    .orchard-scene__hills--far {
        bottom: 37%;
        height: 26%;
        opacity: 0.28;
        background: #778568;
        clip-path:
            polygon(
                0 72%,
                14% 51%,
                29% 62%,
                44% 43%,
                60% 59%,
                75% 40%,
                89% 55%,
                100% 46%,
                100% 100%,
                0 100%
            );
        filter: blur(0.14rem);
    }

    .orchard-scene__hills--near {
        bottom: 28%;
        height: 22%;
        opacity: 0.54;
        background: #52684b;
        clip-path:
            polygon(
                0 64%,
                17% 45%,
                33% 57%,
                49% 38%,
                65% 61%,
                81% 42%,
                100% 55%,
                100% 100%,
                0 100%
            );
    }

    .orchard-scene__ground {
        position: absolute;
        right: -6%;
        bottom: -7%;
        left: -6%;
        height: 48%;
        background:
            linear-gradient(
                180deg,
                rgba(91, 117, 63, 0.72),
                rgba(53, 78, 45, 0.9) 52%,
                rgba(28, 48, 30, 0.98)
            );
        clip-path:
            polygon(
                0 15%,
                13% 9%,
                29% 14%,
                45% 8%,
                62% 14%,
                79% 7%,
                100% 13%,
                100% 100%,
                0 100%
            );
    }

    .orchard-scene__row {
        position: absolute;
        right: 0;
        left: 0;
        display: flex;
        justify-content: space-around;
        align-items: flex-end;
    }

    .orchard-scene__row--far {
        bottom: 33%;
        padding-inline: 4%;
        opacity: 0.7;
    }

    .orchard-scene__row--middle {
        bottom: 20%;
        padding-inline: 1%;
        opacity: 0.86;
    }

    .orchard-scene__row--near {
        bottom: 3%;
        margin-inline: -4%;
        opacity: 0.98;
    }

    .orchard-scene__fallen-fruit {
        position: absolute;
        inset: 0;
    }

    .orchard-scene__fallen-fruit-piece {
        position: absolute;
        bottom: var(--fallen-bottom);
        left: var(--fallen-left);
        width: var(--fallen-size);
        aspect-ratio: 1;
        border-radius: 50%;
        background:
            radial-gradient(
                circle at 34% 28%,
                rgba(211, 139, 66, 0.9),
                rgba(139, 70, 40, 0.92)
            );
        opacity: 0.72;
    }

    .orchard-scene__foreground {
        position: absolute;
        right: -8%;
        bottom: -14%;
        left: -8%;
        height: 27%;
        background:
            linear-gradient(
                180deg,
                rgba(40, 67, 39, 0.62),
                rgba(22, 39, 27, 0.98)
            );
        clip-path:
            polygon(
                0 23%,
                12% 16%,
                26% 22%,
                41% 14%,
                55% 21%,
                70% 13%,
                86% 22%,
                100% 15%,
                100% 100%,
                0 100%
            );
    }

    @media (max-width: 48rem) {
        :global(.orchard-scene) {
            opacity: 0.84;
        }

        .orchard-scene__hills--far {
            bottom: 43%;
        }

        .orchard-scene__hills--near {
            bottom: 35%;
        }

        .orchard-scene__row--far {
            bottom: 38%;
        }

        .orchard-scene__row--middle {
            bottom: 24%;
        }

        .orchard-scene__row--near {
            bottom: 5%;
            margin-inline: -15%;
        }

        .orchard-scene__row--near
        :global(.landscape-tree:nth-child(even)) {
            opacity: 0.52;
        }
    }
</style>

