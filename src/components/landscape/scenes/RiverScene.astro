---
import MountainRange from "../primitives/MountainRange.astro";
import RiverFlow from "../primitives/RiverFlow.astro";
import TerrainForeground from "../primitives/TerrainForeground.astro";
---

<div
    class="river-scene"
    aria-hidden="true"
>

    <div class="river-scene__sky"></div>

    <div class="river-scene__light"></div>

    <MountainRange
        variant="river"
        depth="far"
    />

    <MountainRange
        variant="river"
        depth="middle"
    />

    <div class="river-scene__mist river-scene__mist--one"></div>

    <div class="river-scene__mist river-scene__mist--two"></div>

    <RiverFlow variant="river" />

    <TerrainForeground variant="river" />

</div>

<style>
    .river-scene {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
        opacity: 0.9;
    }

    .river-scene__sky {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(
                180deg,
                rgba(151, 190, 181, 0.09) 0%,
                rgba(90, 138, 130, 0.05) 38%,
                transparent 72%
            );
    }

    .river-scene__light {
        position: absolute;
        top: 5%;
        left: 58%;
        width: clamp(15rem, 30vw, 30rem);
        aspect-ratio: 1;
        transform: translateX(-50%);
        border-radius: 50%;
        background:
            radial-gradient(
                circle,
                rgba(228, 235, 215, 0.14),
                rgba(156, 192, 178, 0.06) 42%,
                transparent 72%
            );
        filter: blur(0.7rem);
        animation:
            river-light-breathe
            15s
            var(--ease-breath)
            infinite alternate;
    }

    .river-scene__mist {
        position: absolute;
        right: -15%;
        left: -15%;
        height: 19%;
        border-radius: 50%;
        filter: blur(3rem);
        background:
            radial-gradient(
                ellipse,
                rgba(211, 229, 222, 0.12),
                transparent 69%
            );
    }

    .river-scene__mist--one {
        bottom: 30%;
        animation:
            river-mist-one
            22s
            var(--ease-breath)
            infinite alternate;
    }

    .river-scene__mist--two {
        bottom: 17%;
        opacity: 0.62;
        animation:
            river-mist-two
            27s
            var(--ease-breath)
            infinite alternate;
    }

    @keyframes river-light-breathe {
        from {
            transform:
                translateX(-50%)
                scale(0.95);
            opacity: 0.62;
        }

        to {
            transform:
                translateX(-50%)
                scale(1.06);
            opacity: 1;
        }
    }

    @keyframes river-mist-one {
        from {
            transform: translate3d(-4%, 0, 0);
        }

        to {
            transform: translate3d(4%, -4%, 0);
        }
    }

    @keyframes river-mist-two {
        from {
            transform: translate3d(5%, 2%, 0);
        }

        to {
            transform: translate3d(-5%, -2%, 0);
        }
    }

    @media (max-width: 48rem) {
        .river-scene {
            opacity: 0.78;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .river-scene__light,
        .river-scene__mist {
            animation: none;
        }
    }
</style>
