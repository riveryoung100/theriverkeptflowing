---
import MountainRange from "../primitives/MountainRange.astro";
import RiverFlow from "../primitives/RiverFlow.astro";
import SpringSource from "../primitives/SpringSource.astro";
import TerrainForeground from "../primitives/TerrainForeground.astro";
---

<div
    class="headwaters-scene"
    aria-hidden="true"
>

    <div class="headwaters-scene__sky"></div>

    <div class="headwaters-scene__sun"></div>

    <div class="headwaters-scene__mountains">

        <MountainRange depth="far" />

        <MountainRange depth="middle" />

        <MountainRange depth="near" />

    </div>

    <div
        class="
            headwaters-scene__mist
            headwaters-scene__mist--one
        "
    ></div>

    <div
        class="
            headwaters-scene__mist
            headwaters-scene__mist--two
        "
    ></div>

    <SpringSource />

    <RiverFlow />

    <TerrainForeground />

</div>

<style>
    .headwaters-scene {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
        opacity: 0.92;
    }

    .headwaters-scene__sky {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(
                180deg,
                rgba(171, 211, 207, 0.09) 0%,
                rgba(109, 161, 156, 0.055) 38%,
                transparent 72%
            );
    }

    .headwaters-scene__sun {
        position: absolute;
        top: 7%;
        right: 12%;
        width: clamp(13rem, 26vw, 27rem);
        aspect-ratio: 1;
        border-radius: 50%;
        background:
            radial-gradient(
                circle,
                rgba(235, 245, 237, 0.13) 0%,
                rgba(190, 224, 216, 0.06) 38%,
                transparent 72%
            );
        filter: blur(0.5rem);
        animation:
            headwaters-light-breathe
            14s
            var(--ease-breath)
            infinite alternate;
    }

    .headwaters-scene__mountains {
        position: absolute;
        inset: 0;
    }

    .headwaters-scene__mist {
        position: absolute;
        right: -15%;
        left: -15%;
        height: 22%;
        border-radius: 50%;
        filter: blur(2.8rem);
        background:
            radial-gradient(
                ellipse,
                rgba(219, 235, 230, 0.15),
                transparent 68%
            );
    }

    .headwaters-scene__mist--one {
        bottom: 29%;
        animation:
            headwaters-mist-left
            20s
            var(--ease-breath)
            infinite alternate;
    }

    .headwaters-scene__mist--two {
        bottom: 18%;
        opacity: 0.65;
        animation:
            headwaters-mist-right
            24s
            var(--ease-breath)
            infinite alternate;
    }

    @keyframes headwaters-light-breathe {
        from {
            transform: scale(0.94);
            opacity: 0.62;
        }

        to {
            transform: scale(1.06);
            opacity: 1;
        }
    }

    @keyframes headwaters-mist-left {
        from {
            transform: translate3d(-4%, 0, 0);
        }

        to {
            transform: translate3d(4%, -5%, 0);
        }
    }

    @keyframes headwaters-mist-right {
        from {
            transform: translate3d(5%, 2%, 0);
        }

        to {
            transform: translate3d(-5%, -3%, 0);
        }
    }

    @media (max-width: 48rem) {
        .headwaters-scene {
            opacity: 0.78;
        }


    }

    @media (prefers-reduced-motion: reduce) {
        .headwaters-scene__sun,
        .headwaters-scene__mist {
            animation: none;
        }
    }
</style>
