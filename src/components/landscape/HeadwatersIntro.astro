<section
    id="headwaters"
    class="headwaters"
>

    <div class="container">

        <p class="eyebrow">
            Headwaters
        </p>

        <h2>
            Every river begins somewhere.
        </h2>

        <p class="headwaters__statement">
            This is a place to slow down, look honestly at the life behind us,
            and follow the current toward what matters most.
        </p>

    </div>

</section>

<style>

.headwaters {
    display: grid;
    place-items: center;

    min-height: 100svh;

    padding:
        var(--space-24)
        var(--page-gutter);
}

.headwaters .container {
    width: min(100%, 64rem);

    text-align: center;
}

.headwaters h2 {
    max-width: 10ch;

    margin:
        var(--space-6)
        auto
        0;

    font-size:
        clamp(3.5rem, 9vw, 8rem);

    line-height: 0.9;
    letter-spacing: -0.055em;
}

.headwaters__statement {
    max-width: 42rem;

    margin:
        var(--space-10)
        auto
        0;

    font-size:
        clamp(1.1rem, 2vw, 1.4rem);

    line-height: 1.7;

    color:
        var(--color-text-muted);
}

@media (max-width: 48rem) {
    .headwaters {
        padding-top: var(--space-20);
        padding-bottom: var(--space-20);
    }

    .headwaters h2 {
        font-size:
            clamp(3.2rem, 15vw, 5.5rem);
    }
}

</style>