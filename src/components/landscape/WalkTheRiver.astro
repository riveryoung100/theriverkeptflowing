---
import { places } from "../../data/places";

const stops = places
    .filter((place) => place.id !== "trailhead" && !place.visibility.hidden)
    .map((place, index) => ({
        eyebrow: place.name,
        title: place.purpose,
        description: place.emotionalTone.join(" · "),
        href: place.path,
        direction: index % 2 === 0 ? "left" : "right"
    }));
---

<section
    class="walk"
    aria-labelledby="walk-title"
>

    <header class="walk__heading">

        <p class="eyebrow">
            Walk the River
        </p>

        <h2 id="walk-title">
            Some places are found slowly.
        </h2>

        <p class="walk__intro">
            There is no right place to begin.
            Follow the part of the river that feels nearest today.
        </p>

    </header>

    <div class="walk__path">

        {
            stops.map((stop, index) => (

                <article
                    class:list={[
                        "stop",
                        `stop--${stop.direction}`
                    ]}
                >

                    <a
                        href={stop.href}
                        class="stop__link"
                    >

                        <span
                            class="stop__marker"
                            aria-hidden="true"
                        >
                            <span></span>
                        </span>

                        <span class="stop__content">

                            <span class="stop__number">
                                {String(index + 1).padStart(2, "0")}
                            </span>

                            <span class="stop__eyebrow">
                                {stop.eyebrow}
                            </span>

                            <span class="stop__title">
                                {stop.title}
                            </span>

                            <span class="stop__description">
                                {stop.description}
                            </span>

                            <span class="stop__invitation">
                                Enter this place
                                <span aria-hidden="true">→</span>
                            </span>

                        </span>

                    </a>

                </article>

            ))
        }

    </div>

</section>

<style>

.walk {
    position: relative;
    overflow: hidden;
    padding:
        var(--space-24)
        var(--page-gutter)
        var(--space-32);
}

.walk::before {
    position: absolute;
    top: 18rem;
    left: 50%;
    width: min(84vw, 62rem);
    height: 70rem;
    border-radius: 50%;
    background:
        radial-gradient(
            ellipse,
            rgba(155, 179, 159, 0.055),
            transparent 72%
        );
    content: "";
    pointer-events: none;
    transform: translateX(-50%);
}

.walk__heading {
    position: relative;
    z-index: 2;
    width: min(100%, 58rem);
    margin: 0 auto;
    text-align: center;
}

.walk__heading h2 {
    max-width: 11ch;
    margin:
        var(--space-6)
        auto
        0;
    font-size:
        clamp(3.6rem, 7vw, 7rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
}

.walk__intro {
    max-width: 38rem;
    margin:
        var(--space-8)
        auto
        0;
    color:
        var(--color-text-muted);
    font-size:
        clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.7;
}

.walk__path {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(8rem, 14vw, 15rem);
    width: min(100%, 72rem);
    margin:
        var(--space-24)
        auto
        0;
}

.walk__path::before {
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: 50%;
    width: 1px;
    background:
        linear-gradient(
            to bottom,
            transparent,
            rgba(204, 217, 204, 0.18) 8%,
            rgba(204, 217, 204, 0.1) 50%,
            rgba(204, 217, 204, 0.18) 92%,
            transparent
        );
    content: "";
    transform: translateX(-50%);
}

.stop {
    display: flex;
    width: 100%;
}

.stop--left {
    justify-content: flex-start;
}

.stop--right {
    justify-content: flex-end;
}

.stop__link {
    display: grid;
    grid-template-columns:
        auto minmax(0, 1fr);
    gap: var(--space-6);
    width: min(100%, 31rem);
    color: inherit;
    text-decoration: none;
    transition:
        transform
        var(--duration-medium)
        var(--ease-soft);
}

.stop--left .stop__link {
    margin-right:
        calc(50% + 3rem);
}

.stop--right .stop__link {
    margin-left:
        calc(50% + 3rem);
}

.stop__marker {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    border:
        1px solid
        rgba(210, 221, 210, 0.14);
    border-radius: 50%;
    background:
        rgba(10, 15, 12, 0.76);
    box-shadow:
        0 0 0 0.75rem
        rgba(185, 201, 187, 0.02);
    backdrop-filter:
        blur(0.6rem);
    transition:
        border-color
        var(--duration-medium)
        var(--ease-soft),
        box-shadow
        var(--duration-medium)
        var(--ease-soft),
        transform
        var(--duration-medium)
        var(--ease-soft);
}

.stop__marker span {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background:
        var(--color-text-soft);
    box-shadow:
        0 0 1rem
        rgba(220, 231, 220, 0.22);
}

.stop__content {
    display: flex;
    flex-direction: column;
    padding-top: 0.2rem;
}

.stop__number {
    color:
        var(--color-text-faint);
    font-family:
        var(--font-interface);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
}

.stop__eyebrow {
    margin-top:
        var(--space-4);
    color:
        var(--color-text-soft);
    font-family:
        var(--font-interface);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
}

.stop__title {
    margin-top:
        var(--space-4);
    font-family:
        var(--font-display);
    font-size:
        clamp(2.7rem, 4.6vw, 4.5rem);
    line-height: 0.96;
    letter-spacing: -0.05em;
}

.stop__description {
    max-width: 26rem;
    margin-top:
        var(--space-5);
    color:
        var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.75;
    text-transform: capitalize;
}

.stop__invitation {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top:
        var(--space-6);
    color:
        var(--color-text-soft);
    font-family:
        var(--font-interface);
    font-size: 0.7rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    opacity: 0.56;
    transition:
        opacity
        var(--duration-medium)
        var(--ease-soft),
        transform
        var(--duration-medium)
        var(--ease-soft);
}

.stop__link:hover,
.stop__link:focus-visible {
    transform:
        translateY(-0.4rem);
}

.stop__link:hover .stop__marker,
.stop__link:focus-visible .stop__marker {
    border-color:
        rgba(220, 230, 220, 0.32);
    box-shadow:
        0 0 0 1rem
        rgba(185, 201, 187, 0.055);
    transform:
        scale(1.04);
}

.stop__link:hover .stop__invitation,
.stop__link:focus-visible .stop__invitation {
    opacity: 1;
    transform:
        translateX(0.25rem);
}

.stop__link:focus-visible {
    outline:
        1px solid
        var(--color-text-soft);
    outline-offset:
        1rem;
}

@media (max-width: 56rem) {
    .walk {
        padding-bottom:
            var(--space-24);
    }

    .walk__path {
        gap:
            var(--space-20);
        margin-top:
            var(--space-20);
    }

    .walk__path::before {
        left:
            2rem;
    }

    .stop,
    .stop--left,
    .stop--right {
        justify-content:
            flex-start;
    }

    .stop--left .stop__link,
    .stop--right .stop__link {
        width: 100%;
        margin-right: 0;
        margin-left: 0;
    }

    .stop__link {
        grid-template-columns:
            4rem minmax(0, 1fr);
    }

    .stop__marker {
        width: 4rem;
        height: 4rem;
    }

    .stop__title {
        font-size:
            clamp(2.5rem, 11vw, 4rem);
    }
}

@media (prefers-reduced-motion: reduce) {
    .stop__link,
    .stop__marker,
    .stop__invitation {
        transition: none;
    }
}

</style>
