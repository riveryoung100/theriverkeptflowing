---
import HeadwatersScene from "./scenes/HeadwatersScene.astro";
import RiverScene from "./scenes/RiverScene.astro";
import FieldScene from "./scenes/FieldScene.astro";
import FireScene from "./scenes/FireScene.astro";

interface Props {
    placeId: string;
}

const { placeId } = Astro.props;

const scenes = {
    headwaters: HeadwatersScene,
    river: RiverScene,
    field: FieldScene,
    fire: FireScene
};

const Scene =
    scenes[
        placeId as keyof typeof scenes
    ];
---

{
    Scene && (
        <Scene />
    )
}
