---
interface Props {
    species?: "saguaro" | "barrel" | "prickly-pear" | "cholla";
    size?: "small" | "medium" | "large";
    flowers?: boolean;
    arms?: number;
    depth?: "background" | "midground" | "foreground";
    opacity?: number;
}

const {
    species = "saguaro",
    size = "medium",
    flowers = false,
    arms = 2,
    depth = "midground",
    opacity = 1
} = Astro.props;

const armCount = Math.max(0, Math.min(4, arms));
---

<div
    class:list={[
        "cactus",
        `cactus--${species}`,
        `cactus--${size}`,
        `cactus--${depth}`
    ]}
    style={`--cactus-opacity: ${opacity};`}
    aria-hidden="true"
>
    {
        species === "saguaro" && (
            <div class="cactus__saguaro">
                <span class="cactus__trunk"></span>

                {
                    Array.from(
                        { length: armCount },
                        (_, index) => (
                            <span
                                class:list={[
                                    "cactus__arm",
                                    index % 2 === 0
                                        ? "cactus__arm--left"
                                        : "cactus__arm--right"
                                ]}
                                style={`
                                    --arm-bottom: ${26 + index * 13}%;
                                    --arm-height: ${28 + ((index * 11) % 22)}%;
                                    --arm-offset: ${14 + ((index * 7) % 9)}%;
                                `}
                            ></span>
                        )
                    )
                }

                {
                    flowers && (
                        <>
                            <span class="cactus__flower cactus__flower--top"></span>
                            <span class="cactus__flower cactus__flower--side"></span>
                        </>
                    )
                }
            </div>
        )
    }

    {
        species === "barrel" && (
            <div class="cactus__barrel">
                {
                    Array.from(
                        { length: 7 },
                        (_, index) => (
                            <span
                                class="cactus__barrel-rib"
                                style={`
                                    --rib-left: ${12 + index * 12.5}%;
                                `}
                            ></span>
                        )
                    )
                }

                {
                    flowers && (
                        <span class="cactus__flower cactus__flower--barrel"></span>
                    )
                }
            </div>
        )
    }

    {
        species === "prickly-pear" && (
            <div class="cactus__prickly-pear">
                {
                    Array.from(
                        { length: 6 },
                        (_, index) => (
                            <span
                                class="cactus__pad"
                                style={`
                                    --pad-left: ${20 + ((index * 23) % 62)}%;
                                    --pad-bottom: ${index < 2
                                        ? 0
                                        : 22 + ((index * 17) % 45)}%;
                                    --pad-rotate: ${-24 + ((index * 19) % 49)}deg;
                                    --pad-scale: ${0.76 + ((index * 7) % 26) / 100};
                                `}
                            >
                                {
                                    flowers &&
                                    index > 2 && (
                                        <span class="cactus__flower cactus__flower--pad"></span>
                                    )
                                }
                            </span>
                        )
                    )
                }
            </div>
        )
    }

    {
        species === "cholla" && (
            <div class="cactus__cholla">
                <span class="cactus__cholla-trunk"></span>

                {
                    Array.from(
                        { length: 8 },
                        (_, index) => (
                            <span
                                class="cactus__cholla-branch"
                                style={`
                                    --branch-left: ${18 + ((index * 19) % 64)}%;
                                    --branch-bottom: ${12 + ((index * 13) % 68)}%;
                                    --branch-rotate: ${-72 + ((index * 31) % 145)}deg;
                                    --branch-length: ${1.7 + ((index * 11) % 23) / 10}rem;
                                `}
                            ></span>
                        )
                    )
                }

                {
                    flowers && (
                        <span class="cactus__flower cactus__flower--cholla"></span>
                    )
                }
            </div>
        )
    }
</div>

<style>
    .cactus {
        position: absolute;
        bottom: 0;
        opacity: var(--cactus-opacity);
        pointer-events: none;
        transform-origin: bottom center;
    }

    .cactus--small {
        width: clamp(3rem, 5vw, 4.5rem);
        height: clamp(5rem, 9vw, 8rem);
    }

    .cactus--medium {
        width: clamp(5rem, 8vw, 7rem);
        height: clamp(8rem, 14vw, 13rem);
    }

    .cactus--large {
        width: clamp(7rem, 12vw, 11rem);
        height: clamp(12rem, 21vw, 19rem);
    }

    .cactus--background {
        filter: blur(0.03rem) saturate(0.82);
        transform: scale(0.82);
    }

    .cactus--midground {
        filter: saturate(0.95);
    }

    .cactus--foreground {
        filter:
            saturate(1.08)
            drop-shadow(
                0 0.4rem 0.45rem
                rgba(20, 35, 20, 0.22)
            );
        transform: scale(1.08);
    }

    .cactus__saguaro,
    .cactus__prickly-pear,
    .cactus__cholla {
        position: absolute;
        inset: 0;
    }

    .cactus__trunk {
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 28%;
        height: 100%;
        transform: translateX(-50%);
        border-radius:
            48% 48% 18% 18% /
            9% 9% 4% 4%;
        background:
            repeating-linear-gradient(
                90deg,
                rgba(42, 93, 59, 0.98) 0 12%,
                rgba(65, 121, 73, 0.98) 12% 24%
            );
        box-shadow:
            inset 0.18rem 0 0.22rem
            rgba(255, 255, 255, 0.08),
            inset -0.2rem 0 0.28rem
            rgba(16, 45, 29, 0.22);
    }

    .cactus__arm {
        position: absolute;
        bottom: var(--arm-bottom);
        width: 18%;
        height: var(--arm-height);
        border-radius: 999px 999px 42% 42%;
        background:
            repeating-linear-gradient(
                90deg,
                rgba(44, 96, 61, 0.98) 0 18%,
                rgba(66, 124, 75, 0.98) 18% 36%
            );
        transform-origin: bottom center;
    }

    .cactus__arm::before {
        content: "";
        position: absolute;
        bottom: 0;
        width: 130%;
        height: 22%;
        border-radius: 999px;
        background: inherit;
    }

    .cactus__arm--left {
        left: calc(50% - var(--arm-offset));
        transform: rotate(-17deg);
    }

    .cactus__arm--left::before {
        right: 65%;
        transform: rotate(18deg);
        transform-origin: right center;
    }

    .cactus__arm--right {
        right: calc(50% - var(--arm-offset));
        transform: rotate(17deg);
    }

    .cactus__arm--right::before {
        left: 65%;
        transform: rotate(-18deg);
        transform-origin: left center;
    }

    .cactus__barrel {
        position: absolute;
        right: 8%;
        bottom: 0;
        left: 8%;
        height: 72%;
        overflow: hidden;
        border-radius:
            48% 48% 34% 34% /
            32% 32% 18% 18%;
        background:
            linear-gradient(
                90deg,
                rgba(39, 91, 55, 0.98),
                rgba(72, 130, 72, 0.98) 50%,
                rgba(34, 78, 49, 0.98)
            );
        box-shadow:
            inset 0.26rem 0 0.3rem
            rgba(255, 255, 255, 0.07),
            inset -0.28rem 0 0.34rem
            rgba(13, 42, 26, 0.25);
    }

    .cactus__barrel-rib {
        position: absolute;
        top: 2%;
        bottom: 0;
        left: var(--rib-left);
        width: 2px;
        transform: translateX(-50%);
        border-radius: 999px;
        background:
            linear-gradient(
                180deg,
                rgba(127, 170, 101, 0.45),
                rgba(20, 59, 34, 0.3)
            );
    }

    .cactus__pad {
        position: absolute;
        left: var(--pad-left);
        bottom: var(--pad-bottom);
        width: 34%;
        height: 42%;
        transform:
            translateX(-50%)
            rotate(var(--pad-rotate))
            scale(var(--pad-scale));
        transform-origin: bottom center;
        border-radius:
            48% 52% 45% 55% /
            42% 44% 56% 58%;
        background:
            radial-gradient(
                circle at 32% 28%,
                rgba(117, 154, 90, 0.96),
                rgba(56, 111, 69, 0.98) 58%,
                rgba(34, 78, 51, 0.98)
            );
        box-shadow:
            inset -0.16rem -0.12rem 0.22rem
            rgba(14, 45, 29, 0.23);
    }

    .cactus__pad::before {
        content: "";
        position: absolute;
        inset: 8%;
        border-radius: inherit;
        opacity: 0.45;
        background:
            radial-gradient(
                circle,
                rgba(230, 226, 183, 0.86) 0 1px,
                transparent 1.4px
            );
        background-size: 0.62rem 0.62rem;
    }

    .cactus__cholla-trunk {
        position: absolute;
        bottom: 0;
        left: 48%;
        width: 14%;
        height: 78%;
        transform: translateX(-50%);
        border-radius: 999px;
        background:
            linear-gradient(
                90deg,
                rgba(63, 94, 47, 0.98),
                rgba(99, 126, 61, 0.98),
                rgba(51, 78, 42, 0.98)
            );
    }

    .cactus__cholla-branch {
        position: absolute;
        left: var(--branch-left);
        bottom: var(--branch-bottom);
        width: var(--branch-length);
        height: 0.6rem;
        transform:
            translateX(-50%)
            rotate(var(--branch-rotate));
        transform-origin: left center;
        border-radius: 999px;
        background:
            linear-gradient(
                180deg,
                rgba(105, 131, 69, 0.98),
                rgba(57, 84, 45, 0.98)
            );
        box-shadow:
            0 0 0.18rem
            rgba(222, 215, 165, 0.28);
    }

    .cactus__flower {
        position: absolute;
        width: 0.72rem;
        height: 0.72rem;
        border-radius: 50%;
        background:
            radial-gradient(
                circle at 45% 42%,
                rgba(255, 222, 98, 0.98) 0 22%,
                rgba(220, 91, 108, 0.98) 24% 62%,
                rgba(139, 47, 73, 0.98) 64%
            );
        box-shadow:
            0 0 0.2rem
            rgba(230, 115, 128, 0.34);
    }

    .cactus__flower--top {
        top: -0.3rem;
        left: 50%;
        transform: translateX(-50%);
    }

    .cactus__flower--side {
        top: 32%;
        right: 15%;
    }

    .cactus__flower--barrel {
        top: 3%;
        left: 50%;
        transform: translateX(-50%);
    }

    .cactus__flower--pad {
        top: -0.3rem;
        left: 50%;
        transform: translateX(-50%);
    }

    .cactus__flower--cholla {
        top: 17%;
        right: 12%;
    }

    @media (max-width: 48rem) {
        .cactus--foreground {
            transform: scale(1);
        }
    }
</style>
