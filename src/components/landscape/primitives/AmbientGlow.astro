---
interface Props {
    position?: "left" | "center" | "right";
    size?: "small" | "medium" | "large";
    intensity?: "soft" | "medium" | "strong";
    duration?: string;
}

const {
    position = "right",
    size = "large",
    intensity = "soft",
    duration = "15s"
} = Astro.props;
---

<div
    class:list={[
        "ambient-glow",
        `ambient-glow--${position}`,
        `ambient-glow--${size}`,
        `ambient-glow--${intensity}`
    ]}
    style={`--ambient-glow-duration: ${duration};`}
></div>

<style>
    .ambient-glow {
        position: absolute;
        top: 4%;
        aspect-ratio: 1;
        border-radius: 50%;
        filter: blur(0.75rem);
        animation:
            ambient-glow-breathe
            var(--ambient-glow-duration)
            var(--ease-breath, ease-in-out)
            infinite alternate;
    }

    .ambient-glow--left {
        left: 9%;
    }

    .ambient-glow--center {
        left: 50%;
        transform: translateX(-50%);
    }

    .ambient-glow--right {
        right: 9%;
    }

    .ambient-glow--small {
        width: clamp(10rem, 20vw, 20rem);
    }

    .ambient-glow--medium {
        width: clamp(13rem, 25vw, 25rem);
    }

    .ambient-glow--large {
        width: clamp(16rem, 31vw, 31rem);
    }

    .ambient-glow--soft {
        background:
            radial-gradient(
                circle,
                rgba(238, 239, 211, 0.12) 0%,
                rgba(210, 218, 180, 0.05) 42%,
                transparent 72%
            );
    }

    .ambient-glow--medium {
        background:
            radial-gradient(
                circle,
                rgba(241, 238, 202, 0.17) 0%,
                rgba(214, 206, 164, 0.07) 44%,
                transparent 73%
            );
    }

    .ambient-glow--strong {
        background:
            radial-gradient(
                circle,
                rgba(246, 237, 190, 0.22) 0%,
                rgba(222, 193, 132, 0.09) 45%,
                transparent 74%
            );
    }

    @keyframes ambient-glow-breathe {
        from {
            opacity: 0.62;
            scale: 0.95;
        }

        to {
            opacity: 1;
            scale: 1.06;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .ambient-glow {
            animation: none;
        }
    }
</style>
