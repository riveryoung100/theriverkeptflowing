---
interface Props {
    width?: "narrow" | "medium" | "wide";
    length?: "short" | "medium" | "long";
    tone?: "earth" | "stone" | "sand";
    opacity?: number;
}

const {
    width = "medium",
    length = "long",
    tone = "earth",
    opacity = 1
} = Astro.props;
---

<div
    class:list={[
        "ground-path",
        `ground-path--${width}`,
        `ground-path--${length}`,
        `ground-path--${tone}`
    ]}
    style={`--ground-path-opacity: ${opacity};`}
    aria-hidden="true"
></div>

<style>
    .ground-path {
        position: absolute;
        bottom: -6%;
        left: 50%;
        transform:
            translateX(-50%)
            perspective(32rem)
            rotateX(8deg);
        transform-origin: bottom center;
        opacity: var(--ground-path-opacity);
        clip-path:
            polygon(
                48% 0,
                52% 0,
                80% 100%,
                18% 100%
            );
    }

    .ground-path--narrow {
        width: 22%;
    }

    .ground-path--medium {
        width: 33%;
    }

    .ground-path--wide {
        width: 46%;
    }

    .ground-path--short {
        height: 34%;
    }

    .ground-path--medium {
        height: 43%;
    }

    .ground-path--long {
        height: 53%;
    }

    .ground-path--earth {
        background:
            linear-gradient(
                180deg,
                rgba(190, 166, 115, 0.18),
                rgba(139, 112, 74, 0.4) 52%,
                rgba(89, 69, 45, 0.66)
            );
    }

    .ground-path--stone {
        background:
            linear-gradient(
                180deg,
                rgba(177, 178, 165, 0.16),
                rgba(116, 119, 110, 0.44) 52%,
                rgba(67, 72, 68, 0.72)
            );
    }

    .ground-path--sand {
        background:
            linear-gradient(
                180deg,
                rgba(220, 198, 148, 0.18),
                rgba(184, 151, 96, 0.44) 52%,
                rgba(126, 94, 57, 0.68)
            );
    }

    @media (max-width: 48rem) {
        .ground-path--narrow {
            width: 34%;
        }

        .ground-path--medium {
            width: 48%;
        }

        .ground-path--wide {
            width: 62%;
        }

        .ground-path--long {
            height: 46%;
        }
    }
</style>
