---
interface Props {
    size?: "small" | "medium" | "large";
    depth?: "far" | "middle" | "near";
    fruitCount?: number;
    fruitColor?: "orange" | "red" | "gold";
    swayDuration?: string;
    animationDelay?: string;
}

const {
    size = "medium",
    depth = "near",
    fruitCount = 0,
    fruitColor = "orange",
    swayDuration = "9s",
    animationDelay = "0s"
} = Astro.props;
---

<div
    class:list={[
        "landscape-tree",
        `landscape-tree--${size}`,
        `landscape-tree--${depth}`,
        `landscape-tree--fruit-${fruitColor}`
    ]}
    style={`
        --tree-sway-duration: ${swayDuration};
        --tree-animation-delay: ${animationDelay};
    `}
    aria-hidden="true"
>
    <span class="landscape-tree__trunk"></span>

    <span
        class="
            landscape-tree__canopy
            landscape-tree__canopy--one
        "
    ></span>

    <span
        class="
            landscape-tree__canopy
            landscape-tree__canopy--two
        "
    ></span>

    <span
        class="
            landscape-tree__canopy
            landscape-tree__canopy--three
        "
    ></span>

    {
        Array.from(
            { length: fruitCount },
            (_, index) => (
                <span
                    class="landscape-tree__fruit"
                    style={`
                        --fruit-left: ${
                            18 +
                            ((index * 19) % 64)
                        }%;

                        --fruit-top: ${
                            14 +
                            ((index * 23) % 52)
                        }%;

                        --fruit-scale: ${
                            0.78 +
                            ((index * 7) % 5) * 0.06
                        };
                    `}
                ></span>
            )
        )
    }
</div>

<style>
    .landscape-tree {
        position: relative;
        flex: 0 0 auto;
        transform-origin: bottom center;
        animation:
            landscape-tree-sway
            var(--tree-sway-duration)
            ease-in-out
            infinite
            alternate;
        animation-delay: var(--tree-animation-delay);
    }

    .landscape-tree--small {
        width: clamp(4rem, 8vw, 7rem);
        height: clamp(6rem, 12vw, 10rem);
    }

    .landscape-tree--medium {
        width: clamp(6rem, 12vw, 10rem);
        height: clamp(9rem, 19vw, 15rem);
    }

    .landscape-tree--large {
        width: clamp(8rem, 16vw, 13rem);
        height: clamp(12rem, 24vw, 19rem);
    }

    .landscape-tree--far {
        opacity: 0.58;
        filter: saturate(0.76);
    }

    .landscape-tree--middle {
        opacity: 0.8;
        filter: saturate(0.9);
    }

    .landscape-tree--near {
        opacity: 1;
    }

    .landscape-tree__trunk {
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 11%;
        height: 58%;
        border-radius:
            55% 45%
            18% 20%;
        transform: translateX(-50%);
        background:
            linear-gradient(
                90deg,
                rgba(76, 54, 36, 0.98),
                rgba(122, 82, 48, 0.94),
                rgba(65, 47, 34, 0.98)
            );
        box-shadow:
            inset -0.18rem 0 0.3rem
            rgba(35, 28, 22, 0.26);
    }

    .landscape-tree__canopy {
        position: absolute;
        border-radius: 50%;
        background:
            radial-gradient(
                circle at 35% 30%,
                rgba(112, 145, 76, 0.98),
                rgba(62, 103, 58, 0.98) 58%,
                rgba(41, 75, 47, 0.98)
            );
        box-shadow:
            inset 0 -0.7rem 1.2rem
            rgba(30, 57, 37, 0.26);
    }

    .landscape-tree__canopy--one {
        top: 8%;
        left: 10%;
        width: 62%;
        height: 48%;
    }

    .landscape-tree__canopy--two {
        top: 3%;
        right: 7%;
        width: 60%;
        height: 52%;
    }

    .landscape-tree__canopy--three {
        top: 23%;
        left: 23%;
        width: 58%;
        height: 42%;
    }

    .landscape-tree__fruit {
        position: absolute;
        z-index: 2;
        top: var(--fruit-top);
        left: var(--fruit-left);
        width: clamp(0.32rem, 0.7vw, 0.58rem);
        aspect-ratio: 1;
        border-radius: 50%;
        scale: var(--fruit-scale);
        box-shadow:
            0 0.12rem 0.2rem
            rgba(44, 45, 24, 0.3);
    }

    .landscape-tree--fruit-orange
    .landscape-tree__fruit {
        background:
            radial-gradient(
                circle at 35% 30%,
                rgba(224, 157, 74, 0.98),
                rgba(169, 88, 45, 0.96)
            );
    }

    .landscape-tree--fruit-red
    .landscape-tree__fruit {
        background:
            radial-gradient(
                circle at 35% 30%,
                rgba(221, 113, 83, 0.98),
                rgba(139, 56, 45, 0.96)
            );
    }

    .landscape-tree--fruit-gold
    .landscape-tree__fruit {
        background:
            radial-gradient(
                circle at 35% 30%,
                rgba(233, 188, 86, 0.98),
                rgba(174, 116, 42, 0.96)
            );
    }

    @keyframes landscape-tree-sway {
        from {
            rotate: -0.8deg;
            translate: -0.08rem 0;
        }

        to {
            rotate: 1.3deg;
            translate: 0.12rem 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .landscape-tree {
            animation: none;
        }
    }
</style>
