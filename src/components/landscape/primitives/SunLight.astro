---
interface Props {
    position?: "left" | "center" | "right";
    size?: "small" | "medium" | "large";
    intensity?: "soft" | "medium" | "bright";
    pulseDuration?: string;
}

const {
    position = "right",
    size = "medium",
    intensity = "soft",
    pulseDuration = "18s"
} = Astro.props;
---

<div
    class:list={[
        "sun-light",
        `sun-light--${position}`,
        `sun-light--${size}`,
        `sun-light--${intensity}`
    ]}
    style={`--sun-pulse-duration: ${pulseDuration};`}
    aria-hidden="true"
>
    <span class="sun-light__disc"></span>
    <span class="sun-light__halo"></span>
    <span class="sun-light__ray sun-light__ray--one"></span>
    <span class="sun-light__ray sun-light__ray--two"></span>
    <span class="sun-light__ray sun-light__ray--three"></span>
</div>

<style>
    .sun-light {
        position: absolute;
        top: 8%;
        width: 14rem;
        aspect-ratio: 1;
        pointer-events: none;
        animation:
            sun-light-breathe
            var(--sun-pulse-duration)
            ease-in-out
            infinite
            alternate;
    }

    .sun-light--left {
        left: 7%;
    }

    .sun-light--center {
        left: 50%;
        transform: translateX(-50%);
    }

    .sun-light--right {
        right: 7%;
    }

    .sun-light--small {
        width: clamp(7rem, 13vw, 10rem);
    }

    .sun-light--medium {
        width: clamp(10rem, 18vw, 14rem);
    }

    .sun-light--large {
        width: clamp(13rem, 23vw, 19rem);
    }

    .sun-light--soft {
        opacity: 0.48;
    }

    .sun-light--medium {
        opacity: 0.68;
    }

    .sun-light--bright {
        opacity: 0.88;
    }

    .sun-light__disc {
        position: absolute;
        top: 31%;
        left: 31%;
        width: 38%;
        aspect-ratio: 1;
        border-radius: 50%;
        background:
            radial-gradient(
                circle at 42% 38%,
                rgba(255, 247, 199, 0.98),
                rgba(235, 200, 113, 0.84) 58%,
                rgba(219, 165, 78, 0.18)
            );
        box-shadow:
            0 0 1.8rem rgba(242, 206, 123, 0.42);
    }

    .sun-light__halo {
        position: absolute;
        inset: 10%;
        border-radius: 50%;
        background:
            radial-gradient(
                circle,
                rgba(246, 219, 148, 0.32),
                rgba(236, 202, 119, 0.12) 46%,
                transparent 72%
            );
        filter: blur(0.5rem);
    }

    .sun-light__ray {
        position: absolute;
        top: 48%;
        left: 50%;
        width: 150%;
        height: 0.22rem;
        transform-origin: left center;
        border-radius: 999px;
        background:
            linear-gradient(
                90deg,
                rgba(246, 221, 156, 0.28),
                transparent 72%
            );
        filter: blur(0.12rem);
    }

    .sun-light__ray--one {
        rotate: 14deg;
    }

    .sun-light__ray--two {
        rotate: 36deg;
        opacity: 0.72;
    }

    .sun-light__ray--three {
        rotate: 58deg;
        opacity: 0.46;
    }

    @keyframes sun-light-breathe {
        from {
            scale: 0.98;
        }

        to {
            scale: 1.03;
        }
    }

    @media (max-width: 48rem) {
        .sun-light {
            top: 11%;
        }

        .sun-light--left {
            left: -1%;
        }

        .sun-light--right {
            right: -1%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .sun-light {
            animation: none;
        }
    }
</style>
