---
interface Props {
    depth?: "far" | "middle" | "near";
    variant?: "headwaters" | "river";
}

const {
    depth = "middle",
    variant = "headwaters"
} = Astro.props;

const classes = [
    "mountain-range",
    `mountain-range--${variant}`,
    `mountain-range--${variant}-${depth}`
];
---

<div class={classes.join(" ")}></div>

<style>
    .mountain-range {
        position: absolute;
        right: -8%;
        left: -8%;
        transform-origin: bottom center;
    }

    /*
     * Headwaters
     */

    .mountain-range--headwaters-far {
        bottom: 35%;
        height: 45%;
        opacity: 0.25;
        background: #58736f;
        clip-path:
            polygon(
                0 78%,
                8% 61%,
                17% 68%,
                29% 35%,
                38% 57%,
                49% 20%,
                57% 46%,
                68% 27%,
                78% 55%,
                88% 38%,
                100% 67%,
                100% 100%,
                0 100%
            );
        filter: blur(0.15rem);
    }

    .mountain-range--headwaters-middle {
        bottom: 25%;
        height: 42%;
        opacity: 0.39;
        background: #344f49;
        clip-path:
            polygon(
                0 71%,
                12% 43%,
                20% 56%,
                32% 23%,
                45% 62%,
                57% 31%,
                67% 55%,
                79% 20%,
                90% 58%,
                100% 43%,
                100% 100%,
                0 100%
            );
    }

    .mountain-range--headwaters-near {
        bottom: 14%;
        height: 37%;
        opacity: 0.62;
        background: #203a34;
        clip-path:
            polygon(
                0 58%,
                11% 32%,
                24% 61%,
                37% 25%,
                49% 67%,
                63% 37%,
                76% 62%,
                89% 31%,
                100% 54%,
                100% 100%,
                0 100%
            );
    }

    /*
     * River
     */

    .mountain-range--river-far {
        bottom: 34%;
        height: 30%;
        opacity: 0.27;
        background: #526d67;
        clip-path:
            polygon(
                0 72%,
                14% 49%,
                27% 64%,
                42% 38%,
                56% 60%,
                70% 34%,
                84% 56%,
                100% 42%,
                100% 100%,
                0 100%
            );
        filter: blur(0.12rem);
    }

    .mountain-range--river-middle {
        bottom: 23%;
        height: 27%;
        opacity: 0.5;
        background: #29443e;
        clip-path:
            polygon(
                0 61%,
                16% 35%,
                31% 58%,
                47% 27%,
                61% 64%,
                76% 40%,
                89% 59%,
                100% 39%,
                100% 100%,
                0 100%
            );
    }

    /*
     * River currently uses only far and middle ridges.
     * Hide an accidental near layer rather than displaying
     * the Headwaters near mountain.
     */

    .mountain-range--river-near {
        display: none;
    }

    @media (max-width: 48rem) {
        .mountain-range--headwaters-far {
            bottom: 39%;
        }

        .mountain-range--headwaters-middle {
            bottom: 31%;
        }

        .mountain-range--headwaters-near {
            bottom: 23%;
        }

        .mountain-range--river-far {
            bottom: 40%;
        }

        .mountain-range--river-middle {
            bottom: 30%;
        }
    }
</style>
