---
interface Props {
    animate?: boolean;
    variant?: "headwaters" | "river";
}

const {
    animate = true,
    variant = "headwaters"
} = Astro.props;

const isRiver = variant === "river";
---

<div
    class:list={[
        "terrain-foreground",
        `terrain-foreground--${variant}`,
        {
            "terrain-foreground--static": !animate
        }
    ]}
>

    {
        isRiver ? (
            <>
                <div class="terrain-foreground__bank terrain-foreground__bank--left"></div>

                <div class="terrain-foreground__bank terrain-foreground__bank--right"></div>

                <div class="terrain-foreground__reeds terrain-foreground__reeds--left"></div>

                <div class="terrain-foreground__reeds terrain-foreground__reeds--right"></div>
            </>
        ) : (
            <>
                <div class="terrain-foreground__left-bank"></div>

                <div class="terrain-foreground__right-bank"></div>

                <div class="terrain-foreground__rock terrain-foreground__rock--left"></div>

                <div class="terrain-foreground__rock terrain-foreground__rock--right"></div>

                <div class="terrain-foreground__grass terrain-foreground__grass--left"></div>

                <div class="terrain-foreground__grass terrain-foreground__grass--center"></div>

                <div class="terrain-foreground__grass terrain-foreground__grass--right"></div>
            </>
        )
    }

</div>

<style>
    .terrain-foreground{
        position:absolute;
        inset:0;
    }

    /* ---------- Headwaters ---------- */

    .terrain-foreground__left-bank,
    .terrain-foreground__right-bank{
        position:absolute;
        bottom:-6%;
        width:52%;
        height:42%;
        background:
            linear-gradient(
                180deg,
                rgba(44,69,52,.72),
                rgba(19,35,27,.96)
            );
    }

    .terrain-foreground__left-bank{
        left:-12%;
        clip-path:polygon(0 10%,56% 24%,78% 47%,100% 100%,0 100%);
    }

    .terrain-foreground__right-bank{
        right:-12%;
        clip-path:polygon(44% 25%,100% 12%,100% 100%,0 100%,23% 46%);
    }

    .terrain-foreground__rock{
        position:absolute;
        bottom:8%;
        width:clamp(4rem,8vw,8rem);
        aspect-ratio:1.3;
        border-radius:46% 54% 42% 58%;
        background:#596c62;
        opacity:.55;
    }

    .terrain-foreground__rock--left{
        left:13%;
    }

    .terrain-foreground__rock--right{
        right:15%;
    }

    .terrain-foreground__grass{
        position:absolute;
        bottom:4%;
        width:clamp(5rem,11vw,9rem);
        height:clamp(5rem,10vw,8rem);
        opacity:.72;
        background:
            repeating-linear-gradient(
                80deg,
                transparent 0 .7rem,
                rgba(126,154,103,.7) .75rem .9rem,
                transparent 1rem 1.55rem
            );
        transform-origin:bottom center;
        animation:grass-sway 7s var(--ease-breath) infinite alternate;
    }

    .terrain-foreground__grass--left{left:4%;}
    .terrain-foreground__grass--center{left:46%;}
    .terrain-foreground__grass--right{right:5%;}

    /* ---------- River ---------- */

    .terrain-foreground__bank{
        position:absolute;
        bottom:-7%;
        width:55%;
        height:40%;
        background:
            linear-gradient(
                180deg,
                rgba(46,70,52,.74),
                rgba(18,34,25,.96)
            );
    }

    .terrain-foreground__bank--left{
        left:-12%;
        clip-path:polygon(0 13%,58% 27%,77% 48%,100% 100%,0 100%);
    }

    .terrain-foreground__bank--right{
        right:-12%;
        clip-path:polygon(42% 27%,100% 13%,100% 100%,0 100%,24% 49%);
    }

    .terrain-foreground__reeds{
        position:absolute;
        bottom:3%;
        width:clamp(5rem,12vw,10rem);
        height:clamp(7rem,15vw,13rem);
        opacity:.72;
        background:
            repeating-linear-gradient(
                78deg,
                transparent 0 .7rem,
                rgba(121,148,101,.7) .75rem .93rem,
                transparent .98rem 1.55rem
            );
        transform-origin:bottom center;
        animation:grass-sway 7s var(--ease-breath) infinite alternate;
    }

    .terrain-foreground__reeds--left{
        left:4%;
    }

    .terrain-foreground__reeds--right{
        right:4%;
        animation-delay:-3s;
    }

    .terrain-foreground--static
    .terrain-foreground__grass,
    .terrain-foreground--static
    .terrain-foreground__reeds{
        animation:none;
    }

    @keyframes grass-sway{
        from{transform:rotate(-2deg);}
        to{transform:rotate(3deg);}
    }

    @media(max-width:48rem){

        .terrain-foreground__bank{
            height:31%;
        }

        .terrain-foreground__reeds{
            opacity:.55;
        }
    }

    @media(prefers-reduced-motion:reduce){

        .terrain-foreground__grass,
        .terrain-foreground__reeds{
            animation:none;
        }

    }
</style>
