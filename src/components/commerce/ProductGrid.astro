---
import ProductCard from "./ProductCard.astro";

interface Item {
    title:string;
    description:string;
    action:string;
    href:string;
    type?:string;
}

interface Props {
    items:Item[];
}

const {
    items
}=Astro.props;
---

<div class="product-grid">

{
    items.map((item)=>(
        
        <ProductCard
            title={item.title}
            description={item.description}
            action={item.action}
            href={item.href}
            type={item.type}
        />

    ))
}

</div>