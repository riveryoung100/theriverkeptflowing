---
import SectionHeader from "../shared/SectionHeader.astro";
---

<section class="paths-section">

    <div class="section-shell">


        <SectionHeader
            label="Explore"
            title="Find your place in the river."
            description="Begin with the story, follow what is being learned today, or explore the ideas and resources shaping the journey."
        />


        <div class="path-grid">

            <a
                href="/headwaters/"
                class="path-card path-card-featured"
            >

                <span class="card-number">
                    01
                </span>

                <h3>
                    Headwaters
                </h3>

                <p>
                    The mission, convictions, and foundation beneath everything
                    being built here.
                </p>

                <span class="card-link">
                    Begin here &rarr;
                </span>

            </a>


            <a
                href="/source/"
                class="path-card"
            >

                <span class="card-number">
                    02
                </span>

                <h3>
                    The Source
                </h3>

                <p>
                    The people, experiences, failures, victories, and turning
                    points that shaped the river.
                </p>

                <span class="card-link">
                    Read the story &rarr;
                </span>

            </a>


            <a
                href="/current/"
                class="path-card"
            >

                <span class="card-number">
                    03
                </span>

                <h3>
                    The Current
                </h3>

                <p>
                    Present reflections, lessons, questions, and ideas from the
                    season unfolding now.
                </p>

                <span class="card-link">
                    See what is current &rarr;
                </span>

            </a>


            <a
                href="/journey/"
                class="path-card"
            >

                <span class="card-number">
                    04
                </span>

                <h3>
                    The Journey
                </h3>

                <p>
                    Videos, conversations, milestones, and documentation of the
                    river as it continues forward.
                </p>

                <span class="card-link">
                    Follow the journey &rarr;
                </span>

            </a>


            <a
                href="/letters-from-the-river/"
                class="path-card"
            >

                <span class="card-number">
                    05
                </span>

                <h3>
                    Letters From the River
                </h3>

                <p>
                    Words preserved for family, future generations, and anyone
                    walking through similar waters.
                </p>

                <span class="card-link">
                    Read the letters &rarr;
                </span>

            </a>


            <a
                href="/river-guides/"
                class="path-card"
            >

                <span class="card-number">
                    06
                </span>

                <h3>
                    River Guides
                </h3>

                <p>
                    Books, tools, systems, resources, and recommendations that
                    have proven useful along the way.
                </p>

                <span class="card-link">
                    Explore resources &rarr;
                </span>

            </a>


        </div>


    </div>

</section>