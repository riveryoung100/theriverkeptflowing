---
import SectionHeader from "../shared/SectionHeader.astro";
---

<section class="mission-section">

    <div class="section-shell">


        <SectionHeader
            label="The Mission"
            title="Pursue truth. Cultivate wisdom. Steward life well."
            description="The River Kept Flowing exists to help people build lives of substance and leave behind something that outlives them."
        />


        <div class="mission-grid">

            <article>

                <span class="card-number">
                    01
                </span>

                <h3>
                    Story
                </h3>

                <p>
                    Where we have been and what shaped us.
                </p>

            </article>


            <article>

                <span class="card-number">
                    02
                </span>

                <h3>
                    Wisdom
                </h3>

                <p>
                    What experience, study, failure, and faith have taught us.
                </p>

            </article>


            <article>

                <span class="card-number">
                    03
                </span>

                <h3>
                    Stewardship
                </h3>

                <p>
                    How we care for our families, bodies, work, gifts,
                    and resources.
                </p>

            </article>


            <article>

                <span class="card-number">
                    04
                </span>

                <h3>
                    Service
                </h3>

                <p>
                    How what we have been given becomes useful to others.
                </p>

            </article>


        </div>


    </div>

</section>