---
import SectionHeader from "../shared/SectionHeader.astro";
---

<section class="tributaries-section">

    <div class="section-shell">


        <SectionHeader
            label="The Tributaries"
            title="A meaningful life is fed by many streams."
            description="These are the disciplines and responsibilities continually shaping the work."
        />


        <div class="tributary-grid">

            <article class="home-tributary-card">

                <h3>
                    Faith
                </h3>

                <p>
                    Seeking God, truth, purpose, wisdom, and obedience
                    in ordinary life.
                </p>

            </article>


            <article class="home-tributary-card">

                <h3>
                    Family and Legacy
                </h3>

                <p>
                    Marriage, fatherhood, relationships, forgiveness,
                    presence, and what we pass forward.
                </p>

            </article>


            <article class="home-tributary-card">

                <h3>
                    Growth and Wisdom
                </h3>

                <p>
                    Learning, philosophy, communication, leadership,
                    discipline, and understanding people.
                </p>

            </article>


            <article class="home-tributary-card">

                <h3>
                    Stewardship
                </h3>

                <p>
                    Health, finances, work, energy, resources, and caring
                    well for what has been entrusted to us.
                </p>

            </article>


            <article class="home-tributary-card">

                <h3>
                    Creation
                </h3>

                <p>
                    Writing, storytelling, technology, food, craftsmanship,
                    and bringing worthy ideas into reality.
                </p>

            </article>


            <article class="home-tributary-card">

                <h3>
                    Service
                </h3>

                <p>
                    Feeding people, strengthening communities, sharing
                    knowledge, and making what we build useful.
                </p>

            </article>


        </div>


    </div>

</section>