<section class="invitation-section">

    <div class="section-shell invitation-layout">

        <div class="invitation-content">

            <p class="section-label light-label">
                Walk with the river
            </p>


            <h2>
                The journey is still being written.
            </h2>


            <p>
                Receive new writing, videos, practical resources, and the next
                things being built as the River continues to grow.
            </p>

        </div>


        <form class="join-form" method="post">

            <label class="sr-only" for="join-name">
                Your name
            </label>

            <input
                id="join-name"
                type="text"
                name="name"
                placeholder="Your name"
                autocomplete="name" required
            >


            <label class="sr-only" for="join-email">
                Your email address
            </label>

            <input
                id="join-email"
                type="email"
                name="email"
                placeholder="Your email address"
                autocomplete="email" required
            >


            <button type="submit">
                Join the Current
            </button>

        </form>

    </div>

</section>