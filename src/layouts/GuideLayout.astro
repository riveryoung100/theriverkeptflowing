---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description: string;
    author?: string;
    stylesheet?: string;
    bodyClass?: string;
    canonical?: string;
    articleTitle?: string;
    articleDescription?: string;
    published?: string;
    modified?: string;
    articleSection?: string;
    version?: string;
}

const {
    title,
    description,
    author = "River Young",
    stylesheet,
    bodyClass = "handbook-page",
    canonical,
    articleTitle = title,
    articleDescription = description,
    published,
    modified,
    articleSection = "River Guides",
    version = "1.0"
} = Astro.props;

const siteOrigin = "https://theriverkeptflowing.com";

const resolvedCanonical =
    canonical ??
    new URL(
        Astro.url.pathname,
        siteOrigin
    ).toString();

const articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: articleTitle,
    description: articleDescription,
    author: {
        "@type": "Person",
        name: author
    },
    publisher: {
        "@type": "Organization",
        name: "The River Kept Flowing",
        url: `${siteOrigin}/`
    },
    datePublished: published,
    dateModified: modified ?? published,
    mainEntityOfPage: resolvedCanonical,
    articleSection,
    version
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${siteOrigin}/`
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "River Guides",
            item: `${siteOrigin}/river-guides/`
        },
        {
            "@type": "ListItem",
            position: 3,
            name: articleTitle,
            item: resolvedCanonical
        }
    ]
};
---

<!DOCTYPE html>

<html lang="en">

    <head>

        <meta charset="UTF-8">

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        >

        <title>{title}</title>

        <meta
            name="description"
            content={description}
        >

        <meta
            name="author"
            content={author}
        >

        <meta
            name="robots"
            content="index, follow"
        >

        <link
            rel="canonical"
            href={resolvedCanonical}
        >

        <meta
            property="og:type"
            content="article"
        >

        <meta
            property="og:title"
            content={articleTitle}
        >

        <meta
            property="og:description"
            content={articleDescription}
        >

        <meta
            property="og:url"
            content={resolvedCanonical}
        >

        <meta
            property="og:site_name"
            content="The River Kept Flowing"
        >

        <meta
            name="twitter:card"
            content="summary_large_image"
        >

        <meta
            name="twitter:title"
            content={articleTitle}
        >

        <meta
            name="twitter:description"
            content={articleDescription}
        >

        <link
            rel="stylesheet"
            href="/styles.css"
        >

        {
            stylesheet && (
                <link
                    rel="stylesheet"
                    href={stylesheet}
                />
            )
        }

        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(articleSchema)}
        ></script>

        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(breadcrumbSchema)}
        ></script>

    </head>


    <body class={bodyClass}>

        <div
            class="reading-progress"
            aria-hidden="true"
        >
            <div class="reading-progress__bar"></div>
        </div>

        <a
            class="skip-link"
            href="#main-content"
        >
            Skip to the handbook
        </a>

        <Navbar />

        <slot name="cover" />

        <main data-pagefind-body id="main-content">

            <slot />

        </main>

        <Footer />

        <script
            is:inline
            src="/script.js"
        ></script>

    </body>

</html>