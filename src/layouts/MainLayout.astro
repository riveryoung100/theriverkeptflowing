---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
    author?: string;
    stylesheet?: string;
    bodyClass?: string;
    canonical?: string;
    image?: string;
    noindex?: boolean;
}

const {
    title = "The River Kept Flowing",
    description = "A living archive of faith, family, stewardship, perseverance, creativity, and the lifelong work of becoming.",
    author = "River Young",
    stylesheet,
    bodyClass = "",
    canonical,
    image = "/social-preview.jpg",
    noindex = false
} = Astro.props;

const siteOrigin = "https://theriverkeptflowing.com";

const resolvedCanonical =
    canonical ??
    new URL(
        Astro.url.pathname,
        siteOrigin
    ).toString();

const resolvedImage = new URL(
    image,
    siteOrigin
).toString();
const isHomepage =
    Astro.url.pathname === "/";

const websiteSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteOrigin}/#website`,
    url: `${siteOrigin}/`,
    name: "The River Kept Flowing",
    description:
        "A living public knowledge ecosystem for helping people build, protect, steward, and live a meaningful life.",
    inLanguage: "en-US"
};
---

<!DOCTYPE html>

<html lang="en">

    <head>

        <meta charset="UTF-8">

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        >

        <title>{title}</title>

        <meta
            name="description"
            content={description}
        >

        <meta
            name="author"
            content={author}
        >

        <link
            rel="canonical"
            href={resolvedCanonical}
        >

        {
            noindex && (
                <meta
                    name="robots"
                    content="noindex, nofollow"
                >
            )
        }

        <meta
            property="og:type"
            content="website"
        >

        <meta
            property="og:site_name"
            content="The River Kept Flowing"
        >

        <meta
            property="og:title"
            content={title}
        >

        <meta
            property="og:description"
            content={description}
        >

        <meta
            property="og:url"
            content={resolvedCanonical}
        >

        <meta
            property="og:image"
            content={resolvedImage}
        >

        <meta
            name="twitter:card"
            content="summary_large_image"
        >

        <meta
            name="twitter:title"
            content={title}
        >

        <meta
            name="twitter:description"
            content={description}
        >

        <meta
            name="twitter:image"
            content={resolvedImage}
        >
        {
            isHomepage && (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(websiteSchema)}
                />
            )
        }

        <script
            is:inline
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-KFMXEZR98E"
        ></script>

        <script is:inline>
            window.dataLayer = window.dataLayer || [];

            function gtag() {
                window.dataLayer.push(arguments);
            }

            gtag("js", new Date());
            gtag("config", "G-KFMXEZR98E");
        </script>

        <link
            rel="stylesheet"
            href="/styles.css"
        >

        {stylesheet && <link rel="stylesheet" href={stylesheet} />}

    </head>


    <body class={bodyClass}>

        <Navbar />

        <slot />

        <Footer />

        <script
            is:inline
            src="/script.js"
        ></script>

    </body>

</html>