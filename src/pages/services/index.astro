---
import MainLayout from "../../layouts/MainLayout.astro";
import ServiceGrid from "../../components/services/ServiceGrid.astro";

const services = [

{
title:"Coaching and Mentorship",
description:
"Personal guidance focused on growth, discipline, stewardship, and intentional living.",
action:"Learn more",
href:"/contribute/#services",
type:"Coaching"
},

{
title:"Digital Foundations",
description:
"Website development, digital systems, and online foundations for people building something meaningful.",
action:"Work together",
href:"/contribute/#services",
type:"Digital"
},

{
title:"Education and Consulting",
description:
"Practical knowledge built from experience in sales, insurance, business, and personal development.",
action:"Explore",
href:"/contribute/#services",
type:"Consulting"
}

];
---

<MainLayout
title="Services | The River Kept Flowing"
description="Services and guidance offered through The River Kept Flowing."
>

<main data-pagefind-body class="library-page">

<section class="library-hero">

<div class="library-shell">

<p class="section-label">
Services
</p>

<h1>
Helping people build what matters.
</h1>

<p>
Experience, lessons, and systems transformed into practical help.
</p>

</div>

</section>


<section class="library-section">

<div class="library-shell">

<ServiceGrid items={services} headingLevel={2} />

</div>

</section>

</main>

</MainLayout>