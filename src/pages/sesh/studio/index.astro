---
import MainLayout from "../../../layouts/MainLayout.astro";

export const prerender =
  false;

Astro.response.headers.set(
  "cache-control",
  "no-store",
);

const canonical =
  "https://theriverkeptflowing.com/sesh/studio/";
---

<MainLayout
  title="Sesh Studio"
  description="Your private Sesh creator workspace."
  canonical={canonical}
  noindex={true}
>
  <main class="sesh-studio">
    <section class="sesh-studio__hero">
      <div class="sesh-studio__shell">
        <p class="sesh-studio__eyebrow">
          Sesh Studio
        </p>

        <h1>
          Make something worth hearing.
        </h1>

        <p class="sesh-studio__lead">
          Your private creator workspace for your profile and projects.
        </p>

        <a
          class="sesh-studio__public-link"
          href="/sesh/"
        >
          Explore public Sesh
        </a>
      </div>
    </section>

    <section
      class="sesh-studio__shell sesh-studio__workspace"
      aria-live="polite"
    >
      <p
        id="studio-status"
        class="sesh-studio__status"
      >
        Loading your Studio…
      </p>

      <section
        id="studio-sign-in"
        class="sesh-studio__panel"
        hidden
      >
        <p class="sesh-studio__kicker">
          Creator access
        </p>

        <h2>
          Sign in to Sesh
        </h2>

        <p>
          Use your River account to open your creator workspace.
        </p>

        <form id="studio-login-form">
          <label>
            Email

            <input
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </label>

          <label>
            Password

            <input
              name="password"
              type="password"
              autocomplete="current-password"
              required
            />
          </label>

          <button type="submit">
            Sign in
          </button>
        </form>
      </section>

      <section
        id="studio-provision"
        class="sesh-studio__panel"
        hidden
      >
        <p class="sesh-studio__kicker">
          First-time setup
        </p>

        <h2>
          Create your Sesh creator profile
        </h2>

        <p>
          This creates your explicit Sesh creator identity. It does not
          grant publishing, management, ownership, or other unrelated
          rights.
        </p>

        <form id="studio-provision-form">
          <label>
            Display name

            <input
              name="displayName"
              type="text"
              maxlength="120"
              autocomplete="name"
              required
            />
          </label>

          <button type="submit">
            Create creator profile
          </button>
        </form>

        <button
          id="studio-provision-logout"
          class="sesh-studio__button-secondary"
          type="button"
        >
          Sign out
        </button>
      </section>

      <section
        id="studio-main"
        hidden
      >
        <div class="sesh-studio__topline">
          <div>
            <p class="sesh-studio__kicker">
              Creator workspace
            </p>

            <h2 id="studio-greeting">
              Your Studio
            </h2>
          </div>

          <button
            id="studio-logout"
            class="sesh-studio__button-secondary"
            type="button"
          >
            Sign out
          </button>
        </div>

        <div class="sesh-studio__grid">
          <section class="sesh-studio__panel">
            <p class="sesh-studio__kicker">
              Profile
            </p>

            <h3>
              Public creator profile
            </h3>

            <form id="studio-profile-form">
              <label>
                Display name

                <input
                  id="studio-display-name"
                  name="displayName"
                  type="text"
                  maxlength="120"
                  required
                />
              </label>

              <label>
                Bio

                <textarea
                  id="studio-bio"
                  name="bio"
                  rows="5"
                  maxlength="1000"
                ></textarea>
              </label>

              <button type="submit">
                Save profile
              </button>
            </form>
          </section>

          <section class="sesh-studio__panel">
            <p class="sesh-studio__kicker">
              Public handle
            </p>

            <h3>
              Your Sesh address
            </h3>

            <div
              id="studio-handle-current"
              class="sesh-studio__handle"
              hidden
            >
              <span>
                Your creator page
              </span>

              <a
                id="studio-handle-link"
                href="/sesh/"
              ></a>
            </div>

            <form id="studio-handle-form">
              <label>
                Handle

                <input
                  id="studio-handle"
                  name="handle"
                  type="text"
                  minlength="3"
                  maxlength="32"
                  autocomplete="off"
                  placeholder="your-name"
                  required
                />
              </label>

              <p class="sesh-studio__hint">
                Handles are canonical and are not ordinary profile fields.
              </p>

              <button type="submit">
                Claim handle
              </button>
            </form>
          </section>
        </div>

        <section class="sesh-studio__projects">
          <div class="sesh-studio__topline">
            <div>
              <p class="sesh-studio__kicker">
                Projects
              </p>

              <h2>
                Your music projects
              </h2>
            </div>
          </div>

          <div class="sesh-studio__grid">
            <section class="sesh-studio__panel">
              <h3>
                Start a project
              </h3>

              <form id="studio-project-form">
                <label>
                  Project title

                  <input
                    name="title"
                    type="text"
                    maxlength="200"
                    required
                  />
                </label>

                <button type="submit">
                  Create project
                </button>
              </form>
            </section>

            <section class="sesh-studio__panel">
              <h3>
                Projects
              </h3>

              <div id="studio-project-list">
                <p class="sesh-studio__muted">
                  Loading projects…
                </p>
              </div>
            </section>
          </div>

          <section class="sesh-studio__panel sesh-studio__audio">
            <p class="sesh-studio__kicker">
              Tracks
            </p>

            <h3>
              Organize this project
            </h3>

            <p class="sesh-studio__hint">
              Tracks are private organizational records inside your project.
              Creating or naming a track does not attach audio or create
              publishing, master, management, licensing, or royalty rights.
            </p>

            <form id="studio-track-form">
              <label>
                Project

                <select
                  id="studio-track-project"
                  required
                >
                  <option value="">
                    Choose a project
                  </option>
                </select>
              </label>

              <label>
                Track name

                <input
                  id="studio-track-name"
                  name="name"
                  type="text"
                  maxlength="120"
                  required
                />
              </label>

              <button
                id="studio-track-create"
                type="submit"
              >
                Create track
              </button>
            </form>

            <p
              id="studio-track-status"
              class="sesh-studio__audio-status sesh-studio__muted"
              aria-live="polite"
            ></p>

            <div
              id="studio-track-list"
              class="sesh-studio__audio-list"
            ></div>
          </section>

          <section class="sesh-studio__panel sesh-studio__audio">
            <p class="sesh-studio__kicker">
              Private audio
            </p>

            <h3>
              Upload a WAV recording
            </h3>

            <p class="sesh-studio__hint">
              Audio uploaded here stays private. Playback, public media,
              deletion, ownership transfers, publishing rights, master rights,
              management rights, and royalties are not created by this upload.
            </p>

            <form id="studio-audio-form">
              <label>
                Project

                <select
                  id="studio-audio-project"
                  name="project"
                  required
                >
                  <option value="">
                    Choose a project
                  </option>
                </select>
              </label>

              <label>
                WAV file

                <input
                  id="studio-audio-file"
                  name="audio"
                  type="file"
                  accept=".wav,audio/wav"
                  required
                />
              </label>

              <label>
                Recording name

                <input
                  id="studio-audio-name"
                  name="name"
                  type="text"
                  maxlength="200"
                  autocomplete="off"
                  placeholder="Take one"
                  required
                />
              </label>

              <p class="sesh-studio__hint">
                WAV only. Maximum file size: 25 MiB.
              </p>

              <button
                id="studio-audio-upload"
                type="submit"
              >
                Upload WAV
              </button>
            </form>

            <p
              id="studio-audio-status"
              class="sesh-studio__audio-status sesh-studio__muted"
              aria-live="polite"
            >
              Choose a project to view its private audio.
            </p>

            <div id="studio-audio-list"></div>
          </section>
        </section>
      </section>
    </section>
  </main>

  <script is:inline>
    (() => {
      const status =
        document.getElementById(
          "studio-status",
        );

      const signIn =
        document.getElementById(
          "studio-sign-in",
        );

      const provision =
        document.getElementById(
          "studio-provision",
        );

      const main =
        document.getElementById(
          "studio-main",
        );

      const loginForm =
        document.getElementById(
          "studio-login-form",
        );

      const provisionForm =
        document.getElementById(
          "studio-provision-form",
        );

      const profileForm =
        document.getElementById(
          "studio-profile-form",
        );

      const handleForm =
        document.getElementById(
          "studio-handle-form",
        );

      const projectForm =
        document.getElementById(
          "studio-project-form",
        );

      const logoutButton =
        document.getElementById(
          "studio-logout",
        );

      const provisionLogout =
        document.getElementById(
          "studio-provision-logout",
        );

      const projectList =
        document.getElementById(
          "studio-project-list",
        );

      const trackForm =
        document.getElementById(
          "studio-track-form",
        );

      const trackProject =
        document.getElementById(
          "studio-track-project",
        );

      const trackName =
        document.getElementById(
          "studio-track-name",
        );

      const trackCreate =
        document.getElementById(
          "studio-track-create",
        );

      const trackStatus =
        document.getElementById(
          "studio-track-status",
        );

      const trackList =
        document.getElementById(
          "studio-track-list",
        );

      const audioForm =
        document.getElementById(
          "studio-audio-form",
        );

      const audioProject =
        document.getElementById(
          "studio-audio-project",
        );

      const audioFile =
        document.getElementById(
          "studio-audio-file",
        );

      const audioName =
        document.getElementById(
          "studio-audio-name",
        );

      const audioUpload =
        document.getElementById(
          "studio-audio-upload",
        );

      const audioStatus =
        document.getElementById(
          "studio-audio-status",
        );

      const audioList =
        document.getElementById(
          "studio-audio-list",
        );

      const greeting =
        document.getElementById(
          "studio-greeting",
        );

      const displayNameInput =
        document.getElementById(
          "studio-display-name",
        );

      const bioInput =
        document.getElementById(
          "studio-bio",
        );

      const handleInput =
        document.getElementById(
          "studio-handle",
        );

      const handleCurrent =
        document.getElementById(
          "studio-handle-current",
        );

      const handleLink =
        document.getElementById(
          "studio-handle-link",
        );

      const setStatus =
        (message, isError = false) => {
          if (!status) {
            return;
          }

          status.textContent =
            message;

          status.dataset.state =
            isError
              ? "error"
              : "normal";
        };

      const showOnly =
        (target) => {
          if (signIn) {
            signIn.hidden =
              target !== signIn;
          }

          if (provision) {
            provision.hidden =
              target !== provision;
          }

          if (main) {
            main.hidden =
              target !== main;
          }
        };

      const fetchJson =
        async (
          url,
          options = {},
        ) => {
          const response =
            await fetch(
              url,
              {
                credentials:
                  "same-origin",

                cache:
                  "no-store",

                ...options,
              },
            );

          let body;

          try {
            body =
              await response.json();
          }
          catch {
            body =
              null;
          }

          return {
            response,
            body,
          };
        };

      const successValue =
        (body) => {
          if (
            !body ||
            typeof body !==
              "object"
          ) {
            return body;
          }

          if (
            Object.prototype.hasOwnProperty.call(
              body,
              "value",
            )
          ) {
            return body.value;
          }

          return body;
        };

      const profileFrom =
        (body) => {
          const value =
            successValue(
              body,
            );

          if (
            value &&
            typeof value ===
              "object" &&
            value.profile &&
            typeof value.profile ===
              "object"
          ) {
            return value.profile;
          }

          if (
            value &&
            typeof value ===
              "object" &&
            typeof value.displayName ===
              "string"
          ) {
            return value;
          }

          if (
            body &&
            typeof body ===
              "object" &&
            body.profile &&
            typeof body.profile ===
              "object"
          ) {
            return body.profile;
          }

          return null;
        };

      const projectsFrom =
        (body) => {
          const value =
            successValue(
              body,
            );

          if (
            Array.isArray(
              value,
            )
          ) {
            return value;
          }

          if (
            value &&
            typeof value ===
              "object" &&
            Array.isArray(
              value.projects,
            )
          ) {
            return value.projects;
          }

          if (
            body &&
            typeof body ===
              "object" &&
            Array.isArray(
              body.projects,
            )
          ) {
            return body.projects;
          }

          return [];
        };

      const errorMessage =
        (
          body,
          fallback,
        ) => {
          if (
            body &&
            typeof body ===
              "object" &&
            body.error &&
            typeof body.error ===
              "object" &&
            typeof body.error.message ===
              "string"
          ) {
            return body.error.message;
          }

          return fallback;
        };

      const renderProfile =
        (profile) => {
          const displayName =
            typeof profile.displayName ===
              "string"
              ? profile.displayName
              : "";

          const bio =
            typeof profile.bio ===
              "string"
              ? profile.bio
              : "";

          const handle =
            typeof profile.handle ===
              "string"
              ? profile.handle
              : "";

          if (greeting) {
            greeting.textContent =
              displayName
                ? `${displayName}'s Studio`
                : "Your Studio";
          }

          if (displayNameInput) {
            displayNameInput.value =
              displayName;
          }

          if (bioInput) {
            bioInput.value =
              bio;
          }

          if (
            handle &&
            handleCurrent &&
            handleLink &&
            handleForm
          ) {
            handleCurrent.hidden =
              false;

            handleForm.hidden =
              true;

            handleLink.textContent =
              `sesh/${handle}`;

            handleLink.href =
              `/sesh/${encodeURIComponent(
                handle,
              )}/`;
          }
          else {
            if (handleCurrent) {
              handleCurrent.hidden =
                true;
            }

            if (handleForm) {
              handleForm.hidden =
                false;
            }

            if (handleInput) {
              handleInput.value =
                "";
            }
          }
        };

      const audioAssetsFrom =
        (body) => {
          const value =
            successValue(
              body,
            );

          if (
            Array.isArray(
              value,
            )
          ) {
            return value;
          }

          if (
            value &&
            typeof value ===
              "object" &&
            Array.isArray(
              value.audioAssets,
            )
          ) {
            return value.audioAssets;
          }

          return [];
        };

      const setAudioStatus =
        (
          message,
          isError = false,
        ) => {
          if (!audioStatus) {
            return;
          }

          audioStatus.textContent =
            message;

          audioStatus.dataset.state =
            isError
              ? "error"
              : "ok";
        };

      const setAudioBusy =
        (busy) => {
          if (audioUpload) {
            audioUpload.disabled =
              busy;
          }

          if (audioProject) {
            audioProject.disabled =
              busy;
          }

          if (audioFile) {
            audioFile.disabled =
              busy;
          }

          if (audioName) {
            audioName.disabled =
              busy;
          }
        };
      const renderProjects =
        (projects) => {
          if (!projectList) {
            return;
          }

          projectList.textContent =
            "";

          const safeProjects =
            projects.filter(
              (project) =>
                project &&
                typeof project ===
                  "object" &&
                typeof project.title ===
                  "string",
            );

          if (
            safeProjects.length ===
              0
          ) {
            const empty =
              document.createElement(
                "p",
              );

            empty.className =
              "sesh-studio__muted";

            empty.textContent =
              "No projects yet. Start your first one.";

            projectList.appendChild(
              empty,
            );

            return;
          }

          const list =
            document.createElement(
              "div",
            );

          list.className =
            "sesh-studio__project-list";

          for (
            const project of
            safeProjects
          ) {
            const article =
              document.createElement(
                "article",
              );

            article.className =
              "sesh-studio__project";

            const title =
              document.createElement(
                "h4",
              );

            title.textContent =
              project.title;

            article.appendChild(
              title,
            );

            if (
              typeof project.id ===
                "string" &&
              project.id
            ) {
              const manage =
                document.createElement(
                  "a",
                );

              manage.textContent =
                "Manage project";

              manage.href =
                `/sesh/studio/projects/${encodeURIComponent(
                  project.id,
                )}/`;

              article.appendChild(
                manage,
              );
            }

            if (
              typeof project.description ===
                "string" &&
              project.description.trim()
            ) {
              const description =
                document.createElement(
                  "p",
                );

              description.textContent =
                project.description;

              article.appendChild(
                description,
              );
            }

            list.appendChild(
              article,
            );
          }

          projectList.appendChild(
            list,
          );
        };

      const renderTrackProjectOptions =
        (projects) => {
          if (!trackProject) {
            return;
          }

          const currentValue =
            trackProject.value;

          trackProject.textContent =
            "";

          const placeholder =
            document.createElement(
              "option",
            );

          placeholder.value =
            "";

          placeholder.textContent =
            "Choose a project";

          trackProject.appendChild(
            placeholder,
          );

          for (
            const project of
            Array.isArray(projects)
              ? projects
              : []
          ) {
            if (
              !project ||
              typeof project.id !==
                "string" ||
              !project.id ||
              typeof project.title !==
                "string"
            ) {
              continue;
            }

            const option =
              document.createElement(
                "option",
              );

            option.value =
              project.id;

            option.textContent =
              project.title;

            trackProject.appendChild(
              option,
            );
          }

          if (
            currentValue &&
            Array.from(
              trackProject.options,
            ).some(
              (option) =>
                option.value ===
                  currentValue,
            )
          ) {
            trackProject.value =
              currentValue;
          }
        };

      const renderAudioProjectOptions =
        (projects) => {
          if (!audioProject) {
            return;
          }

          const previousValue =
            audioProject.value;

          audioProject.textContent =
            "";

          const placeholder =
            document.createElement(
              "option",
            );

          placeholder.value =
            "";

          placeholder.textContent =
            "Choose a project";

          audioProject.appendChild(
            placeholder,
          );

          const safeProjects =
            projects.filter(
              (project) =>
                project &&
                typeof project ===
                  "object" &&
                typeof project.id ===
                  "string" &&
                project.id &&
                typeof project.title ===
                  "string",
            );

          for (
            const project of
            safeProjects
          ) {
            const option =
              document.createElement(
                "option",
              );

            option.value =
              project.id;

            option.textContent =
              project.title;

            audioProject.appendChild(
              option,
            );
          }

          if (
            safeProjects.some(
              (project) =>
                project.id ===
                  previousValue,
            )
          ) {
            audioProject.value =
              previousValue;
          }

          if (
            safeProjects.length ===
              0
          ) {
            audioProject.disabled =
              true;

            setAudioStatus(
              "Create a project before uploading private audio.",
            );

            if (audioList) {
              audioList.textContent =
                "";
            }
          }
          else {
            audioProject.disabled =
              false;
          }
        };

      const setTrackStatus = (
        message,
        error = false,
      ) => {
        if (!trackStatus) {
          return;
        }

        trackStatus.textContent =
          message;

        if (error) {
          trackStatus.dataset.state =
            "error";
        }
        else {
          delete trackStatus.dataset.state;
        }
      };

      const setTrackBusy =
        (busy) => {
          if (trackProject) {
            trackProject.disabled =
              busy;
          }

          if (trackName) {
            trackName.disabled =
              busy;
          }

          if (trackCreate) {
            trackCreate.disabled =
              busy;
          }
        };

      const tracksFrom =
        (body) => {
          if (
            !body ||
            body.ok !==
              true ||
            !Array.isArray(
              body.value,
            )
          ) {
            return [];
          }

          return body.value;
        };

      const createProjectTrack =
        async (
          projectId,
          name,
        ) => {
          const {
            response,
            body,
          } =
            await fetchJson(
              `/api/sesh/projects/${encodeURIComponent(
                projectId,
              )}/tracks`,
              {
                method:
                  "POST",

                headers: {
                  "content-type":
                    "application/json",
                },

                body:
                  JSON.stringify({
                    name,
                  }),
              },
            );

          if (
            !response.ok ||
            !body ||
            body.ok !==
              true
          ) {
            throw new Error(
              errorMessage(
                body,
                "Unable to create track.",
              ),
            );
          }

          return body.value;
        };

      const renameProjectTrack =
        async (
          projectId,
          trackId,
          name,
        ) => {
          const {
            response,
            body,
          } =
            await fetchJson(
              `/api/sesh/projects/${encodeURIComponent(
                projectId,
              )}/tracks/${encodeURIComponent(
                trackId,
              )}`,
              {
                method:
                  "PATCH",

                headers: {
                  "content-type":
                    "application/json",
                },

                body:
                  JSON.stringify({
                    name,
                  }),
              },
            );

          if (
            !response.ok ||
            !body ||
            body.ok !==
              true
          ) {
            throw new Error(
              errorMessage(
                body,
                "Unable to rename track.",
              ),
            );
          }

          return body.value;
        };

      const deleteProjectTrack =
        async (
          projectId,
          trackId,
        ) => {
          const {
            response,
            body,
          } =
            await fetchJson(
              `/api/sesh/projects/${encodeURIComponent(
                projectId,
              )}/tracks/${encodeURIComponent(
                trackId,
              )}`,
              {
                method:
                  "DELETE",
              },
            );

          if (
            !response.ok ||
            !body ||
            body.ok !==
              true
          ) {
            throw new Error(
              errorMessage(
                body,
                "Unable to delete track.",
              ),
            );
          }

          return body.value;
        };

      const updateTrackMixField =
        async (
          projectId,
          trackId,
          field,
          value,
        ) => {
          let body;

          if (
            field ===
            "muted" &&
            typeof value ===
              "boolean"
          ) {
            body = {
              muted:
                value,
            };
          }
          else if (
            field ===
            "solo" &&
            typeof value ===
              "boolean"
          ) {
            body = {
              solo:
                value,
            };
          }
          else if (
            field ===
            "gain" &&
            typeof value ===
              "number" &&
            Number.isFinite(
              value,
            )
          ) {
            body = {
              gain:
                value,
            };
          }
          else {
            throw new Error(
              "Invalid track mix update.",
            );
          }

          const {
            response,
            body: responseBody,
          } =
            await fetchJson(
              `/api/sesh/projects/${encodeURIComponent(
                projectId,
              )}/tracks/${encodeURIComponent(
                trackId,
              )}`,
              {
                method:
                  "PATCH",

                headers: {
                  "content-type":
                    "application/json",
                },

                body:
                  JSON.stringify(
                    body,
                  ),
              },
            );

          if (!response.ok) {
            throw new Error(
              errorMessage(
                responseBody,
                "Unable to update track mix.",
              ),
            );
          }

          return responseBody;
        };

      let trackAudioInventory =
        [];

      const loadTrackAudioInventory =
        async (
          projectId,
        ) => {
          const {
            response,
            body,
          } =
            await fetchJson(
              `/api/sesh/projects/${encodeURIComponent(
                projectId,
              )}/audio`,
            );

          if (!response.ok) {
            throw new Error(
              errorMessage(
                body,
                "Private audio is temporarily unavailable.",
              ),
            );
          }

          return audioAssetsFrom(
            body,
          );
        };

      const updateTrackAudioMembership =
        async (
          projectId,
          trackId,
          audioAssetId,
          method,
        ) => {
          if (
            method !==
              "PUT" &&
            method !==
              "DELETE"
          ) {
            throw new Error(
              "Unsupported track audio mutation.",
            );
          }

          const {
            response,
            body,
          } =
            await fetchJson(
              `/api/sesh/projects/${encodeURIComponent(
                projectId,
              )}/tracks/${encodeURIComponent(
                trackId,
              )}/audio/${encodeURIComponent(
                audioAssetId,
              )}`,
              {
                method,
              },
            );

          if (!response.ok) {
            throw new Error(
              errorMessage(
                body,
                method ===
                  "PUT"
                  ? "Unable to attach private audio to track."
                  : "Unable to detach private audio from track.",
              ),
            );
          }

          return body;
        };
      const renderTracks = (
        tracks,
        projectId,
      ) => {
        if (!trackList) {
          return;
        }

        trackList.textContent =
          "";

        const sanitizedTracks =
          Array.isArray(tracks)
            ? tracks.filter(
                (track) =>
                  track &&
                  typeof track.id ===
                    "string" &&
                  track.id &&
                  typeof track.name ===
                    "string" &&
                  track.name &&
                  typeof track.order ===
                    "number",
              )
            : [];

        if (
          sanitizedTracks.length ===
            0
        ) {
          const empty =
            document.createElement(
              "p",
            );

          empty.className =
            "sesh-studio__muted";

          empty.textContent =
            "No tracks exist in this project yet.";

          trackList.appendChild(
            empty,
          );

          return;
        }

        for (
          const track of
          sanitizedTracks
        ) {
          const item =
            document.createElement(
              "article",
            );

          item.className =
            "sesh-studio__audio-item";

          const heading =
            document.createElement(
              "div",
            );

          heading.className =
            "sesh-studio__audio-heading";

          const title =
            document.createElement(
              "h4",
            );

          title.textContent =
            track.name;

          const actions =
            document.createElement(
              "div",
            );

          const renameButton =
            document.createElement(
              "button",
            );

          renameButton.type =
            "button";

          renameButton.className =
            "sesh-studio__audio-delete sesh-studio__audio-rename";

          renameButton.textContent =
            "Rename";

          const deleteButton =
            document.createElement(
              "button",
            );

          deleteButton.type =
            "button";

          deleteButton.className =
            "sesh-studio__audio-delete";

          deleteButton.textContent =
            "Delete";

          renameButton.addEventListener(
            "click",
            async () => {
              const requestedName =
                window.prompt(
                  "Rename track",
                  track.name,
                );

              if (
                requestedName ===
                  null
              ) {
                return;
              }

              const name =
                requestedName.trim();

              if (
                name.length ===
                  0 ||
                name.length >
                  120
              ) {
                setTrackStatus(
                  "Track names must be between 1 and 120 characters.",
                  true,
                );

                return;
              }

              renameButton.disabled =
                true;

              deleteButton.disabled =
                true;

              setTrackStatus(
                "Renaming track…",
              );

              try {
                await renameProjectTrack(
                  projectId,
                  track.id,
                  name,
                );

                await loadProjectTracks(
                  projectId,
                );

                setTrackStatus(
                  "Track renamed.",
                );
              }
              catch (error) {
                renameButton.disabled =
                  false;

                deleteButton.disabled =
                  false;

                setTrackStatus(
                  error instanceof Error
                    ? error.message
                    : "Unable to rename track.",
                  true,
                );
              }
            },
          );

          deleteButton.addEventListener(
            "click",
            async () => {
              const confirmed =
                window.confirm(
                  `Delete "${track.name}"? This removes the track record from this project. It does not delete uploaded audio.`,
                );

              if (!confirmed) {
                return;
              }

              renameButton.disabled =
                true;

              deleteButton.disabled =
                true;

              setTrackStatus(
                "Deleting track…",
              );

              try {
                await deleteProjectTrack(
                  projectId,
                  track.id,
                );

                await loadProjectTracks(
                  projectId,
                );

                setTrackStatus(
                  "Track deleted.",
                );
              }
              catch (error) {
                renameButton.disabled =
                  false;

                deleteButton.disabled =
                  false;

                setTrackStatus(
                  error instanceof Error
                    ? error.message
                    : "Unable to delete track.",
                  true,
                );
              }
            },
          );

          actions.append(
            renameButton,
            deleteButton,
          );

          heading.append(
            title,
            actions,
          );

          item.appendChild(
            heading,
          );

          const details =
            document.createElement(
              "p",
            );

          details.className =
            "sesh-studio__muted";

          details.textContent =
            `Track ${track.order + 1}`;

          item.appendChild(
            details,
          );

          const trackMix =
            document.createElement(
              "div",
            );

          trackMix.className =
            "sesh-studio__track-mix";

          const mixTitle =
            document.createElement(
              "p",
            );

          mixTitle.className =
            "sesh-studio__muted";

          mixTitle.textContent =
            "Mix";

          trackMix.appendChild(
            mixTitle,
          );

          const mixActions =
            document.createElement(
              "div",
            );

          mixActions.className =
            "sesh-studio__actions";

          const muteButton =
            document.createElement(
              "button",
            );

          muteButton.type =
            "button";

          muteButton.textContent =
            track.muted ===
            true
              ? "Unmute"
              : "Mute";

          muteButton.setAttribute(
            "aria-pressed",
            track.muted ===
              true
              ? "true"
              : "false",
          );

          muteButton.addEventListener(
            "click",
            async () => {
              muteButton.disabled =
                true;

              setTrackStatus(
                "Updating track mute…",
              );

              try {
                await updateTrackMixField(
                  projectId,
                  track.id,
                  "muted",
                  track.muted !==
                    true,
                );

                await loadProjectTracks(
                  projectId,
                );

                setTrackStatus(
                  "Track mute updated.",
                );
              }
              catch (error) {
                setTrackStatus(
                  error instanceof Error
                    ? error.message
                    : "Unable to update track mute.",
                  true,
                );

                muteButton.disabled =
                  false;
              }
            },
          );

          const soloButton =
            document.createElement(
              "button",
            );

          soloButton.type =
            "button";

          soloButton.textContent =
            track.solo ===
            true
              ? "Unsolo"
              : "Solo";

          soloButton.setAttribute(
            "aria-pressed",
            track.solo ===
              true
              ? "true"
              : "false",
          );

          soloButton.addEventListener(
            "click",
            async () => {
              soloButton.disabled =
                true;

              setTrackStatus(
                "Updating track solo…",
              );

              try {
                await updateTrackMixField(
                  projectId,
                  track.id,
                  "solo",
                  track.solo !==
                    true,
                );

                await loadProjectTracks(
                  projectId,
                );

                setTrackStatus(
                  "Track solo updated.",
                );
              }
              catch (error) {
                setTrackStatus(
                  error instanceof Error
                    ? error.message
                    : "Unable to update track solo.",
                  true,
                );

                soloButton.disabled =
                  false;
              }
            },
          );

          mixActions.append(
            muteButton,
            soloButton,
          );

          trackMix.appendChild(
            mixActions,
          );

          const gainLabel =
            document.createElement(
              "label",
            );

          gainLabel.textContent =
            "Gain";

          const gainInput =
            document.createElement(
              "input",
            );

          gainInput.type =
            "number";

          gainInput.step =
            "any";

          gainInput.setAttribute(
            "data-control",
            "track-mix-gain",
          );

          if (
            typeof track.gain ===
              "number" &&
            Number.isFinite(
              track.gain,
            )
          ) {
            gainInput.value =
              String(
                track.gain,
              );
          }
          else {
            gainInput.placeholder =
              "Unset";
          }

          gainInput.addEventListener(
            "change",
            async () => {
              const raw =
                gainInput.value.trim();

              if (!raw) {
                setTrackStatus(
                  "Enter a finite numeric gain value.",
                  true,
                );

                return;
              }

              const gain =
                Number(
                  raw,
                );

              if (
                !Number.isFinite(
                  gain,
                )
              ) {
                setTrackStatus(
                  "Gain must be a finite number.",
                  true,
                );

                return;
              }

              gainInput.disabled =
                true;

              setTrackStatus(
                "Updating track gain…",
              );

              try {
                await updateTrackMixField(
                  projectId,
                  track.id,
                  "gain",
                  gain,
                );

                await loadProjectTracks(
                  projectId,
                );

                setTrackStatus(
                  "Track gain updated.",
                );
              }
              catch (error) {
                setTrackStatus(
                  error instanceof Error
                    ? error.message
                    : "Unable to update track gain.",
                  true,
                );

                gainInput.disabled =
                  false;
              }
            },
          );

          gainLabel.appendChild(
            gainInput,
          );

          trackMix.appendChild(
            gainLabel,
          );

          item.appendChild(
            trackMix,
          );

          const attachedIds =
            Array.isArray(
              track.audioAssetIds,
            )
              ? track.audioAssetIds.filter(
                  (value) =>
                    typeof value ===
                      "string" &&
                    value,
                )
              : [];

          const inventory =
            Array.isArray(
              trackAudioInventory,
            )
              ? trackAudioInventory.filter(
                  (asset) =>
                    asset &&
                    typeof asset ===
                      "object" &&
                    typeof asset.id ===
                      "string" &&
                    asset.id,
                )
              : [];

          const inventoryById =
            new Map(
              inventory.map(
                (asset) => [
                  asset.id,
                  asset,
                ],
              ),
            );

          const trackAudio =
            document.createElement(
              "div",
            );

          trackAudio.className =
            "sesh-studio__track-audio";

          const trackAudioTitle =
            document.createElement(
              "p",
            );

          trackAudioTitle.className =
            "sesh-studio__muted";

          trackAudioTitle.textContent =
            "Private audio";

          trackAudio.appendChild(
            trackAudioTitle,
          );

          const attachedList =
            document.createElement(
              "div",
            );

          attachedList.className =
            "sesh-studio__audio-list";

          if (
            attachedIds.length ===
            0
          ) {
            const emptyAttached =
              document.createElement(
                "p",
              );

            emptyAttached.className =
              "sesh-studio__muted";

            emptyAttached.textContent =
              "No private audio is attached to this track.";

            attachedList.appendChild(
              emptyAttached,
            );
          }
          else {
            for (
              const attachedId of
              attachedIds
            ) {
              const asset =
                inventoryById.get(
                  attachedId,
                );

              const attachedRow =
                document.createElement(
                  "div",
                );

              attachedRow.className =
                "sesh-studio__audio-list";

              const attachedName =
                document.createElement(
                  "span",
                );

              attachedName.textContent =
                asset &&
                typeof asset.name ===
                  "string" &&
                asset.name
                  ? asset.name
                  : "Attached private audio";

              const detachButton =
                document.createElement(
                  "button",
                );

              detachButton.type =
                "button";

              detachButton.textContent =
                "Detach";

              detachButton.addEventListener(
                "click",
                async () => {
                  detachButton.disabled =
                    true;

                  setTrackStatus(
                    "Detaching private audio…",
                  );

                  try {
                    await updateTrackAudioMembership(
                      projectId,
                      track.id,
                      attachedId,
                      "DELETE",
                    );

                    await loadProjectTracks(
                      projectId,
                    );

                    setTrackStatus(
                      "Private audio detached from track.",
                    );
                  }
                  catch (error) {
                    setTrackStatus(
                      error instanceof Error
                        ? error.message
                        : "Unable to detach private audio from track.",
                      true,
                    );

                    detachButton.disabled =
                      false;
                  }
                },
              );

              attachedRow.append(
                attachedName,
                detachButton,
              );

              attachedList.appendChild(
                attachedRow,
              );
            }
          }

          trackAudio.appendChild(
            attachedList,
          );

          const availableAssets =
            inventory.filter(
              (asset) =>
                !attachedIds.includes(
                  asset.id,
                ),
            );

          const attachControls =
            document.createElement(
              "div",
            );

          attachControls.className =
            "sesh-studio__actions";

          const attachSelect =
            document.createElement(
              "select",
            );

          attachSelect.setAttribute(
            "aria-label",
            "Private audio to attach",
          );

          const attachPlaceholder =
            document.createElement(
              "option",
            );

          attachPlaceholder.value =
            "";

          attachPlaceholder.textContent =
            availableAssets.length > 0
              ? "Choose private audio"
              : "No unattached private audio";

          attachSelect.appendChild(
            attachPlaceholder,
          );

          for (
            const asset of
            availableAssets
          ) {
            const option =
              document.createElement(
                "option",
              );

            option.value =
              asset.id;

            option.textContent =
              typeof asset.name ===
                "string" &&
              asset.name
                ? asset.name
                : "Private audio";

            attachSelect.appendChild(
              option,
            );
          }

          attachSelect.disabled =
            availableAssets.length ===
            0;

          const attachButton =
            document.createElement(
              "button",
            );

          attachButton.type =
            "button";

          attachButton.textContent =
            "Attach";

          attachButton.disabled =
            availableAssets.length ===
            0;

          attachButton.addEventListener(
            "click",
            async () => {
              const audioAssetId =
                attachSelect.value;

              if (!audioAssetId) {
                setTrackStatus(
                  "Choose private audio to attach.",
                  true,
                );

                return;
              }

              attachButton.disabled =
                true;

              attachSelect.disabled =
                true;

              setTrackStatus(
                "Attaching private audio…",
              );

              try {
                const freshInventory =
                  await loadTrackAudioInventory(
                    projectId,
                  );

                if (
                  !freshInventory.some(
                    (asset) =>
                      asset &&
                      asset.id ===
                        audioAssetId,
                  )
                ) {
                  throw new Error(
                    "That private audio is no longer available for this project.",
                  );
                }

                await updateTrackAudioMembership(
                  projectId,
                  track.id,
                  audioAssetId,
                  "PUT",
                );

                await loadProjectTracks(
                  projectId,
                );

                setTrackStatus(
                  "Private audio attached to track.",
                );
              }
              catch (error) {
                setTrackStatus(
                  error instanceof Error
                    ? error.message
                    : "Unable to attach private audio to track.",
                  true,
                );

                attachButton.disabled =
                  false;

                attachSelect.disabled =
                  availableAssets.length ===
                  0;
              }
            },
          );

          attachControls.append(
            attachSelect,
            attachButton,
          );

          trackAudio.appendChild(
            attachControls,
          );

          item.appendChild(
            trackAudio,
          );

          trackList.appendChild(
            item,
          );
        }
      };

      const loadProjectTracks =
        async (
          projectId,
        ) => {
          if (!trackList) {
            return;
          }

          if (
            typeof projectId !==
              "string" ||
            !projectId
          ) {
            trackList.textContent =
              "";

            trackAudioInventory =
              [];

            setTrackStatus(
              "Choose a project to manage tracks.",
            );

            return;
          }

          trackList.innerHTML =
            '<p class="sesh-studio__muted">Loading tracks…</p>';

          setTrackStatus(
            "Loading tracks…",
          );

          try {
            const {
              response,
              body,
            } =
              await fetchJson(
                `/api/sesh/projects/${encodeURIComponent(
                  projectId,
                )}/tracks`,
              );

            if (!response.ok) {
              trackList.textContent =
                "";

              setTrackStatus(
                errorMessage(
                  body,
                  "Tracks are temporarily unavailable.",
                ),
                true,
              );

              return;
            }

            trackAudioInventory =
              await loadTrackAudioInventory(
                projectId,
              );

            renderTracks(
              tracksFrom(
                body,
              ),
              projectId,
            );

            setTrackStatus(
              "Tracks are up to date.",
            );
          }
          catch {
            trackList.textContent =
              "";

            setTrackStatus(
              "Tracks are temporarily unavailable.",
              true,
            );
          }
        };

      const setPrivateAudioStatus = (
  message,
  state = "",
) => {
  if (!audioStatus) {
    return;
  }

  audioStatus.textContent =
    message;

  if (state) {
    audioStatus.dataset.state =
      state;
  }
  else {
    delete audioStatus.dataset.state;
  }
};

const deleteProjectAudio =
  async (
    projectId,
    audioAssetId,
  ) => {
    const response =
      await fetch(
        `/api/sesh/projects/${encodeURIComponent(
          projectId,
        )}/audio/${encodeURIComponent(
          audioAssetId,
        )}`,
        {
          method:
            "DELETE",
        },
      );

    let body =
      null;

    try {
      body =
        await response.json();
    }
    catch {
      body =
        null;
    }

    if (
      !response.ok ||
      !body ||
      body.ok !==
        true
    ) {
      const message =
        body &&
        body.error &&
        typeof body.error.message ===
          "string"
          ? body.error.message
          : "Unable to delete private audio.";

      throw new Error(
        message,
      );
    }

    return body;
  };

const renameProjectAudio =
  async (
    projectId,
    audioAssetId,
    name,
  ) => {
    const response =
      await fetch(
        `/api/sesh/projects/${encodeURIComponent(
          projectId,
        )}/audio/${encodeURIComponent(
          audioAssetId,
        )}`,
        {
          method:
            "PATCH",

          headers: {
            "content-type":
              "application/json",
          },

          body:
            JSON.stringify({
              name,
            }),
        },
      );

    let body =
      null;

    try {
      body =
        await response.json();
    }
    catch {
      body =
        null;
    }

    if (
      !response.ok ||
      !body ||
      body.ok !==
        true
    ) {
      const message =
        body &&
        body.error &&
        typeof body.error.message ===
          "string"
          ? body.error.message
          : "Unable to rename private audio.";

      throw new Error(
        message,
      );
    }

    return body;
  };

const renderAudioAssets = (
  assets,
  projectId,
) => {
  if (!audioList) {
    return;
  }

  audioList.textContent =
    "";

  const sanitizedAssets =
    Array.isArray(
      assets,
    )
      ? assets.filter(
          (
            asset,
          ) =>
            asset &&
            typeof asset ===
              "object" &&
            typeof asset.id ===
              "string" &&
            asset.id &&
            typeof projectId ===
              "string" &&
            projectId,
        )
      : [];

  if (
    sanitizedAssets.length ===
    0
  ) {
    const empty =
      document.createElement(
        "p",
      );

    empty.className =
      "sesh-studio__muted";

    empty.textContent =
      "No private audio has been uploaded to this project yet.";

    audioList.append(
      empty,
    );

    return;
  }

  const list =
    document.createElement(
      "div",
    );

  list.className =
    "sesh-studio__audio-list";

  for (
    const asset of
    sanitizedAssets
  ) {
    const item =
      document.createElement(
        "article",
      );

    item.className =
      "sesh-studio__audio-item";

    const heading =
      document.createElement(
        "div",
      );

    heading.className =
      "sesh-studio__audio-heading";

    const title =
      document.createElement(
        "strong",
      );

    title.textContent =
      typeof asset.name ===
        "string" &&
      asset.name
        ? asset.name
        : "Private audio";

    heading.append(
      title,
    );

    const actions =
      document.createElement(
        "div",
      );

    actions.className =
      "sesh-studio__audio-actions";

    actions.style.display =
      "flex";

    actions.style.alignItems =
      "center";

    actions.style.gap =
      "0.5rem";

    const renameButton =
      document.createElement(
        "button",
      );

    renameButton.type =
      "button";

    renameButton.className =
      "sesh-studio__audio-delete sesh-studio__audio-rename";

    renameButton.textContent =
      "Rename";

    renameButton.setAttribute(
      "aria-label",
      `Rename ${title.textContent}`,
    );

    renameButton.addEventListener(
      "click",
      async () => {
        const currentName =
          typeof title.textContent ===
            "string"
            ? title.textContent
            : "";

        const requestedName =
          window.prompt(
            "Rename private audio",
            currentName,
          );

        if (
          requestedName ===
          null
        ) {
          return;
        }

        const name =
          requestedName.trim();

        if (
          name.length ===
            0 ||
          name.length >
            120
        ) {
          setPrivateAudioStatus(
            "Private audio name must be between 1 and 120 characters.",
            "error",
          );

          return;
        }

        if (
          name ===
          currentName
        ) {
          return;
        }

        renameButton.disabled =
          true;

        deleteButton.disabled =
          true;

        setPrivateAudioStatus(
          "Renaming private audio…",
        );

        try {
          await renameProjectAudio(
            projectId,
            asset.id,
            name,
          );

          await loadProjectAudio(
            projectId,
          );

          setPrivateAudioStatus(
            "Private audio renamed.",
          );
        }
        catch (error) {
          renameButton.disabled =
            false;

          deleteButton.disabled =
            false;

          setPrivateAudioStatus(
            error instanceof Error
              ? error.message
              : "Unable to rename private audio.",
            "error",
          );
        }
      },
    );

    const deleteButton =
      document.createElement(
        "button",
      );

    deleteButton.type =
      "button";

    deleteButton.className =
      "sesh-studio__audio-delete";

    deleteButton.textContent =
      "Delete";

    deleteButton.setAttribute(
      "aria-label",
      `Delete ${title.textContent}`,
    );

    deleteButton.addEventListener(
      "click",
      async () => {
        const confirmed =
          window.confirm(
            `Delete "${title.textContent}"? This permanently removes this private audio from the project.`,
          );

        if (!confirmed) {
          return;
        }

        deleteButton.disabled =
          true;

        setPrivateAudioStatus(
          "Deleting private audio…",
        );

        try {
          await deleteProjectAudio(
            projectId,
            asset.id,
          );

          await loadProjectAudio(
            projectId,
          );

          setPrivateAudioStatus(
            "Private audio deleted.",
          );
        }
        catch (error) {
          deleteButton.disabled =
            false;

          setPrivateAudioStatus(
            error instanceof Error
              ? error.message
              : "Unable to delete private audio.",
            "error",
          );
        }
      },
    );

    actions.append(
      renameButton,
      deleteButton,
    );

    heading.append(
      actions,
    );

    item.append(
      heading,
    );

    if (
      asset.hasStoredAudio ===
      true
    ) {
      const player =
        document.createElement(
          "audio",
        );

      player.className =
        "sesh-studio__audio-player";

      player.controls =
        true;

      player.preload =
        "metadata";

      player.src =
        `/api/sesh/projects/${encodeURIComponent(
          projectId,
        )}/audio/${encodeURIComponent(
          asset.id,
        )}/content`;

      item.append(
        player,
      );
    }

    const details =
      [];

    if (
      typeof asset.contentType ===
        "string" &&
      asset.contentType
    ) {
      details.push(
        asset.contentType,
      );
    }

    if (
      typeof asset.durationSeconds ===
        "number" &&
      Number.isFinite(
        asset.durationSeconds,
      )
    ) {
      details.push(
        `${asset.durationSeconds}s`,
      );
    }

    if (
      typeof asset.sampleRateHz ===
        "number" &&
      Number.isFinite(
        asset.sampleRateHz,
      )
    ) {
      details.push(
        `${asset.sampleRateHz} Hz`,
      );
    }

    if (
      typeof asset.channelCount ===
        "number" &&
      Number.isFinite(
        asset.channelCount,
      )
    ) {
      details.push(
        `${asset.channelCount} channel${
          asset.channelCount ===
          1
            ? ""
            : "s"
        }`,
      );
    }

    if (
      details.length >
      0
    ) {
      const detail =
        document.createElement(
          "p",
        );

      detail.className =
        "sesh-studio__muted";

      detail.textContent =
        details.join(
          " · ",
        );

      item.append(
        detail,
      );
    }

    list.append(
      item,
    );
  }

  audioList.append(
    list,
  );
};
const loadProjectAudio =
        async (
          projectId,
        ) => {
          if (
            typeof projectId !==
              "string" ||
            !projectId
          ) {
            if (audioList) {
              audioList.textContent =
                "";
            }

            setAudioStatus(
              "Choose a project to view its private audio.",
            );

            return;
          }

          setAudioStatus(
            "Loading private audio…",
          );

          if (audioList) {
            audioList.innerHTML =
              '<p class="sesh-studio__muted">Loading private audio…</p>';
          }

          try {
            const {
              response,
              body,
            } =
              await fetchJson(
                `/api/sesh/projects/${encodeURIComponent(
                  projectId,
                )}/audio/`,
              );

            if (!response.ok) {
              if (audioList) {
                audioList.textContent =
                  "";
              }

              setAudioStatus(
                errorMessage(
                  body,
                  "Private audio is temporarily unavailable.",
                ),
                true,
              );

              return;
            }

            renderAudioAssets(
              audioAssetsFrom(
                body,
              ),
              projectId,
            );

            setAudioStatus(
              "Private audio is up to date.",
            );
          }
          catch {
            if (audioList) {
              audioList.textContent =
                "";
            }

            setAudioStatus(
              "Private audio is temporarily unavailable.",
              true,
            );
          }
        };
      const loadProjects =
        async () => {
          if (projectList) {
            projectList.innerHTML =
              '<p class="sesh-studio__muted">Loading projects…</p>';
          }

          try {
            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/sesh/projects",
              );

            if (!response.ok) {
              if (projectList) {
                projectList.innerHTML =
                  '<p class="sesh-studio__muted">Projects are temporarily unavailable.</p>';
              }

              return;
            }

            const projects =
              projectsFrom(
                body,
              );

            renderProjects(
              projects,
            );

            renderTrackProjectOptions(
              projects,
            );

            renderAudioProjectOptions(
              projects,
            );
          }
          catch {
            if (projectList) {
              projectList.innerHTML =
                '<p class="sesh-studio__muted">Projects are temporarily unavailable.</p>';
            }
          }
        };

      const refreshStudio =
        async () => {
          setStatus(
            "Loading your Studio…",
          );

          try {
            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/sesh/creator/profile",
              );

            if (
              response.status ===
                401
            ) {
              showOnly(
                signIn,
              );

              setStatus(
                "Sign in to open your creator workspace.",
              );

              return;
            }

            if (
              response.status ===
                403 ||
              response.status ===
                404
            ) {
              showOnly(
                provision,
              );

              setStatus(
                "Your River account is signed in. Create your Sesh creator profile to continue.",
              );

              return;
            }

            if (!response.ok) {
              showOnly(
                null,
              );

              setStatus(
                errorMessage(
                  body,
                  "Sesh Studio is temporarily unavailable.",
                ),
                true,
              );

              return;
            }

            const profile =
              profileFrom(
                body,
              );

            if (!profile) {
              showOnly(
                null,
              );

              setStatus(
                "Sesh Studio could not read your creator profile.",
                true,
              );

              return;
            }

            renderProfile(
              profile,
            );

            showOnly(
              main,
            );

            setStatus(
              "Studio ready.",
            );

            await loadProjects();
          }
          catch {
            showOnly(
              null,
            );

            setStatus(
              "Sesh Studio is temporarily unavailable.",
              true,
            );
          }
        };

      if (loginForm) {
        loginForm.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            const form =
              new FormData(
                loginForm,
              );

            const email =
              String(
                form.get(
                  "email",
                ) ??
                  "",
              );

            const password =
              String(
                form.get(
                  "password",
                ) ??
                  "",
              );

            setStatus(
              "Signing in…",
            );

            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/identity/login",
                {
                  method:
                    "POST",

                  headers: {
                    "content-type":
                      "application/json",
                  },

                  body:
                    JSON.stringify({
                      email,
                      password,
                    }),
                },
              );

            if (!response.ok) {
              setStatus(
                errorMessage(
                  body,
                  "Unable to sign in.",
                ),
                true,
              );

              return;
            }

            loginForm.reset();

            await refreshStudio();
          },
        );
      }

      if (provisionForm) {
        provisionForm.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            const form =
              new FormData(
                provisionForm,
              );

            const displayName =
              String(
                form.get(
                  "displayName",
                ) ??
                  "",
              ).trim();

            setStatus(
              "Creating your creator profile…",
            );

            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/sesh/creator/provision",
                {
                  method:
                    "POST",

                  headers: {
                    "content-type":
                      "application/json",
                  },

                  body:
                    JSON.stringify({
                      displayName,
                    }),
                },
              );

            if (!response.ok) {
              setStatus(
                errorMessage(
                  body,
                  "Unable to create your creator profile.",
                ),
                true,
              );

              return;
            }

            await refreshStudio();
          },
        );
      }

      if (profileForm) {
        profileForm.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            const form =
              new FormData(
                profileForm,
              );

            const displayName =
              String(
                form.get(
                  "displayName",
                ) ??
                  "",
              ).trim();

            const bio =
              String(
                form.get(
                  "bio",
                ) ??
                  "",
              ).trim();

            const update = {
              displayName,
            };

            if (bio) {
              update.bio =
                bio;
            }

            setStatus(
              "Saving profile…",
            );

            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/sesh/creator/profile",
                {
                  method:
                    "PATCH",

                  headers: {
                    "content-type":
                      "application/json",
                  },

                  body:
                    JSON.stringify(
                      update,
                    ),
                },
              );

            if (!response.ok) {
              setStatus(
                errorMessage(
                  body,
                  "Unable to save your profile.",
                ),
                true,
              );

              return;
            }

            setStatus(
              "Profile saved.",
            );

            await refreshStudio();
          },
        );
      }

      if (handleForm) {
        handleForm.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            const form =
              new FormData(
                handleForm,
              );

            const handle =
              String(
                form.get(
                  "handle",
                ) ??
                  "",
              ).trim();

            setStatus(
              "Claiming handle…",
            );

            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/sesh/creator/handle",
                {
                  method:
                    "POST",

                  headers: {
                    "content-type":
                      "application/json",
                  },

                  body:
                    JSON.stringify({
                      handle,
                    }),
                },
              );

            if (!response.ok) {
              setStatus(
                errorMessage(
                  body,
                  "Unable to claim that handle.",
                ),
                true,
              );

              return;
            }

            setStatus(
              "Handle claimed.",
            );

            await refreshStudio();
          },
        );
      }

      if (trackProject) {
        trackProject.addEventListener(
          "change",
          async () => {
            await loadProjectTracks(
              trackProject.value,
            );
          },
        );
      }

      if (trackForm) {
        trackForm.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            const projectId =
              trackProject
                ? trackProject.value
                : "";

            const name =
              trackName
                ? trackName.value.trim()
                : "";

            if (!projectId) {
              setTrackStatus(
                "Choose a project before creating a track.",
                true,
              );

              return;
            }

            if (
              name.length ===
                0 ||
              name.length >
                120
            ) {
              setTrackStatus(
                "Track names must be between 1 and 120 characters.",
                true,
              );

              return;
            }

            setTrackBusy(
              true,
            );

            setTrackStatus(
              "Creating track…",
            );

            try {
              await createProjectTrack(
                projectId,
                name,
              );

              if (trackName) {
                trackName.value =
                  "";
              }

              await loadProjectTracks(
                projectId,
              );

              setTrackStatus(
                "Track created.",
              );
            }
            catch (error) {
              setTrackStatus(
                error instanceof Error
                  ? error.message
                  : "Unable to create track.",
                true,
              );
            }
            finally {
              setTrackBusy(
                false,
              );
            }
          },
        );
      }

      if (audioProject) {
        audioProject.addEventListener(
          "change",
          async () => {
            await loadProjectAudio(
              audioProject.value,
            );
          },
        );
      }

      if (
        audioFile &&
        audioName
      ) {
        audioFile.addEventListener(
          "change",
          () => {
            const files =
              audioFile.files;

            if (
              !files ||
              files.length !==
                1
            ) {
              return;
            }

            const file =
              files[0];

            if (
              !audioName.value.trim()
            ) {
              audioName.value =
                file.name.replace(
                  /\.wav$/i,
                  "",
                );
            }
          },
        );
      }

      if (audioForm) {
        audioForm.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            const projectId =
              audioProject
                ? audioProject.value
                : "";

            const files =
              audioFile
                ? audioFile.files
                : null;

            const name =
              audioName
                ? audioName.value.trim()
                : "";

            if (!projectId) {
              setAudioStatus(
                "Choose a project before uploading audio.",
                true,
              );

              return;
            }

            if (
              !files ||
              files.length !==
                1
            ) {
              setAudioStatus(
                "Choose one WAV file to upload.",
                true,
              );

              return;
            }

            const file =
              files[0];

            if (
              !/\.wav$/i.test(
                file.name,
              )
            ) {
              setAudioStatus(
                "Choose a WAV file.",
                true,
              );

              return;
            }

            if (
              file.size <=
                0
            ) {
              setAudioStatus(
                "The selected WAV file is empty.",
                true,
              );

              return;
            }

            if (
              file.size >
                26214400
            ) {
              setAudioStatus(
                "The selected WAV file is larger than 25 MiB.",
                true,
              );

              return;
            }

            if (!name) {
              setAudioStatus(
                "Give this recording a name.",
                true,
              );

              return;
            }

            setAudioBusy(
              true,
            );

            setAudioStatus(
              "Uploading private audio…",
            );

            try {
              const {
                response,
                body,
              } =
                await fetchJson(
                  `/api/sesh/projects/${encodeURIComponent(
                    projectId,
                  )}/audio/`,
                  {
                    method:
                      "POST",

                    headers: {
                      "content-type":
                        "audio/wav",

                      "x-sesh-audio-name":
                        name,
                    },

                    body:
                      file,
                  },
                );

              if (!response.ok) {
                setAudioStatus(
                  errorMessage(
                    body,
                    "Unable to upload private audio.",
                  ),
                  true,
                );

                return;
              }

              if (audioFile) {
                audioFile.value =
                  "";
              }

              if (audioName) {
                audioName.value =
                  "";
              }

              setAudioStatus(
                "Private audio uploaded.",
              );

              await loadProjectAudio(
                projectId,
              );
            }
            catch {
              setAudioStatus(
                "Unable to upload private audio.",
                true,
              );
            }
            finally {
              setAudioBusy(
                false,
              );
            }
          },
        );
      }
      if (projectForm) {
        projectForm.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            const form =
              new FormData(
                projectForm,
              );

            const title =
              String(
                form.get(
                  "title",
                ) ??
                  "",
              ).trim();

            setStatus(
              "Creating project…",
            );

            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/sesh/projects",
                {
                  method:
                    "POST",

                  headers: {
                    "content-type":
                      "application/json",
                  },

                  body:
                    JSON.stringify({
                      title,
                    }),
                },
              );

            if (!response.ok) {
              setStatus(
                errorMessage(
                  body,
                  "Unable to create the project.",
                ),
                true,
              );

              return;
            }

            projectForm.reset();

            setStatus(
              "Project created.",
            );

            await loadProjects();
          },
        );
      }

      const logout =
        async () => {
          setStatus(
            "Signing out…",
          );

          try {
            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/identity/logout",
                {
                  method:
                    "POST",
                },
              );

            if (!response.ok) {
              setStatus(
                errorMessage(
                  body,
                  "Unable to sign out.",
                ),
                true,
              );

              return;
            }

            await refreshStudio();
          }
          catch {
            setStatus(
              "Unable to sign out.",
              true,
            );
          }
        };

      if (logoutButton) {
        logoutButton.addEventListener(
          "click",
          logout,
        );
      }

      if (provisionLogout) {
        provisionLogout.addEventListener(
          "click",
          logout,
        );
      }

      refreshStudio();
    })();
  </script>

