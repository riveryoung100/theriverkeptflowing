---
import MainLayout from "../../../layouts/MainLayout.astro";

export const prerender =
  false;

Astro.response.headers.set(
  "cache-control",
  "no-store",
);

const canonical =
  "https://theriverkeptflowing.com/sesh/studio/";
---

<MainLayout
  title="Sesh Studio"
  description="Your private Sesh creator workspace."
  canonical={canonical}
  noindex={true}
>
  <main class="sesh-studio">
    <section class="sesh-studio__hero">
      <div class="sesh-studio__shell">
        <p class="sesh-studio__eyebrow">
          Sesh Studio
        </p>

        <h1>
          Make something worth hearing.
        </h1>

        <p class="sesh-studio__lead">
          Your private creator workspace for your profile and projects.
        </p>

        <a
          class="sesh-studio__public-link"
          href="/sesh/"
        >
          Explore public Sesh
        </a>
      </div>
    </section>

    <section
      class="sesh-studio__shell sesh-studio__workspace"
      aria-live="polite"
    >
      <p
        id="studio-status"
        class="sesh-studio__status"
      >
        Loading your Studio…
      </p>

      <section
        id="studio-sign-in"
        class="sesh-studio__panel"
        hidden
      >
        <p class="sesh-studio__kicker">
          Creator access
        </p>

        <h2>
          Sign in to Sesh
        </h2>

        <p>
          Use your River account to open your creator workspace.
        </p>

        <form id="studio-login-form">
          <label>
            Email

            <input
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </label>

          <label>
            Password

            <input
              name="password"
              type="password"
              autocomplete="current-password"
              required
            />
          </label>

          <button type="submit">
            Sign in
          </button>
        </form>
      </section>

      <section
        id="studio-provision"
        class="sesh-studio__panel"
        hidden
      >
        <p class="sesh-studio__kicker">
          First-time setup
        </p>

        <h2>
          Create your Sesh creator profile
        </h2>

        <p>
          This creates your explicit Sesh creator identity. It does not
          grant publishing, management, ownership, or other unrelated
          rights.
        </p>

        <form id="studio-provision-form">
          <label>
            Display name

            <input
              name="displayName"
              type="text"
              maxlength="120"
              autocomplete="name"
              required
            />
          </label>

          <button type="submit">
            Create creator profile
          </button>
        </form>

        <button
          id="studio-provision-logout"
          class="sesh-studio__button-secondary"
          type="button"
        >
          Sign out
        </button>
      </section>

      <section
        id="studio-main"
        hidden
      >
        <div class="sesh-studio__topline">
          <div>
            <p class="sesh-studio__kicker">
              Creator workspace
            </p>

            <h2 id="studio-greeting">
              Your Studio
            </h2>
          </div>

          <button
            id="studio-logout"
            class="sesh-studio__button-secondary"
            type="button"
          >
            Sign out
          </button>
        </div>

        <div class="sesh-studio__grid">
          <section class="sesh-studio__panel">
            <p class="sesh-studio__kicker">
              Profile
            </p>

            <h3>
              Public creator profile
            </h3>

            <form id="studio-profile-form">
              <label>
                Display name

                <input
                  id="studio-display-name"
                  name="displayName"
                  type="text"
                  maxlength="120"
                  required
                />
              </label>

              <label>
                Bio

                <textarea
                  id="studio-bio"
                  name="bio"
                  rows="5"
                  maxlength="1000"
                ></textarea>
              </label>

              <button type="submit">
                Save profile
              </button>
            </form>
          </section>

          <section class="sesh-studio__panel">
            <p class="sesh-studio__kicker">
              Public handle
            </p>

            <h3>
              Your Sesh address
            </h3>

            <div
              id="studio-handle-current"
              class="sesh-studio__handle"
              hidden
            >
              <span>
                Your creator page
              </span>

              <a
                id="studio-handle-link"
                href="/sesh/"
              ></a>
            </div>

            <form id="studio-handle-form">
              <label>
                Handle

                <input
                  id="studio-handle"
                  name="handle"
                  type="text"
                  minlength="3"
                  maxlength="32"
                  autocomplete="off"
                  placeholder="your-name"
                  required
                />
              </label>

              <p class="sesh-studio__hint">
                Handles are canonical and are not ordinary profile fields.
              </p>

              <button type="submit">
                Claim handle
              </button>
            </form>
          </section>
        </div>

        <section class="sesh-studio__projects">
          <div class="sesh-studio__topline">
            <div>
              <p class="sesh-studio__kicker">
                Projects
              </p>

              <h2>
                Your music projects
              </h2>
            </div>
          </div>

          <div class="sesh-studio__grid">
            <section class="sesh-studio__panel">
              <h3>
                Start a project
              </h3>

              <form id="studio-project-form">
                <label>
                  Project title

                  <input
                    name="title"
                    type="text"
                    maxlength="200"
                    required
                  />
                </label>

                <button type="submit">
                  Create project
                </button>
              </form>
            </section>

            <section class="sesh-studio__panel">
              <h3>
                Projects
              </h3>

              <div id="studio-project-list">
                <p class="sesh-studio__muted">
                  Loading projects…
                </p>
              </div>
            </section>
          </div>

          <section class="sesh-studio__panel sesh-studio__audio">
            <p class="sesh-studio__kicker">
              Private audio
            </p>

            <h3>
              Upload a WAV recording
            </h3>

            <p class="sesh-studio__hint">
              Audio uploaded here stays private. Playback, public media,
              deletion, ownership transfers, publishing rights, master rights,
              management rights, and royalties are not created by this upload.
            </p>

            <form id="studio-audio-form">
              <label>
                Project

                <select
                  id="studio-audio-project"
                  name="project"
                  required
                >
                  <option value="">
                    Choose a project
                  </option>
                </select>
              </label>

              <label>
                WAV file

                <input
                  id="studio-audio-file"
                  name="audio"
                  type="file"
                  accept=".wav,audio/wav"
                  required
                />
              </label>

              <label>
                Recording name

                <input
                  id="studio-audio-name"
                  name="name"
                  type="text"
                  maxlength="200"
                  autocomplete="off"
                  placeholder="Take one"
                  required
                />
              </label>

              <p class="sesh-studio__hint">
                WAV only. Maximum file size: 25 MiB.
              </p>

              <button
                id="studio-audio-upload"
                type="submit"
              >
                Upload WAV
              </button>
            </form>

            <p
              id="studio-audio-status"
              class="sesh-studio__audio-status sesh-studio__muted"
              aria-live="polite"
            >
              Choose a project to view its private audio.
            </p>

            <div id="studio-audio-list"></div>
          </section>
        </section>
      </section>
    </section>
  </main>

  <script is:inline>
    (() => {
      const status =
        document.getElementById(
          "studio-status",
        );

      const signIn =
        document.getElementById(
          "studio-sign-in",
        );

      const provision =
        document.getElementById(
          "studio-provision",
        );

      const main =
        document.getElementById(
          "studio-main",
        );

      const loginForm =
        document.getElementById(
          "studio-login-form",
        );

      const provisionForm =
        document.getElementById(
          "studio-provision-form",
        );

      const profileForm =
        document.getElementById(
          "studio-profile-form",
        );

      const handleForm =
        document.getElementById(
          "studio-handle-form",
        );

      const projectForm =
        document.getElementById(
          "studio-project-form",
        );

      const logoutButton =
        document.getElementById(
          "studio-logout",
        );

      const provisionLogout =
        document.getElementById(
          "studio-provision-logout",
        );

      const projectList =
        document.getElementById(
          "studio-project-list",
        );

      const audioForm =
        document.getElementById(
          "studio-audio-form",
        );

      const audioProject =
        document.getElementById(
          "studio-audio-project",
        );

      const audioFile =
        document.getElementById(
          "studio-audio-file",
        );

      const audioName =
        document.getElementById(
          "studio-audio-name",
        );

      const audioUpload =
        document.getElementById(
          "studio-audio-upload",
        );

      const audioStatus =
        document.getElementById(
          "studio-audio-status",
        );

      const audioList =
        document.getElementById(
          "studio-audio-list",
        );

      const greeting =
        document.getElementById(
          "studio-greeting",
        );

      const displayNameInput =
        document.getElementById(
          "studio-display-name",
        );

      const bioInput =
        document.getElementById(
          "studio-bio",
        );

      const handleInput =
        document.getElementById(
          "studio-handle",
        );

      const handleCurrent =
        document.getElementById(
          "studio-handle-current",
        );

      const handleLink =
        document.getElementById(
          "studio-handle-link",
        );

      const setStatus =
        (message, isError = false) => {
          if (!status) {
            return;
          }

          status.textContent =
            message;

          status.dataset.state =
            isError
              ? "error"
              : "normal";
        };

      const showOnly =
        (target) => {
          if (signIn) {
            signIn.hidden =
              target !== signIn;
          }

          if (provision) {
            provision.hidden =
              target !== provision;
          }

          if (main) {
            main.hidden =
              target !== main;
          }
        };

      const fetchJson =
        async (
          url,
          options = {},
        ) => {
          const response =
            await fetch(
              url,
              {
                credentials:
                  "same-origin",

                cache:
                  "no-store",

                ...options,
              },
            );

          let body;

          try {
            body =
              await response.json();
          }
          catch {
            body =
              null;
          }

          return {
            response,
            body,
          };
        };

      const successValue =
        (body) => {
          if (
            !body ||
            typeof body !==
              "object"
          ) {
            return body;
          }

          if (
            Object.prototype.hasOwnProperty.call(
              body,
              "value",
            )
          ) {
            return body.value;
          }

          return body;
        };

      const profileFrom =
        (body) => {
          const value =
            successValue(
              body,
            );

          if (
            value &&
            typeof value ===
              "object" &&
            value.profile &&
            typeof value.profile ===
              "object"
          ) {
            return value.profile;
          }

          if (
            value &&
            typeof value ===
              "object" &&
            typeof value.displayName ===
              "string"
          ) {
            return value;
          }

          if (
            body &&
            typeof body ===
              "object" &&
            body.profile &&
            typeof body.profile ===
              "object"
          ) {
            return body.profile;
          }

          return null;
        };

      const projectsFrom =
        (body) => {
          const value =
            successValue(
              body,
            );

          if (
            Array.isArray(
              value,
            )
          ) {
            return value;
          }

          if (
            value &&
            typeof value ===
              "object" &&
            Array.isArray(
              value.projects,
            )
          ) {
            return value.projects;
          }

          if (
            body &&
            typeof body ===
              "object" &&
            Array.isArray(
              body.projects,
            )
          ) {
            return body.projects;
          }

          return [];
        };

      const errorMessage =
        (
          body,
          fallback,
        ) => {
          if (
            body &&
            typeof body ===
              "object" &&
            body.error &&
            typeof body.error ===
              "object" &&
            typeof body.error.message ===
              "string"
          ) {
            return body.error.message;
          }

          return fallback;
        };

      const renderProfile =
        (profile) => {
          const displayName =
            typeof profile.displayName ===
              "string"
              ? profile.displayName
              : "";

          const bio =
            typeof profile.bio ===
              "string"
              ? profile.bio
              : "";

          const handle =
            typeof profile.handle ===
              "string"
              ? profile.handle
              : "";

          if (greeting) {
            greeting.textContent =
              displayName
                ? `${displayName}'s Studio`
                : "Your Studio";
          }

          if (displayNameInput) {
            displayNameInput.value =
              displayName;
          }

          if (bioInput) {
            bioInput.value =
              bio;
          }

          if (
            handle &&
            handleCurrent &&
            handleLink &&
            handleForm
          ) {
            handleCurrent.hidden =
              false;

            handleForm.hidden =
              true;

            handleLink.textContent =
              `sesh/${handle}`;

            handleLink.href =
              `/sesh/${encodeURIComponent(
                handle,
              )}/`;
          }
          else {
            if (handleCurrent) {
              handleCurrent.hidden =
                true;
            }

            if (handleForm) {
              handleForm.hidden =
                false;
            }

            if (handleInput) {
              handleInput.value =
                "";
            }
          }
        };

      const audioAssetsFrom =
        (body) => {
          const value =
            successValue(
              body,
            );

          if (
            Array.isArray(
              value,
            )
          ) {
            return value;
          }

          if (
            value &&
            typeof value ===
              "object" &&
            Array.isArray(
              value.audioAssets,
            )
          ) {
            return value.audioAssets;
          }

          return [];
        };

      const setAudioStatus =
        (
          message,
          isError = false,
        ) => {
          if (!audioStatus) {
            return;
          }

          audioStatus.textContent =
            message;

          audioStatus.dataset.state =
            isError
              ? "error"
              : "ok";
        };

      const setAudioBusy =
        (busy) => {
          if (audioUpload) {
            audioUpload.disabled =
              busy;
          }

          if (audioProject) {
            audioProject.disabled =
              busy;
          }

          if (audioFile) {
            audioFile.disabled =
              busy;
          }

          if (audioName) {
            audioName.disabled =
              busy;
          }
        };
      const renderProjects =
        (projects) => {
          if (!projectList) {
            return;
          }

          projectList.textContent =
            "";

          const safeProjects =
            projects.filter(
              (project) =>
                project &&
                typeof project ===
                  "object" &&
                typeof project.title ===
                  "string",
            );

          if (
            safeProjects.length ===
              0
          ) {
            const empty =
              document.createElement(
                "p",
              );

            empty.className =
              "sesh-studio__muted";

            empty.textContent =
              "No projects yet. Start your first one.";

            projectList.appendChild(
              empty,
            );

            return;
          }

          const list =
            document.createElement(
              "div",
            );

          list.className =
            "sesh-studio__project-list";

          for (
            const project of
            safeProjects
          ) {
            const article =
              document.createElement(
                "article",
              );

            article.className =
              "sesh-studio__project";

            const title =
              document.createElement(
                "h4",
              );

            title.textContent =
              project.title;

            article.appendChild(
              title,
            );

            if (
              typeof project.id ===
                "string" &&
              project.id
            ) {
              const manage =
                document.createElement(
                  "a",
                );

              manage.textContent =
                "Manage project";

              manage.href =
                `/sesh/studio/projects/${encodeURIComponent(
                  project.id,
                )}/`;

              article.appendChild(
                manage,
              );
            }

            if (
              typeof project.description ===
                "string" &&
              project.description.trim()
            ) {
              const description =
                document.createElement(
                  "p",
                );

              description.textContent =
                project.description;

              article.appendChild(
                description,
              );
            }

            list.appendChild(
              article,
            );
          }

          projectList.appendChild(
            list,
          );
        };

      const renderAudioProjectOptions =
        (projects) => {
          if (!audioProject) {
            return;
          }

          const previousValue =
            audioProject.value;

          audioProject.textContent =
            "";

          const placeholder =
            document.createElement(
              "option",
            );

          placeholder.value =
            "";

          placeholder.textContent =
            "Choose a project";

          audioProject.appendChild(
            placeholder,
          );

          const safeProjects =
            projects.filter(
              (project) =>
                project &&
                typeof project ===
                  "object" &&
                typeof project.id ===
                  "string" &&
                project.id &&
                typeof project.title ===
                  "string",
            );

          for (
            const project of
            safeProjects
          ) {
            const option =
              document.createElement(
                "option",
              );

            option.value =
              project.id;

            option.textContent =
              project.title;

            audioProject.appendChild(
              option,
            );
          }

          if (
            safeProjects.some(
              (project) =>
                project.id ===
                  previousValue,
            )
          ) {
            audioProject.value =
              previousValue;
          }

          if (
            safeProjects.length ===
              0
          ) {
            audioProject.disabled =
              true;

            setAudioStatus(
              "Create a project before uploading private audio.",
            );

            if (audioList) {
              audioList.textContent =
                "";
            }
          }
          else {
            audioProject.disabled =
              false;
          }
        };

      const setPrivateAudioStatus = (
  message,
  state = "",
) => {
  if (!audioStatus) {
    return;
  }

  audioStatus.textContent =
    message;

  if (state) {
    audioStatus.dataset.state =
      state;
  }
  else {
    delete audioStatus.dataset.state;
  }
};

const deleteProjectAudio =
  async (
    projectId,
    audioAssetId,
  ) => {
    const response =
      await fetch(
        `/api/sesh/projects/${encodeURIComponent(
          projectId,
        )}/audio/${encodeURIComponent(
          audioAssetId,
        )}`,
        {
          method:
            "DELETE",
        },
      );

    let body =
      null;

    try {
      body =
        await response.json();
    }
    catch {
      body =
        null;
    }

    if (
      !response.ok ||
      !body ||
      body.ok !==
        true
    ) {
      const message =
        body &&
        body.error &&
        typeof body.error.message ===
          "string"
          ? body.error.message
          : "Unable to delete private audio.";

      throw new Error(
        message,
      );
    }

    return body;
  };

const renderAudioAssets = (
  assets,
  projectId,
) => {
  if (!audioList) {
    return;
  }

  audioList.textContent =
    "";

  const sanitizedAssets =
    Array.isArray(
      assets,
    )
      ? assets.filter(
          (
            asset,
          ) =>
            asset &&
            typeof asset ===
              "object" &&
            typeof asset.id ===
              "string" &&
            asset.id &&
            typeof projectId ===
              "string" &&
            projectId,
        )
      : [];

  if (
    sanitizedAssets.length ===
    0
  ) {
    const empty =
      document.createElement(
        "p",
      );

    empty.className =
      "sesh-studio__muted";

    empty.textContent =
      "No private audio has been uploaded to this project yet.";

    audioList.append(
      empty,
    );

    return;
  }

  const list =
    document.createElement(
      "div",
    );

  list.className =
    "sesh-studio__audio-list";

  for (
    const asset of
    sanitizedAssets
  ) {
    const item =
      document.createElement(
        "article",
      );

    item.className =
      "sesh-studio__audio-item";

    const heading =
      document.createElement(
        "div",
      );

    heading.className =
      "sesh-studio__audio-heading";

    const title =
      document.createElement(
        "strong",
      );

    title.textContent =
      typeof asset.name ===
        "string" &&
      asset.name
        ? asset.name
        : "Private audio";

    heading.append(
      title,
    );

    const deleteButton =
      document.createElement(
        "button",
      );

    deleteButton.type =
      "button";

    deleteButton.className =
      "sesh-studio__audio-delete";

    deleteButton.textContent =
      "Delete";

    deleteButton.setAttribute(
      "aria-label",
      `Delete ${title.textContent}`,
    );

    deleteButton.addEventListener(
      "click",
      async () => {
        const confirmed =
          window.confirm(
            `Delete "${title.textContent}"? This permanently removes this private audio from the project.`,
          );

        if (!confirmed) {
          return;
        }

        deleteButton.disabled =
          true;

        setPrivateAudioStatus(
          "Deleting private audio…",
        );

        try {
          await deleteProjectAudio(
            projectId,
            asset.id,
          );

          await loadProjectAudio(
            projectId,
          );

          setPrivateAudioStatus(
            "Private audio deleted.",
          );
        }
        catch (error) {
          deleteButton.disabled =
            false;

          setPrivateAudioStatus(
            error instanceof Error
              ? error.message
              : "Unable to delete private audio.",
            "error",
          );
        }
      },
    );

    heading.append(
      deleteButton,
    );

    item.append(
      heading,
    );

    if (
      asset.hasStoredAudio ===
      true
    ) {
      const player =
        document.createElement(
          "audio",
        );

      player.className =
        "sesh-studio__audio-player";

      player.controls =
        true;

      player.preload =
        "metadata";

      player.src =
        `/api/sesh/projects/${encodeURIComponent(
          projectId,
        )}/audio/${encodeURIComponent(
          asset.id,
        )}/content`;

      item.append(
        player,
      );
    }

    const details =
      [];

    if (
      typeof asset.contentType ===
        "string" &&
      asset.contentType
    ) {
      details.push(
        asset.contentType,
      );
    }

    if (
      typeof asset.durationSeconds ===
        "number" &&
      Number.isFinite(
        asset.durationSeconds,
      )
    ) {
      details.push(
        `${asset.durationSeconds}s`,
      );
    }

    if (
      typeof asset.sampleRateHz ===
        "number" &&
      Number.isFinite(
        asset.sampleRateHz,
      )
    ) {
      details.push(
        `${asset.sampleRateHz} Hz`,
      );
    }

    if (
      typeof asset.channelCount ===
        "number" &&
      Number.isFinite(
        asset.channelCount,
      )
    ) {
      details.push(
        `${asset.channelCount} channel${
          asset.channelCount ===
          1
            ? ""
            : "s"
        }`,
      );
    }

    if (
      details.length >
      0
    ) {
      const detail =
        document.createElement(
          "p",
        );

      detail.className =
        "sesh-studio__muted";

      detail.textContent =
        details.join(
          " · ",
        );

      item.append(
        detail,
      );
    }

    list.append(
      item,
    );
  }

  audioList.append(
    list,
  );
};
const loadProjectAudio =
        async (
          projectId,
        ) => {
          if (
            typeof projectId !==
              "string" ||
            !projectId
          ) {
            if (audioList) {
              audioList.textContent =
                "";
            }

            setAudioStatus(
              "Choose a project to view its private audio.",
            );

            return;
          }

          setAudioStatus(
            "Loading private audio…",
          );

          if (audioList) {
            audioList.innerHTML =
              '<p class="sesh-studio__muted">Loading private audio…</p>';
          }

          try {
            const {
              response,
              body,
            } =
              await fetchJson(
                `/api/sesh/projects/${encodeURIComponent(
                  projectId,
                )}/audio/`,
              );

            if (!response.ok) {
              if (audioList) {
                audioList.textContent =
                  "";
              }

              setAudioStatus(
                errorMessage(
                  body,
                  "Private audio is temporarily unavailable.",
                ),
                true,
              );

              return;
            }

            renderAudioAssets(
              audioAssetsFrom(
                body,
              ),
              projectId,
            );

            setAudioStatus(
              "Private audio is up to date.",
            );
          }
          catch {
            if (audioList) {
              audioList.textContent =
                "";
            }

            setAudioStatus(
              "Private audio is temporarily unavailable.",
              true,
            );
          }
        };
      const loadProjects =
        async () => {
          if (projectList) {
            projectList.innerHTML =
              '<p class="sesh-studio__muted">Loading projects…</p>';
          }

          try {
            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/sesh/projects",
              );

            if (!response.ok) {
              if (projectList) {
                projectList.innerHTML =
                  '<p class="sesh-studio__muted">Projects are temporarily unavailable.</p>';
              }

              return;
            }

            const projects =
              projectsFrom(
                body,
              );

            renderProjects(
              projects,
            );

            renderAudioProjectOptions(
              projects,
            );
          }
          catch {
            if (projectList) {
              projectList.innerHTML =
                '<p class="sesh-studio__muted">Projects are temporarily unavailable.</p>';
            }
          }
        };

      const refreshStudio =
        async () => {
          setStatus(
            "Loading your Studio…",
          );

          try {
            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/sesh/creator/profile",
              );

            if (
              response.status ===
                401
            ) {
              showOnly(
                signIn,
              );

              setStatus(
                "Sign in to open your creator workspace.",
              );

              return;
            }

            if (
              response.status ===
                403 ||
              response.status ===
                404
            ) {
              showOnly(
                provision,
              );

              setStatus(
                "Your River account is signed in. Create your Sesh creator profile to continue.",
              );

              return;
            }

            if (!response.ok) {
              showOnly(
                null,
              );

              setStatus(
                errorMessage(
                  body,
                  "Sesh Studio is temporarily unavailable.",
                ),
                true,
              );

              return;
            }

            const profile =
              profileFrom(
                body,
              );

            if (!profile) {
              showOnly(
                null,
              );

              setStatus(
                "Sesh Studio could not read your creator profile.",
                true,
              );

              return;
            }

            renderProfile(
              profile,
            );

            showOnly(
              main,
            );

            setStatus(
              "Studio ready.",
            );

            await loadProjects();
          }
          catch {
            showOnly(
              null,
            );

            setStatus(
              "Sesh Studio is temporarily unavailable.",
              true,
            );
          }
        };

      if (loginForm) {
        loginForm.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            const form =
              new FormData(
                loginForm,
              );

            const email =
              String(
                form.get(
                  "email",
                ) ??
                  "",
              );

            const password =
              String(
                form.get(
                  "password",
                ) ??
                  "",
              );

            setStatus(
              "Signing in…",
            );

            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/identity/login",
                {
                  method:
                    "POST",

                  headers: {
                    "content-type":
                      "application/json",
                  },

                  body:
                    JSON.stringify({
                      email,
                      password,
                    }),
                },
              );

            if (!response.ok) {
              setStatus(
                errorMessage(
                  body,
                  "Unable to sign in.",
                ),
                true,
              );

              return;
            }

            loginForm.reset();

            await refreshStudio();
          },
        );
      }

      if (provisionForm) {
        provisionForm.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            const form =
              new FormData(
                provisionForm,
              );

            const displayName =
              String(
                form.get(
                  "displayName",
                ) ??
                  "",
              ).trim();

            setStatus(
              "Creating your creator profile…",
            );

            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/sesh/creator/provision",
                {
                  method:
                    "POST",

                  headers: {
                    "content-type":
                      "application/json",
                  },

                  body:
                    JSON.stringify({
                      displayName,
                    }),
                },
              );

            if (!response.ok) {
              setStatus(
                errorMessage(
                  body,
                  "Unable to create your creator profile.",
                ),
                true,
              );

              return;
            }

            await refreshStudio();
          },
        );
      }

      if (profileForm) {
        profileForm.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            const form =
              new FormData(
                profileForm,
              );

            const displayName =
              String(
                form.get(
                  "displayName",
                ) ??
                  "",
              ).trim();

            const bio =
              String(
                form.get(
                  "bio",
                ) ??
                  "",
              ).trim();

            const update = {
              displayName,
            };

            if (bio) {
              update.bio =
                bio;
            }

            setStatus(
              "Saving profile…",
            );

            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/sesh/creator/profile",
                {
                  method:
                    "PATCH",

                  headers: {
                    "content-type":
                      "application/json",
                  },

                  body:
                    JSON.stringify(
                      update,
                    ),
                },
              );

            if (!response.ok) {
              setStatus(
                errorMessage(
                  body,
                  "Unable to save your profile.",
                ),
                true,
              );

              return;
            }

            setStatus(
              "Profile saved.",
            );

            await refreshStudio();
          },
        );
      }

      if (handleForm) {
        handleForm.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            const form =
              new FormData(
                handleForm,
              );

            const handle =
              String(
                form.get(
                  "handle",
                ) ??
                  "",
              ).trim();

            setStatus(
              "Claiming handle…",
            );

            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/sesh/creator/handle",
                {
                  method:
                    "POST",

                  headers: {
                    "content-type":
                      "application/json",
                  },

                  body:
                    JSON.stringify({
                      handle,
                    }),
                },
              );

            if (!response.ok) {
              setStatus(
                errorMessage(
                  body,
                  "Unable to claim that handle.",
                ),
                true,
              );

              return;
            }

            setStatus(
              "Handle claimed.",
            );

            await refreshStudio();
          },
        );
      }

      if (audioProject) {
        audioProject.addEventListener(
          "change",
          async () => {
            await loadProjectAudio(
              audioProject.value,
            );
          },
        );
      }

      if (
        audioFile &&
        audioName
      ) {
        audioFile.addEventListener(
          "change",
          () => {
            const files =
              audioFile.files;

            if (
              !files ||
              files.length !==
                1
            ) {
              return;
            }

            const file =
              files[0];

            if (
              !audioName.value.trim()
            ) {
              audioName.value =
                file.name.replace(
                  /\.wav$/i,
                  "",
                );
            }
          },
        );
      }

      if (audioForm) {
        audioForm.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            const projectId =
              audioProject
                ? audioProject.value
                : "";

            const files =
              audioFile
                ? audioFile.files
                : null;

            const name =
              audioName
                ? audioName.value.trim()
                : "";

            if (!projectId) {
              setAudioStatus(
                "Choose a project before uploading audio.",
                true,
              );

              return;
            }

            if (
              !files ||
              files.length !==
                1
            ) {
              setAudioStatus(
                "Choose one WAV file to upload.",
                true,
              );

              return;
            }

            const file =
              files[0];

            if (
              !/\.wav$/i.test(
                file.name,
              )
            ) {
              setAudioStatus(
                "Choose a WAV file.",
                true,
              );

              return;
            }

            if (
              file.size <=
                0
            ) {
              setAudioStatus(
                "The selected WAV file is empty.",
                true,
              );

              return;
            }

            if (
              file.size >
                26214400
            ) {
              setAudioStatus(
                "The selected WAV file is larger than 25 MiB.",
                true,
              );

              return;
            }

            if (!name) {
              setAudioStatus(
                "Give this recording a name.",
                true,
              );

              return;
            }

            setAudioBusy(
              true,
            );

            setAudioStatus(
              "Uploading private audio…",
            );

            try {
              const {
                response,
                body,
              } =
                await fetchJson(
                  `/api/sesh/projects/${encodeURIComponent(
                    projectId,
                  )}/audio/`,
                  {
                    method:
                      "POST",

                    headers: {
                      "content-type":
                        "audio/wav",

                      "x-sesh-audio-name":
                        name,
                    },

                    body:
                      file,
                  },
                );

              if (!response.ok) {
                setAudioStatus(
                  errorMessage(
                    body,
                    "Unable to upload private audio.",
                  ),
                  true,
                );

                return;
              }

              if (audioFile) {
                audioFile.value =
                  "";
              }

              if (audioName) {
                audioName.value =
                  "";
              }

              setAudioStatus(
                "Private audio uploaded.",
              );

              await loadProjectAudio(
                projectId,
              );
            }
            catch {
              setAudioStatus(
                "Unable to upload private audio.",
                true,
              );
            }
            finally {
              setAudioBusy(
                false,
              );
            }
          },
        );
      }
      if (projectForm) {
        projectForm.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            const form =
              new FormData(
                projectForm,
              );

            const title =
              String(
                form.get(
                  "title",
                ) ??
                  "",
              ).trim();

            setStatus(
              "Creating project…",
            );

            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/sesh/projects",
                {
                  method:
                    "POST",

                  headers: {
                    "content-type":
                      "application/json",
                  },

                  body:
                    JSON.stringify({
                      title,
                    }),
                },
              );

            if (!response.ok) {
              setStatus(
                errorMessage(
                  body,
                  "Unable to create the project.",
                ),
                true,
              );

              return;
            }

            projectForm.reset();

            setStatus(
              "Project created.",
            );

            await loadProjects();
          },
        );
      }

      const logout =
        async () => {
          setStatus(
            "Signing out…",
          );

          try {
            const {
              response,
              body,
            } =
              await fetchJson(
                "/api/identity/logout",
                {
                  method:
                    "POST",
                },
              );

            if (!response.ok) {
              setStatus(
                errorMessage(
                  body,
                  "Unable to sign out.",
                ),
                true,
              );

              return;
            }

            await refreshStudio();
          }
          catch {
            setStatus(
              "Unable to sign out.",
              true,
            );
          }
        };

      if (logoutButton) {
        logoutButton.addEventListener(
          "click",
          logout,
        );
      }

      if (provisionLogout) {
        provisionLogout.addEventListener(
          "click",
          logout,
        );
      }

      refreshStudio();
    })();
  </script>

