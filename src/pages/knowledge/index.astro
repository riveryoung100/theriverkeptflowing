---
import MainLayout from "../../layouts/MainLayout.astro";
import ContentCard from "../../components/content/ContentCard.astro";
import {
    getKnowledgeGraph
} from "../../lib/knowledgeGraph";

const graph =
    await getKnowledgeGraph();

const canonical =
    new URL(
        "/knowledge/",
        Astro.site ?? Astro.url
    ).toString();

const description =
    "Explore how the published work of The River Kept Flowing connects through shared ideas, subjects, and practical questions.";

const strongestConnections =
    graph.edges.slice(
        0,
        12
    );

const mostConnectedEntries =
    graph.nodes.slice(
        0,
        6
    );

const collectionPageSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name:
        "The River Knowledge Graph",
    description,
    url: canonical,
    mainEntity: {
        "@type": "ItemList",
        numberOfItems:
            graph.nodes.length,
        itemListElement:
            graph.nodes.map(
                (node, index) => ({
                    "@type": "ListItem",
                    position:
                        index + 1,
                    name:
                        node.title,
                    url: new URL(
                        node.href,
                        canonical
                    ).toString()
                })
            )
    }
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item:
                "https://theriverkeptflowing.com/"
        },
        {
            "@type": "ListItem",
            position: 2,
            name:
                "Knowledge Graph",
            item: canonical
        }
    ]
};
---

<MainLayout
    title="The River Knowledge Graph | The River Kept Flowing"
    description={description}
    canonical={canonical}
    stylesheet="/knowledge.css"
>

    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(
            collectionPageSchema
        )}
    ></script>

    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(
            breadcrumbSchema
        )}
    ></script>


    <main
        class="knowledge-page"
        data-pagefind-body
    >

        <header class="knowledge-hero">

            <p class="knowledge-eyebrow">
                The River Library
            </p>

            <h1>
                The River Knowledge Graph
            </h1>

            <p class="knowledge-introduction">
                Every published work becomes more useful
                when its connections are visible. This
                map shows how guides, essays, letters,
                journal entries, recipes, and films meet
                through shared ideas.
            </p>

            <div class="knowledge-summary">

                <span>
                    {graph.nodes.length}
                    {
                        graph.nodes.length === 1
                            ? " published work"
                            : " published works"
                    }
                </span>

                <span aria-hidden="true">
                    Â·
                </span>

                <span>
                    {graph.edges.length}
                    {
                        graph.edges.length === 1
                            ? " connection"
                            : " connections"
                    }
                </span>

                <span aria-hidden="true">
                    Â·
                </span>

                <span>
                    {graph.topics.length}
                    {
                        graph.topics.length === 1
                            ? " topic"
                            : " topics"
                    }
                </span>

            </div>

        </header>


        <section
            class="knowledge-section"
            aria-labelledby="connected-work-title"
        >

            <div class="knowledge-section-heading">

                <p>
                    Central works
                </p>

                <h2 id="connected-work-title">
                    Most Connected
                </h2>

                <p>
                    These works currently share the
                    greatest number of meaningful
                    relationships across the library.
                </p>

            </div>


            <div class="knowledge-card-grid">

                {
                    mostConnectedEntries.map(
                        (entry) => (

                            <div class="knowledge-node">

                                <div
                                    class="knowledge-node-score"
                                    aria-label={`${entry.connectionCount} connections with a total relationship weight of ${entry.totalWeight}`}
                                >

                                    <span>
                                        {
                                            entry.connectionCount
                                        }
                                        {
                                            entry.connectionCount === 1
                                                ? " connection"
                                                : " connections"
                                        }
                                    </span>

                                    <span>
                                        Weight {
                                            entry.totalWeight
                                        }
                                    </span>

                                </div>

                                <ContentCard
                                    type={entry.type}
                                    title={entry.title}
                                    description={
                                        entry.description
                                    }
                                    href={entry.href}
                                    number={entry.number}
                                    tags={entry.tags}
                                    published={
                                        entry.published
                                    }
                                    readingMinutes={
                                        entry.readingMinutes
                                    }
                                    featured={
                                        entry.featured
                                    }
                                    action="Explore"
                                />

                            </div>

                        )
                    )
                }

            </div>

        </section>


        <section
            class="knowledge-section"
            aria-labelledby="strongest-connections-title"
        >

            <div class="knowledge-section-heading">

                <p>
                    Shared ideas
                </p>

                <h2 id="strongest-connections-title">
                    Strongest Connections
                </h2>

                <p>
                    A stronger connection means two
                    works currently share more published
                    topics.
                </p>

            </div>


            <div
                class="knowledge-explorer-controls"
                data-knowledge-explorer
            >

                <label class="knowledge-explorer-field">

                    <span>
                        Search connections
                    </span>

                    <input
                        type="search"
                        placeholder="Search works or topics"
                        autocomplete="off"
                        data-knowledge-search
                    />

                </label>


                <label class="knowledge-explorer-field">

                    <span>
                        Relationship
                    </span>

                    <select
                        data-knowledge-relationship-filter
                    >

                        <option value="all">
                            All relationships
                        </option>

                        <option value="prerequisite">
                            Prerequisite
                        </option>

                        <option value="next-reading">
                            Next reading
                        </option>

                        <option value="learning-path">
                            Learning path
                        </option>

                    </select>

                </label>


                <p
                    class="knowledge-explorer-results"
                    aria-live="polite"
                    data-knowledge-results
                >
                    Showing {strongestConnections.length}
                    connections
                </p>

            </div>


            {
                strongestConnections.length > 0
                    ? (
                        <div class="knowledge-connections">

                            {
                                strongestConnections.map(
                                    (connection) => (

                                        <article
                                            class="knowledge-connection"
                                            data-knowledge-connection
                                            data-relationship={
                                                connection
                                                    .relationshipType
                                            }
                                            data-search-text={
                                                [
                                                    connection
                                                        .sourceEntry
                                                        .title,
                                                    connection
                                                        .targetEntry
                                                        .title,
                                                    connection
                                                        .relationshipLabel,
                                                    ...connection
                                                        .sharedTopics
                                                ]
                                                    .join(" ")
                                                    .toLowerCase()
                                            }
                                            data-pagefind-ignore
                                        >

                                            <div class="knowledge-connection-score">

                                                <span>
                                                    Weight
                                                </span>

                                                <strong>
                                                    {
                                                        connection.weight
                                                    }
                                                </strong>

                                                <span
                                                    class="knowledge-relationship-badge"
                                                    data-relationship={
                                                        connection
                                                            .relationshipType
                                                    }
                                                >
                                                    {
                                                        connection
                                                            .relationshipLabel
                                                    }
                                                </span>

                                            </div>


                                            <div class="knowledge-connection-work">

                                                <a
                                                    href={
                                                        connection
                                                            .sourceEntry
                                                            .href
                                                    }
                                                >
                                                    {
                                                        connection
                                                            .sourceEntry
                                                            .title
                                                    }
                                                </a>

                                                <span
                                                    class="knowledge-connection-direction"
                                                    aria-hidden="true"
                                                >
                                                    {
                                                        connection.directed
                                                            ? "â†’"
                                                            : "â†”"
                                                    }
                                                </span>

                                                <a
                                                    href={
                                                        connection
                                                            .targetEntry
                                                            .href
                                                    }
                                                >
                                                    {
                                                        connection
                                                            .targetEntry
                                                            .title
                                                    }
                                                </a>

                                            </div>


                                            <div class="knowledge-shared-topics">

                                                {
                                                    connection.sharedTopics.map(
                                                        (topic) => (

                                                            <span>
                                                                {topic}
                                                            </span>

                                                        )
                                                    )
                                                }

                                            </div>

                                        </article>

                                    )
                                )
                            }



                            <p
                                class="knowledge-empty"
                                hidden
                                data-knowledge-no-results
                            >
                                No connections match
                                the current search and
                                relationship filter.
                            </p>
                        </div>
                    )
                    : (
                        <p class="knowledge-empty">
                            Connections will appear as
                            more published work enters the
                            River Library.
                        </p>
                    )
            }

        </section>


        <section
            class="knowledge-section"
            aria-labelledby="knowledge-topics-title"
        >

            <div class="knowledge-section-heading">

                <p>
                    Current vocabulary
                </p>

                <h2 id="knowledge-topics-title">
                    Connected Topics
                </h2>

            </div>


            <div class="knowledge-topics">

                {
                    graph.topics.map((topic) => {

                        const slug =
                            topic
                                .normalize("NFKD")
                                .replace(
                                    /[\u0300-\u036f]/g,
                                    ""
                                )
                                .toLowerCase()
                                .replace(
                                    /[^a-z0-9]+/g,
                                    "-"
                                )
                                .replace(
                                    /^-+|-+$/g,
                                    ""
                                );


                        return (

                            <a
                                href={`/topics/${slug}/`}
                            >
                                {topic}
                            </a>

                        );

                    })
                }

            </div>

        </section>


        <footer class="knowledge-footer">

            <a href="/library/">
                â† Visit the Library
            </a>

            <a href="/topics/">
                Browse all topics â†’
            </a>

        </footer>

    </main>

</MainLayout>


<script>
    function knowledgeExplorer() {

        const explorer =
            document.querySelector<HTMLElement>(
                "[data-knowledge-explorer]"
            );


        if (
            !explorer ||
            explorer.dataset.initialized ===
                "true"
        ) {

            return;

        }


        const searchInput =
            explorer.querySelector<HTMLInputElement>(
                "[data-knowledge-search]"
            );

        const relationshipFilter =
            explorer.querySelector<HTMLSelectElement>(
                "[data-knowledge-relationship-filter]"
            );

        const results =
            explorer.querySelector<HTMLElement>(
                "[data-knowledge-results]"
            );

        const noResults =
            document.querySelector<HTMLElement>(
                "[data-knowledge-no-results]"
            );

        const cards =
            Array.from(
                document.querySelectorAll<HTMLElement>(
                    "[data-knowledge-connection]"
                )
            );


        if (
            !searchInput ||
            !relationshipFilter ||
            !results ||
            !noResults
        ) {

            return;

        }


        explorer.dataset.initialized =
            "true";


        const applyFilters = () => {

            const query =
                searchInput.value
                    .trim()
                    .toLowerCase();

            const selectedRelationship =
                relationshipFilter.value;

            let visibleCount =
                0;


            for (const card of cards) {

                const searchText =
                    card.dataset.searchText ??
                    "";

                const relationship =
                    card.dataset.relationship ??
                    "";

                const matchesSearch =
                    !query ||
                    searchText.includes(query);

                const matchesRelationship =
                    selectedRelationship ===
                        "all" ||
                    relationship ===
                        selectedRelationship;

                const isVisible =
                    matchesSearch &&
                    matchesRelationship;


                card.hidden =
                    !isVisible;


                if (isVisible) {

                    visibleCount += 1;

                }

            }


            results.textContent =
                `Showing ${visibleCount} of ${cards.length} connections`;

            noResults.hidden =
                visibleCount !== 0;

        };


        searchInput.addEventListener(
            "input",
            applyFilters
        );

        relationshipFilter.addEventListener(
            "change",
            applyFilters
        );


        applyFilters();

    }


    knowledgeExplorer();

    document.addEventListener(
        "astro:page-load",
        knowledgeExplorer
    );
</script>
