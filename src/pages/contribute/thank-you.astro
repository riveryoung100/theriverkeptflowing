---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
    title="Thank You | The River Kept Flowing"
    description="Thank you for contributing to The River Kept Flowing."
    stylesheet="/contribute.css"
>

    <main data-pagefind-body class="contribute-page">

        <section class="contribute-hero">

            <div class="contribute-shell contribute-shell--reading">

                <p class="eyebrow">
                    Thank you
                </p>

                <h1>
                    You helped the river keep flowing.
                </h1>

                <p class="contribute-hero__lead">
                    Your contribution helps carry this work forward through
                    publishing, education, service, community care, and the
                    continued building of something meant to last.
                </p>

                <a
                    href="/"
                    class="button contribute-button-primary"
                >
                    Return to the River
                </a>

            </div>

        </section>

    </main>

</MainLayout>