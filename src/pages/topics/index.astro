---
import MainLayout from "../../layouts/MainLayout.astro";
import {
    getTopicArchives
} from "../../lib/topics";

const topics =
    await getTopicArchives();

const canonical =
    new URL(
        "/topics/",
        Astro.site ?? Astro.url
    ).toString();

const totalEntries =
    new Set(
        topics.flatMap((topic) => {
            return topic.entries.map(
                (entry) => {
                    return `${entry.collection}:${entry.id}`;
                }
            );
        })
    ).size;

const collectionPageSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Topics | The River Kept Flowing",
    description:
        "Explore the River Library by subject, including insurance, protection, stewardship, family, liability, and practical decisions.",
    url: canonical,
    mainEntity: {
        "@type": "ItemList",
        numberOfItems: topics.length,
        itemListElement: topics.map(
            (topic, index) => ({
                "@type": "ListItem",
                position: index + 1,
                name: topic.name,
                url: new URL(
                    `/topics/${topic.slug}/`,
                    canonical
                ).toString()
            })
        )
    }
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item:
                "https://theriverkeptflowing.com/"
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Topics",
            item: canonical
        }
    ]
};
---

<MainLayout
    title="Topics | The River Kept Flowing"
    description="Explore the River Library by subject, including insurance, protection, stewardship, family, liability, and practical decisions."
    canonical={canonical}
>

    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(
            collectionPageSchema
        )}
    ></script>

    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(
            breadcrumbSchema
        )}
    ></script>


    <main
        class="topics-page"
        data-pagefind-body
    >

        <section class="topics-hero">

            <p class="topics-eyebrow">
                The River Library
            </p>

            <h1>
                Explore by Topic
            </h1>

            <p class="topics-introduction">
                Follow a subject across the growing
                River Library. Each page gathers every
                published guide, essay, letter, journal
                entry, recipe, and film connected to
                that topic.
            </p>

            <div class="topics-summary">

                <span>
                    {topics.length} topics
                </span>

                <span aria-hidden="true">
                    ·
                </span>

                <span>
                    {totalEntries} published works
                </span>

            </div>

        </section>


        <section
            class="topics-directory"
            aria-labelledby="topics-directory-title"
        >

            <div class="topics-section-heading">

                <p>
                    Browse the current archive
                </p>

                <h2 id="topics-directory-title">
                    All Topics
                </h2>

            </div>


            {
                topics.length > 0
                    ? (
                        <div class="topics-grid">

                            {
                                topics.map((topic) => (

                                    <article
                                        class="topic-card"
                                        data-pagefind-ignore
                                    >

                                        <a
                                            href={`/topics/${topic.slug}/`}
                                        >

                                            <p class="topic-count">
                                                {
                                                    topic.entries.length
                                                }
                                                {
                                                    topic.entries.length === 1
                                                        ? " work"
                                                        : " works"
                                                }
                                            </p>

                                            <h3>
                                                {topic.name}
                                            </h3>

                                            <p>
                                                Explore everything currently
                                                published about {
                                                    topic.name
                                                }.
                                            </p>

                                            <span>
                                                View topic →
                                            </span>

                                        </a>

                                    </article>

                                ))
                            }

                        </div>
                    )
                    : (
                        <p class="topics-empty">
                            No published topics are
                            available yet.
                        </p>
                    )
            }

        </section>

    </main>

</MainLayout>


<style>

    .topics-page {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
        padding: 96px 0 120px;
    }


    .topics-hero {
        max-width: 820px;
        margin-bottom: 72px;
    }


    .topics-eyebrow,
    .topics-section-heading p {
        margin: 0 0 14px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        opacity: 0.72;
    }


    .topics-hero h1,
    .topics-section-heading h2 {
        margin: 0;
        line-height: 1.04;
    }


    .topics-hero h1 {
        font-size: clamp(2.8rem, 7vw, 5.8rem);
    }


    .topics-introduction {
        max-width: 720px;
        margin: 26px 0 0;
        font-size: clamp(1.05rem, 2vw, 1.28rem);
        line-height: 1.75;
    }


    .topics-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 28px;
        font-size: 0.94rem;
        opacity: 0.72;
    }


    .topics-section-heading {
        margin-bottom: 28px;
    }


    .topics-section-heading h2 {
        font-size: clamp(2rem, 4vw, 3.4rem);
    }


    .topics-grid {
        display: grid;
        grid-template-columns:
            repeat(
                auto-fit,
                minmax(240px, 1fr)
            );
        gap: 18px;
    }


    .topic-card {
        min-height: 250px;
        border: 1px solid
            color-mix(
                in srgb,
                currentColor 16%,
                transparent
            );
        border-radius: 20px;
        overflow: hidden;
    }


    .topic-card a {
        display: flex;
        min-height: 100%;
        flex-direction: column;
        padding: 28px;
        color: inherit;
        text-decoration: none;
    }


    .topic-card h3 {
        margin: 22px 0 14px;
        font-size: 1.55rem;
        line-height: 1.15;
    }


    .topic-card p {
        line-height: 1.65;
    }


    .topic-count {
        margin: 0;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0.66;
    }


    .topic-card span {
        margin-top: auto;
        padding-top: 28px;
        font-weight: 700;
    }


    .topic-card a:hover,
    .topic-card a:focus-visible {
        background:
            color-mix(
                in srgb,
                currentColor 5%,
                transparent
            );
    }


    .topics-empty {
        padding: 32px;
        border: 1px solid
            color-mix(
                in srgb,
                currentColor 16%,
                transparent
            );
        border-radius: 18px;
    }


    @media (max-width: 640px) {

        .topics-page {
            width: min(100% - 24px, 1180px);
            padding: 72px 0 88px;
        }


        .topics-hero {
            margin-bottom: 56px;
        }


        .topic-card {
            min-height: 220px;
        }

    }

</style>