---
import MainLayout from "../../layouts/MainLayout.astro";
import ContentCard from "../../components/content/ContentCard.astro";
import {
    getTopicArchives,
    type TopicArchive
} from "../../lib/topics";

export async function getStaticPaths() {

    const topics =
        await getTopicArchives();


    return topics.map((topic) => ({
        params: {
            slug: topic.slug
        },
        props: {
            topic
        }
    }));

}

interface Props {
    topic: TopicArchive;
}

const {
    topic
} = Astro.props;

const canonical =
    new URL(
        `/topics/${topic.slug}/`,
        Astro.site ?? Astro.url
    ).toString();

const description =
    `Explore every published River Library work connected to ${topic.name}.`;

const itemListSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${topic.name} | The River Kept Flowing`,
    description,
    url: canonical,
    mainEntity: {
        "@type": "ItemList",
        numberOfItems: topic.entries.length,
        itemListElement: topic.entries.map(
            (entry, index) => ({
                "@type": "ListItem",
                position: index + 1,
                name: entry.title,
                url: new URL(
                    entry.href,
                    canonical
                ).toString()
            })
        )
    }
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item:
                "https://theriverkeptflowing.com/"
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Topics",
            item:
                "https://theriverkeptflowing.com/topics/"
        },
        {
            "@type": "ListItem",
            position: 3,
            name: topic.name,
            item: canonical
        }
    ]
};
---

<MainLayout
    title={`${topic.name} | The River Kept Flowing`}
    description={description}
    canonical={canonical}
>

    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(
            itemListSchema
        )}
    ></script>

    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(
            breadcrumbSchema
        )}
    ></script>


    <main
        class="topic-archive-page"
        data-pagefind-body
    >

        <nav
            class="topic-breadcrumbs"
            aria-label="Breadcrumb"
        >

            <a href="/">
                Home
            </a>

            <span aria-hidden="true">
                /
            </span>

            <a href="/topics/">
                Topics
            </a>

            <span aria-hidden="true">
                /
            </span>

            <span aria-current="page">
                {topic.name}
            </span>

        </nav>


        <header class="topic-archive-header">

            <p class="topic-eyebrow">
                Topic Archive
            </p>

            <h1>
                {topic.name}
            </h1>

            <p>
                {
                    topic.entries.length === 1
                        ? `One published work currently explores ${topic.name}.`
                        : `${topic.entries.length} published works currently explore ${topic.name}.`
                }
            </p>

        </header>


        <section
            class="topic-results"
            aria-labelledby="topic-results-title"
        >

            <div class="topic-results-heading">

                <p>
                    From across the River Library
                </p>

                <h2 id="topic-results-title">
                    Published Work
                </h2>

            </div>


            <div class="topic-content-grid">

                {
                    topic.entries.map((entry) => (

                        <ContentCard
                            type={entry.type}
                            title={entry.title}
                            description={
                                entry.description
                            }
                            href={entry.href}
                            number={entry.number}
                            tags={entry.tags}
                            published={
                                entry.published
                            }
                            readingMinutes={
                                entry.readingMinutes
                            }
                            featured={
                                entry.featured
                            }
                            action="Read"
                        />

                    ))
                }

            </div>

        </section>


        <footer class="topic-archive-footer">

            <a href="/topics/">
                ← Browse all topics
            </a>

            <a href="/library/">
                Visit the complete Library →
            </a>

        </footer>

    </main>

</MainLayout>


<style>

    .topic-archive-page {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
        padding: 72px 0 120px;
    }


    .topic-breadcrumbs {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 72px;
        font-size: 0.88rem;
        opacity: 0.72;
    }


    .topic-breadcrumbs a {
        color: inherit;
    }


    .topic-archive-header {
        max-width: 840px;
        margin-bottom: 76px;
    }


    .topic-eyebrow,
    .topic-results-heading p {
        margin: 0 0 14px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        opacity: 0.7;
    }


    .topic-archive-header h1 {
        margin: 0;
        font-size: clamp(2.8rem, 7vw, 5.8rem);
        line-height: 1.04;
    }


    .topic-archive-header > p:last-child {
        max-width: 680px;
        margin: 26px 0 0;
        font-size: clamp(1.05rem, 2vw, 1.24rem);
        line-height: 1.7;
    }


    .topic-results-heading {
        margin-bottom: 28px;
    }


    .topic-results-heading h2 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3.2rem);
        line-height: 1.08;
    }


    .topic-content-grid {
        display: grid;
        grid-template-columns:
            repeat(
                auto-fit,
                minmax(280px, 1fr)
            );
        gap: 22px;
    }


    .topic-archive-footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 20px;
        margin-top: 72px;
        padding-top: 28px;
        border-top: 1px solid
            color-mix(
                in srgb,
                currentColor 16%,
                transparent
            );
    }


    .topic-archive-footer a {
        color: inherit;
        font-weight: 700;
    }


    @media (max-width: 640px) {

        .topic-archive-page {
            width: min(100% - 24px, 1180px);
            padding: 56px 0 88px;
        }


        .topic-breadcrumbs {
            margin-bottom: 52px;
        }


        .topic-archive-header {
            margin-bottom: 56px;
        }


        .topic-content-grid {
            grid-template-columns: 1fr;
        }


        .topic-archive-footer {
            flex-direction: column;
        }

    }

</style>