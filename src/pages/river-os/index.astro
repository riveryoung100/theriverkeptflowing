---
import RiverOsLayout from "../../layouts/RiverOsLayout.astro";

export const prerender =
    false;
---

<style>
    .hub-hero {
        display:
            grid;
        gap:
            1rem;
        max-width:
            760px;
        padding:
            5rem 0 3rem;
    }

    .eyebrow {
        margin:
            0;
        color:
            var(--river-water);
        font-size:
            0.76rem;
        font-weight:
            800;
        letter-spacing:
            0.16em;
        text-transform:
            uppercase;
    }

    h1 {
        margin:
            0;
        font-family:
            var(--river-serif);
        font-size:
            clamp(2.8rem, 6vw, 5.6rem);
        font-weight:
            400;
        line-height:
            0.96;
        letter-spacing:
            -0.045em;
    }

    .hub-copy {
        max-width:
            650px;
        margin:
            0;
        color:
            var(--river-text-soft);
        font-size:
            1.05rem;
    }

    .workspace-grid {
        display:
            grid;
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
        gap:
            1rem;
    }

    .workspace-card {
        display:
            grid;
        gap:
            1.25rem;
        min-height:
            230px;
        padding:
            1.6rem;
        border:
            1px solid var(--river-line);
        border-radius:
            20px;
        background:
            rgba(255, 253, 248, 0.72);
    }

    .workspace-card.available {
        background:
            var(--river-white);
    }

    .workspace-card-head {
        display:
            flex;
        align-items:
            flex-start;
        justify-content:
            space-between;
        gap:
            1rem;
    }

    .workspace-card h2 {
        margin:
            0;
        font-family:
            var(--river-serif);
        font-size:
            1.65rem;
        font-weight:
            400;
    }

    .status {
        flex:
            none;
        border:
            1px solid var(--river-line);
        border-radius:
            999px;
        color:
            var(--river-text-muted);
        font-size:
            0.7rem;
        font-weight:
            800;
        letter-spacing:
            0.1em;
        text-transform:
            uppercase;
        padding:
            0.4rem 0.65rem;
    }

    .status.ready {
        border-color:
            rgba(41, 72, 58, 0.24);
        color:
            var(--river-forest);
    }

    .workspace-card p {
        margin:
            0;
        color:
            var(--river-text-soft);
    }

    .workspace-link {
        align-self:
            end;
        width:
            fit-content;
        color:
            var(--river-forest-deep);
        font-size:
            0.88rem;
        font-weight:
            800;
        text-decoration:
            none;
    }

    .planned-note {
        align-self:
            end;
        color:
            var(--river-text-muted);
        font-size:
            0.82rem;
        font-weight:
            700;
    }

    .foundation {
        margin-top:
            1rem;
        padding:
            1.4rem 1.6rem;
        border:
            1px solid var(--river-line);
        border-radius:
            18px;
    }

    .foundation strong {
        display:
            block;
        margin-bottom:
            0.35rem;
        font-family:
            var(--river-serif);
        font-size:
            1.2rem;
        font-weight:
            400;
    }

    .foundation p {
        margin:
            0;
        color:
            var(--river-text-soft);
        font-size:
            0.9rem;
    }

    @media (
        max-width: 760px
    ) {
        .workspace-grid {
            grid-template-columns:
                1fr;
        }

        .hub-hero {
            padding-top:
                3.5rem;
        }
    }
</style>

<RiverOsLayout
    title="River OS | The River Kept Flowing"
    workspaceVariant="dashboard"
    activeSection="overview"
>
    <section class="hub-hero">
        <p class="eyebrow">
            River OS
        </p>

        <h1>
            Operating workspace
        </h1>

        <p class="hub-copy">
            One private system for the work behind The River Kept Flowing.
            Content is the first operational workspace; the remaining
            domains will connect here as their governed foundations are built.
        </p>
    </section>

    <section
        class="workspace-grid"
        aria-label="River OS workspaces"
    >
        <article class="workspace-card available">
            <div class="workspace-card-head">
                <h2>
                    Content
                </h2>

                <span class="status ready">
                    Available
                </span>
            </div>

            <p>
                Canonical sources, transcript readiness, ingestion state,
                content-engine planning, and repurposing workflows.
            </p>

            <a
                class="workspace-link"
                href="/river-os/content"
            >
                Open Content Workspace →
            </a>
        </article>

        <article class="workspace-card available">
            <div class="workspace-card-head">
                <h2>
                    CRM
                </h2>

                <span class="status ready">
                    Available
                </span>
            </div>

            <p>
                Leads, relationships, pipelines, follow-up, appointments,
                routing, and future sales-team workflows.
            </p>

            <a
                class="workspace-link"
                href="/river-os/crm"
            >
                Open CRM Workspace →
            </a>
        </article>

        <article class="workspace-card">
            <div class="workspace-card-head">
                <h2>
                    Operations
                </h2>

                <span class="status">
                    Planned
                </span>
            </div>

            <p>
                Team workflows, permissions, fulfillment, quality control,
                and the operating layer behind delivery.
            </p>

            <span class="planned-note">
                Not connected yet
            </span>
        </article>

        <article class="workspace-card">
            <div class="workspace-card-head">
                <h2>
                    Analytics
                </h2>

                <span class="status">
                    Planned
                </span>
            </div>

            <p>
                Cross-system reporting for content, leads, revenue,
                conversion, operations, and long-term decision support.
            </p>

            <span class="planned-note">
                Not connected yet
            </span>
        </article>
    </section>

    <aside class="foundation">
        <strong>
            Built to expand without pretending unfinished systems are live.
        </strong>

        <p>
            Only operational River OS workspaces receive navigation routes.
            Planned domains remain visible here until their real foundations exist.
        </p>
    </aside>
</RiverOsLayout>
