---
export const prerender =
    false;

Astro.response.headers.set(
    "cache-control",
    "no-store"
);
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width"
        />
        <meta
            name="robots"
            content="noindex,nofollow,noarchive"
        />
        <title>River OS</title>
        <style>
            :root {
                font-family:
                    system-ui,
                    sans-serif;
                color:
                    #17211d;
                background:
                    #f7f4ed;
            }

            body {
                margin:
                    0;
                min-height:
                    100vh;
            }

            main {
                width:
                    min(1120px, calc(100% - 48px));
                margin:
                    0 auto;
                padding:
                    64px 0;
            }

            .eyebrow {
                margin:
                    0 0 10px;
                color:
                    #607f83;
                font-size:
                    0.78rem;
                font-weight:
                    700;
                letter-spacing:
                    0.14em;
                text-transform:
                    uppercase;
            }

            h1 {
                margin:
                    0;
                font-family:
                    Georgia,
                    serif;
                font-size:
                    clamp(2.4rem, 7vw, 5rem);
                font-weight:
                    500;
            }

            .intro {
                max-width:
                    640px;
                margin:
                    18px 0 40px;
                line-height:
                    1.7;
            }

            .panel {
                padding:
                    28px;
                border:
                    1px solid rgba(23, 33, 29, 0.15);
                border-radius:
                    16px;
                background:
                    white;
            }

            form {
                margin-top:
                    32px;
            }

            button {
                padding:
                    10px 14px;
                border:
                    1px solid #29483a;
                border-radius:
                    8px;
                font:
                    inherit;
                background:
                    transparent;
                cursor:
                    pointer;
            }
        </style>
    </head>
    <body>
        <main>
            <p class="eyebrow">
                Private workspace
            </p>

            <h1>River OS</h1>

            <p class="intro">
                The private operating layer for the content system,
                automation engine, CRM, sales operations, and analytics.
            </p>

            <section class="panel">
                <strong>
                    Access foundation active.
                </strong>

                <p>
                    The next site slice will connect the protected workspace
                    to the River OS content catalog.
                </p>
            </section>

            <form
                method="post"
                action="/river-os/logout"
            >
                <button type="submit">
                    Sign out
                </button>
            </form>
        </main>
    </body>
</html>