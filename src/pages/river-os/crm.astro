---
import {
    env
} from "cloudflare:workers";

import RiverOsLayout from "../../layouts/RiverOsLayout.astro";

import {
    summarizeRiverCrmWorkspace
} from "../../lib/river-os/crm-workspace";


export const prerender =
    false;

Astro.response.headers.set(
    "cache-control",
    "no-store"
);

const runtimeEnvironment =
    env as unknown as
        Record<string, unknown>;

const database =
    runtimeEnvironment
        .RIVER_CRM_DB;

const relationships =
    [];

const summary =
    summarizeRiverCrmWorkspace(
        relationships
    );

const databaseConnected =
    database !== undefined;
---

<style>
    .crm-hero {
        display:
            grid;
        gap:
            1rem;
        max-width:
            820px;
        padding:
            4.5rem 0 2.5rem;
    }

    .eyebrow {
        margin:
            0;
        color:
            var(--river-water);
        font-size:
            0.76rem;
        font-weight:
            800;
        letter-spacing:
            0.16em;
        text-transform:
            uppercase;
    }

    h1,
    h2 {
        font-family:
            var(--river-serif);
        font-weight:
            400;
    }

    h1 {
        margin:
            0;
        font-size:
            clamp(
                2.7rem,
                6vw,
                5rem
            );
        line-height:
            0.98;
        letter-spacing:
            -0.04em;
    }

    .hero-copy {
        max-width:
            690px;
        margin:
            0;
        color:
            var(--river-text-soft);
        font-size:
            1.02rem;
    }

    .connection-state {
        width:
            fit-content;
        border:
            1px solid var(--river-line);
        border-radius:
            999px;
        background:
            var(--river-white);
        color:
            var(--river-text-soft);
        font-size:
            0.78rem;
        font-weight:
            800;
        padding:
            0.5rem 0.75rem;
    }

    .summary-grid {
        display:
            grid;
        grid-template-columns:
            repeat(
                3,
                minmax(0, 1fr)
            );
        gap:
            1rem;
    }

    .summary-card,
    .workspace-panel {
        border:
            1px solid var(--river-line);
        border-radius:
            20px;
        background:
            rgba(
                255,
                253,
                248,
                0.82
            );
    }

    .summary-card {
        display:
            grid;
        gap:
            0.35rem;
        padding:
            1.25rem;
    }

    .summary-label {
        color:
            var(--river-text-muted);
        font-size:
            0.72rem;
        font-weight:
            800;
        letter-spacing:
            0.1em;
        text-transform:
            uppercase;
    }

    .summary-value {
        font-family:
            var(--river-serif);
        font-size:
            2.3rem;
        line-height:
            1;
    }

    .workspace-grid {
        display:
            grid;
        grid-template-columns:
            repeat(
                2,
                minmax(0, 1fr)
            );
        gap:
            1rem;
        margin-top:
            1rem;
    }

    .workspace-panel {
        display:
            grid;
        gap:
            0.9rem;
        min-height:
            210px;
        padding:
            1.5rem;
    }

    .workspace-panel h2 {
        margin:
            0;
        font-size:
            1.55rem;
    }

    .workspace-panel p {
        margin:
            0;
        color:
            var(--river-text-soft);
    }

    .panel-note {
        align-self:
            end;
        color:
            var(--river-text-muted);
        font-size:
            0.82rem;
        font-weight:
            700;
    }

    .foundation-note {
        margin-top:
            1rem;
        border:
            1px solid var(--river-line);
        border-radius:
            18px;
        background:
            var(--river-paper-warm);
        padding:
            1.4rem 1.5rem;
    }

    .foundation-note strong {
        display:
            block;
        margin-bottom:
            0.4rem;
        font-family:
            var(--river-serif);
        font-size:
            1.2rem;
        font-weight:
            400;
    }

    .foundation-note p {
        margin:
            0;
        color:
            var(--river-text-soft);
        font-size:
            0.9rem;
    }

    @media (
        max-width: 760px
    ) {
        .summary-grid,
        .workspace-grid {
            grid-template-columns:
                1fr;
        }

        .crm-hero {
            padding-top:
                3.5rem;
        }
    }
</style>

<RiverOsLayout
    title="CRM | River OS"
    workspaceVariant="dashboard"
    activeSection="crm"
>
    <section class="crm-hero">
        <p class="eyebrow">
            River OS · CRM
        </p>

        <h1>
            Relationship workspace
        </h1>

        <p class="hero-copy">
            One private place for leads, clients, recruits, partners,
            pipeline movement, appointments, and deliberate follow-up.
        </p>

        <span class="connection-state">
            {
                databaseConnected
                    ? "CRM database connected"
                    : "CRM foundation ready · database not provisioned"
            }
        </span>
    </section>

    <section
        class="summary-grid"
        aria-label="CRM summary"
    >
        <article class="summary-card">
            <span class="summary-label">
                Relationships
            </span>

            <strong class="summary-value">
                {summary.total}
            </strong>
        </article>

        <article class="summary-card">
            <span class="summary-label">
                Active pipeline
            </span>

            <strong class="summary-value">
                {summary.active}
            </strong>
        </article>

        <article class="summary-card">
            <span class="summary-label">
                Due follow-up
            </span>

            <strong class="summary-value">
                {summary.followUps}
            </strong>
        </article>

        <article class="summary-card">
            <span class="summary-label">
                Appointments
            </span>

            <strong class="summary-value">
                {summary.appointments}
            </strong>
        </article>

        <article class="summary-card">
            <span class="summary-label">
                Won
            </span>

            <strong class="summary-value">
                {summary.won}
            </strong>
        </article>

        <article class="summary-card">
            <span class="summary-label">
                Nurture
            </span>

            <strong class="summary-value">
                {summary.nurture}
            </strong>
        </article>
    </section>

    <section
        class="workspace-grid"
        aria-label="CRM operating areas"
    >
        <article class="workspace-panel">
            <h2>
                Relationships
            </h2>

            <p>
                The canonical people layer for leads, clients, recruits,
                and partners—without forcing every relationship into the
                same sales process.
            </p>

            <span class="panel-note">
                Durable records will activate with RIVER_CRM_DB.
            </span>
        </article>

        <article class="workspace-panel">
            <h2>
                Pipeline
            </h2>

            <p>
                Move relationships through new, contacted, qualified,
                appointment-set, proposal, won, lost, and nurture stages.
            </p>

            <span class="panel-note">
                Stage authority is already defined in the CRM domain.
            </span>
        </article>

        <article class="workspace-panel">
            <h2>
                Follow-up
            </h2>

            <p>
                Surface relationships that require attention and preserve
                the next intentional follow-up instead of relying on memory.
            </p>

            <span class="panel-note">
                No message is sent automatically from this workspace.
            </span>
        </article>

        <article class="workspace-panel">
            <h2>
                Appointments
            </h2>

            <p>
                Track appointment commitments alongside the relationship
                and pipeline context that produced them.
            </p>

            <span class="panel-note">
                Calendar integrations remain separately governed.
            </span>
        </article>
    </section>

    <aside class="foundation-note">
        <strong>
            The CRM workspace exists without pretending persistence is live.
        </strong>

        <p>
            The private domain contract and workspace are ready.
            A dedicated RIVER_CRM_DB has not been provisioned yet,
            so no CRM relationship data is currently written or read.
        </p>
    </aside>
</RiverOsLayout>
