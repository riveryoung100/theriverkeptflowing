---
import {
    resolveInsurancePrivateActionFeedback
} from "../../lib/insurance/private-action-feedback";
import {
    env
} from "cloudflare:workers";

import RiverOsLayout from "../../layouts/RiverOsLayout.astro";
import CrmCreateRelationshipForm from "../../components/river-os/CrmCreateRelationshipForm.astro";
import CrmRelationshipList from "../../components/river-os/CrmRelationshipList.astro";

import {
    summarizeRiverCrmWorkspace
} from "../../lib/river-os/crm-workspace";

import type {
    RiverCrmRelationship
} from "../../lib/river-os/crm-workspace";

import {
    createD1RiverCrmPersistence
} from "../../lib/river-os/d1-crm";

import {
    createD1InsuranceContactAttemptPersistence
} from "../../lib/insurance/d1-contact-attempt";

import type {
    InsuranceContactAttempt
} from "../../lib/insurance/contact-attempt";

import {
    createD1InsuranceLeadPresentationPersistence
} from "../../lib/insurance/d1-lead-presentation";

import {
    createD1InsuranceLeadQueuePersistence
} from "../../lib/insurance/d1-lead-queue";

import type {
    InsuranceLeadPresentation
} from "../../lib/insurance/lead-presentation";

import {
    createInsuranceLeadTriageSnapshot,
    INSURANCE_LEAD_TRIAGE_FILTERS,
    selectInsuranceLeadTriageItems
} from "../../lib/insurance/lead-triage";

import type {
    InsuranceLeadTriageFilter
} from "../../lib/insurance/lead-triage";


export const prerender =
    false;

Astro.response.headers.set(
    "cache-control",
    "no-store"
);

const runtimeEnvironment =
    env as unknown as
        Record<string, unknown>;

const database =
    runtimeEnvironment
        .RIVER_CRM_DB as
            D1Database | undefined;

const databaseConnected =
    database !== undefined;

const requestedSearch =
    Astro.url.searchParams
        .get(
            "search"
        )
        ?.trim()
        .slice(
            0,
            200
        ) ??
    "";

let databaseReadable =
    false;

let relationships:
    RiverCrmRelationship[] =
        [];

let relationshipSearchResults:
    RiverCrmRelationship[] | undefined;


let insuranceQueueRelationships:
    RiverCrmRelationship[] =
        [];

let insurancePresentations:
    InsuranceLeadPresentation[] =
        [];

let insurancePresentationReadable =
    false;

let insuranceContactAttempts:
    InsuranceContactAttempt[] =
        [];

let insuranceContactAttemptsReadable =
    false;

if (database !== undefined) {
    try {
        const crmPersistence =
            createD1RiverCrmPersistence(
                database
            );

        relationships =
            [...await crmPersistence.list()];

        databaseReadable =
            true;

        if (requestedSearch !== "") {
            try {
                relationshipSearchResults =
                    [...await crmPersistence.searchRelationships({
                        query:
                            requestedSearch,

                        limit:
                            100
                    })];
            } catch {
                relationshipSearchResults =
                    [];
            }
        }

        try {
            insuranceQueueRelationships =
                [...await createD1InsuranceLeadQueuePersistence(
                    database
                ).listComplete()];

            insurancePresentations =
                [...await createD1InsuranceLeadPresentationPersistence(
                    database
                ).listForRelationships(
                    insuranceQueueRelationships.map(
                        relationship =>
                            relationship.relationshipId
                    )
                )];

            insurancePresentationReadable =
                true;

            try {
                insuranceContactAttempts =
                    [...await createD1InsuranceContactAttemptPersistence(
                        database
                    ).listAttemptsForRelationships(
                        insuranceQueueRelationships.map(
                            relationship =>
                                relationship.relationshipId
                        ),
                        5
                    )];

                insuranceContactAttemptsReadable =
                    true;
            } catch {
                insuranceContactAttempts =
                    [];

                insuranceContactAttemptsReadable =
                    false;
            }
        } catch {
            insuranceQueueRelationships =
                [];

            insurancePresentations =
                [];

            insurancePresentationReadable =
                false;

            insuranceContactAttempts =
                [];

            insuranceContactAttemptsReadable =
                false;
        }
    } catch {
        relationships =
            [];
    }
}

const summary =
    summarizeRiverCrmWorkspace(
        relationships
    );

const insuranceSummary = {
    total:
        insurancePresentations.length,

    active:
        insurancePresentations.filter(
            presentation =>
                presentation.quoteStatus === "requested" ||
                presentation.quoteStatus === "in-progress"
        ).length,

    quoted:
        insurancePresentations.filter(
            presentation =>
                presentation.quoteStatus === "quoted"
        ).length,

    bound:
        insurancePresentations.filter(
            presentation =>
                presentation.quoteStatus === "bound"
        ).length
};

const privateActionFeedback =
    resolveInsurancePrivateActionFeedback(
        Astro.url.searchParams
    );

const requestedInsuranceQueue =
    Astro.url.searchParams
        .get(
            "insuranceQueue"
        )
        ?.trim() ??
    "all";


const selectedInsuranceQueue:
    InsuranceLeadTriageFilter =
        (
            INSURANCE_LEAD_TRIAGE_FILTERS as
                readonly string[]
        ).includes(
            requestedInsuranceQueue
        )
            ? requestedInsuranceQueue as
                InsuranceLeadTriageFilter
            : "all";


const insuranceTriageSnapshot =
    createInsuranceLeadTriageSnapshot({
        relationships:
            insuranceQueueRelationships,

        insurancePresentations,

        now:
            new Date()
                .toISOString()
    });


const selectedInsuranceTriageItems =
    selectedInsuranceQueue ===
        "all"
        ? insuranceTriageSnapshot.items
        : selectInsuranceLeadTriageItems(
            insuranceTriageSnapshot,
            selectedInsuranceQueue
        );


const searchedRelationships:
    readonly RiverCrmRelationship[] =
        relationshipSearchResults ??
        relationships;


const searchedRelationshipIds =
    new Set(
        searchedRelationships.map(
            relationship =>
                relationship.relationshipId
        )
    );


const visibleRelationships:
    readonly RiverCrmRelationship[] =
        (
            selectedInsuranceQueue ===
                "all" ||
            !insurancePresentationReadable
        )
            ? searchedRelationships
            : selectedInsuranceTriageItems
                .map(
                    item =>
                        item.relationship
                )
                .filter(
                    relationship =>
                        requestedSearch === "" ||
                        searchedRelationshipIds.has(
                            relationship.relationshipId
                        )
                );

const insuranceQueueOptions:
    readonly {
        readonly value:
            InsuranceLeadTriageFilter;

        readonly label:
            string;

        readonly count:
            number;
    }[] = [
        {
            value:
                "all",

            label:
                "All relationships",

            count:
                relationships.length
        },
        {
            value:
                "new",

            label:
                "New inbound",

            count:
                insuranceTriageSnapshot
                    .summary
                    .newInbound
        },
        {
            value:
                "not-started",

            label:
                "Not started",

            count:
                insuranceTriageSnapshot
                    .summary
                    .notStarted
        },
        {
            value:
                "requested",

            label:
                "Requested",

            count:
                insuranceTriageSnapshot
                    .summary
                    .requested
        },
        {
            value:
                "in-progress",

            label:
                "In progress",

            count:
                insuranceTriageSnapshot
                    .summary
                    .inProgress
        },
        {
            value:
                "quoted",

            label:
                "Quoted",

            count:
                insuranceTriageSnapshot
                    .summary
                    .quoted
        },
        {
            value:
                "bound",

            label:
                "Bound",

            count:
                insuranceTriageSnapshot
                    .summary
                    .bound
        },
        {
            value:
                "declined",

            label:
                "Declined",

            count:
                insuranceTriageSnapshot
                    .summary
                    .declined
        },
        {
            value:
                "lost",

            label:
                "Lost",

            count:
                insuranceTriageSnapshot
                    .summary
                    .lost
        },
        {
            value:
                "stage-new",

            label:
                "Stage: New",

            count:
                insuranceTriageSnapshot
                    .summary
                    .stageNew
        },
        {
            value:
                "stage-contacted",

            label:
                "Stage: Contacted",

            count:
                insuranceTriageSnapshot
                    .summary
                    .stageContacted
        },
        {
            value:
                "stage-qualified",

            label:
                "Stage: Qualified",

            count:
                insuranceTriageSnapshot
                    .summary
                    .stageQualified
        },
        {
            value:
                "stage-appointment-set",

            label:
                "Stage: Appointment set",

            count:
                insuranceTriageSnapshot
                    .summary
                    .stageAppointmentSet
        },
        {
            value:
                "stage-proposal",

            label:
                "Stage: Proposal",

            count:
                insuranceTriageSnapshot
                    .summary
                    .stageProposal
        },
        {
            value:
                "stage-won",

            label:
                "Stage: Won",

            count:
                insuranceTriageSnapshot
                    .summary
                    .stageWon
        },
        {
            value:
                "stage-lost",

            label:
                "Stage: Lost",

            count:
                insuranceTriageSnapshot
                    .summary
                    .stageLost
        },
        {
            value:
                "stage-nurture",

            label:
                "Stage: Nurture",

            count:
                insuranceTriageSnapshot
                    .summary
                    .stageNurture
        },
        {
            value:
                "unassigned",

            label:
                "Unassigned",

            count:
                insuranceTriageSnapshot
                    .summary
                    .unassigned
        },
        {
            value:
                "follow-up-due",

            label:
                "Follow-up due",

            count:
                insuranceTriageSnapshot
                    .summary
                    .followUpDue
        },
        {
            value:
                "appointments",

            label:
                "Appointments",

            count:
                insuranceTriageSnapshot
                    .summary
                    .appointments
        },
        {
            value:
                "suppressed",

            label:
                "Suppressed",

            count:
                insuranceTriageSnapshot
                    .summary
                    .suppressed
        }
    ];


function insuranceQueueHref(
    filter:
        InsuranceLeadTriageFilter
): string {
    const params =
        new URLSearchParams();

    if (filter !== "all") {
        params.set(
            "insuranceQueue",
            filter
        );
    }

    if (requestedSearch !== "") {
        params.set(
            "search",
            requestedSearch
        );
    }

    const query =
        params.toString();

    return query === ""
        ? "/river-os/crm"
        : `/river-os/crm?${query}`;
}
---

<style>
    .crm-hero {
        display:
            grid;
        gap:
            1rem;
        max-width:
            820px;
        padding:
            4.5rem 0 2.5rem;
    }

    .eyebrow {
        margin:
            0;
        color:
            var(--river-water);
        font-size:
            0.76rem;
        font-weight:
            800;
        letter-spacing:
            0.16em;
        text-transform:
            uppercase;
    }

    h1,
    h2 {
        font-family:
            var(--river-serif);
        font-weight:
            400;
    }

    h1 {
        margin:
            0;
        font-size:
            clamp(
                2.7rem,
                6vw,
                5rem
            );
        line-height:
            0.98;
        letter-spacing:
            -0.04em;
    }

    .hero-copy {
        max-width:
            690px;
        margin:
            0;
        color:
            var(--river-text-soft);
        font-size:
            1.02rem;
    }

    .connection-state {
        width:
            fit-content;
        border:
            1px solid var(--river-line);
        border-radius:
            999px;
        background:
            var(--river-white);
        color:
            var(--river-text-soft);
        font-size:
            0.78rem;
        font-weight:
            800;
        padding:
            0.5rem 0.75rem;
    }

    .summary-grid {
        display:
            grid;
        grid-template-columns:
            repeat(
                3,
                minmax(0, 1fr)
            );
        gap:
            1rem;
    }

    .summary-card,
    .workspace-panel {
        border:
            1px solid var(--river-line);
        border-radius:
            20px;
        background:
            rgba(
                255,
                253,
                248,
                0.82
            );
    }

    .summary-card {
        display:
            grid;
        gap:
            0.35rem;
        padding:
            1.25rem;
    }

    .summary-label {
        color:
            var(--river-text-muted);
        font-size:
            0.72rem;
        font-weight:
            800;
        letter-spacing:
            0.1em;
        text-transform:
            uppercase;
    }

    .summary-value {
        font-family:
            var(--river-serif);
        font-size:
            2.3rem;
        line-height:
            1;
    }

    .insurance-summary {
        margin-top:
            1rem;
    }

    .insurance-summary-heading {
        display:
            flex;
        align-items:
            baseline;
        justify-content:
            space-between;
        gap:
            1rem;
        margin-bottom:
            0.75rem;
    }

    .insurance-summary-heading h2,
    .insurance-summary-heading p {
        margin:
            0;
    }

    .insurance-summary-heading h2 {
        font-size:
            1.4rem;
    }

    .insurance-summary-heading p {
        color:
            var(--river-text-muted);
        font-size:
            0.8rem;
    }

    .insurance-summary-grid {
        display:
            grid;
        grid-template-columns:
            repeat(
                4,
                minmax(0, 1fr)
            );
        gap:
            1rem;
    }
    .insurance-triage {
        display:
            grid;
        gap:
            0.9rem;
        margin:
            1rem 0 1.5rem;
        padding:
            1rem;
        border:
            1px solid var(--river-line);
        border-radius:
            14px;
        background:
            var(--river-white);
    }

    .insurance-triage-heading {
        display:
            flex;
        align-items:
            baseline;
        justify-content:
            space-between;
        gap:
            1rem;
        flex-wrap:
            wrap;
    }

    .insurance-triage-heading h2,
    .insurance-triage-heading p,
    .insurance-triage-selection,
    .insurance-triage-unavailable {
        margin:
            0;
    }

    .insurance-triage-heading h2 {
        font-size:
            1.15rem;
    }

    .insurance-triage-heading p,
    .insurance-triage-selection,
    .insurance-triage-unavailable {
        color:
            var(--river-text-muted);
        font-size:
            0.8rem;
        line-height:
            1.5;
    }

    .insurance-triage-filters {
        display:
            flex;
        flex-wrap:
            wrap;
        gap:
            0.55rem;
    }

    .insurance-triage-filter {
        display:
            inline-flex;
        align-items:
            center;
        gap:
            0.5rem;
        min-height:
            2.25rem;
        padding:
            0.45rem 0.7rem;
        border:
            1px solid var(--river-line);
        border-radius:
            999px;
        color:
            var(--river-text-soft);
        text-decoration:
            none;
        font-size:
            0.78rem;
        font-weight:
            700;
    }

    .insurance-triage-filter:hover,
    .insurance-triage-filter:focus-visible,
    .insurance-triage-filter.is-active {
        border-color:
            var(--river-water);
        color:
            var(--river-text);
    }

    .insurance-triage-filter.is-active {
        background:
            color-mix(
                in srgb,
                var(--river-water) 10%,
                transparent
            );
    }

    .insurance-triage-filter strong {
        min-width:
            1.35rem;
        padding:
            0.1rem 0.35rem;
        border-radius:
            999px;
        background:
            color-mix(
                in srgb,
                currentColor 8%,
                transparent
            );
        text-align:
            center;
        font-size:
            0.72rem;
    }

    .workspace-grid {
        display:
            grid;
        grid-template-columns:
            repeat(
                2,
                minmax(0, 1fr)
            );
        gap:
            1rem;
        margin-top:
            1rem;
    }

    .workspace-panel {
        display:
            grid;
        gap:
            0.9rem;
        min-height:
            210px;
        padding:
            1.5rem;
    }

    .workspace-panel h2 {
        margin:
            0;
        font-size:
            1.55rem;
    }

    .workspace-panel p {
        margin:
            0;
        color:
            var(--river-text-soft);
    }

    .panel-note {
        align-self:
            end;
        color:
            var(--river-text-muted);
        font-size:
            0.82rem;
        font-weight:
            700;
    }

    .foundation-note {
        margin-top:
            1rem;
        border:
            1px solid var(--river-line);
        border-radius:
            18px;
        background:
            var(--river-paper-warm);
        padding:
            1.4rem 1.5rem;
    }

    .foundation-note strong {
        display:
            block;
        margin-bottom:
            0.4rem;
        font-family:
            var(--river-serif);
        font-size:
            1.2rem;
        font-weight:
            400;
    }

    .foundation-note p {
        margin:
            0;
        color:
            var(--river-text-soft);
        font-size:
            0.9rem;
    }

    @media (
        max-width: 760px
    ) {
        .summary-grid,
        .insurance-summary-grid,
        .workspace-grid {
            grid-template-columns:
                1fr;
        }

        .crm-hero {
            padding-top:
                3.5rem;
        }
    }
    .private-action-feedback {
        display:
            flex;
        align-items:
            baseline;
        gap:
            0.65rem;
        margin:
            0 0 1rem;
        padding:
            0.8rem 1rem;
        border:
            1px solid var(--river-line);
        border-radius:
            12px;
        background:
            var(--river-paper-warm);
        color:
            var(--river-text-soft);
        font-size:
            0.88rem;
    }

    .private-action-feedback strong {
        color:
            var(--river-text);
        font-weight:
            800;
    }

</style>

<RiverOsLayout
    title="CRM | River OS"
    workspaceVariant="dashboard"
    activeSection="crm"
>
    <section class="crm-hero">
        <p class="eyebrow">
            River OS Ã‚Â· CRM
        </p>

        <h1>
            Relationship workspace
        </h1>

        <p class="hero-copy">
            One private place for leads, clients, recruits, partners,
            pipeline movement, appointments, and deliberate follow-up.
        </p>

        <span class="connection-state">
            {
                databaseReadable
                    ? "CRM database connected Ã‚Â· schema ready"
                    : databaseConnected
                        ? "CRM database connected Ã‚Â· schema/read unavailable"
                        : "CRM foundation ready Ã‚Â· database not provisioned"
            }
        </span>
    </section>

    {
        privateActionFeedback !== undefined && (
            <div
                class="private-action-feedback"
                role="status"
                aria-live="polite"
                data-private-action-feedback={privateActionFeedback.kind}
            >
                <strong>CRM update</strong>
                <span>{privateActionFeedback.message}</span>
            </div>
        )
    }

    <section
        class="summary-grid"
        aria-label="CRM summary"
    >
        <article class="summary-card">
            <span class="summary-label">
                Relationships
            </span>

            <strong class="summary-value">
                {summary.total}
            </strong>
        </article>

        <article class="summary-card">
            <span class="summary-label">
                Active pipeline
            </span>

            <strong class="summary-value">
                {summary.active}
            </strong>
        </article>

        <article class="summary-card">
            <span class="summary-label">
                Due follow-up
            </span>

            <strong class="summary-value">
                {summary.followUps}
            </strong>
        </article>

        <article class="summary-card">
            <span class="summary-label">
                Appointments
            </span>

            <strong class="summary-value">
                {summary.appointments}
            </strong>
        </article>

        <article class="summary-card">
            <span class="summary-label">
                Won
            </span>

            <strong class="summary-value">
                {summary.won}
            </strong>
        </article>

        <article class="summary-card">
            <span class="summary-label">
                Nurture
            </span>

            <strong class="summary-value">
                {summary.nurture}
            </strong>
        </article>
    </section>

    <CrmCreateRelationshipForm />

        <section
        class="insurance-summary"
        aria-label="Insurance summary"
    >
        <div class="insurance-summary-heading">
            <h2>
                Insurance pipeline
            </h2>

            <p>
                {
                    insurancePresentationReadable
                        ? "Read-only insurance acquisition and quote context"
                        : databaseReadable
                            ? "Insurance enrichment unavailable"
                            : "Available when CRM persistence is readable"
                }
            </p>
        </div>

        <div class="insurance-summary-grid">
            <article class="summary-card">
                <span class="summary-label">
                    Insurance leads
                </span>

                <strong class="summary-value">
                    {insuranceSummary.total}
                </strong>
            </article>

            <article class="summary-card">
                <span class="summary-label">
                    Requested / in progress
                </span>

                <strong class="summary-value">
                    {insuranceSummary.active}
                </strong>
            </article>

            <article class="summary-card">
                <span class="summary-label">
                    Quoted
                </span>

                <strong class="summary-value">
                    {insuranceSummary.quoted}
                </strong>
            </article>

            <article class="summary-card">
                <span class="summary-label">
                    Bound
                </span>

                <strong class="summary-value">
                    {insuranceSummary.bound}
                </strong>
            </article>
        </div>
    </section>

    <section
        class="insurance-triage"
        aria-labelledby="insurance-triage-heading"
    >
        <div class="insurance-triage-heading">
            <h2 id="insurance-triage-heading">
                Inbound insurance queue
            </h2>

            <p>
                {
                    insurancePresentationReadable
                        ? "Transparent operational filters from canonical CRM and insurance state."
                        : databaseReadable
                            ? "Insurance queue context is temporarily unavailable."
                            : "Available when CRM persistence is readable."
                }
            </p>
        </div>

        {
            insurancePresentationReadable
                ? (
                    <nav
                        class="insurance-triage-filters"
                        aria-label="Insurance lead queue filters"
                    >
                        {
                            insuranceQueueOptions.map(
                                option => (
                                    <a
                                        class={
                                            selectedInsuranceQueue ===
                                                option.value
                                                ? "insurance-triage-filter is-active"
                                                : "insurance-triage-filter"
                                        }
                                        href={insuranceQueueHref(option.value)}
                                        aria-current={
                                            selectedInsuranceQueue ===
                                                option.value
                                                ? "page"
                                                : undefined
                                        }
                                    >
                                        <span>
                                            {option.label}
                                        </span>

                                        <strong>
                                            {option.count}
                                        </strong>
                                    </a>
                                )
                            )
                        }
                    </nav>
                )
                : (
                    <p class="insurance-triage-unavailable">
                        Generic CRM relationships remain visible while insurance
                        enrichment is unavailable.
                    </p>
                )
        }

        {
            selectedInsuranceQueue !== "all" &&
            insurancePresentationReadable && (
                <p class="insurance-triage-selection">
                    Showing
                    {" "}
                    {visibleRelationships.length}
                    {" "}
                    {
                        visibleRelationships.length === 1
                            ? "relationship"
                            : "relationships"
                    }
                    {" "}
                    for this insurance queue.
                </p>
            )
        }
    </section>

    <section
        class="workspace-panel"
        aria-label="CRM relationship search"
    >
        <form method="get" action="/river-os/crm">
            {
                selectedInsuranceQueue !== "all" && (
                    <input
                        type="hidden"
                        name="insuranceQueue"
                        value={selectedInsuranceQueue}
                    />
                )
            }

            <label for="crm-relationship-search">
                Search relationships
            </label>

            <input
                id="crm-relationship-search"
                type="search"
                name="search"
                value={requestedSearch}
                placeholder="Name, email, phone, relationship ID, owner, or source"
                maxlength="200"
                autocomplete="off"
            />

            <button type="submit">
                Search
            </button>

            {
                requestedSearch !== "" && (
                    <a
                        href={
                            selectedInsuranceQueue === "all"
                                ? "/river-os/crm"
                                : `/river-os/crm?insuranceQueue=${encodeURIComponent(
                                    selectedInsuranceQueue
                                )}`
                        }
                    >
                        Clear search
                    </a>
                )
            }
        </form>

        {
            requestedSearch !== "" && (
                <p class="panel-note">
                    Showing
                    {" "}
                    {visibleRelationships.length}
                    {" "}
                    matching
                    {" "}
                    {
                        visibleRelationships.length === 1
                            ? "relationship"
                            : "relationships"
                    }
                    {" "}
                    for
                    {" "}
                    <strong>{requestedSearch}</strong>.
                </p>
            )
        }
    </section>

    <CrmRelationshipList
        relationships={visibleRelationships}
        insurancePresentations={insurancePresentations}
        insuranceContactAttempts={insuranceContactAttempts}
        insuranceContactAttemptsReadable={insuranceContactAttemptsReadable}
        insuranceQueue={selectedInsuranceQueue}
        search={requestedSearch}
    />

    <section
        class="workspace-grid"
        aria-label="CRM operating areas"
    >
        <article class="workspace-panel">
            <h2>
                Relationships
            </h2>

            <p>
                The canonical people layer for leads, clients, recruits,
                and partnersÃ¢â‚¬â€without forcing every relationship into the
                same sales process.
            </p>

            <span class="panel-note">
                Records are stored in the connected River CRM database.
            </span>
        </article>

        <article class="workspace-panel">
            <h2>
                Pipeline
            </h2>

            <p>
                Move relationships through new, contacted, qualified,
                appointment-set, proposal, won, lost, and nurture stages.
            </p>

            <span class="panel-note">
                Stage authority is already defined in the CRM domain.
            </span>
        </article>

        <article class="workspace-panel">
            <h2>
                Follow-up
            </h2>

            <p>
                Surface relationships that require attention and preserve
                the next intentional follow-up instead of relying on memory.
            </p>

            <span class="panel-note">
                No message is sent automatically from this workspace.
            </span>
        </article>

        <article class="workspace-panel">
            <h2>
                Appointments
            </h2>

            <p>
                Track appointment commitments alongside the relationship
                and pipeline context that produced them.
            </p>

            <span class="panel-note">
                Calendar integrations remain separately governed.
            </span>
        </article>
    </section>

    <aside class="foundation-note">
        <strong>
            The CRM workspace is connected to governed persistence.
        </strong>

        <p>
            The private domain contract, workspace, and manual record controls are ready.
            {
                databaseReadable
                    ? "CRM persistence is connected and readable."
                    : databaseConnected
                        ? "RIVER_CRM_DB is connected, but its CRM schema is not readable yet."
                        : "A dedicated RIVER_CRM_DB has not been provisioned yet, so no CRM relationship data is currently written or read."
            }
        </p>
    </aside>
</RiverOsLayout>
