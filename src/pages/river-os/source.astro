---
import RiverOsLayout from "../../layouts/RiverOsLayout.astro";

import {
    env
} from "cloudflare:workers";

import {
    createD1RiverContentCatalogPersistence
} from "../../lib/river-os/d1-content-catalog";

import type {
    RiverContentCatalogEntry
} from "../../lib/river-os/content-catalog";

import {
    formatRiverContentDate,
    formatRiverContentPlatform
} from "../../lib/river-os/content-workspace";
import {
    createRiverContentEngineWorkspace
} from "../../lib/river-os/content-engine-workspace";
import {
    createRiverRepurposePlan
} from "../../lib/river-os/content-repurpose-planner";
import {
    buildRiverContentTranscriptActionPath,
    RIVER_CONTENT_TRANSCRIPT_ACTION_STATUS
} from "../../lib/river-os/content-engine-actions";

export const prerender =
    false;

Astro.response.headers.set(
    "cache-control",
    "no-store"
);

const runtimeEnvironment =
    env as unknown as
        Record<string, unknown>;

const database =
    runtimeEnvironment
        .RIVER_CONTENT_DB;

const sourceId =
    Astro.url.searchParams
        .get(
            "sourceId"
        )
        ?.trim() ??
    "";

const transcriptActionStatus =
    Astro.url.searchParams
        .get(
            "transcriptAction"
        );

let entry:
    RiverContentCatalogEntry | undefined;

let catalogError:
    string | undefined;
let contentEngine:
    ReturnType<typeof createRiverContentEngineWorkspace> | undefined;
let repurposePlan:
    ReturnType<typeof createRiverRepurposePlan> | undefined;

if (
    sourceId.length ===
    0
) {

    Astro.response.status =
        400;

    catalogError =
        "No source identity was provided.";

}
else if (
    database === undefined
) {

    Astro.response.status =
        503;

    catalogError =
        "The dedicated River content catalog is not connected.";

}
else {

    try {

        const catalog =
            createD1RiverContentCatalogPersistence(
                database as D1Database
            );

        entry =
            await catalog.get(
                sourceId
            );

        if (
            entry === undefined
        ) {

            Astro.response.status =
                404;

            catalogError =
                "The requested source is not present in the River content catalog.";

        }
        else {

            contentEngine =
                createRiverContentEngineWorkspace(
                    entry
                );

            repurposePlan =
                createRiverRepurposePlan(
                    entry
                );

        }

    }
    catch {

        Astro.response.status =
            503;

        catalogError =
            "The content catalog could not be read.";

    }

}
---

<style>
.published-link {
    border:
        1px solid var(--river-line);
    border-radius:
        999px;
    color:
        var(--river-ink);
    font:
        inherit;
    font-size:
        0.85rem;
    text-decoration:
        none;
    padding:
        0.7rem 1rem;
    cursor:
        pointer;
}
.hero {
                padding:
                    4.75rem 0 3rem;
                border-bottom:
                    1px solid var(--river-line);
            }

            .hero h1 {
                max-width:
                    900px;
                margin:
                    0.75rem 0 0;
                font-family:
                    var(--river-serif);
                font-size:
                    clamp(
                        2.5rem,
                        6vw,
                        5.5rem
                    );
                font-weight:
                    400;
                line-height:
                    0.98;
                letter-spacing:
                    -0.045em;
            }

            .hero-copy {
                max-width:
                    720px;
                margin:
                    1.5rem 0 0;
                color:
                    var(--river-text-soft);
                font-size:
                    1.05rem;
                line-height:
                    1.7;
            }

            .state {
                display:
                    inline-flex;
                width:
                    fit-content;
                margin-top:
                    1.25rem;
                border:
                    1px solid rgba(168, 111, 80, 0.35);
                border-radius:
                    999px;
                background:
                    rgba(168, 111, 80, 0.08);
                color:
                    var(--river-clay);
                padding:
                    0.45rem 0.7rem;
                font-size:
                    0.78rem;
                font-weight:
                    700;
            }

            .state.available {
                border-color:
                    rgba(41, 72, 58, 0.3);
                background:
                    rgba(41, 72, 58, 0.08);
                color:
                    var(--river-forest);
            }

            .source-overview {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 0.75rem;
                max-width: 900px;
                margin-top: 1.25rem;
            }

            .source-overview-item {
                border: 1px solid var(--river-line);
                border-radius: 0.75rem;
                background: rgba(255, 253, 248, 0.54);
                padding: 0.85rem 1rem;
                min-width: 0;
            }

            .source-overview-label {
                display: block;
                margin-bottom: 0.3rem;
                color: var(--river-muted);
                font-size: 0.72rem;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

            .source-overview-value {
                display: block;
                overflow-wrap: anywhere;
                color: var(--river-ink);
                font-size: 0.9rem;
                line-height: 1.45;
            }

            .grid {
                display:
                    grid;
                grid-template-columns:
                    minmax(0, 1.5fr)
                    minmax(280px, 0.75fr);
                gap:
                    1.5rem;
                padding-top:
                    2rem;
            }

            .panel {
                border:
                    1px solid var(--river-line);
                border-radius:
                    18px;
                background:
                    rgba(255, 253, 248, 0.72);
                padding:
                    1.5rem;
            }

            .panel h2 {
                margin:
                    0.35rem 0 1.5rem;
                font-family:
                    var(--river-serif);
                font-size:
                    1.8rem;
                font-weight:
                    400;
            }

            .fields {
                display:
                    grid;
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
                gap:
                    0;
                border-top:
                    1px solid var(--river-line);
            }

            .field {
                min-width:
                    0;
                padding:
                    1rem 1rem 1rem 0;
                border-bottom:
                    1px solid var(--river-line);
            }

            .field:nth-child(even) {
                padding-left:
                    1rem;
                border-left:
                    1px solid var(--river-line);
            }

            .field-value {
                display:
                    block;
                margin-top:
                    0.4rem;
                overflow-wrap:
                    anywhere;
                line-height:
                    1.45;
            }

            .description {
                margin:
                    0 0 1.5rem;
                color:
                    var(--river-text-soft);
                line-height:
                    1.7;
            }

            .actions-copy {
                margin:
                    0;
                color:
                    var(--river-text-soft);
                line-height:
                    1.65;
            }

            .preserved {
                margin-top:
                    1.5rem;
                padding-top:
                    1.5rem;
                border-top:
                    1px solid var(--river-line);
            }

            .preserved strong {
                display:
                    block;
                margin-bottom:
                    0.45rem;
                font-family:
                    var(--river-serif);
                font-size:
                    1.25rem;
                font-weight:
                    400;
            }

            .engine-workflow {
                display:
                    grid;
                gap:
                    0.75rem;
                margin-top:
                    1.5rem;
            }

            .engine-stage {
                border:
                    1px solid var(--river-line);
                border-radius:
                    14px;
                padding:
                    1rem;
                background:
                    rgba(247, 244, 237, 0.6);
            }

            .engine-stage-head {
                display:
                    flex;
                align-items:
                    center;
                justify-content:
                    space-between;
                gap:
                    1rem;
            }

            .engine-stage h3 {
                margin:
                    0;
                font-family:
                    var(--river-serif);
                font-size:
                    1.1rem;
                font-weight:
                    400;
            }

            .engine-stage p {
                margin:
                    0.65rem 0 0;
                color:
                    var(--river-text-soft);
                line-height:
                    1.55;
            }

            .engine-stage-state {
                flex:
                    0 0 auto;
                border:
                    1px solid rgba(168, 111, 80, 0.3);
                border-radius:
                    999px;
                padding:
                    0.3rem 0.55rem;
                color:
                    var(--river-clay);
                font-size:
                    0.7rem;
                font-weight:
                    700;
                letter-spacing:
                    0.05em;
                text-transform:
                    uppercase;
            }

            .engine-stage.ready .engine-stage-state {
                border-color:
                    rgba(41, 72, 58, 0.3);
                color:
                    var(--river-forest);
            }

            .repurpose-plan {
                display:
                    grid;
                gap:
                    0.75rem;
                margin-top:
                    1.5rem;
            }

            .repurpose-target {
                border:
                    1px solid var(--river-line);
                border-radius:
                    14px;
                padding:
                    1rem;
                background:
                    rgba(255, 255, 255, 0.42);
            }

            .repurpose-target.ready {
                border-color:
                    rgba(41, 72, 58, 0.28);
            }

            .repurpose-target-head {
                display:
                    flex;
                align-items:
                    flex-start;
                justify-content:
                    space-between;
                gap:
                    1rem;
            }

            .repurpose-target h3 {
                margin:
                    0;
                font-family:
                    var(--river-serif);
                font-size:
                    1rem;
            }

            .repurpose-target-state {
                flex:
                    0 0 auto;
                font-size:
                    0.72rem;
                font-weight:
                    700;
                letter-spacing:
                    0.05em;
                text-transform:
                    uppercase;
                color:
                    var(--river-text-soft);
            }

            .repurpose-target p {
                margin:
                    0.65rem 0 0;
                color:
                    var(--river-text-soft);
                font-size:
                    0.82rem;
                line-height:
                    1.55;
            }

            .repurpose-target-meta {
                margin-top:
                    0.7rem;
                font-size:
                    0.74rem;
                color:
                    var(--river-text-soft);
                overflow-wrap:
                    anywhere;
            }

            .engine-action {
                margin-top:
                    1rem;
            }

            .engine-action button {
                width:
                    100%;
                border:
                    1px solid var(--river-forest);
                border-radius:
                    999px;
                padding:
                    0.75rem 1rem;
                background:
                    var(--river-forest);
                color:
                    var(--river-paper);
                font:
                    inherit;
                font-size:
                    0.8rem;
                font-weight:
                    700;
                letter-spacing:
                    0.04em;
                cursor:
                    pointer;
            }

            .engine-action button:hover {
                opacity:
                    0.92;
            }

            .engine-gate {
                margin-top:
                    1rem;
                border:
                    1px solid rgba(181, 138, 74, 0.35);
                border-radius:
                    12px;
                padding:
                    0.9rem 1rem;
                background:
                    rgba(181, 138, 74, 0.08);
                color:
                    var(--river-text-soft);
                font-size:
                    0.82rem;
                line-height:
                    1.55;
            }

            .engine-note {
                margin-top:
                    1.5rem;
                padding-top:
                    1.5rem;
                border-top:
                    1px solid var(--river-line);
                color:
                    var(--river-text-soft);
                font-size:
                    0.85rem;
                line-height:
                    1.6;
            }

            .error {
                margin-top:
                    3rem;
                border:
                    1px solid var(--river-line);
                border-radius:
                    18px;
                background:
                    var(--river-white);
                padding:
                    2rem;
            }

            .error h1 {
                margin:
                    0 0 0.75rem;
                font-family:
                    var(--river-serif);
                font-weight:
                    400;
            }

            .error p {
                margin:
                    0;
                color:
                    var(--river-text-soft);
            }

            @media (
                max-width: 820px
            ) {

                .source-overview {
                    grid-template-columns:
                        1fr;
                }

                .grid {
                    grid-template-columns:
                        1fr;
                }

                .fields {
                    grid-template-columns:
                        1fr;
                }

                .field:nth-child(even) {
                    padding-left:
                        0;
                    border-left:
                        0;
                }

            }

            @media (
                max-width: 620px
            ) {
.hero {
                    padding-top:
                        3rem;
                }

            }
</style>

<RiverOsLayout
    title={entry === undefined ? "Source Detail | River OS" : `${entry.title} | River OS`}
    workspaceVariant="detail"
    activeSection="content"
    backHref="/river-os/content"
    backLabel="Back to content"
>
{
                entry === undefined
                    ? (
                        <section class="error">
                            <p class="eyebrow">
                                River OS / Source
                            </p>

                            <h1>
                                Source unavailable
                            </h1>

                            <p>
                                {
                                    catalogError ??
                                    "The requested source could not be loaded."
                                }
                            </p>
                        </section>
                    )
                    : (
                        <>
                            <section class="hero">
                                <p class="eyebrow">
                                    River OS / Canonical source
                                </p>

                                <h1>
                                    {entry.title}
                                </h1>

                                {
                                    entry.description === undefined
                                        ? null
                                        : (
                                            <p class="hero-copy">
                                                {entry.description}
                                            </p>
                                        )
                                }

                                <span
                                    class:list={[
                                        "state",
                                        {
                                            available:
                                                entry.transcriptState ===
                                                "available"
                                        }
                                    ]}
                                >
                                    {
                                        entry.transcriptState ===
                                        "available"
                                            ? "Transcript available"
                                            : "Transcript pending"
                                    }
                                </span>

                                <div class="source-overview" aria-label="Source overview">
                                    <div class="source-overview-item">
                                        <span class="source-overview-label">Platform</span>
                                        <span class="source-overview-value">
                                            {formatRiverContentPlatform(entry.platform)}
                                        </span>
                                    </div>

                                    <div class="source-overview-item">
                                        <span class="source-overview-label">Published</span>
                                        <span class="source-overview-value">
                                            {formatRiverContentDate(entry.publishedAt)}
                                        </span>
                                    </div>

                                    <div class="source-overview-item">
                                        <span class="source-overview-label">External ID</span>
                                        <span class="source-overview-value">
                                            {entry.externalPlatformId}
                                        </span>
                                    </div>
                                </div>
                            </section>

                            <section class="grid">
                                <article class="panel">
                                    <p class="eyebrow">
                                        Source record
                                    </p>

                                    <h2>
                                        Canonical metadata
                                    </h2>

                                    <div class="fields">
                                        <div class="field">
                                            <span class="field-label">
                                                Source ID
                                            </span>

                                            <span class="field-value">
                                                {entry.sourceId}
                                            </span>
                                        </div>

                                        <div class="field">
                                            <span class="field-label">
                                                Platform
                                            </span>

                                            <span class="field-value">
                                                {
                                                    formatRiverContentPlatform(
                                                        entry.platform
                                                    )
                                                }
                                            </span>
                                        </div>

                                        <div class="field">
                                            <span class="field-label">
                                                External ID
                                            </span>

                                            <span class="field-value">
                                                {entry.externalPlatformId}
                                            </span>
                                        </div>

                                        <div class="field">
                                            <span class="field-label">
                                                Published
                                            </span>

                                            <span class="field-value">
                                                {
                                                    formatRiverContentDate(
                                                        entry.publishedAt
                                                    )
                                                }
                                            </span>
                                        </div>

                                        <div class="field">
                                            <span class="field-label">
                                                Source status
                                            </span>

                                            <span class="field-value">
                                                {entry.sourceStatus}
                                            </span>
                                        </div>

                                        <div class="field">
                                            <span class="field-label">
                                                Transcript state
                                            </span>

                                            <span class="field-value">
                                                {entry.transcriptState}
                                            </span>
                                        </div>

                                        <div class="field">
                                            <span class="field-label">
                                                Transcript ID
                                            </span>

                                            <span class="field-value">
                                                {
                                                    entry.transcriptId ??
                                                    "Not available"
                                                }
                                            </span>
                                        </div>

                                        <div class="field">
                                            <span class="field-label">
                                                Transcript persisted
                                            </span>

                                            <span class="field-value">
                                                {
                                                    entry.transcriptPersistedAt ===
                                                    undefined
                                                        ? "Not available"
                                                        : formatRiverContentDate(
                                                            entry.transcriptPersistedAt
                                                        )
                                                }
                                            </span>
                                        </div>

                                        <div class="field">
                                            <span class="field-label">
                                                Transcript provider
                                            </span>

                                            <span class="field-value">
                                                {
                                                    entry.transcriptProvider ??
                                                    "Not available"
                                                }
                                            </span>
                                        </div>

                                        <div class="field">
                                            <span class="field-label">
                                                Transcript language
                                            </span>

                                            <span class="field-value">
                                                {
                                                    entry.transcriptLanguage ??
                                                    "Not available"
                                                }
                                            </span>
                                        </div>

                                        <div class="field">
                                            <span class="field-label">
                                                Ingested
                                            </span>

                                            <span class="field-value">
                                                {
                                                    formatRiverContentDate(
                                                        entry.ingestedAt
                                                    )
                                                }
                                            </span>
                                        </div>

                                        <div class="field">
                                            <span class="field-label">
                                                Last catalog update
                                            </span>

                                            <span class="field-value">
                                                {
                                                    formatRiverContentDate(
                                                        entry.updatedAt
                                                    )
                                                }
                                            </span>
                                        </div>
                                    </div>

                                    <div class="preserved">
                                        <strong>
                                            Original source preserved
                                        </strong>

                                        <p class="actions-copy">
                                            This operational record mirrors the
                                            published source without redefining
                                            the canonical assimilation record.
                                        </p>
                                    </div>
                                </article>

                                <aside class="panel">
                                    <p class="eyebrow">
                                        Published source
                                    </p>

                                    <h2>
                                        Original platform
                                    </h2>

                                    <p class="description">
                                        Open the canonical published source in
                                        a separate tab without leaving the River
                                        OS record.
                                    </p>

                                    <a
                                        class="published-link"
                                        href={entry.canonicalUrl}
                                        target="_blank"
                                        rel="noreferrer"
                                    >
                                        Open published source
                                    </a>

                                    <div class="preserved">
                                        <p class="eyebrow">
                                            Content engine
                                        </p>

                                        <strong>
                                            Operational workflow
                                        </strong>

                                        <p class="actions-copy">
                                            This workspace shows what is ready
                                            for this source without executing
                                            external or destructive actions.
                                        </p>

                                        {
                                            contentEngine === undefined
                                                ? null
                                                : (
                                                    <div class="engine-workflow">
                                                        {
                                                            contentEngine.stages.map(
                                                                (stage) => (
                                                                    <section
                                                                        class:list={[
                                                                            "engine-stage",
                                                                            stage.state
                                                                        ]}
                                                                    >
                                                                        <div class="engine-stage-head">
                                                                            <h3>
                                                                                {stage.label}
                                                                            </h3>

                                                                            <span class="engine-stage-state">
                                                                                {stage.stateLabel}
                                                                            </span>
                                                                        </div>

                                                                        <p>
                                                                            {stage.description}
                                                                        </p>
                                                                    </section>
                                                                )
                                                            )
                                                        }
                                                    </div>
                                                )
                                        }

                                        {
                                            repurposePlan === undefined
                                                ? null
                                                : (
                                                    <div class="repurpose-plan">
                                                        {
                                                            repurposePlan.targets.map(
                                                                (target) => (
                                                                    <section
                                                                        class:list={[
                                                                            "repurpose-target",
                                                                            target.state
                                                                        ]}
                                                                    >
                                                                        <div class="repurpose-target-head">
                                                                            <h3>
                                                                                {target.label}
                                                                            </h3>

                                                                            <span class="repurpose-target-state">
                                                                                {target.stateLabel}
                                                                            </span>
                                                                        </div>

                                                                        <p>
                                                                            {target.description}
                                                                        </p>

                                                                        <div class="repurpose-target-meta">
                                                                            {
                                                                                target.kind ===
                                                                                "site-collection"
                                                                                    ? `${target.destination} / ${target.requiredFields.join(", ")}`
                                                                                    : `${target.destination} / planning only`
                                                                            }
                                                                        </div>
                                                                    </section>
                                                                )
                                                            )
                                                        }
                                                    </div>
                                                )
                                        }

                                        {
                                            entry.transcriptState ===
                                            "pending"
                                                ? (
                                                    <form
                                                        class="engine-action"
                                                        method="post"
                                                        action={buildRiverContentTranscriptActionPath()}
                                                    >
                                                        <input
                                                            type="hidden"
                                                            name="sourceId"
                                                            value={entry.sourceId}
                                                        />

                                                        <button type="submit">
                                                            Prepare transcript acquisition
                                                        </button>
                                                    </form>
                                                )
                                                : null
                                        }

                                        {
                                            transcriptActionStatus ===
                                            RIVER_CONTENT_TRANSCRIPT_ACTION_STATUS
                                                ? (
                                                    <p class="engine-gate">
                                                        Transcript acquisition remains gated.
                                                        This control made no external request,
                                                        consumed no credential, and changed no data.
                                                        A separately authorized operation is still required.
                                                    </p>
                                                )
                                                : null
                                        }

                                        <p class="engine-note">
                                            Workflow controls are connected only
                                            through separately governed operations.
                                            This panel does not automatically acquire
                                            transcripts, write data, publish content,
                                            or contact an external service.
                                        </p>
                                    </div>
                                </aside>
                            </section>
                        </>
                    )
            }
</RiverOsLayout>
