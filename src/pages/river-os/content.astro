---
import {
    env
} from "cloudflare:workers";

import {
    createD1RiverContentCatalogPersistence
} from "../../lib/river-os/d1-content-catalog";

import type {
    RiverContentCatalogEntry
} from "../../lib/river-os/content-catalog";

import {
    buildRiverContentSourceDetailPath,
    formatRiverContentDate,
    formatRiverContentPlatform,
    summarizeRiverContentWorkspace
} from "../../lib/river-os/content-workspace";

import RiverOsLayout from "../../layouts/RiverOsLayout.astro";

export const prerender =
    false;

Astro.response.headers.set(
    "cache-control",
    "no-store"
);

const runtimeEnvironment =
    env as unknown as
        Record<string, unknown>;

const database =
    runtimeEnvironment
        .RIVER_CONTENT_DB;

let entries:
    readonly RiverContentCatalogEntry[] =
        [];

let catalogConnected =
    false;

let catalogError:
    string | undefined;

if (
    database !== undefined
) {

    try {

        const catalog =
            createD1RiverContentCatalogPersistence(
                database as D1Database
            );

        entries =
            await catalog.list(
                100
            );

        catalogConnected =
            true;

    }
    catch {

        catalogError =
            "The content catalog could not be read.";

    }

}

const summary =
    summarizeRiverContentWorkspace(
        entries
    );

const platformOptions =
    Array.from(
        new Set(
            entries.map(
                (
                    entry
                ) => entry.platform
            )
        )
    ).sort();
---

<style>
.hero {
                display:
                    grid;
                grid-template-columns:
                    minmax(0, 1.5fr)
                    minmax(18rem, 0.5fr);
                gap:
                    3rem;
                align-items:
                    end;
                padding:
                    4.5rem 0 3rem;
            }

            .eyebrow {
                margin:
                    0 0 1rem;
                color:
                    var(--river-clay);
                font-size:
                    0.75rem;
                font-weight:
                    700;
                letter-spacing:
                    0.16em;
                text-transform:
                    uppercase;
            }

            h1 {
                max-width:
                    12ch;
                margin:
                    0;
                font-family:
                    var(--river-serif);
                font-size:
                    clamp(
                        3rem,
                        7vw,
                        6.2rem
                    );
                font-weight:
                    400;
                line-height:
                    0.98;
                letter-spacing:
                    -0.045em;
            }

            .hero-copy {
                margin:
                    1.5rem 0 0;
                max-width:
                    62ch;
                color:
                    var(--river-text-soft);
                font-size:
                    1.05rem;
            }

            .connection {
                padding:
                    1.35rem;
                border:
                    1px solid var(--river-line);
                border-radius:
                    1rem;
                background:
                    rgba(255, 253, 248, 0.72);
            }

            .connection-label {
                margin:
                    0 0 0.45rem;
                color:
                    var(--river-text-muted);
                font-size:
                    0.72rem;
                font-weight:
                    700;
                letter-spacing:
                    0.14em;
                text-transform:
                    uppercase;
            }

            .connection strong {
                display:
                    block;
                font-family:
                    var(--river-serif);
                font-size:
                    1.35rem;
                font-weight:
                    400;
            }

            .connection p {
                margin:
                    0.55rem 0 0;
                color:
                    var(--river-text-soft);
                font-size:
                    0.86rem;
            }

            .summary {
                display:
                    grid;
                grid-template-columns:
                    repeat(4, minmax(0, 1fr));
                gap:
                    1rem;
                margin-bottom:
                    3rem;
            }

            .metric {
                min-height:
                    8.5rem;
                padding:
                    1.35rem;
                border:
                    1px solid var(--river-line);
                border-radius:
                    1rem;
                background:
                    rgba(255, 253, 248, 0.74);
            }

            .metric span {
                display:
                    block;
                color:
                    var(--river-text-muted);
                font-size:
                    0.72rem;
                font-weight:
                    700;
                letter-spacing:
                    0.12em;
                text-transform:
                    uppercase;
            }

            .metric strong {
                display:
                    block;
                margin-top:
                    1rem;
                font-family:
                    var(--river-serif);
                font-size:
                    2.35rem;
                font-weight:
                    400;
                line-height:
                    1;
            }

            .catalog {
                overflow:
                    hidden;
                border:
                    1px solid var(--river-line);
                border-radius:
                    1.35rem;
                background:
                    rgba(255, 253, 248, 0.86);
                box-shadow:
                    0 24px 70px
                    rgba(23, 33, 29, 0.08);
            }

            .catalog-header {
                display:
                    flex;
                align-items:
                    end;
                justify-content:
                    space-between;
                gap:
                    1.5rem;
                padding:
                    1.5rem 1.5rem 1.25rem;
                border-bottom:
                    1px solid var(--river-line);
            }

            .catalog-header h2 {
                margin:
                    0;
                font-family:
                    var(--river-serif);
                font-size:
                    clamp(
                        1.8rem,
                        3vw,
                        2.7rem
                    );
                font-weight:
                    400;
                letter-spacing:
                    -0.03em;
            }

            .catalog-header p {
                margin:
                    0.35rem 0 0;
                color:
                    var(--river-text-soft);
                font-size:
                    0.9rem;
            }


            .catalog-tools {
                display: grid;
                grid-template-columns: minmax(0, 1.6fr) minmax(10rem, 0.7fr) minmax(10rem, 0.7fr);
                gap: 0.85rem;
                padding: 1.15rem 1.5rem;
                border-bottom: 1px solid var(--river-line);
                background: rgba(255, 253, 248, 0.54);
            }

            .catalog-control {
                display: grid;
                gap: 0.4rem;
            }

            .catalog-control label {
                color: var(--river-text-muted);
                font-size: 0.66rem;
                font-weight: 700;
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }

            .catalog-control input,
            .catalog-control select {
                width: 100%;
                min-height: 2.65rem;
                box-sizing: border-box;
                border: 1px solid var(--river-line);
                border-radius: 0.7rem;
                background: var(--river-white);
                color: var(--river-ink);
                font: inherit;
                font-size: 0.86rem;
                padding: 0.62rem 0.75rem;
            }

            .catalog-control input:focus,
            .catalog-control select:focus {
                outline: 2px solid var(--river-water);
                outline-offset: 2px;
            }

            .catalog-result-status {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                min-height: 2.8rem;
                padding: 0.65rem 1.5rem;
                border-bottom: 1px solid var(--river-line);
                color: var(--river-text-soft);
                font-size: 0.8rem;
            }

            .catalog-filter-empty {
                padding: 3rem 1.5rem;
                color: var(--river-text-soft);
                text-align: center;
            }

            .catalog-filter-empty[hidden] {
                display: none;
            }

            .source[hidden] {
                display: none;
            }
            .source-list {
                margin:
                    0;
                padding:
                    0;
                list-style:
                    none;
            }

            .source {
                display:
                    grid;
                grid-template-columns:
                    minmax(0, 2fr)
                    minmax(8rem, 0.55fr)
                    minmax(9rem, 0.65fr)
                    minmax(9rem, 0.7fr);
                gap:
                    1.25rem;
                align-items:
                    center;
                padding:
                    1.35rem 1.5rem;
                border-bottom:
                    1px solid var(--river-line);
            }

            .source:last-child {
                border-bottom:
                    0;
            }

            .source-title {
                min-width:
                    0;
            }

            .source-title a {
                display:
                    inline-block;
                max-width:
                    100%;
                overflow:
                    hidden;
                color:
                    var(--river-ink);
                font-family:
                    var(--river-serif);
                font-size:
                    1.18rem;
                line-height:
                    1.25;
                text-decoration:
                    none;
                text-overflow:
                    ellipsis;
                white-space:
                    nowrap;
            }

            .source-title p {
                margin:
                    0.45rem 0 0;
                overflow:
                    hidden;
                color:
                    var(--river-text-muted);
                font-size:
                    0.75rem;
                text-overflow:
                    ellipsis;
                white-space:
                    nowrap;
            }

            .field-label {
                display:
                    block;
                margin-bottom:
                    0.3rem;
                color:
                    var(--river-text-muted);
                font-size:
                    0.65rem;
                font-weight:
                    700;
                letter-spacing:
                    0.12em;
                text-transform:
                    uppercase;
            }

            .field-value {
                font-size:
                    0.86rem;
            }

            .state {
                display:
                    inline-flex;
                align-items:
                    center;
                gap:
                    0.4rem;
                padding:
                    0.35rem 0.62rem;
                border-radius:
                    999px;
                font-size:
                    0.74rem;
                font-weight:
                    700;
                background:
                    var(--river-paper-warm);
            }

            .state::before {
                width:
                    0.45rem;
                height:
                    0.45rem;
                border-radius:
                    50%;
                content:
                    "";
                background:
                    var(--river-gold);
            }

            .state.available::before {
                background:
                    var(--river-forest);
            }

            .empty {
                padding:
                    4rem 1.5rem;
                text-align:
                    center;
            }

            .empty strong {
                display:
                    block;
                font-family:
                    var(--river-serif);
                font-size:
                    1.75rem;
                font-weight:
                    400;
            }

            .empty p {
                max-width:
                    54ch;
                margin:
                    0.75rem auto 0;
                color:
                    var(--river-text-soft);
            }

            @media (
                max-width: 950px
            ) {

                .catalog-tools {
                    grid-template-columns:
                        1fr;
                }

                .catalog-result-status {
                    align-items:
                        flex-start;
                    flex-direction:
                        column;
                }

                .hero {
                    grid-template-columns:
                        1fr;
                }

                .summary {
                    grid-template-columns:
                        repeat(2, 1fr);
                }

                .source {
                    grid-template-columns:
                        1fr 1fr;
                }

                .source-title {
                    grid-column:
                        1 / -1;
                }

            }

            @media (
                max-width: 620px
            ) {

                .workspace {
                    width:
                        min(
                            calc(100% - 2rem),
                            1440px
                        );
                }

                .topbar {
                    align-items:
                        flex-start;
                }

                .hero {
                    padding-top:
                        3rem;
                }

                .summary {
                    grid-template-columns:
                        1fr;
                }

                .source {
                    grid-template-columns:
                        1fr;
                }

            }
</style>

<RiverOsLayout
    title="Content Workspace · River OS"
    workspaceVariant="dashboard"
    activeSection="content"
>
<section class="hero">
                <div>
                    <p class="eyebrow">
                        River OS · Content
                    </p>

                    <h1>
                        Content Workspace
                    </h1>

                    <p class="hero-copy">
                        Canonical published sources, transcript readiness,
                        ingestion state, and the operational foundation for
                        the content engine.
                    </p>
                </div>

                <aside class="connection">
                    <p class="connection-label">
                        Catalog connection
                    </p>

                    {
                        catalogConnected
                            ? (
                                <>
                                    <strong>
                                        Connected
                                    </strong>

                                    <p>
                                        Reading the dedicated River content catalog.
                                    </p>
                                </>
                            )
                            : (
                                <>
                                    <strong>
                                        Not connected
                                    </strong>

                                    <p>
                                        {
                                            catalogError ??
                                            "A dedicated RIVER_CONTENT_DB binding has not been provisioned yet."
                                        }
                                    </p>
                                </>
                            )
                    }
                </aside>
            </section>

            <section
                class="summary"
                aria-label="Content catalog summary"
            >
                <article class="metric">
                    <span>
                        Canonical sources
                    </span>

                    <strong>
                        {summary.totalSources}
                    </strong>
                </article>

                <article class="metric">
                    <span>
                        Transcript pending
                    </span>

                    <strong>
                        {summary.transcriptPending}
                    </strong>
                </article>

                <article class="metric">
                    <span>
                        Transcript available
                    </span>

                    <strong>
                        {summary.transcriptAvailable}
                    </strong>
                </article>

                <article class="metric">
                    <span>
                        Platforms
                    </span>

                    <strong>
                        {summary.platforms}
                    </strong>
                </article>
            </section>

            <section class="catalog">
                <header class="catalog-header">
                    <div>
                        <p class="eyebrow">
                            Source registry
                        </p>

                        <h2>
                            Published content
                        </h2>

                        <p>
                            Newest canonical sources first.
                        </p>
                    </div>
                </header>

                <div class="catalog-tools" data-source-filter>
                    <div class="catalog-control">
                        <label for="river-content-search">Search</label>
                        <input id="river-content-search" type="search" placeholder="Title or source ID" autocomplete="off" data-source-search />
                    </div>

                    <div class="catalog-control">
                        <label for="river-platform-filter">Platform</label>
                        <select id="river-platform-filter" data-platform-filter>
                            <option value="">All platforms</option>
                            {platformOptions.map((platform) => (
                                <option value={platform}>
                                    {formatRiverContentPlatform(platform)}
                                </option>
                            ))}
                        </select>
                    </div>

                    <div class="catalog-control">
                        <label for="river-transcript-filter">Transcript</label>
                        <select id="river-transcript-filter" data-transcript-filter>
                            <option value="">All states</option>
                            <option value="available">Available</option>
                            <option value="pending">Pending</option>
                        </select>
                    </div>
                </div>

                <div class="catalog-result-status" aria-live="polite">
                    <span data-visible-count>{entries.length === 1 ? "1 source" : entries.length + " sources"}</span>
                    <span>Filters apply only to this workspace view.</span>
                </div>

                {
                    entries.length === 0
                        ? (
                            <div class="empty">
                                <strong>
                                    {
                                        catalogConnected
                                            ? "No catalog entries yet."
                                            : "Catalog awaiting connection."
                                    }
                                </strong>

                                <p>
                                    {
                                        catalogConnected
                                            ? "Canonical sources will appear here as the River OS read model is populated."
                                            : "The workspace is built and protected. Provisioning the dedicated content database is the remaining runtime connection step."
                                    }
                                </p>
                            </div>
                        )
                        : (
                            <ol class="source-list">
                                {
                                    entries.map(
                                        (
                                            entry
                                        ) => (
                                            <li
                                                class="source"
                                                data-source-row
                                                data-search={`${entry.title} ${entry.sourceId}`.toLowerCase()}
                                                data-platform={entry.platform}
                                                data-transcript={entry.transcriptState}
                                            >
                                                <div class="source-title">
                                                    <a
                                                            href={
                                                                buildRiverContentSourceDetailPath(
                                                                    entry.sourceId
                                                                )
                                                            }
                                                        >
                                                            {entry.title}
                                                        </a>

                                                    <p>
                                                        {entry.sourceId}
                                                    </p>
                                                </div>

                                                <div>
                                                    <span class="field-label">
                                                        Platform
                                                    </span>

                                                    <span class="field-value">
                                                        {
                                                            formatRiverContentPlatform(
                                                                entry.platform
                                                            )
                                                        }
                                                    </span>
                                                </div>

                                                <div>
                                                    <span class="field-label">
                                                        Transcript
                                                    </span>

                                                    <span
                                                        class:list={[
                                                            "state",
                                                            {
                                                                available:
                                                                    entry.transcriptState ===
                                                                    "available"
                                                            }
                                                        ]}
                                                    >
                                                        {
                                                            entry.transcriptState ===
                                                            "available"
                                                                ? "Available"
                                                                : "Pending"
                                                        }
                                                    </span>
                                                </div>

                                                <div>
                                                    <span class="field-label">
                                                        Published
                                                    </span>

                                                    <span class="field-value">
                                                        {
                                                            formatRiverContentDate(
                                                                entry.publishedAt
                                                            )
                                                        }
                                                    </span>
                                                </div>
                                            </li>
                                        )
                                    )
                                }
                            </ol>

                            <div class="catalog-filter-empty" data-filter-empty hidden>
                                No sources match the current filters.
                            </div>
                        )
                }
            </section>

<script>
    const workspaceFilter = document.querySelector("[data-source-filter]");

    if (workspaceFilter !== null) {
        const searchInput = workspaceFilter.querySelector("[data-source-search]");
        const platformFilter = workspaceFilter.querySelector("[data-platform-filter]");
        const transcriptFilter = workspaceFilter.querySelector("[data-transcript-filter]");
        const sourceRows = Array.from(document.querySelectorAll("[data-source-row]"));
        const visibleCount = document.querySelector("[data-visible-count]");
        const emptyState = document.querySelector("[data-filter-empty]");

        const applyFilters = () => {
            const search = searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : "";
            const platform = platformFilter instanceof HTMLSelectElement ? platformFilter.value : "";
            const transcript = transcriptFilter instanceof HTMLSelectElement ? transcriptFilter.value : "";
            let visible = 0;

            for (const row of sourceRows) {
                const matchesSearch = search === "" || (row.getAttribute("data-search") ?? "").includes(search);
                const matchesPlatform = platform === "" || row.getAttribute("data-platform") === platform;
                const matchesTranscript = transcript === "" || row.getAttribute("data-transcript") === transcript;
                const matches = matchesSearch && matchesPlatform && matchesTranscript;

                if (row instanceof HTMLElement) {
                    row.hidden = !matches;
                }

                if (matches) {
                    visible += 1;
                }
            }

            if (visibleCount !== null) {
                visibleCount.textContent = visible + (visible === 1 ? " source" : " sources");
            }

            if (emptyState instanceof HTMLElement) {
                emptyState.hidden = visible !== 0;
            }
        };

        searchInput?.addEventListener("input", applyFilters);
        platformFilter?.addEventListener("change", applyFilters);
        transcriptFilter?.addEventListener("change", applyFilters);
    }
</script>
</RiverOsLayout>
