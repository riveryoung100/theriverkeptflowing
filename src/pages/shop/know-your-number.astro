---
import MainLayout from "../../layouts/MainLayout.astro";

export const prerender = false;

import {
    KNOW_YOUR_NUMBER_COMMERCE_PRODUCT,
} from "../../lib/commerce/product-catalog";

import {
    PRODUCT_002N_KNOW_YOUR_NUMBER_PRICE_AVAILABILITY_PUBLICATION_STATE,
    buildPublicPriceAvailabilityPresentation,
} from "../../lib/commerce/product-price-availability-presentation";

import {
    KNOW_YOUR_NUMBER_CHECKOUT_PUBLICATION_STATE,
    buildPublicProductPurchaseCta,
} from "../../lib/commerce/product-purchase-cta";

import {
    buildCustomerLaunchReturnNotice,
} from "../../lib/commerce/product-customer-launch-path";

const product =
    KNOW_YOUR_NUMBER_COMMERCE_PRODUCT;

const workingPriceUsd =
    product.unitAmountUsdCents / 100;

const publicOffer =
    buildPublicPriceAvailabilityPresentation({
        publicationState:
            PRODUCT_002N_KNOW_YOUR_NUMBER_PRICE_AVAILABILITY_PUBLICATION_STATE,
        workingPriceUsd,
        digitallyDeliverable: true,
    });

const purchaseCta =
    buildPublicProductPurchaseCta(
        KNOW_YOUR_NUMBER_CHECKOUT_PUBLICATION_STATE,
        {
            productId:
                product.productId,
            productVersion:
                product.productVersion,
            productName:
                product.productName,
            checkoutEndpoint:
                product.checkoutPath,
        }
    );

const customerLaunchReturnNotice =
    buildCustomerLaunchReturnNotice(
        Astro.url.searchParams.get("checkout")
    );
---

<MainLayout
    title="Know Your Number | The River Kept Flowing"
    description="Find the amount your household can realistically use each month to protect your family and build your future without sacrificing the life you are living today."
>
    <main
        data-pagefind-body
        class="library-page know-your-number-page"
    >
        {
            customerLaunchReturnNotice && (
                <section id="checkout-return" class="library-section">
                    <div class="library-shell">
                        <div class="library-section__heading">
                            <div>
                                <p class="section-label">Purchase status</p>
                                <h2>{customerLaunchReturnNotice.heading}</h2>
                            </div>
                            <p>{customerLaunchReturnNotice.message}</p>
                        </div>
                    </div>
                </section>
            )
        }

        <section class="library-hero">
            <div class="library-shell">
                <p class="section-label">
                    Money & Future Planning
                </p>

                <h1>
                    Know Your Number
                </h1>

                <p class="know-your-number-page__lead">
                    Find the amount your household can realistically use each month
                    to protect your family and build your future without sacrificing
                    the life you are living today.
                </p>

                <p class="know-your-number-page__sublead">
                    Before you decide how much to save, invest, pay toward debt, or
                    spend on protection, first figure out what your life can
                    sustainably support.
                </p>

                <div class="know-your-number-page__offer">
                    <strong>{publicOffer.priceLabel}</strong>
                    <span>{publicOffer.availabilityLabel}</span>
                </div>

                {
                    purchaseCta && (
                        <a
                            class="know-your-number-page__hero-cta"
                            href="#purchase"
                        >
                            Get Know Your Number — {publicOffer.priceLabel}
                        </a>
                    )
                }

                <p class="know-your-number-page__microcopy">
                    One-time purchase. Digital delivery after successful payment.
                </p>
            </div>
        </section>

        <section class="library-section">
            <div class="library-shell">
                <div class="library-section__heading">
                    <div>
                        <p class="section-label">
                            Start with capacity
                        </p>

                        <h2>
                            Stop forcing your life to fit a financial product.
                        </h2>
                    </div>

                    <p>
                        Most financial decisions start with a product, a percentage,
                        or a rule of thumb. Know Your Number starts somewhere more
                        useful: your actual household.
                    </p>
                </div>

                <div class="know-your-number-page__callout">
                    <p>
                        The goal is not to squeeze every possible dollar out of your
                        month. The goal is to find a number you can actually sustain
                        while still living, enjoying your life, protecting what
                        matters, and building toward the future.
                    </p>
                </div>
            </div>
        </section>

        <section class="library-section">
            <div class="library-shell">
                <div class="library-section__heading">
                    <div>
                        <p class="section-label">
                            The Four Buckets
                        </p>

                        <h2>
                            Live. Enjoy. Protect. Build.
                        </h2>
                    </div>

                    <p>
                        Work from income and monthly obligations toward true margin,
                        then decide what that margin can responsibly do for your
                        household today and over time.
                    </p>
                </div>

                <div class="know-your-number-page__grid">
                    <article>
                        <span>01</span>
                        <h3>Live</h3>
                        <p>
                            Account honestly for the housing, food, transportation,
                            bills, and responsibilities your household already
                            carries.
                        </p>
                    </article>

                    <article>
                        <span>02</span>
                        <h3>Enjoy</h3>
                        <p>
                            Make room for fun, hobbies, family experiences, and the
                            parts of life you do not want every financial plan to
                            erase.
                        </p>
                    </article>

                    <article>
                        <span>03</span>
                        <h3>Protect</h3>
                        <p>
                            Consider emergency reserves and family protection needs
                            without manufacturing room for a predetermined product.
                        </p>
                    </article>

                    <article>
                        <span>04</span>
                        <h3>Build</h3>
                        <p>
                            Direct sustainable capacity toward debt reduction,
                            future priorities, and long-term goals with greater
                            clarity.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section class="library-section">
            <div class="library-shell">
                <div class="library-section__heading">
                    <div>
                        <p class="section-label">
                            What you get
                        </p>

                        <h2>
                            A practical process you can work through at your own pace.
                        </h2>
                    </div>

                    <p>
                        Instead of treating financial questions as separate problems,
                        Know Your Number puts them into one connected sequence so you
                        can see the relationship between your present life and your
                        future priorities.
                    </p>
                </div>

                <div class="know-your-number-page__steps">
                    <p>Monthly household income</p>
                    <p>Core living expenses</p>
                    <p>Fun and lifestyle spending</p>
                    <p>Debt and financial obligations</p>
                    <p>True monthly margin</p>
                    <p>Emergency reserve target</p>
                    <p>Debt pressure</p>
                    <p>Optional educational family protection estimate</p>
                    <p>Future priorities and the advantage of time</p>
                </div>
            </div>
        </section>

        <section class="library-section">
            <div class="library-shell">
                <div class="library-section__heading">
                    <div>
                        <p class="section-label">
                            Who this is for
                        </p>

                        <h2>
                            For households that want clarity before another financial decision.
                        </h2>
                    </div>

                    <p>
                        This system is especially useful if you earn money but still
                        feel unsure what you can responsibly commit each month, if
                        competing priorities keep pulling your money in different
                        directions, or if you simply want a clearer framework before
                        making bigger financial choices.
                    </p>
                </div>
            </div>
        </section>

        <section class="library-section">
            <div class="library-shell">
                <div class="know-your-number-page__privacy">
                    <p class="section-label">
                        Private by design
                    </p>

                    <h2>
                        Your completed financial information stays with you.
                    </h2>

                    <p>
                        The River Kept Flowing does not need your passwords, Social
                        Security number, bank or card numbers, policy numbers,
                        account numbers, access codes, or the exact locations of
                        valuables and important documents for you to use this system.
                    </p>

                    <p>
                        You work through your household numbers privately. The
                        system is designed to help you organize the information, not
                        hand your completed financial picture to us.
                    </p>
                </div>
            </div>
        </section>

        <section
            id="purchase"
            class="library-section"
        >
            <div class="library-shell">
                <div class="know-your-number-page__purchase">
                    <p class="section-label">
                        Know Your Number V1
                    </p>

                    <h2>
                        Find the number your life can actually support.
                    </h2>

                    <p class="know-your-number-page__purchase-copy">
                        Get the complete Four Buckets planning system and work
                        through your household from real monthly life to sustainable
                        future capacity.
                    </p>

                    <div class="know-your-number-page__offer">
                        <strong>{publicOffer.priceLabel}</strong>
                        <span>{publicOffer.availabilityLabel}</span>
                    </div>

                    {
                        purchaseCta ? (
                            <form
                                id="know-your-number-purchase"
                                data-checkout-endpoint={purchaseCta.checkoutEndpoint}
                                data-product-id={purchaseCta.productId}
                                data-product-version={purchaseCta.productVersion}
                            >
                                <label for="know-your-number-delivery-email">
                                    Delivery email
                                </label>

                                <input
                                    id="know-your-number-delivery-email"
                                    name="deliveryEmail"
                                    type="email"
                                    autocomplete="email"
                                    placeholder="you@example.com"
                                    required
                                />

                                <button type="submit">
                                    {purchaseCta.label}
                                </button>

                                <p class="know-your-number-page__checkout-note">
                                    Secure checkout powered by Stripe. Your digital
                                    product is delivered to the email you enter above
                                    after successful payment.
                                </p>

                                <p
                                    id="know-your-number-purchase-status"
                                    role="status"
                                    aria-live="polite"
                                ></p>
                            </form>
                        ) : (
                            <p class="know-your-number-page__launch-note">
                                Secure checkout is being kept closed until the
                                governed checkout launch step is explicitly opened.
                            </p>
                        )
                    }

                    <p class="know-your-number-page__boundary">
                        Educational planning tool only. Know Your Number does not
                        provide individualized financial, tax, legal, investment, or
                        insurance advice and does not promise a particular outcome.
                    </p>
                </div>
            </div>
        </section>
    </main>

    <script is:inline>
        const purchaseForm =
            document.querySelector("#know-your-number-purchase");

        if (purchaseForm instanceof HTMLFormElement) {
            purchaseForm.addEventListener(
                "submit",
                async (event) => {
                    event.preventDefault();

                    const status =
                        document.querySelector(
                            "#know-your-number-purchase-status"
                        );

                    const submitButton =
                        purchaseForm.querySelector(
                            'button[type="submit"]'
                        );

                    const deliveryEmailInput =
                        purchaseForm.querySelector(
                            'input[name="deliveryEmail"]'
                        );

                    const checkoutEndpoint =
                        purchaseForm.dataset.checkoutEndpoint;

                    const productId =
                        purchaseForm.dataset.productId;

                    const productVersion =
                        purchaseForm.dataset.productVersion;

                    if (
                        !(status instanceof HTMLElement) ||
                        !(submitButton instanceof HTMLButtonElement) ||
                        !(deliveryEmailInput instanceof HTMLInputElement) ||
                        !checkoutEndpoint ||
                        !productId ||
                        !productVersion
                    ) {
                        return;
                    }

                    const deliveryEmail =
                        deliveryEmailInput.value.trim();

                    if (!deliveryEmail) {
                        status.textContent =
                            "Enter the email address where you want the product delivered.";
                        return;
                    }

                    submitButton.disabled = true;
                    status.textContent =
                        "Preparing secure checkout...";

                    try {
                        const customerReference =
                            crypto.randomUUID();

                        const response =
                            await fetch(
                                checkoutEndpoint,
                                {
                                    method: "POST",
                                    headers: {
                                        "content-type":
                                            "application/json",
                                    },
                                    body: JSON.stringify({
                                        productId,
                                        productVersion,
                                        customerReference,
                                        deliveryEmail,
                                    }),
                                }
                            );

                        const result =
                            await response.json();

                        if (
                            !response.ok ||
                            result.created !== true ||
                            typeof result.checkoutUrl !== "string" ||
                            result.checkoutUrl.length === 0
                        ) {
                            throw new Error(
                                "Checkout creation failed."
                            );
                        }

                        window.location.assign(
                            result.checkoutUrl
                        );
                    }
                    catch {
                        submitButton.disabled = false;
                        status.textContent =
                            "Secure checkout could not be prepared. Please try again.";
                    }
                }
            );
        }
    </script>

    <style>
        .know-your-number-page__lead {
            max-width: 52rem;
            font-size: clamp(1.15rem, 2vw, 1.4rem);
        }

        .know-your-number-page__sublead,
        .know-your-number-page__purchase-copy {
            max-width: 48rem;
            margin-top: 1rem;
        }

        .know-your-number-page__offer {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: 0.75rem 1.25rem;
            margin-top: 1.5rem;
        }

        .know-your-number-page__offer strong {
            font-size: clamp(2rem, 5vw, 3.5rem);
            line-height: 1;
        }

        .know-your-number-page__hero-cta {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 3.25rem;
            margin-top: 1.5rem;
            padding: 0.85rem 1.25rem;
            border: 1px solid currentColor;
            border-radius: 999px;
            font-weight: 700;
            text-decoration: none;
        }

        .know-your-number-page__microcopy,
        .know-your-number-page__checkout-note {
            max-width: 42rem;
            margin-top: 0.75rem;
            font-size: 0.9rem;
        }

        .know-your-number-page__callout {
            max-width: 56rem;
            margin-top: 2rem;
            padding: clamp(1.25rem, 3vw, 2rem);
            border-left: 3px solid currentColor;
        }

        .know-your-number-page__callout p {
            margin: 0;
        }

        .know-your-number-page__grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
            margin-top: 2rem;
        }

        .know-your-number-page__grid article,
        .know-your-number-page__privacy,
        .know-your-number-page__purchase {
            padding: clamp(1.5rem, 4vw, 2.5rem);
            border: 1px solid currentColor;
            border-radius: 1.5rem;
        }

        .know-your-number-page__grid span {
            font-size: 0.8rem;
            letter-spacing: 0.14em;
        }

        .know-your-number-page__steps {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.75rem;
            margin-top: 2rem;
        }

        .know-your-number-page__steps p {
            margin: 0;
            padding: 1rem;
            border-top: 1px solid currentColor;
        }

        #know-your-number-purchase {
            display: grid;
            gap: 0.75rem;
            max-width: 34rem;
            margin-top: 2rem;
        }

        #know-your-number-purchase input,
        #know-your-number-purchase button {
            width: 100%;
            min-height: 3.25rem;
        }

        #know-your-number-purchase input {
            padding: 0.75rem 1rem;
        }

        #know-your-number-purchase button {
            cursor: pointer;
            font-weight: 700;
        }

        #know-your-number-purchase button:disabled {
            cursor: wait;
            opacity: 0.65;
        }

        .know-your-number-page__launch-note,
        .know-your-number-page__boundary {
            max-width: 48rem;
            margin-top: 1.5rem;
        }

        @media (max-width: 760px) {
            .know-your-number-page__grid,
            .know-your-number-page__steps {
                grid-template-columns: 1fr;
            }
        }
    </style>
</MainLayout>