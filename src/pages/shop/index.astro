---
import MainLayout from "../../layouts/MainLayout.astro";

import {
    RIVER_LIFE_OPERATING_SYSTEM_PRESENTATION,
    RIVER_LIFE_OPERATING_SYSTEM_WORKING_PRICE_USD,
} from "../../lib/commerce/product-presentation";

import {
    PRODUCT_001F_03_PRICE_AVAILABILITY_PUBLICATION_STATE,
    buildPublicPriceAvailabilityPresentation,
    hasPublicPriceAvailabilityPresentation,
} from "../../lib/commerce/product-price-availability-presentation";

import {
    PRODUCT_001F_04_CHECKOUT_PUBLICATION_STATE,
    buildPublicPurchaseCta,
} from "../../lib/commerce/product-purchase-cta";

import {
    buildCustomerLaunchReturnNotice,
} from "../../lib/commerce/product-customer-launch-path";

const product = RIVER_LIFE_OPERATING_SYSTEM_PRESENTATION;

const publicOffer = buildPublicPriceAvailabilityPresentation({
    publicationState: PRODUCT_001F_03_PRICE_AVAILABILITY_PUBLICATION_STATE,
    workingPriceUsd: RIVER_LIFE_OPERATING_SYSTEM_WORKING_PRICE_USD,
    digitallyDeliverable: true,
});

const hasPublicOffer =
    hasPublicPriceAvailabilityPresentation(publicOffer);

const purchaseCta =
    buildPublicPurchaseCta(
        PRODUCT_001F_04_CHECKOUT_PUBLICATION_STATE
    );

const customerLaunchReturnNotice =
    buildCustomerLaunchReturnNotice(
        Astro.url.searchParams.get("checkout")
    );
---

<MainLayout
    title={`${product.productName} | The River Kept Flowing`}
    description={product.positioning}
>

<main data-pagefind-body class="library-page">

{
    customerLaunchReturnNotice && (
        <section
            id="checkout-return"
            class="library-section"
        >
            <div class="library-shell">
                <div class="library-section__heading">
                    <div>
                        <p class="section-label">
                            Purchase status
                        </p>

                        <h2>
                            {customerLaunchReturnNotice.heading}
                        </h2>
                    </div>

                    <p>
                        {customerLaunchReturnNotice.message}
                    </p>
                </div>
            </div>
        </section>
    )
}

<section class="library-hero">

<div class="library-shell">

<p class="section-label">
River Life Operating System
</p>

<h1>
Build a life around what matters most.
</h1>

<p>
{product.positioning}
</p>

<p>
The River Life Operating System is a guided digital system for examining
the life you have inherited and built, seeing more clearly where it is
actually carrying you, and choosing a smaller set of deliberate priorities
and next actions.
</p>

</div>

</section>


<section
    id="purpose"
    class="library-section"
>

<div class="library-shell">

<div class="library-section__heading">

<div>

<p class="section-label">
The purpose
</p>

<h2>
A life can fill up before you decide what it is for.
</h2>

</div>

<p>
This system is designed to help you slow the pattern down long enough to
look at it clearly: what receives your time, what shapes your attention,
what your responsibilities are asking of you, what your relationships need,
what your work and money are serving, what your habits are reinforcing,
and what your ambitions are quietly costing.
</p>

</div>

<p>
The goal is not to optimize every part of life or create a perfect plan.
It is to identify what matters most, recognize what is pulling you away
from it, and leave with fewer priorities that can actually guide the way
you live.
</p>

</div>

</section>


<section
    id="architecture"
    class="library-section"
>

<div class="library-shell">

<div class="library-section__heading">

<div>

<p class="section-label">
The system
</p>

<h2>
Five parts. One life examined as a whole.
</h2>

</div>

<p>
The River Life Operating System moves through five connected parts.
Each one asks a different question about where your life came from,
what is shaping it now, and where it is carrying you next.
</p>

</div>

{
    product.architecture.map((section) => (
        <section class="library-section">
            <div class="library-section__heading">
                <div>
                    <p class="section-label">
                        {String(section.order).padStart(2, "0")}
                    </p>

                    <h3>
                        {section.title}
                    </h3>
                </div>

                <p>
                    {
                        section.id === "headwaters"
                            ? "Examine what formed you: the experiences, assumptions, expectations, environments, and inherited patterns that helped shape the life you began building."
                            : section.id === "source"
                              ? "Identify what you actually believe matters most before schedules, obligations, habits, and ambition decide those priorities for you."
                              : section.id === "tributaries"
                                ? "Look at the major streams feeding your life \u2014 relationships, work, money, responsibilities, habits, attention, health, service, and the other areas competing for limited capacity."
                                : section.id === "current"
                                  ? "Examine the direction created by your ordinary days: where your time goes, what repeats, what receives your best energy, and what your present patterns are producing."
                                  : "Choose the direction you want to move toward and reduce that direction into deliberate priorities and next actions you can actually carry into ordinary life."
                    }
                </p>
            </div>
        </section>
    ))
}

</div>

</section>


<section
    id="what-you-receive"
    class="library-section"
>

<div class="library-shell">

<div class="library-section__heading">

<div>

<p class="section-label">
What you receive
</p>

<h2>
A guided system you can work through, not just something to read.
</h2>

</div>

<p>
{product.customerDeliverable}
</p>

</div>

<p>
The value of the system is in structured application and guided execution.
It brings the ideas into one deliberate process so you can write, examine,
compare, decide, and leave with something usable rather than simply consume
another collection of thoughts.
</p>

<p>
The V1 system is built as a digital guided experience around the completed
five-part architecture: Headwaters, The Source, Tributaries, The Current,
and The Destination.
</p>

</div>

</section>


<section
    id="who-it-is-for"
    class="library-section"
>

<div class="library-shell">

<div class="library-section__heading">

<div>

<p class="section-label">
Who it is for
</p>

<h2>
For people who want to live more deliberately.
</h2>

</div>

<p>
You do not need to be in crisis, reinvent your entire life, or have every
answer before beginning. The system is for someone willing to examine
their life carefully and make more deliberate decisions about what deserves
their time, attention, responsibility, and effort.
</p>

</div>

<p>
It may be especially useful when life feels crowded, when success and
direction no longer feel like the same thing, when too many good things
are competing for the same limited capacity, or when you know something
needs to change but do not yet know what deserves to remain.
</p>

</div>

</section>


<section
    id="boundaries"
    class="library-section"
>

<div class="library-shell">

<div class="library-section__heading">

<div>

<p class="section-label">
Built with boundaries
</p>

<h2>
A life-planning system, not a promise of outcomes.
</h2>

</div>

<p>
The River Life Operating System is an educational and reflective planning
resource. It does not replace therapy, medical care, legal advice,
financial advice, or another licensed professional relationship.
</p>

</div>

<p>
The system does not promise a particular result. It gives you a structure
for examining your own life, making your own decisions, and turning those
decisions into more deliberate next actions.
</p>

</div>

</section>


{
    hasPublicOffer && (
        <section
            id="product-offer"
            class="library-section"
        >

        <div class="library-shell">

        <div class="library-section__heading">

        <div>

        <p class="section-label">
        Product details
        </p>

        <h2>
        The River Life Operating System V1
        </h2>

        </div>

        <div>
            {
                publicOffer.priceLabel && (
                    <p>
                        <strong>{publicOffer.priceLabel}</strong>
                    </p>
                )
            }

            {
                publicOffer.availabilityLabel && (
                    <p>
                        {publicOffer.availabilityLabel}
                    </p>
                )
            }
        </div>

        </div>

        <p>
        The product is delivered digitally through the governed River
        fulfillment path after verified payment.
        </p>

        {
            purchaseCta && (
                <form
                    id="product-purchase"
                    data-checkout-endpoint={purchaseCta.checkoutEndpoint}
                >
                    <label for="delivery-email">
                        Delivery email
                    </label>

                    <input
                        id="delivery-email"
                        name="deliveryEmail"
                        type="email"
                        autocomplete="email"
                        required
                    />

                    <button type="submit">
                        {purchaseCta.label}
                    </button>

                    <p
                        id="purchase-status"
                        role="status"
                        aria-live="polite"
                    ></p>
                </form>
            )
        }

        </div>

        </section>
    )
}


<section
    id="release-state"
    class="library-section"
>

<div class="library-shell">

<div class="library-section__heading">

<div>

<p class="section-label">
V1 presentation
</p>

<h2>
The product is being prepared carefully before public release.
</h2>

</div>

<p>
This page describes the actual River Life Operating System V1 and what it
is designed to do. Pricing and digital availability are now presented
here. Customer purchasing remains closed until the later governed launch
steps explicitly authorize it.
</p>

</div>

<p>
The River Kept Flowing is keeping those steps separate on purpose:
the product should be represented accurately first, and commerce should
only become public when the complete launch path is deliberately ready.
</p>

</div>

</section>

</main>

{
    purchaseCta && (
        <script>
            const purchaseForm =
                document.querySelector<HTMLFormElement>(
                    "#product-purchase"
                );

            purchaseForm?.addEventListener(
                "submit",
                async (event) => {

                    event.preventDefault();

                    const status =
                        document.querySelector<HTMLElement>(
                            "#purchase-status"
                        );

                    const submitButton =
                        purchaseForm.querySelector<HTMLButtonElement>(
                            'button[type="submit"]'
                        );

                    const deliveryEmailInput =
                        purchaseForm.querySelector<HTMLInputElement>(
                            'input[name="deliveryEmail"]'
                        );

                    const checkoutEndpoint =
                        purchaseForm.dataset
                            .checkoutEndpoint;

                    if (
                        !status ||
                        !submitButton ||
                        !deliveryEmailInput ||
                        !checkoutEndpoint
                    ) {
                        return;
                    }

                    const deliveryEmail =
                        deliveryEmailInput
                            .value
                            .trim();

                    if (!deliveryEmail) {
                        status.textContent =
                            "Enter the email address where you want the product delivered.";

                        return;
                    }

                    submitButton.disabled =
                        true;

                    status.textContent =
                        "Preparing secure checkout...";

                    try {

                        const customerReference =
                            crypto.randomUUID();

                        const response =
                            await fetch(
                                checkoutEndpoint,
                                {
                                    method:
                                        "POST",

                                    headers: {
                                        "content-type":
                                            "application/json",
                                    },

                                    body:
                                        JSON.stringify({
                                            customerReference,
                                            deliveryEmail,
                                        }),
                                }
                            );

                        const result =
                            await response.json() as {
                                created?: boolean;
                                checkoutUrl?: string;
                            };

                        if (
                            !response.ok ||
                            result.created !== true ||
                            typeof result.checkoutUrl !== "string" ||
                            result.checkoutUrl.length === 0
                        ) {
                            throw new Error(
                                "Checkout creation failed."
                            );
                        }

                        window.location.assign(
                            result.checkoutUrl
                        );
                    }
                    catch {

                        submitButton.disabled =
                            false;

                        status.textContent =
                            "Secure checkout could not be prepared. Please try again.";
                    }
                }
            );
        </script>
    )
}

</MainLayout>
