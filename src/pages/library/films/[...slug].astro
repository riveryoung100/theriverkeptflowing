---
import { getCollection, render } from "astro:content";
import ReadingLayout from "../../../layouts/ReadingLayout.astro";
import ContentEntry from "../../../components/content/ContentEntry.astro";
import RelatedContent from "../../../components/content/RelatedContent.astro";

export async function getStaticPaths() {

    const films = await getCollection(
        "films",
        ({ data }) => {
            return import.meta.env.PROD ? !data.draft : true;
        }
    );

    return films
        .filter((film) => !film.data.draft)
        .map((film) => ({
            params:{
                slug:film.id
            },
            props:{
                film
            }
        }));
}

const { film } = Astro.props;

const { Content } = await render(film);

const canonical = new URL(
    `/library/films/${film.id}/`,
    Astro.site ?? Astro.url
).toString();
---

<ReadingLayout
    title={`${film.data.title} | The River Kept Flowing`}
    description={film.data.description}
    author={film.data.author}
    canonical={canonical}
>

    <ContentEntry
        eyebrow={film.data.platform ?? "Films From the River"}
        title={film.data.title}
        description={film.data.description}
        author={film.data.author}
        published={film.data.published}
        readingMinutes={film.data.durationMinutes}
        tags={film.data.tags}
    >

        <Content />

    </ContentEntry>
    <RelatedContent
        currentCollection="films"
        currentId={film.id}
        currentTags={film.data.tags}
    />

</ReadingLayout>