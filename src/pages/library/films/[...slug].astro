---
import { getCollection, render } from "astro:content";
import ReadingLayout from "../../../layouts/ReadingLayout.astro";

export async function getStaticPaths() {
    const films = await getCollection("films", ({ data }) => {
        return import.meta.env.PROD ? !data.draft : true;
    });

    return films
        .filter((film) => !film.data.draft)
        .map((film) => ({
            params: {
                slug: film.id
            },
            props: {
                film
            }
        }));
}

const { film } = Astro.props;
const { Content } = await render(film);

const canonical = new URL(
    `/library/films/${film.id}/`,
    Astro.site ?? Astro.url
).toString();
---

<ReadingLayout
    title={`${film.data.title} | The River Kept Flowing`}
    description={film.data.description}
    author={film.data.author}
    canonical={canonical}
    bodyClass="reading-page film-reading-page"
>

    <article class="content-entry film-entry">

        <header class="content-entry__header">

            <p class="eyebrow">
                The Video Journey
            </p>

            <h1>
                {film.data.title}
            </h1>

            <p class="content-entry__description">
                {film.data.description}
            </p>

            <div class="content-entry__meta">

                <span>
                    By {film.data.author}
                </span>

                <span>
                    {film.data.published.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                        day: "numeric"
                    })}
                </span>

                {film.data.platform && (
                    <span>
                        {film.data.platform}
                    </span>
                )}

                {film.data.durationMinutes && (
                    <span>
                        {film.data.durationMinutes} min
                    </span>
                )}

            </div>

            {film.data.videoUrl && (

                <p class="film-entry__watch">

                    <a
                        href={film.data.videoUrl}
                        class="button page-button-primary"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Watch the Video
                    </a>

                </p>

            )}

        </header>


        <div class="content-entry__body">

            <Content />

        </div>


        {film.data.tags.length > 0 && (

            <footer class="content-entry__tags">

                <p class="section-label">
                    Filed under
                </p>

                <ul>
                    {film.data.tags.map((tag) => (
                        <li>{tag}</li>
                    ))}
                </ul>

            </footer>

        )}

    </article>

</ReadingLayout>