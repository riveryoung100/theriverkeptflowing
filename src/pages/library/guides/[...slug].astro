---
import { getCollection, render } from "astro:content";
import ReadingLayout from "../../../layouts/ReadingLayout.astro";
import ContentEntry from "../../../components/content/ContentEntry.astro";

export async function getStaticPaths() {

    const guides = await getCollection(
        "guides",
        ({ data }) => {
            return import.meta.env.PROD ? !data.draft : true;
        }
    );

    return guides.map((guide) => ({
        params:{
            slug:guide.id
        },
        props:{
            guide
        }
    }));
}

const { guide } = Astro.props;

const { Content } = await render(guide);

const canonical = new URL(
    `/library/guides/${guide.id}/`,
    Astro.site ?? Astro.url
).toString();
---

<ReadingLayout
    title={`${guide.data.title} | The River Kept Flowing`}
    description={guide.data.description}
    canonical={canonical}
>

    <ContentEntry
        eyebrow={guide.data.category}
        title={guide.data.title}
        description={guide.data.description}
        author={guide.data.author}
        published={guide.data.published}
        readingMinutes={guide.data.readingMinutes}
        version={guide.data.version}
        tags={guide.data.tags}
    >

        <Content />

    </ContentEntry>

</ReadingLayout>