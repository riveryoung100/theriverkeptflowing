---
import { getCollection } from "astro:content";
import MainLayout from "../../../layouts/MainLayout.astro";
import LibraryGrid from "../../../components/library/LibraryGrid.astro";
import LibraryHero from "../../../components/library/LibraryHero.astro";
import LibraryCollectionHeader from "../../../components/library/LibraryCollectionHeader.astro";

const guides = await getCollection(
    "guides",
    ({ data }) => !data.draft
);

const guideItems = guides
    .sort(
        (a, b) =>
            b.data.published.getTime() -
            a.data.published.getTime()
    )
    .map((guide) => ({
        title: guide.data.title,
        description: guide.data.description,
        href: `/library/guides/${guide.id}/`,
        label: guide.data.category,
        action: "Read the guide",
        number: guide.data.guideNumber
            ? `River Guide No. ${String(
                guide.data.guideNumber
            ).padStart(3, "0")}`
            : undefined,
        published: guide.data.published,
        readingMinutes: guide.data.readingMinutes,
        tags: guide.data.tags,
        featured: guide.data.featured
    }));
---

<MainLayout
    title="Guide Library | The River Kept Flowing"
    description="Explore practical River Guides covering stewardship, insurance, faith, family, work, health, finances, creativity, service, and the lifelong work of becoming."
    stylesheet="/library.css"
>

    <main class="library-page">

        <LibraryHero
            eyebrow="The practical library"
            title="River Guides"
            description="Clear explanations, practical systems, and durable lessons for building a meaningful life and caring well for what has been entrusted to us."
            buttonText="Explore the Complete River Guides Page"
            buttonHref="/river-guides/"
        />


        <section class="library-section">

            <div class="library-shell">

                <LibraryCollectionHeader
    label="Published guides"
    title="The growing collection"
    count={guideItems.length}
    singular="guide"
    plural="guides"
/>


                <LibraryGrid
                    items={guideItems}
                    emptyTitle="No Markdown River Guides have been published yet."
                    emptyDescription="The existing insurance handbooks remain available through the complete River Guides page. Future collection-based guides will appear here automatically when they are published."
                    emptyHref="/river-guides/"
                    emptyAction="Explore the existing guides"
                />

            </div>

        </section>

    </main>

</MainLayout>