---
import { getCollection, render } from "astro:content";
import ReadingLayout from "../../../layouts/ReadingLayout.astro";
import ContentEntry from "../../../components/content/ContentEntry.astro";
import RelatedContent from "../../../components/content/RelatedContent.astro";

export async function getStaticPaths() {

    const essays = await getCollection(
        "essays",
        ({ data }) => {
            return import.meta.env.PROD ? !data.draft : true;
        }
    );

    return essays
        .filter((essay) => !essay.data.draft)
        .map((essay) => ({
            params:{
                slug:essay.id
            },
            props:{
                essay
            }
        }));
}

const { essay } = Astro.props;

const { Content } = await render(essay);

const canonical = new URL(
    `/library/essays/${essay.id}/`,
    Astro.site ?? Astro.url
).toString();
---

<ReadingLayout
    title={`${essay.data.title} | The River Kept Flowing`}
    description={essay.data.description}
    author={essay.data.author}
    canonical={canonical}
    bodyClass="reading-page essay-reading-page"
>

    <ContentEntry
        eyebrow={essay.data.category ?? "Essays From the River"}
        title={essay.data.title}
        description={essay.data.description}
        author={essay.data.author}
        published={essay.data.published}
        readingMinutes={essay.data.readingMinutes}
        tags={essay.data.tags}
    >

        <Content />

    </ContentEntry>
    <RelatedContent
        currentCollection="essays"
        currentId={essay.id}
        currentTags={essay.data.tags}
    />

</ReadingLayout>