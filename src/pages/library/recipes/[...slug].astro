---
import { getCollection, render } from "astro:content";
import ReadingLayout from "../../../layouts/ReadingLayout.astro";
import ContentEntry from "../../../components/content/ContentEntry.astro";

export async function getStaticPaths() {

    const recipes = await getCollection(
        "recipes",
        ({ data }) => {
            return import.meta.env.PROD ? !data.draft : true;
        }
    );

    return recipes
        .filter((recipe) => !recipe.data.draft)
        .map((recipe) => ({
            params:{
                slug:recipe.id
            },
            props:{
                recipe
            }
        }));
}

const { recipe } = Astro.props;

const { Content } = await render(recipe);

const canonical = new URL(
    `/library/recipes/${recipe.id}/`,
    Astro.site ?? Astro.url
).toString();
---

<ReadingLayout
    title={`${recipe.data.title} | The River Kept Flowing`}
    description={recipe.data.description}
    author={recipe.data.author}
    canonical={canonical}
>

    <ContentEntry
        eyebrow={recipe.data.cuisine ?? "The River Table"}
        title={recipe.data.title}
        description={recipe.data.description}
        author={recipe.data.author}
        published={recipe.data.published}
        tags={recipe.data.tags}
    >

        <Content />

    </ContentEntry>

</ReadingLayout>