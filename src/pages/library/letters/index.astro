---
import { getCollection } from "astro:content";
import MainLayout from "../../../layouts/MainLayout.astro";
import LibraryHero from "../../../components/library/LibraryHero.astro";
import LibraryGrid from "../../../components/library/LibraryGrid.astro";
import LibraryCollectionHeader from "../../../components/library/LibraryCollectionHeader.astro";

const letters = await getCollection(
    "letters",
    ({ data }) => !data.draft
);

const letterItems = letters
    .sort(
        (a,b)=>
            b.data.published.getTime()-
            a.data.published.getTime()
    )
    .map((letter)=>({
        title:letter.data.title,
        description:letter.data.description,
        href:`/library/letters/${letter.id}/`,
        label:letter.data.recipient ?? "Letter",
        action:"Read the letter",
        published:letter.data.published,
        tags:letter.data.tags,
        featured:letter.data.featured
    }));
---

<MainLayout
    title="Letters | The River Kept Flowing"
    description="Read letters written across seasons of life to family, friends, future generations, and people walking beside the river."
    stylesheet="/library.css"
>

<main data-pagefind-body class="library-page">

    <LibraryHero
        eyebrow="Letters"
        title="Words written to people who mattered."
        description="Letters to family, friends, future generations, and anyone walking beside the river."
        buttonText="View Current"
        buttonHref="/current/"
    />

    <section class="library-section">

        <div class="library-shell">

            <LibraryCollectionHeader
    label="Published letters"
    title="The collection"
    count={letterItems.length}
    singular="letter"
    plural="letters"
/>


            <LibraryGrid
                items={letterItems}
                emptyTitle="No letters have been published yet."
                emptyDescription="Published Markdown letters will automatically appear here."
                emptyHref="/journey/"
                emptyAction="Explore the Journey"
            />

        </div>

    </section>

</main>

</MainLayout>