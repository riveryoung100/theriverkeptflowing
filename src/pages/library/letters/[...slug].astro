---
import { getCollection, render } from "astro:content";
import ReadingLayout from "../../../layouts/ReadingLayout.astro";
import ContentEntry from "../../../components/content/ContentEntry.astro";

export async function getStaticPaths() {

    const letters = await getCollection(
        "letters",
        ({ data }) => {
            return import.meta.env.PROD ? !data.draft : true;
        }
    );

    return letters
        .filter((letter) => !letter.data.draft)
        .map((letter) => ({
            params:{
                slug:letter.id
            },
            props:{
                letter
            }
        }));
}

const { letter } = Astro.props;

const { Content } = await render(letter);

const canonical = new URL(
    `/library/letters/${letter.id}/`,
    Astro.site ?? Astro.url
).toString();
---

<ReadingLayout
    title={`${letter.data.title} | The River Kept Flowing`}
    description={letter.data.description}
    author={letter.data.author}
    canonical={canonical}
>

    <ContentEntry
        eyebrow={letter.data.recipient ?? "Letters From the River"}
        title={letter.data.title}
        description={letter.data.description}
        author={letter.data.author}
        published={letter.data.published}
        tags={letter.data.tags}
    >

        <Content />

    </ContentEntry>

</ReadingLayout>