---
import "../styles/reset.css";
import "../styles/tokens.css";
import "../styles/typography.css";
import "../styles/world.css";

const title = "The River Kept Flowing";
const description =
    "A living reflective reality built to cultivate attention, stewardship, and wonder.";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        />

        <meta
            name="description"
            content={description}
        />

        <title>{title}</title>
    </head>

    <body>
        <main class="construction">
            <p class="construction__eyebrow">
                The landscape is being surveyed.
            </p>

            <h1>
                The River Kept Flowing
            </h1>

            <p class="construction__statement">
                A living reflective reality.
            </p>
        </main>
    </body>
</html>
