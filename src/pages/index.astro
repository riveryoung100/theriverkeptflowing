---
import MainLayout from "../layouts/MainLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeIntro from "../components/home/HomeIntro.astro";
import HomePaths from "../components/home/HomePaths.astro";
---

<MainLayout
    title="The River Kept Flowing | Build a Life That Lasts"
    description="The River Kept Flowing is a living archive of faith, family, stewardship, perseverance, creativity, and the lifelong work of becoming."
>
<main>

    <HomeHero />

    <HomeIntro />

    <HomePaths />

<section class="mission-section">

            <div class="section-shell mission-layout">

                <div class="mission-copy">

                    <p class="section-label light-label">
                        The mission
                    </p>

                    <h2>
                        Pursue truth. Cultivate wisdom. Steward life well.
                    </h2>

                    <p>
                        The River Kept Flowing exists to help people build lives of
                        substance and leave behind something that outlives them.
                    </p>

                    <p>
                        That means honest stories instead of polished appearances,
                        practical wisdom instead of empty motivation, and faithfulness
                        instead of constant performance.
                    </p>

                </div>


                <div class="mission-principles">

                    <article>
                        <span>01</span>

                        <div>
                            <h3>Story</h3>
                            <p>Where we have been and what shaped us.</p>
                        </div>
                    </article>

                    <article>
                        <span>02</span>

                        <div>
                            <h3>Wisdom</h3>
                            <p>What experience, study, failure, and faith have taught us.</p>
                        </div>
                    </article>

                    <article>
                        <span>03</span>

                        <div>
                            <h3>Stewardship</h3>
                            <p>How we care for our families, bodies, work, gifts, and resources.</p>
                        </div>
                    </article>

                    <article>
                        <span>04</span>

                        <div>
                            <h3>Service</h3>
                            <p>How what we have been given can become useful to others.</p>
                        </div>
                    </article>

                </div>

            </div>

        </section>


        <section class="tributaries-section">

            <div class="section-shell">

                <div class="centered-heading">

                    <p class="section-label">
                        The tributaries
                    </p>

                    <h2>
                        A meaningful life is fed by many streams.
                    </h2>

                    <p>
                        These are the disciplines and responsibilities continually
                        shaping the work.
                    </p>

                </div>


                <div class="tributary-grid">

                    <article class="home-tributary-card">
                        <h3>Faith</h3>
                        <p>
                            Seeking God, truth, purpose, wisdom, and obedience in ordinary life.
                        </p>
                    </article>

                    <article class="home-tributary-card">
                        <h3>Family and Legacy</h3>
                        <p>
                            Marriage, fatherhood, relationships, forgiveness, presence,
                            and what we pass forward.
                        </p>
                    </article>

                    <article class="home-tributary-card">
                        <h3>Growth and Wisdom</h3>
                        <p>
                            Learning, philosophy, communication, leadership, discipline,
                            and understanding people.
                        </p>
                    </article>

                    <article class="home-tributary-card">
                        <h3>Stewardship</h3>
                        <p>
                            Health, finances, work, energy, resources, and caring well
                            for what has been entrusted to us.
                        </p>
                    </article>

                    <article class="home-tributary-card">
                        <h3>Creation</h3>
                        <p>
                            Writing, storytelling, technology, food, craftsmanship,
                            and bringing worthy ideas into reality.
                        </p>
                    </article>

                    <article class="home-tributary-card">
                        <h3>Service</h3>
                        <p>
                            Feeding people, strengthening communities, sharing knowledge,
                            and making what we build useful.
                        </p>
                    </article>

                </div>

            </div>

        </section>


        <section class="latest-section">

            <div class="section-shell">

                <div class="section-heading">

                    <div>
                        <p class="section-label">
                            From the current
                        </p>

                        <h2>
                            Recent work from the river.
                        </h2>
                    </div>

                    <a href="pages/current.html" class="text-link">
                        View everything â†’
                    </a>

                </div>


                <div class="latest-grid">

                    <a href="content/first-entry.html" class="latest-card">

                        <span class="content-type">Journal</span>

                        <h3>
                            The River Kept Flowing
                        </h3>

                        <p>
                            The first entry in a living archive of lessons, reflection,
                            faith, and becoming.
                        </p>

                        <span class="card-link">Read the entry â†’</span>

                    </a>


                    <a href="articles/first-post.html" class="latest-card">

                        <span class="content-type">Article</span>

                        <h3>
                            The Beginning of Something That Lasts
                        </h3>

                        <p>
                            Why this platform exists and what it means to build beyond
                            achievement alone.
                        </p>

                        <span class="card-link">Read the article â†’</span>

                    </a>


                    <a href="pages/work-of-becoming.html" class="latest-card">

                        <span class="content-type">Ongoing Project</span>

                        <h3>
                            The Work of Becoming
                        </h3>

                        <p>
                            A growing record of the choices, disciplines, and convictions
                            shaping the person behind the work.
                        </p>

                        <span class="card-link">Explore the project â†’</span>

                    </a>

                </div>

            </div>

        </section>


        <section class="invitation-section">

            <div class="section-shell invitation-layout">

                <div>

                    <p class="section-label light-label">
                        Walk with the river
                    </p>

                    <h2>
                        The journey is still being written.
                    </h2>

                    <p>
                        Receive new writing, videos, resources, and updates as the platform
                        continues to grow.
                    </p>

                </div>


                <form class="join-form">

                    <label class="sr-only" for="join-name">
                        Your name
                    </label>

                    <input
                        id="join-name"
                        type="text"
                        name="name"
                        placeholder="Your name"
                        autocomplete="name"
                        required
                    >

                    <label class="sr-only" for="join-email">
                        Your email address
                    </label>

                    <input
                        id="join-email"
                        type="email"
                        name="email"
                        placeholder="Your email address"
                        autocomplete="email"
                        required
                    >

                    <button type="submit">
                        Join the Current
                    </button>

                </form>

            </div>

        </section>

    </main>
</MainLayout>