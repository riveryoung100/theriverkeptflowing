---
import "../styles/tokens.css";
import "../styles/typography.css";
import "../styles/accessibility.css";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Content-Type-Options", "nosniff");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Register | The River Kept Flowing</title>
  </head>
  <body>
    <a class="skip-link" href="#account-main">Skip to account form</a>
    <main id="account-main">
      <a href="/" class="home-link">The River Kept Flowing</a>
      <h1>Register</h1>
      <p>Submit a registration request, then continue to sign in.</p>
      <form id="account-form" method="post" action="/api/identity/register" aria-busy="false" aria-describedby="account-status">
        <fieldset id="account-fields" disabled>
          <legend class="sr-only">Register credentials</legend>
          <label for="account-email">Email</label>
          <input id="account-email" type="email" autocomplete="email" required />
          <label for="account-password">Password</label>
          <input id="account-password" type="password" autocomplete="new-password" aria-describedby="password-help" required />
          <p id="password-help" class="help">Use 15 to 128 characters. Unicode characters count as characters; the server checks the password requirements.</p>
          <button id="account-submit" type="submit" disabled>Register</button>
        </fieldset>
      </form>
      <p id="account-status" role="status" aria-live="polite" aria-atomic="true"></p>
      <p id="account-uncertainty" hidden>Try normal sign-in before retrying an uncertain registration request.</p>
      <noscript><p>JavaScript is required to submit this form. Credential fields remain disabled.</p></noscript>
      <p>Continue to <a href="/login">sign in</a>.</p>
    </main>
  </body>
</html>
<style>
  :global(body) { margin: 0; background: var(--river-paper); }
  main { box-sizing: border-box; width: min(100%, 32rem); margin: 4rem auto; padding: 2rem; background: var(--river-white); border: 1px solid var(--river-line); border-radius: var(--river-radius-md); }
  h1 { font-size: var(--river-heading-lg); margin-top: 1rem; }
  a { color: var(--river-forest-deep); text-underline-offset: 0.2em; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  label { display: block; margin-top: 1rem; font-weight: 600; }
  input { box-sizing: border-box; width: 100%; padding: 0.75rem; border: 1px solid var(--river-line-strong); border-radius: var(--river-radius-sm); font: inherit; color: var(--river-ink); background: var(--river-white); }
  button { width: 100%; padding: 0.8rem 1rem; border: 0; border-radius: var(--river-radius-sm); font: inherit; color: var(--river-white); background: var(--river-forest-deep); cursor: pointer; }
  button:disabled { opacity: 0.65; cursor: wait; }
  .help { font-size: var(--river-small); color: var(--river-text-soft); }
  [role="status"] { min-height: 1.7em; overflow-wrap: anywhere; }
  .skip-link { position: absolute; left: 1rem; top: -4rem; }
  .skip-link:focus { top: 1rem; padding: 0.5rem; background: var(--river-white); }
  input:focus-visible, button:focus-visible, a:focus-visible { outline: 3px solid var(--river-gold); outline-offset: 4px; }
  @media (max-width: 36rem) { main { margin: 1rem auto; border-radius: 0; padding: 1.5rem; } }
</style>

<script>
  {
    const form = document.getElementById("account-form");
    const email = document.getElementById("account-email");
    const password = document.getElementById("account-password");
    const fields = document.getElementById("account-fields");
    const submit = document.getElementById("account-submit");
    const status = document.getElementById("account-status");
    const uncertainty = document.getElementById("account-uncertainty");
    if (form instanceof HTMLFormElement && email instanceof HTMLInputElement &&
        password instanceof HTMLInputElement && fields instanceof HTMLFieldSetElement &&
        submit instanceof HTMLButtonElement && status instanceof HTMLElement && uncertainty instanceof HTMLElement) {
      const unavailable = "Registration is temporarily unavailable.";
      const messages = { 400: { "invalid-input": "Registration input is invalid.", "password-rejected": "Choose a different password." }, 403: { "origin-rejected": "Registration request was rejected." }, 413: { "payload-too-large": "Registration request is too large." }, 415: { "unsupported-content-type": "Registration requires JSON." }, 429: { "rate-limited": "Registration is temporarily limited. Try again later." }, 503: { unavailable: "Registration is temporarily unavailable." } };
      let pending = false;

      function object(value) {
        return typeof value === "object" && value !== null && !Array.isArray(value);
      }
      function keys(value, expected) {
        return object(value) && Object.keys(value).sort().join(",") === expected;
      }
      async function readResponse(response) {
        if (response.redirected || !response.body) throw new Error();
        const reader = response.body.getReader();
        const bytes = new Uint8Array(4096);
        let length = 0;
        try {
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            if (!(value instanceof Uint8Array) || value.byteLength > bytes.length - length) throw new Error();
            bytes.set(value, length);
            length += value.byteLength;
          }
          if (length >= 3 && bytes[0] === 239 && bytes[1] === 187 && bytes[2] === 191) throw new Error();
          return JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(bytes.subarray(0, length)));
        } catch {
          try { await reader.cancel(); } catch { /* No response detail displayed. */ }
          throw new Error();
        } finally {
          reader.releaseLock();
        }
      }
      function feedback(statusCode, body) {
        if (statusCode === 202 && keys(body, "message,ok") && body.ok === true && body.message === "Registration request processed. Continue to sign in.") return "Registration request processed. Continue to sign in.";
        if (!keys(body, "error,ok") || body.ok !== false || !keys(body.error, "code,message") ||
            typeof body.error.code !== "string" || typeof body.error.message !== "string") return unavailable;

        const message = messages[statusCode]?.[body.error.code];
        return typeof message === "string" && message === body.error.message ? message : unavailable;
      }
      form.addEventListener("submit", async event => {
        event.preventDefault();
        if (pending || !form.reportValidity()) return;
        pending = true;
        fields.disabled = true;
        submit.disabled = true;
        form.setAttribute("aria-busy", "true");
        status.textContent = "Processing registration request…";
        uncertainty.hidden = true;
        let payload;
        let body;
        try {
          payload = { email: email.value, password: password.value };
          body = JSON.stringify(payload);
          password.value = "";
          const response = await fetch("/api/identity/register", {
            method: "POST", headers: { "Content-Type": "application/json" },
            credentials: "same-origin", redirect: "error", cache: "no-store", body
          });
          status.textContent = feedback(response.status, await readResponse(response));
        } catch {
          status.textContent = unavailable;
        } finally {
          payload = undefined;
          body = undefined;
          password.value = "";
          pending = false;
          fields.disabled = false;
          submit.disabled = false;
          form.setAttribute("aria-busy", "false");
          uncertainty.hidden = status.textContent !== unavailable;
        }
      });
      // Install prevention before enabling controls; native fallback has no credential names.
      fields.disabled = false;
      submit.disabled = false;
    }
  }
</script>
