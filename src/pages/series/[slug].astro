---
import MainLayout from "../../layouts/MainLayout.astro";
import ContentCard from "../../components/content/ContentCard.astro";

import {
    getContentSeries
} from "../../lib/series";

export async function getStaticPaths() {

    const series =
        await getContentSeries();


    return series.map((item) => ({
        params: {
            slug:
                item.slug
        },

        props: {
            series:
                item
        }
    }));

}

const {
    series
} = Astro.props;

const canonical =
    new URL(
        `/series/${series.slug}/`,
        Astro.site ?? Astro.url
    ).toString();

const title =
    `${series.name} | The River Kept Flowing`;

const seriesSchema = {
    "@context": "https://schema.org",
    "@type": "CreativeWorkSeries",
    name:
        series.name,
    description:
        series.description,
    url:
        canonical,
    hasPart:
        series.entries.map(
            (entry, index) => ({
                "@type": "CreativeWork",
                position:
                    index + 1,
                name:
                    entry.title,
                description:
                    entry.description,
                url:
                    new URL(
                        entry.href,
                        canonical
                    ).toString(),
                datePublished:
                    entry.published
                        .toISOString()
            })
        )
};

const itemListSchema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name:
        series.name,
    numberOfItems:
        series.entryCount,
    itemListElement:
        series.entries.map(
            (entry, index) => ({
                "@type": "ListItem",
                position:
                    index + 1,
                name:
                    entry.title,
                url:
                    new URL(
                        entry.href,
                        canonical
                    ).toString()
            })
        )
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item:
                "https://theriverkeptflowing.com/"
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Library",
            item:
                "https://theriverkeptflowing.com/library/"
        },
        {
            "@type": "ListItem",
            position: 3,
            name: "Series",
            item:
                "https://theriverkeptflowing.com/series/"
        },
        {
            "@type": "ListItem",
            position: 4,
            name:
                series.name,
            item:
                canonical
        }
    ]
};
---

<MainLayout
    title={title}
    description={series.description}
    canonical={canonical}
>

    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(
            seriesSchema
        )}
    ></script>

    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(
            itemListSchema
        )}
    ></script>

    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(
            breadcrumbSchema
        )}
    ></script>


    <main
        class="series-archive"
        data-pagefind-body
    >

        <nav
            class="series-breadcrumbs"
            aria-label="Breadcrumb"
        >

            <a href="/library/">
                Library
            </a>

            <span aria-hidden="true">
                /
            </span>

            <a href="/series/">
                Series
            </a>

        </nav>


        <header class="series-archive__hero">

            <p class="series-archive__eyebrow">
                Ordered River Library Series
            </p>

            <h1>
                {series.name}
            </h1>

            <p>
                {series.description}
            </p>

            <div class="series-archive__summary">

                <span>
                    {series.entryCount}
                    {
                        series.entryCount === 1
                            ? " published work"
                            : " published works"
                    }
                </span>

                <span aria-hidden="true">
                    ·
                </span>

                <span>
                    {
                        series.collections.join(
                            ", "
                        )
                    }
                </span>

            </div>

        </header>


        <section
            class="series-sequence"
            aria-labelledby="series-sequence-title"
        >

            <div class="series-sequence__heading">

                <p>
                    Read in order
                </p>

                <h2 id="series-sequence-title">
                    The Complete Series
                </h2>

            </div>


            <ol class="series-sequence__list">

                {
                    series.entries.map((entry) => (

                        <li class="series-sequence__entry">

                            <div class="series-sequence__position">

                                <span>
                                    Part
                                </span>

                                <strong>
                                    {
                                        entry.seriesOrder
                                    }
                                </strong>

                            </div>

                            <div class="series-sequence__card">

                                <ContentCard
                                    type={
                                        entry.collectionLabel
                                    }
                                    title={entry.title}
                                    description={
                                        entry.description
                                    }
                                    href={entry.href}
                                    published={
                                        entry.published
                                    }
                                    readingMinutes={
                                        entry.readingMinutes
                                    }
                                    featured={
                                        entry.featured
                                    }
                                    tags={entry.tags}
                                    action="Read this part"
                                />

                            </div>

                        </li>

                    ))
                }

            </ol>

        </section>


        <footer class="series-archive__footer">

            <a href="/series/">
                ← Browse all series
            </a>

            <a href="/library/">
                Visit the Library →
            </a>

        </footer>

    </main>

</MainLayout>


<style>

    .series-archive {
        width:
            min(
                1080px,
                calc(100% - 32px)
            );
        margin: 0 auto;
        padding: 72px 0 120px;
    }


    .series-breadcrumbs {
        display: flex;
        gap: 10px;
        margin-bottom: 54px;
        font-size: 0.86rem;
    }


    .series-breadcrumbs a,
    .series-archive__footer a {
        color: inherit;
    }


    .series-archive__hero {
        max-width: 820px;
        margin-bottom: 80px;
    }


    .series-archive__eyebrow,
    .series-sequence__heading > p {
        margin: 0 0 14px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        opacity: 0.7;
    }


    .series-archive__hero h1 {
        margin: 0;
        font-size:
            clamp(
                2.8rem,
                7vw,
                5.5rem
            );
        line-height: 1.02;
    }


    .series-archive__hero > p {
        margin: 28px 0 0;
        font-size: 1.14rem;
        line-height: 1.75;
    }


    .series-archive__summary {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 26px;
        font-size: 0.88rem;
        opacity: 0.72;
    }


    .series-sequence__heading {
        margin-bottom: 30px;
    }


    .series-sequence__heading h2 {
        margin: 0;
        font-size:
            clamp(
                2rem,
                4vw,
                3.2rem
            );
    }


    .series-sequence__list {
        display: grid;
        gap: 26px;
        margin: 0;
        padding: 0;
        list-style: none;
    }


    .series-sequence__entry {
        display: grid;
        grid-template-columns:
            90px
            minmax(0, 1fr);
        align-items: start;
        gap: 24px;
    }


    .series-sequence__position {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding-top: 24px;
        text-align: center;
    }


    .series-sequence__position span {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0.65;
    }


    .series-sequence__position strong {
        font-size: 2.1rem;
        line-height: 1;
    }


    .series-archive__footer {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-top: 84px;
        padding-top: 28px;
        border-top: 1px solid
            color-mix(
                in srgb,
                currentColor 16%,
                transparent
            );
    }


    @media (max-width: 640px) {

        .series-archive {
            width:
                min(
                    100% - 24px,
                    1080px
                );
            padding:
                54px 0 88px;
        }


        .series-sequence__entry {
            grid-template-columns:
                1fr;
        }


        .series-sequence__position {
            align-items: flex-start;
            padding:
                0 8px;
            text-align: left;
        }


        .series-archive__footer {
            flex-direction:
                column;
        }

    }

</style>