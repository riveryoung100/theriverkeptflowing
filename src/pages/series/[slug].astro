---
import MainLayout from "../../layouts/MainLayout.astro";
import ContentCard from "../../components/content/ContentCard.astro";

import {
    getContentSeries
} from "../../lib/series";

export async function getStaticPaths() {

    const series =
        await getContentSeries();


    return series.map((item) => ({
        params: {
            slug:
                item.slug
        },

        props: {
            series:
                item
        }
    }));

}

const {
    series
} = Astro.props;

const canonical =
    new URL(
        `/series/${series.slug}/`,
        Astro.site ?? Astro.url
    ).toString();

const title =
    `${series.name} | The River Kept Flowing`;

const seriesSchema = {
    "@context": "https://schema.org",
    "@type": "CreativeWorkSeries",
    name:
        series.name,
    description:
        series.description,
    url:
        canonical,
    hasPart:
        series.entries.map(
            (entry, index) => ({
                "@type": "CreativeWork",
                position:
                    index + 1,
                name:
                    entry.title,
                description:
                    entry.description,
                url:
                    new URL(
                        entry.href,
                        canonical
                    ).toString(),
                datePublished:
                    entry.published
                        .toISOString()
            })
        )
};

const itemListSchema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name:
        series.name,
    numberOfItems:
        series.entryCount,
    itemListElement:
        series.entries.map(
            (entry, index) => ({
                "@type": "ListItem",
                position:
                    index + 1,
                name:
                    entry.title,
                url:
                    new URL(
                        entry.href,
                        canonical
                    ).toString()
            })
        )
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item:
                "https://theriverkeptflowing.com/"
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Library",
            item:
                "https://theriverkeptflowing.com/library/"
        },
        {
            "@type": "ListItem",
            position: 3,
            name: "Series",
            item:
                "https://theriverkeptflowing.com/series/"
        },
        {
            "@type": "ListItem",
            position: 4,
            name:
                series.name,
            item:
                canonical
        }
    ]
};
---

<MainLayout
    title={title}
    description={series.description}
    canonical={canonical}
    stylesheet="/series.css"
>

    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(
            seriesSchema
        )}
    ></script>

    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(
            itemListSchema
        )}
    ></script>

    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(
            breadcrumbSchema
        )}
    ></script>


    <main
        class="series-archive"
        data-pagefind-body
    >

        <nav
            class="series-breadcrumbs"
            aria-label="Breadcrumb"
        >

            <a href="/library/">
                Library
            </a>

            <span aria-hidden="true">
                /
            </span>

            <a href="/series/">
                Series
            </a>

        </nav>


        <header class="series-archive__hero">

            <p class="series-archive__eyebrow">
                Ordered River Library Series
            </p>

            <h1>
                {series.name}
            </h1>

            <p>
                {series.description}
            </p>

            <div class="series-archive__summary">

                <span>
                    {series.entryCount}
                    {
                        series.entryCount === 1
                            ? " published work"
                            : " published works"
                    }
                </span>

                <span aria-hidden="true">
                    ·
                </span>

                <span>
                    {
                        series.collections.join(
                            ", "
                        )
                    }
                </span>

            </div>

        </header>


        <section
            class="series-sequence"
            aria-labelledby="series-sequence-title"
        >

            <div class="series-sequence__heading">

                <p>
                    Read in order
                </p>

                <h2 id="series-sequence-title">
                    The Complete Series
                </h2>

            </div>


            <ol class="series-sequence__list">

                {
                    series.entries.map((entry) => (

                        <li class="series-sequence__entry">

                            <div class="series-sequence__position">

                                <span>
                                    Part
                                </span>

                                <strong>
                                    {
                                        entry.seriesOrder
                                    }
                                </strong>

                            </div>

                            <div class="series-sequence__card">

                                <ContentCard
                                    type={
                                        entry.collectionLabel
                                    }
                                    title={entry.title}
                                    description={
                                        entry.description
                                    }
                                    href={entry.href}
                                    published={
                                        entry.published
                                    }
                                    readingMinutes={
                                        entry.readingMinutes
                                    }
                                    featured={
                                        entry.featured
                                    }
                                    tags={entry.tags}
                                    action="Read this part"
                                />

                            </div>

                        </li>

                    ))
                }

            </ol>

        </section>


        <footer class="series-archive__footer">

            <a href="/series/">
                ← Browse all series
            </a>

            <a href="/library/">
                Visit the Library →
            </a>

        </footer>

    </main>

</MainLayout>


