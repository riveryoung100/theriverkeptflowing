{
    "extends": "astro/tsconfigs/strict",
    "include": [
        ".astro/types.d.ts",
        "**/*"
    ],
    "exclude": [
        "dist",
        "archive"
    ],
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "baseUrl": ".",
        "paths": {
            "@assets/*": [
                "src/assets/*"
            ],
            "@components/*": [
                "src/components/*"
            ],
            "@content/*": [
                "src/content/*"
            ],
            "@data/*": [
                "src/data/*"
            ],
            "@layouts/*": [
                "src/layouts/*"
            ],
            "@scripts/*": [
                "src/scripts/*"
            ],
            "@styles/*": [
                "src/styles/*"
            ]
        }
    }
}
